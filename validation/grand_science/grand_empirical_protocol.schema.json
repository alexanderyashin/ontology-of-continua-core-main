{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "OC133_GRAND_EMPIRICAL_PROTOCOL_v1",
  "title": "OC Core 1.3.3 Grand Empirical Protocol and Decomposition Queue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "release_id",
    "version",
    "capability_owner",
    "blocker_id",
    "verdict",
    "blocked_domain_total",
    "queue_total",
    "requirements_ref",
    "evidence_schema_ref",
    "protocol_schema_ref",
    "sample_pack_ref",
    "rows"
  ],
  "properties": {
    "schema_id": {
      "const": "OC133_GRAND_EMPIRICAL_DECOMPOSITION_QUEUE_v1"
    },
    "release_id": {
      "const": "oc_core_1_3_3"
    },
    "version": {
      "const": "1.3.3"
    },
    "capability_owner": {
      "const": "Research/EmpiricalScience"
    },
    "blocker_id": {
      "const": "grand_toe_empirical_superiority"
    },
    "verdict": {
      "type": "string"
    },
    "blocked_domain_total": {
      "type": "integer",
      "minimum": 0
    },
    "queue_total": {
      "type": "integer",
      "minimum": 0
    },
    "requirements_ref": {
      "type": "string",
      "minLength": 1
    },
    "evidence_schema_ref": {
      "type": "string",
      "minLength": 1
    },
    "protocol_schema_ref": {
      "type": "string",
      "minLength": 1
    },
    "sample_pack_ref": {
      "type": "string",
      "minLength": 1
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "queue_id",
          "blocker_id",
          "domain",
          "owner_capability",
          "status",
          "current_valid_n",
          "minimum_n",
          "missing_n",
          "domain_blockers",
          "required_protocol_steps",
          "required_pack_fields",
          "sample_pack_ref",
          "evidence_schema_ref",
          "protocol_schema_ref",
          "registry_ref"
        ],
        "properties": {
          "queue_id": {
            "type": "string",
            "minLength": 1
          },
          "blocker_id": {
            "const": "grand_toe_empirical_superiority"
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "owner_capability": {
            "const": "Research/EmpiricalScience"
          },
          "status": {
            "const": "BLOCKED_PENDING_GENUINE_EVIDENCE_PACK"
          },
          "current_valid_n": {
            "type": "integer",
            "minimum": 0
          },
          "minimum_n": {
            "type": "integer",
            "minimum": 1
          },
          "missing_n": {
            "type": "integer",
            "minimum": 0
          },
          "domain_blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_protocol_steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_pack_fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sample_pack_ref": {
            "type": "string",
            "minLength": 1
          },
          "evidence_schema_ref": {
            "type": "string",
            "minLength": 1
          },
          "protocol_schema_ref": {
            "type": "string",
            "minLength": 1
          },
          "registry_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
