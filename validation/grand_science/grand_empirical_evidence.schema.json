{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "OC133_GRAND_EMPIRICAL_EVIDENCE_v1",
  "title": "OC Core 1.3.3 Grand Empirical Evidence Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "release_id",
    "evidence_owner",
    "evidence_pack_id",
    "domain",
    "source_separation",
    "n",
    "model_under_test",
    "comparator_baseline",
    "uncertainty",
    "residuals",
    "negative_controls",
    "falsifiers",
    "grand_toe_support_allowed"
  ],
  "properties": {
    "schema_id": {
      "const": "OC133_GRAND_EMPIRICAL_EVIDENCE_v1"
    },
    "release_id": {
      "const": "oc_core_1_3_3"
    },
    "evidence_owner": {
      "const": "Research/EmpiricalScience"
    },
    "evidence_pack_id": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "enum": [
        "biology",
        "chemistry",
        "mathematics",
        "physics",
        "systems"
      ]
    },
    "source_separation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "pre_target_lock",
        "target_hidden_until_scoring",
        "training_sources",
        "target_sources"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "prospective",
            "target_blind"
          ]
        },
        "pre_target_lock": {
          "type": "boolean"
        },
        "target_hidden_until_scoring": {
          "type": "boolean"
        },
        "training_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "target_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "n": {
      "type": "integer",
      "minimum": 20
    },
    "model_under_test": {
      "type": "string",
      "minLength": 1
    },
    "comparator_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "prediction_rule",
        "pre_registered"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "prediction_rule": {
          "type": "string",
          "minLength": 1
        },
        "pre_registered": {
          "type": "boolean"
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "method",
        "interval"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "interval": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "residuals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "comparator",
        "superiority_margin"
      ],
      "properties": {
        "model": {
          "type": "number",
          "minimum": 0
        },
        "comparator": {
          "type": "number",
          "minimum": 0
        },
        "superiority_margin": {
          "type": "number"
        }
      }
    },
    "negative_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "control_id",
          "description",
          "rejected"
        ],
        "properties": {
          "control_id": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "rejected": {
            "type": "boolean"
          }
        }
      }
    },
    "falsifiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "grand_toe_support_allowed": {
      "const": true
    }
  }
}
