{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OC Core simulation output",
  "type": "object",
  "required": [
    "simulation_id",
    "seed",
    "trace_points",
    "stability_score",
    "boundary_crossed"
  ],
  "properties": {
    "simulation_id": {
      "type": "string"
    },
    "seed": {
      "type": "integer"
    },
    "trace_points": {
      "type": "array"
    },
    "stability_score": {
      "type": "number"
    },
    "boundary_crossed": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
