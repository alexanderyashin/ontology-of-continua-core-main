{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OC Core 1.4 demonstrator spec",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "spec_id",
    "title",
    "demo_class",
    "purpose",
    "window_id",
    "oc_concept",
    "parameters",
    "limits"
  ],
  "properties": {
    "spec_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "demo_class": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "window_id": {
      "type": "string",
      "minLength": 1
    },
    "oc_concept": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "type",
          "default"
        ],
        "properties": {
          "type": {
            "enum": [
              "integer",
              "number",
              "string"
            ]
          },
          "default": {},
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          }
        }
      }
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
