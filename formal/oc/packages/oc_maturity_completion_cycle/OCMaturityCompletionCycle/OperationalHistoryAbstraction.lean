import OCMaturityCompletionCycle.FiniteJointOpenProcess

/-!
# Operational observation/control histories

History dependence is primitive in this layer: a normalized next joint law is
indexed by an observation history and a control history.  A separate
`FrozenHistoryMarkovRealization` can show that such a law is generated by a
memoryless joint process on a richer state.  The context-indexed encoder `qChi`
appears in the abstract next law and in every history defect.
-/

namespace OCMaturityCompletionCycle

universe uHistory uObservation uState uContext uBoundaryIn uAction uBoundaryOut
  uAbstractState uAbstractContext uAbstractBoundaryIn uAbstractAction
  uAbstractBoundaryOut

/-- Finite index of prospectively frozen observation/control histories. -/
structure FrozenOperationalHistorySupport
    (HistoryIndex : Type uHistory)
    (Observation : Type uObservation)
    (Context : Type uContext)
    (BoundaryIn : Type uBoundaryIn)
    (Action : Type uAction)
    [Fintype HistoryIndex] where
  observations : HistoryIndex → List Observation
  controls : HistoryIndex → List (JointOpenControl Context BoundaryIn Action)
  currentContext : HistoryIndex → Context
  currentBoundaryIn : HistoryIndex → BoundaryIn
  currentAction : HistoryIndex → Action
  observations_nonempty : ∀ index, (observations index).length > 0
  history_shape : ∀ index,
    (controls index).length + 1 = (observations index).length

/--
A primitive normalized history-indexed joint law.  It need not be memoryless in
the visible state; realization by a richer process is an additional witness.
-/
structure FiniteHistoryJointOpenProcess
    (HistoryIndex : Type uHistory)
    (Observation : Type uObservation)
    (State : Type uState)
    (Context : Type uContext)
    (BoundaryIn : Type uBoundaryIn)
    (Action : Type uAction)
    (BoundaryOut : Type uBoundaryOut)
    [Fintype HistoryIndex]
    [Fintype State]
    [Fintype BoundaryOut] where
  support : FrozenOperationalHistorySupport HistoryIndex Observation Context
    BoundaryIn Action
  nextLaw : HistoryIndex → FiniteProbabilityMass (State × BoundaryOut)

/-- Current fine input attached to one frozen operational history. -/
def FiniteHistoryJointOpenProcess.currentControl
    {HistoryIndex : Type uHistory}
    {Observation : Type uObservation}
    {State : Type uState}
    {Context : Type uContext}
    {BoundaryIn : Type uBoundaryIn}
    {Action : Type uAction}
    {BoundaryOut : Type uBoundaryOut}
    [Fintype HistoryIndex]
    [Fintype State]
    [Fintype BoundaryOut]
    (process : FiniteHistoryJointOpenProcess HistoryIndex Observation State
      Context BoundaryIn Action BoundaryOut)
    (index : HistoryIndex) : JointOpenControl Context BoundaryIn Action :=
  (process.support.currentContext index,
    process.support.currentBoundaryIn index,
    process.support.currentAction index)

/--
An explicit Markov realization of every frozen history witness.  The complete
state/output path must have positive probability under the declared plant and
policy, its policy must reproduce the recorded control trace, and the
primitive history-indexed next law must equal the plant law at that path's
endpoint.  Thus this is stronger than an endpoint-only representation.
-/
structure FrozenHistoryMarkovRealization
    {HistoryIndex : Type uHistory}
    {Observation : Type uObservation}
    {State : Type uState}
    {Context : Type uContext}
    {BoundaryIn : Type uBoundaryIn}
    {Action : Type uAction}
    {BoundaryOut : Type uBoundaryOut}
    [Fintype HistoryIndex]
    [Fintype State]
    [Fintype BoundaryOut]
    (historyProcess : FiniteHistoryJointOpenProcess HistoryIndex Observation
       State Context BoundaryIn Action BoundaryOut)
    (plant : FiniteJointOpenProcess State Context BoundaryIn Action BoundaryOut) where
  observeState : State → Observation
  experiment : HistoryIndex →
    FiniteJointOpenExperiment State Context BoundaryIn Action BoundaryOut
  experiment_uses_plant : ∀ index, (experiment index).process = plant
  horizon_agrees : ∀ index,
    (experiment index).horizon = (historyProcess.support.controls index).length
  policy_agrees : ∀ index step
      (stepInHistory : step < (historyProcess.support.controls index).length),
    (experiment index).policy step =
      (historyProcess.support.controls index).get ⟨step, stepInHistory⟩
  witnessedPath : (index : HistoryIndex) →
    FiniteStateOutputPath State BoundaryOut (experiment index).horizon
  witnessed_path_positive : ∀ index,
    0 < (inducedFiniteStateOutputPathLaw (experiment index)).mass
      (witnessedPath index)
  observations_realized : ∀ index,
    List.map observeState
        (finiteStateOutputPathStates (experiment index).horizon
          (witnessedPath index)) =
      historyProcess.support.observations index
  next_law_realized : ∀ index,
    (historyProcess.nextLaw index).mass =
      (jointStepProbability plant
        (finiteStateOutputPathLastState (experiment index).horizon
          (witnessedPath index))
        (historyProcess.currentControl index)).mass

/--
A strict prefix relation internal to the frozen finite history support.  Equal
observation histories may still represent distinct hidden-state alternatives;
only a genuinely shorter declared history is required to be a trace prefix.
-/
def StrictOperationalHistoryPrefix
    {HistoryIndex : Type uHistory}
    {Observation : Type uObservation}
    {Context : Type uContext}
    {BoundaryIn : Type uBoundaryIn}
    {Action : Type uAction}
    [Fintype HistoryIndex]
    (support : FrozenOperationalHistorySupport HistoryIndex Observation Context
      BoundaryIn Action)
    (short long : HistoryIndex) : Prop :=
  (support.observations short).IsPrefix (support.observations long) ∧
    (support.controls short).IsPrefix (support.controls long) ∧
    (support.observations short).length < (support.observations long).length

/--
Finite-support coherence witness for the family of realized histories.  This
does not claim an infinite-path stochastic process: it says every declared
strict prefix is realized by the same plant/policy trace prefix, both in state
and emitted boundary output.
-/
structure FrozenHistoryPrefixConsistency
    {HistoryIndex : Type uHistory}
    {Observation : Type uObservation}
    {State : Type uState}
    {Context : Type uContext}
    {BoundaryIn : Type uBoundaryIn}
    {Action : Type uAction}
    {BoundaryOut : Type uBoundaryOut}
    [Fintype HistoryIndex]
    [Fintype State]
    [Fintype BoundaryOut]
    {historyProcess : FiniteHistoryJointOpenProcess HistoryIndex Observation
      State Context BoundaryIn Action BoundaryOut}
    {plant : FiniteJointOpenProcess State Context BoundaryIn Action BoundaryOut}
    (realization : FrozenHistoryMarkovRealization historyProcess plant) where
  state_trace_prefix : ∀ short long,
    StrictOperationalHistoryPrefix historyProcess.support short long →
      (finiteStateOutputPathStates (realization.experiment short).horizon
        (realization.witnessedPath short)).IsPrefix
      (finiteStateOutputPathStates (realization.experiment long).horizon
        (realization.witnessedPath long))
  output_trace_prefix : ∀ short long,
    StrictOperationalHistoryPrefix historyProcess.support short long →
      (finiteStateOutputPathOutputs (realization.experiment short).horizon
        (realization.witnessedPath short)).IsPrefix
      (finiteStateOutputPathOutputs (realization.experiment long).horizon
        (realization.witnessedPath long))

/--
Operational abstraction of observation and control histories.  The singleton
law is the explicit length-one bridge to `stateMap`.
-/
structure OperationalHistoryAbstraction
    {State : Type uState}
    {Context : Type uContext}
    {BoundaryIn : Type uBoundaryIn}
    {Action : Type uAction}
    {BoundaryOut : Type uBoundaryOut}
    {Observation : Type uObservation}
    {AbstractState : Type uAbstractState}
    {AbstractContext : Type uAbstractContext}
    {AbstractBoundaryIn : Type uAbstractBoundaryIn}
    {AbstractAction : Type uAbstractAction}
    {AbstractBoundaryOut : Type uAbstractBoundaryOut}
    [Fintype State]
    [Fintype BoundaryOut]
    [Fintype AbstractState]
    [Fintype AbstractBoundaryOut]
    (abstraction : FiniteJointContextualAbstraction State Context BoundaryIn
      Action BoundaryOut AbstractState AbstractContext AbstractBoundaryIn
      AbstractAction AbstractBoundaryOut) where
  observeState : State → Observation
  qChi : Context → List Observation →
    List (JointOpenControl Context BoundaryIn Action) → AbstractState
  singleton_compatibility : ∀ context state,
    qChi context [observeState state] [] = abstraction.stateMap state

/-- Explicit length-one state/history compatibility gate. -/
def HistoryStateCompatibility
    {State : Type uState}
    {Context : Type uContext}
    {BoundaryIn : Type uBoundaryIn}
    {Action : Type uAction}
    {BoundaryOut : Type uBoundaryOut}
    {Observation : Type uObservation}
    {AbstractState : Type uAbstractState}
    {AbstractContext : Type uAbstractContext}
    {AbstractBoundaryIn : Type uAbstractBoundaryIn}
    {AbstractAction : Type uAbstractAction}
    {AbstractBoundaryOut : Type uAbstractBoundaryOut}
    [Fintype State]
    [Fintype BoundaryOut]
    [Fintype AbstractState]
    [Fintype AbstractBoundaryOut]
    {abstraction : FiniteJointContextualAbstraction State Context BoundaryIn
      Action BoundaryOut AbstractState AbstractContext AbstractBoundaryIn
      AbstractAction AbstractBoundaryOut}
    (historyAbstraction :
      OperationalHistoryAbstraction (Observation := Observation) abstraction) : Prop :=
  ∀ context state,
    historyAbstraction.qChi context [historyAbstraction.observeState state] [] =
      abstraction.stateMap state

theorem operationalHistoryAbstraction_has_stateCompatibility
    {State : Type uState}
    {Context : Type uContext}
    {BoundaryIn : Type uBoundaryIn}
    {Action : Type uAction}
    {BoundaryOut : Type uBoundaryOut}
    {Observation : Type uObservation}
    {AbstractState : Type uAbstractState}
    {AbstractContext : Type uAbstractContext}
    {AbstractBoundaryIn : Type uAbstractBoundaryIn}
    {AbstractAction : Type uAbstractAction}
    {AbstractBoundaryOut : Type uAbstractBoundaryOut}
    [Fintype State]
    [Fintype BoundaryOut]
    [Fintype AbstractState]
    [Fintype AbstractBoundaryOut]
    {abstraction : FiniteJointContextualAbstraction State Context BoundaryIn
      Action BoundaryOut AbstractState AbstractContext AbstractBoundaryIn
      AbstractAction AbstractBoundaryOut}
    (historyAbstraction :
      OperationalHistoryAbstraction (Observation := Observation) abstraction) :
    HistoryStateCompatibility historyAbstraction :=
  historyAbstraction.singleton_compatibility

/-- Fine history law transported jointly through state and boundary output. -/
def transportedFineHistoryJointLaw
    {HistoryIndex : Type uHistory}
    {Observation : Type uObservation}
    {State : Type uState}
    {Context : Type uContext}
    {BoundaryIn : Type uBoundaryIn}
    {Action : Type uAction}
    {BoundaryOut : Type uBoundaryOut}
    {AbstractState : Type uAbstractState}
    {AbstractContext : Type uAbstractContext}
    {AbstractBoundaryIn : Type uAbstractBoundaryIn}
    {AbstractAction : Type uAbstractAction}
    {AbstractBoundaryOut : Type uAbstractBoundaryOut}
    [Fintype HistoryIndex]
    [Fintype State]
    [Fintype BoundaryOut]
    [Fintype AbstractState]
    [Fintype AbstractBoundaryOut]
    [DecidableEq AbstractState]
    [DecidableEq AbstractBoundaryOut]
    (abstraction : FiniteJointContextualAbstraction State Context BoundaryIn
      Action BoundaryOut AbstractState AbstractContext AbstractBoundaryIn
      AbstractAction AbstractBoundaryOut)
    (historyProcess : FiniteHistoryJointOpenProcess HistoryIndex Observation
      State Context BoundaryIn Action BoundaryOut)
    (index : HistoryIndex) :
    FiniteProbabilityMass (AbstractState × AbstractBoundaryOut) :=
  pushforwardFiniteProbability
    (jointOutcomeMap abstraction.stateMap abstraction.boundaryOutMap)
    (historyProcess.nextLaw index)

/-- Abstract next law selected by the operational history encoder. -/
def abstractHistoryJointLaw
    {HistoryIndex : Type uHistory}
    {Observation : Type uObservation}
    {State : Type uState}
    {Context : Type uContext}
    {BoundaryIn : Type uBoundaryIn}
    {Action : Type uAction}
    {BoundaryOut : Type uBoundaryOut}
    {AbstractState : Type uAbstractState}
    {AbstractContext : Type uAbstractContext}
    {AbstractBoundaryIn : Type uAbstractBoundaryIn}
    {AbstractAction : Type uAbstractAction}
    {AbstractBoundaryOut : Type uAbstractBoundaryOut}
    [Fintype HistoryIndex]
    [Fintype State]
    [Fintype BoundaryOut]
    [Fintype AbstractState]
    [Fintype AbstractBoundaryOut]
    (abstraction : FiniteJointContextualAbstraction State Context BoundaryIn
      Action BoundaryOut AbstractState AbstractContext AbstractBoundaryIn
      AbstractAction AbstractBoundaryOut)
    (historyAbstraction :
      OperationalHistoryAbstraction (Observation := Observation) abstraction)
    (historyProcess : FiniteHistoryJointOpenProcess HistoryIndex Observation
      State Context BoundaryIn Action BoundaryOut)
    (index : HistoryIndex) :
    FiniteProbabilityMass (AbstractState × AbstractBoundaryOut) :=
  jointStepProbability abstraction.abstract
    (historyAbstraction.qChi
      (historyProcess.support.currentContext index)
      (historyProcess.support.observations index)
      (historyProcess.support.controls index))
    (abstraction.contextMap (historyProcess.support.currentContext index),
      abstraction.boundaryInMap (historyProcess.support.currentBoundaryIn index),
      abstraction.actionMap (historyProcess.support.currentAction index))

/-- Fine next-state prediction law; emitted boundary output is marginalized. -/
def transportedFineHistoryStateLaw
    {HistoryIndex : Type uHistory}
    {Observation : Type uObservation}
    {State : Type uState}
    {Context : Type uContext}
    {BoundaryIn : Type uBoundaryIn}
    {Action : Type uAction}
    {BoundaryOut : Type uBoundaryOut}
    {AbstractState : Type uAbstractState}
    {AbstractContext : Type uAbstractContext}
    {AbstractBoundaryIn : Type uAbstractBoundaryIn}
    {AbstractAction : Type uAbstractAction}
    {AbstractBoundaryOut : Type uAbstractBoundaryOut}
    [Fintype HistoryIndex]
    [Fintype State]
    [Fintype BoundaryOut]
    [Fintype AbstractState]
    [Fintype AbstractBoundaryOut]
    [DecidableEq AbstractState]
    [DecidableEq AbstractBoundaryOut]
    (abstraction : FiniteJointContextualAbstraction State Context BoundaryIn
      Action BoundaryOut AbstractState AbstractContext AbstractBoundaryIn
      AbstractAction AbstractBoundaryOut)
    (historyProcess : FiniteHistoryJointOpenProcess HistoryIndex Observation
      State Context BoundaryIn Action BoundaryOut)
    (index : HistoryIndex) : FiniteProbabilityMass AbstractState :=
  pushforwardFiniteProbability Prod.fst
    (transportedFineHistoryJointLaw abstraction historyProcess index)

/-- Abstract next-state prediction law selected by qChi. -/
def abstractHistoryStateLaw
    {HistoryIndex : Type uHistory}
    {Observation : Type uObservation}
    {State : Type uState}
    {Context : Type uContext}
    {BoundaryIn : Type uBoundaryIn}
    {Action : Type uAction}
    {BoundaryOut : Type uBoundaryOut}
    {AbstractState : Type uAbstractState}
    {AbstractContext : Type uAbstractContext}
    {AbstractBoundaryIn : Type uAbstractBoundaryIn}
    {AbstractAction : Type uAbstractAction}
    {AbstractBoundaryOut : Type uAbstractBoundaryOut}
    [Fintype HistoryIndex]
    [Fintype State]
    [Fintype BoundaryOut]
    [Fintype AbstractState]
    [Fintype AbstractBoundaryOut]
    [DecidableEq AbstractState]
    [DecidableEq AbstractBoundaryOut]
    (abstraction : FiniteJointContextualAbstraction State Context BoundaryIn
      Action BoundaryOut AbstractState AbstractContext AbstractBoundaryIn
      AbstractAction AbstractBoundaryOut)
    (historyAbstraction :
      OperationalHistoryAbstraction (Observation := Observation) abstraction)
    (historyProcess : FiniteHistoryJointOpenProcess HistoryIndex Observation
      State Context BoundaryIn Action BoundaryOut)
    (index : HistoryIndex) : FiniteProbabilityMass AbstractState :=
  pushforwardFiniteProbability Prod.fst
    (abstractHistoryJointLaw abstraction historyAbstraction historyProcess index)

/-- Next-state prediction defect over a frozen observation/control-history support. -/
def historyPredictionDefect
    {HistoryIndex : Type uHistory}
    {Observation : Type uObservation}
    {State : Type uState}
    {Context : Type uContext}
    {BoundaryIn : Type uBoundaryIn}
    {Action : Type uAction}
    {BoundaryOut : Type uBoundaryOut}
    {AbstractState : Type uAbstractState}
    {AbstractContext : Type uAbstractContext}
    {AbstractBoundaryIn : Type uAbstractBoundaryIn}
    {AbstractAction : Type uAbstractAction}
    {AbstractBoundaryOut : Type uAbstractBoundaryOut}
    [Fintype HistoryIndex]
    [Fintype State]
    [Fintype BoundaryOut]
    [Fintype AbstractState]
    [Fintype AbstractBoundaryOut]
    [DecidableEq AbstractState]
    [DecidableEq AbstractBoundaryOut]
    (abstraction : FiniteJointContextualAbstraction State Context BoundaryIn
      Action BoundaryOut AbstractState AbstractContext AbstractBoundaryIn
      AbstractAction AbstractBoundaryOut)
    (historyAbstraction :
      OperationalHistoryAbstraction (Observation := Observation) abstraction)
    (historyProcess : FiniteHistoryJointOpenProcess HistoryIndex Observation
      State Context BoundaryIn Action BoundaryOut) : ℚ :=
  finiteLawFamilyDefect
    (transportedFineHistoryStateLaw abstraction historyProcess)
    (abstractHistoryStateLaw abstraction historyAbstraction historyProcess)

theorem historyPredictionDefect_eq_zero_iff_exact
    {HistoryIndex : Type uHistory}
    {Observation : Type uObservation}
    {State : Type uState}
    {Context : Type uContext}
    {BoundaryIn : Type uBoundaryIn}
    {Action : Type uAction}
    {BoundaryOut : Type uBoundaryOut}
    {AbstractState : Type uAbstractState}
    {AbstractContext : Type uAbstractContext}
    {AbstractBoundaryIn : Type uAbstractBoundaryIn}
    {AbstractAction : Type uAbstractAction}
    {AbstractBoundaryOut : Type uAbstractBoundaryOut}
    [Fintype HistoryIndex]
    [Fintype State]
    [Fintype BoundaryOut]
    [Fintype AbstractState]
    [Fintype AbstractBoundaryOut]
    [DecidableEq AbstractState]
    [DecidableEq AbstractBoundaryOut]
    (abstraction : FiniteJointContextualAbstraction State Context BoundaryIn
      Action BoundaryOut AbstractState AbstractContext AbstractBoundaryIn
      AbstractAction AbstractBoundaryOut)
    (historyAbstraction :
      OperationalHistoryAbstraction (Observation := Observation) abstraction)
    (historyProcess : FiniteHistoryJointOpenProcess HistoryIndex Observation
      State Context BoundaryIn Action BoundaryOut) :
    historyPredictionDefect abstraction historyAbstraction historyProcess = 0 ↔
      FiniteLawFamilyExact
        (transportedFineHistoryStateLaw abstraction historyProcess)
        (abstractHistoryStateLaw abstraction historyAbstraction historyProcess) :=
  finiteLawFamilyDefect_eq_zero_iff_exact _ _

/-- Encoded abstract state attached to one operational history. -/
def operationalHistoryAbstractState
    {HistoryIndex : Type uHistory}
    {Observation : Type uObservation}
    {State : Type uState}
    {Context : Type uContext}
    {BoundaryIn : Type uBoundaryIn}
    {Action : Type uAction}
    {BoundaryOut : Type uBoundaryOut}
    {AbstractState : Type uAbstractState}
    {AbstractContext : Type uAbstractContext}
    {AbstractBoundaryIn : Type uAbstractBoundaryIn}
    {AbstractAction : Type uAbstractAction}
    {AbstractBoundaryOut : Type uAbstractBoundaryOut}
    [Fintype HistoryIndex]
    [Fintype State]
    [Fintype BoundaryOut]
    [Fintype AbstractState]
    [Fintype AbstractBoundaryOut]
    {abstraction : FiniteJointContextualAbstraction State Context BoundaryIn
      Action BoundaryOut AbstractState AbstractContext AbstractBoundaryIn
      AbstractAction AbstractBoundaryOut}
    (historyAbstraction :
      OperationalHistoryAbstraction (Observation := Observation) abstraction)
    (historyProcess : FiniteHistoryJointOpenProcess HistoryIndex Observation
      State Context BoundaryIn Action BoundaryOut)
    (index : HistoryIndex) : AbstractState :=
  historyAbstraction.qChi
    (historyProcess.support.currentContext index)
    (historyProcess.support.observations index)
    (historyProcess.support.controls index)

/-- Mapped current open control attached to one operational history. -/
def operationalHistoryAbstractControl
    {HistoryIndex : Type uHistory}
    {Observation : Type uObservation}
    {State : Type uState}
    {Context : Type uContext}
    {BoundaryIn : Type uBoundaryIn}
    {Action : Type uAction}
    {BoundaryOut : Type uBoundaryOut}
    {AbstractState : Type uAbstractState}
    {AbstractContext : Type uAbstractContext}
    {AbstractBoundaryIn : Type uAbstractBoundaryIn}
    {AbstractAction : Type uAbstractAction}
    {AbstractBoundaryOut : Type uAbstractBoundaryOut}
    [Fintype HistoryIndex]
    [Fintype State]
    [Fintype BoundaryOut]
    [Fintype AbstractState]
    [Fintype AbstractBoundaryOut]
    (abstraction : FiniteJointContextualAbstraction State Context BoundaryIn
      Action BoundaryOut AbstractState AbstractContext AbstractBoundaryIn
      AbstractAction AbstractBoundaryOut)
    (historyProcess : FiniteHistoryJointOpenProcess HistoryIndex Observation
      State Context BoundaryIn Action BoundaryOut)
    (index : HistoryIndex) :
    JointOpenControl AbstractContext AbstractBoundaryIn AbstractAction :=
  (abstraction.contextMap (historyProcess.support.currentContext index),
    abstraction.boundaryInMap (historyProcess.support.currentBoundaryIn index),
    abstraction.actionMap (historyProcess.support.currentAction index))

/-- Histories are comparable only inside the same abstract state/control fibre. -/
def HistoryComparisonAligned
    {HistoryIndex : Type uHistory}
    {Observation : Type uObservation}
    {State : Type uState}
    {Context : Type uContext}
    {BoundaryIn : Type uBoundaryIn}
    {Action : Type uAction}
    {BoundaryOut : Type uBoundaryOut}
    {AbstractState : Type uAbstractState}
    {AbstractContext : Type uAbstractContext}
    {AbstractBoundaryIn : Type uAbstractBoundaryIn}
    {AbstractAction : Type uAbstractAction}
    {AbstractBoundaryOut : Type uAbstractBoundaryOut}
    [Fintype HistoryIndex]
    [Fintype State]
    [Fintype BoundaryOut]
    [Fintype AbstractState]
    [Fintype AbstractBoundaryOut]
    {abstraction : FiniteJointContextualAbstraction State Context BoundaryIn
      Action BoundaryOut AbstractState AbstractContext AbstractBoundaryIn
      AbstractAction AbstractBoundaryOut}
    (historyAbstraction :
      OperationalHistoryAbstraction (Observation := Observation) abstraction)
    (historyProcess : FiniteHistoryJointOpenProcess HistoryIndex Observation
      State Context BoundaryIn Action BoundaryOut)
    (left right : HistoryIndex) : Prop :=
  operationalHistoryAbstractState historyAbstraction historyProcess left =
      operationalHistoryAbstractState historyAbstraction historyProcess right ∧
    operationalHistoryAbstractControl abstraction historyProcess left =
      operationalHistoryAbstractControl abstraction historyProcess right

/-- Exact history lumpability inside one abstract state/current-control fibre. -/
def HistoryEncoderKernelConsistent
    {HistoryIndex : Type uHistory}
    {Observation : Type uObservation}
    {State : Type uState}
    {Context : Type uContext}
    {BoundaryIn : Type uBoundaryIn}
    {Action : Type uAction}
    {BoundaryOut : Type uBoundaryOut}
    {AbstractState : Type uAbstractState}
    {AbstractContext : Type uAbstractContext}
    {AbstractBoundaryIn : Type uAbstractBoundaryIn}
    {AbstractAction : Type uAbstractAction}
    {AbstractBoundaryOut : Type uAbstractBoundaryOut}
    [Fintype HistoryIndex]
    [Fintype State]
    [Fintype BoundaryOut]
    [Fintype AbstractState]
    [Fintype AbstractBoundaryOut]
    [DecidableEq AbstractState]
    [DecidableEq AbstractBoundaryOut]
    {abstraction : FiniteJointContextualAbstraction State Context BoundaryIn
      Action BoundaryOut AbstractState AbstractContext AbstractBoundaryIn
      AbstractAction AbstractBoundaryOut}
    (historyAbstraction :
      OperationalHistoryAbstraction (Observation := Observation) abstraction)
    (historyProcess : FiniteHistoryJointOpenProcess HistoryIndex Observation
      State Context BoundaryIn Action BoundaryOut) : Prop :=
  ∀ left right,
    HistoryComparisonAligned historyAbstraction historyProcess left right →
      (transportedFineHistoryStateLaw abstraction historyProcess left).mass =
        (transportedFineHistoryStateLaw abstraction historyProcess right).mass

/-- Pairwise left law used by the finite lumpability defect. -/
def historyLumpabilityLeftLaw
    {HistoryIndex : Type uHistory}
    {Observation : Type uObservation}
    {State : Type uState}
    {Context : Type uContext}
    {BoundaryIn : Type uBoundaryIn}
    {Action : Type uAction}
    {BoundaryOut : Type uBoundaryOut}
    {AbstractState : Type uAbstractState}
    {AbstractContext : Type uAbstractContext}
    {AbstractBoundaryIn : Type uAbstractBoundaryIn}
    {AbstractAction : Type uAbstractAction}
    {AbstractBoundaryOut : Type uAbstractBoundaryOut}
    [Fintype HistoryIndex]
    [Fintype State]
    [Fintype BoundaryOut]
    [Fintype AbstractState]
    [Fintype AbstractBoundaryOut]
    [DecidableEq AbstractState]
    [DecidableEq AbstractBoundaryOut]
    (abstraction : FiniteJointContextualAbstraction State Context BoundaryIn
      Action BoundaryOut AbstractState AbstractContext AbstractBoundaryIn
      AbstractAction AbstractBoundaryOut)
    (historyProcess : FiniteHistoryJointOpenProcess HistoryIndex Observation
      State Context BoundaryIn Action BoundaryOut) :
    HistoryIndex × HistoryIndex →
      FiniteProbabilityMass AbstractState :=
  fun pair => transportedFineHistoryStateLaw abstraction historyProcess pair.1

/-- Conditional right law: unrelated control fibres contribute exactly zero. -/
def historyLumpabilityRightLaw
    {HistoryIndex : Type uHistory}
    {Observation : Type uObservation}
    {State : Type uState}
    {Context : Type uContext}
    {BoundaryIn : Type uBoundaryIn}
    {Action : Type uAction}
    {BoundaryOut : Type uBoundaryOut}
    {AbstractState : Type uAbstractState}
    {AbstractContext : Type uAbstractContext}
    {AbstractBoundaryIn : Type uAbstractBoundaryIn}
    {AbstractAction : Type uAbstractAction}
    {AbstractBoundaryOut : Type uAbstractBoundaryOut}
    [Fintype HistoryIndex]
    [Fintype State]
    [Fintype BoundaryOut]
    [Fintype AbstractState]
    [Fintype AbstractBoundaryOut]
    [DecidableEq AbstractState]
    [DecidableEq AbstractContext]
    [DecidableEq AbstractBoundaryIn]
    [DecidableEq AbstractAction]
    [DecidableEq AbstractBoundaryOut]
    {abstraction : FiniteJointContextualAbstraction State Context BoundaryIn
      Action BoundaryOut AbstractState AbstractContext AbstractBoundaryIn
      AbstractAction AbstractBoundaryOut}
    (historyAbstraction :
      OperationalHistoryAbstraction (Observation := Observation) abstraction)
    (historyProcess : FiniteHistoryJointOpenProcess HistoryIndex Observation
      State Context BoundaryIn Action BoundaryOut) :
    HistoryIndex × HistoryIndex →
      FiniteProbabilityMass AbstractState :=
  by
    intro pair
    letI : Decidable
        (HistoryComparisonAligned historyAbstraction historyProcess pair.1 pair.2) := by
      unfold HistoryComparisonAligned
      infer_instance
    exact if HistoryComparisonAligned historyAbstraction historyProcess pair.1 pair.2
    then transportedFineHistoryStateLaw abstraction historyProcess pair.2
    else transportedFineHistoryStateLaw abstraction historyProcess pair.1

/-- Pairwise history lumpability defect in aligned state/control fibres. -/
def historyLumpabilityDefect
    {HistoryIndex : Type uHistory}
    {Observation : Type uObservation}
    {State : Type uState}
    {Context : Type uContext}
    {BoundaryIn : Type uBoundaryIn}
    {Action : Type uAction}
    {BoundaryOut : Type uBoundaryOut}
    {AbstractState : Type uAbstractState}
    {AbstractContext : Type uAbstractContext}
    {AbstractBoundaryIn : Type uAbstractBoundaryIn}
    {AbstractAction : Type uAbstractAction}
    {AbstractBoundaryOut : Type uAbstractBoundaryOut}
    [Fintype HistoryIndex]
    [Fintype State]
    [Fintype BoundaryOut]
    [Fintype AbstractState]
    [Fintype AbstractBoundaryOut]
    [DecidableEq AbstractState]
    [DecidableEq AbstractContext]
    [DecidableEq AbstractBoundaryIn]
    [DecidableEq AbstractAction]
    [DecidableEq AbstractBoundaryOut]
    {abstraction : FiniteJointContextualAbstraction State Context BoundaryIn
      Action BoundaryOut AbstractState AbstractContext AbstractBoundaryIn
      AbstractAction AbstractBoundaryOut}
    (historyAbstraction :
      OperationalHistoryAbstraction (Observation := Observation) abstraction)
    (historyProcess : FiniteHistoryJointOpenProcess HistoryIndex Observation
      State Context BoundaryIn Action BoundaryOut) : ℚ :=
  finiteLawFamilyDefect
    (historyLumpabilityLeftLaw abstraction historyProcess)
    (historyLumpabilityRightLaw historyAbstraction historyProcess)

theorem historyLumpabilityDefect_eq_zero_iff_kernelConsistent
    {HistoryIndex : Type uHistory}
    {Observation : Type uObservation}
    {State : Type uState}
    {Context : Type uContext}
    {BoundaryIn : Type uBoundaryIn}
    {Action : Type uAction}
    {BoundaryOut : Type uBoundaryOut}
    {AbstractState : Type uAbstractState}
    {AbstractContext : Type uAbstractContext}
    {AbstractBoundaryIn : Type uAbstractBoundaryIn}
    {AbstractAction : Type uAbstractAction}
    {AbstractBoundaryOut : Type uAbstractBoundaryOut}
    [Fintype HistoryIndex]
    [Fintype State]
    [Fintype BoundaryOut]
    [Fintype AbstractState]
    [Fintype AbstractBoundaryOut]
    [DecidableEq AbstractState]
    [DecidableEq AbstractContext]
    [DecidableEq AbstractBoundaryIn]
    [DecidableEq AbstractAction]
    [DecidableEq AbstractBoundaryOut]
    {abstraction : FiniteJointContextualAbstraction State Context BoundaryIn
      Action BoundaryOut AbstractState AbstractContext AbstractBoundaryIn
      AbstractAction AbstractBoundaryOut}
    (historyAbstraction :
      OperationalHistoryAbstraction (Observation := Observation) abstraction)
    (historyProcess : FiniteHistoryJointOpenProcess HistoryIndex Observation
      State Context BoundaryIn Action BoundaryOut) :
    historyLumpabilityDefect historyAbstraction historyProcess = 0 ↔
      HistoryEncoderKernelConsistent historyAbstraction historyProcess := by
  unfold historyLumpabilityDefect
  rw [finiteLawFamilyDefect_eq_zero_iff_exact]
  constructor
  · intro exactFamilies left right aligned
    have pairExact := exactFamilies (left, right)
    simpa [historyLumpabilityLeftLaw, historyLumpabilityRightLaw, aligned] using
      pairExact
  · intro consistent pair
    by_cases aligned :
        HistoryComparisonAligned historyAbstraction historyProcess pair.1 pair.2
    · simpa [historyLumpabilityLeftLaw, historyLumpabilityRightLaw, aligned] using
        consistent pair.1 pair.2 aligned
    · simp [historyLumpabilityLeftLaw, historyLumpabilityRightLaw, aligned]

/-- Fine boundary law derived from the primitive joint history law. -/
def transportedFineHistoryBoundaryLaw
    {HistoryIndex : Type uHistory}
    {Observation : Type uObservation}
    {State : Type uState}
    {Context : Type uContext}
    {BoundaryIn : Type uBoundaryIn}
    {Action : Type uAction}
    {BoundaryOut : Type uBoundaryOut}
    {AbstractState : Type uAbstractState}
    {AbstractContext : Type uAbstractContext}
    {AbstractBoundaryIn : Type uAbstractBoundaryIn}
    {AbstractAction : Type uAbstractAction}
    {AbstractBoundaryOut : Type uAbstractBoundaryOut}
    [Fintype HistoryIndex]
    [Fintype State]
    [Fintype BoundaryOut]
    [Fintype AbstractState]
    [Fintype AbstractBoundaryOut]
    [DecidableEq AbstractState]
    [DecidableEq AbstractBoundaryOut]
    (abstraction : FiniteJointContextualAbstraction State Context BoundaryIn
      Action BoundaryOut AbstractState AbstractContext AbstractBoundaryIn
      AbstractAction AbstractBoundaryOut)
    (historyProcess : FiniteHistoryJointOpenProcess HistoryIndex Observation
      State Context BoundaryIn Action BoundaryOut)
    (index : HistoryIndex) : FiniteProbabilityMass AbstractBoundaryOut :=
  pushforwardFiniteProbability Prod.snd
    (transportedFineHistoryJointLaw abstraction historyProcess index)

/-- Abstract boundary law derived from the abstract joint next law. -/
def abstractHistoryBoundaryLaw
    {HistoryIndex : Type uHistory}
    {Observation : Type uObservation}
    {State : Type uState}
    {Context : Type uContext}
    {BoundaryIn : Type uBoundaryIn}
    {Action : Type uAction}
    {BoundaryOut : Type uBoundaryOut}
    {AbstractState : Type uAbstractState}
    {AbstractContext : Type uAbstractContext}
    {AbstractBoundaryIn : Type uAbstractBoundaryIn}
    {AbstractAction : Type uAbstractAction}
    {AbstractBoundaryOut : Type uAbstractBoundaryOut}
    [Fintype HistoryIndex]
    [Fintype State]
    [Fintype BoundaryOut]
    [Fintype AbstractState]
    [Fintype AbstractBoundaryOut]
    [DecidableEq AbstractBoundaryOut]
    (abstraction : FiniteJointContextualAbstraction State Context BoundaryIn
      Action BoundaryOut AbstractState AbstractContext AbstractBoundaryIn
      AbstractAction AbstractBoundaryOut)
    (historyAbstraction :
      OperationalHistoryAbstraction (Observation := Observation) abstraction)
    (historyProcess : FiniteHistoryJointOpenProcess HistoryIndex Observation
      State Context BoundaryIn Action BoundaryOut)
    (index : HistoryIndex) : FiniteProbabilityMass AbstractBoundaryOut :=
  pushforwardFiniteProbability Prod.snd
    (abstractHistoryJointLaw abstraction historyAbstraction historyProcess index)

/-- Exact equality of joint laws forces equality of their output marginals. -/
theorem finiteJointLawFamilyExact_implies_secondMarginalExact
    {Index : Type*}
    {Left : Type*}
    {Right : Type*}
    [Fintype Left]
    [Fintype Right]
    [DecidableEq Right]
    (reference abstracted : Index → FiniteProbabilityMass (Left × Right))
    (jointExact : FiniteLawFamilyExact reference abstracted) :
    FiniteLawFamilyExact
      (fun index => pushforwardFiniteProbability Prod.snd (reference index))
      (fun index => pushforwardFiniteProbability Prod.snd (abstracted index)) := by
  intro index
  funext output
  simp only [pushforwardFiniteProbability]
  apply Finset.sum_congr rfl
  intro outcome _
  rw [congrFun (jointExact index) outcome]

/--
The boundary lane is independent of the state-prediction coordinate.  It is
only forced when the stronger full joint next-state/output law is assumed exact.
-/
theorem historyJointLawExact_implies_boundaryExact
    {HistoryIndex : Type uHistory}
    {Observation : Type uObservation}
    {State : Type uState}
    {Context : Type uContext}
    {BoundaryIn : Type uBoundaryIn}
    {Action : Type uAction}
    {BoundaryOut : Type uBoundaryOut}
    {AbstractState : Type uAbstractState}
    {AbstractContext : Type uAbstractContext}
    {AbstractBoundaryIn : Type uAbstractBoundaryIn}
    {AbstractAction : Type uAbstractAction}
    {AbstractBoundaryOut : Type uAbstractBoundaryOut}
    [Fintype HistoryIndex]
    [Fintype State]
    [Fintype BoundaryOut]
    [Fintype AbstractState]
    [Fintype AbstractBoundaryOut]
    [DecidableEq AbstractState]
    [DecidableEq AbstractBoundaryOut]
    (abstraction : FiniteJointContextualAbstraction State Context BoundaryIn
      Action BoundaryOut AbstractState AbstractContext AbstractBoundaryIn
      AbstractAction AbstractBoundaryOut)
    (historyAbstraction :
      OperationalHistoryAbstraction (Observation := Observation) abstraction)
    (historyProcess : FiniteHistoryJointOpenProcess HistoryIndex Observation
      State Context BoundaryIn Action BoundaryOut)
    (jointExact : FiniteLawFamilyExact
      (transportedFineHistoryJointLaw abstraction historyProcess)
      (abstractHistoryJointLaw abstraction historyAbstraction historyProcess)) :
    FiniteLawFamilyExact
      (transportedFineHistoryBoundaryLaw abstraction historyProcess)
      (abstractHistoryBoundaryLaw abstraction historyAbstraction historyProcess) := by
  simpa [transportedFineHistoryBoundaryLaw, abstractHistoryBoundaryLaw] using
    (finiteJointLawFamilyExact_implies_secondMarginalExact
      (transportedFineHistoryJointLaw abstraction historyProcess)
      (abstractHistoryJointLaw abstraction historyAbstraction historyProcess)
      jointExact)

