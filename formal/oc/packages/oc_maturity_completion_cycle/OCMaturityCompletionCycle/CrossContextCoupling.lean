import OCMaturityCompletionCycle.IdentityPredictiveBridge
import OCMaturityCompletionCycle.ContextNaturality

/-!
# Crossing-context functional and law-stitching obstructions

This module implements the prospectively frozen C13 attempts A4 and A5.

A4 asks whether one functional code can simultaneously collapse continuation
evidence, receive transports from two local contexts, and remain sufficient for
a joint predictive/path-law signature.  The exact answer is an equivalence-
closure/kernel-inclusion boundary.  It is useful, but it reduces to the existing
evidence-safety and used-range factorization results.

A5 asks whether local restrictions determine a joint law.  Exact stitching on
the used local range exists exactly when the restriction is injective on the
admitted law family.  A finite correlated/anticorrelated fixture has identical
local marginals and different joint laws, so an additional coupling coordinate
is necessary for exact stitching.
-/

namespace OCMaturityCompletionCycle

universe uOccurrence uFirst uSecond uBehavior uCode uLaw uLocal uJoint

/-! ## A4: one functional common coarsening -/

/-- Raw edges generated by evidence or equality in either local context. -/
def EvidenceOrContextEdge
    {Occurrence : Type uOccurrence}
    {FirstContext : Type uFirst}
    {SecondContext : Type uSecond}
    (evidence : BinaryRelation Occurrence)
    (firstContext : Occurrence → FirstContext)
    (secondContext : Occurrence → SecondContext) : BinaryRelation Occurrence :=
  fun left right =>
    evidence left right ∨
      firstContext left = firstContext right ∨
      secondContext left = secondContext right

/--
One functional code receives both local context transports, collapses admitted
continuation evidence, and is sufficient for the joint behavior.
-/
structure CommonContextPredictiveCode
    {Occurrence : Type uOccurrence}
    {FirstContext : Type uFirst}
    {SecondContext : Type uSecond}
    {Behavior : Type uBehavior}
    {Code : Type uCode}
    (evidence : BinaryRelation Occurrence)
    (firstContext : Occurrence → FirstContext)
    (secondContext : Occurrence → SecondContext)
    (jointBehavior : Occurrence → Behavior)
    (code : Occurrence → Code) : Prop where
  evidence_preserving : ContinuationPreserving evidence code
  first_transport : Nonempty (UsedContextTransport firstContext code)
  second_transport : Nonempty (UsedContextTransport secondContext code)
  joint_sufficient : KernelIncluded code jointBehavior

/--
Exact A4 boundary.  A common functional code exists precisely when equivalence
closure of evidence plus both context kernels preserves the joint behavior.
The constructive reverse direction chooses the joint behavior itself as code.
-/
theorem commonContextPredictiveCode_exists_iff_generatedSafe
    {Occurrence : Type uOccurrence}
    {FirstContext : Type uFirst}
    {SecondContext : Type uSecond}
    {Behavior : Type uBehavior}
    (evidence : BinaryRelation Occurrence)
    (firstContext : Occurrence → FirstContext)
    (secondContext : Occurrence → SecondContext)
    (jointBehavior : Occurrence → Behavior) :
    (∃ code : Occurrence → Behavior,
      CommonContextPredictiveCode evidence firstContext secondContext
        jointBehavior code) ↔
      EvidenceGeneratedIdentitySafe
        (EvidenceOrContextEdge evidence firstContext secondContext)
        jointBehavior := by
  constructor
  · rintro ⟨code, certificate⟩
    apply (evidenceGeneratedIdentitySafe_iff_edgesPreservePrediction
      (EvidenceOrContextEdge evidence firstContext secondContext)
      jointBehavior).2
    intro left right edge
    apply certificate.joint_sufficient
    rcases edge with evidenceEdge | firstEqual | secondEqual
    · exact certificate.evidence_preserving evidenceEdge
    · exact ((usedContextTransport_iff_kernelRefinement
        firstContext code).1 certificate.first_transport) firstEqual
    · exact ((usedContextTransport_iff_kernelRefinement
        secondContext code).1 certificate.second_transport) secondEqual
  · intro safe
    have edgeSafe :=
      (evidenceGeneratedIdentitySafe_iff_edgesPreservePrediction
        (EvidenceOrContextEdge evidence firstContext secondContext)
        jointBehavior).1 safe
    refine ⟨jointBehavior, ?_⟩
    constructor
    · intro left right evidenceEdge
      exact edgeSafe (Or.inl evidenceEdge)
    · apply (usedContextTransport_iff_kernelRefinement
        firstContext jointBehavior).2
      intro left right firstEqual
      exact edgeSafe (Or.inr (Or.inl firstEqual))
    · apply (usedContextTransport_iff_kernelRefinement
        secondContext jointBehavior).2
      intro left right secondEqual
      exact edgeSafe (Or.inr (Or.inr secondEqual))
    · intro left right sameBehavior
      exact sameBehavior

/-- Prediction and exact path-law values are one explicitly typed joint target. -/
def JointPredictiveLawSignature
    {Occurrence : Type uOccurrence}
    {Prediction : Type uFirst}
    {PathLaw : Type uSecond}
    (prediction : Occurrence → Prediction)
    (pathLaw : Occurrence → PathLaw) : Occurrence → Prediction × PathLaw :=
  fun occurrence => (prediction occurrence, pathLaw occurrence)

/-- A joint prediction/law specialization of the exact A4 boundary. -/
theorem commonContextJointCode_exists_iff_generatedJointSafe
    {Occurrence : Type uOccurrence}
    {FirstContext : Type uFirst}
    {SecondContext : Type uSecond}
    {Prediction : Type uBehavior}
    {PathLaw : Type uCode}
    (evidence : BinaryRelation Occurrence)
    (firstContext : Occurrence → FirstContext)
    (secondContext : Occurrence → SecondContext)
    (prediction : Occurrence → Prediction)
    (pathLaw : Occurrence → PathLaw) :
    (∃ code : Occurrence → Prediction × PathLaw,
      CommonContextPredictiveCode evidence firstContext secondContext
        (JointPredictiveLawSignature prediction pathLaw) code) ↔
      EvidenceGeneratedIdentitySafe
        (EvidenceOrContextEdge evidence firstContext secondContext)
        (JointPredictiveLawSignature prediction pathLaw) := by
  exact commonContextPredictiveCode_exists_iff_generatedSafe
    evidence firstContext secondContext
      (JointPredictiveLawSignature prediction pathLaw)

def emptyContinuationEvidence
    {Occurrence : Type uOccurrence} : BinaryRelation Occurrence :=
  fun _ _ => False

/-- Joint behavior distinguished inside the north row of the crossing fixture. -/
def crossingDiagonalSignature : CrossingOccurrence → Bool
  | .northWest | .southEast => true
  | .northEast | .southWest => false

/--
The crossing fixture has no functional common coarsening sufficient for the
diagonal joint law.  The obstruction is an exact context-kernel collision.
-/
theorem crossing_context_joint_signature_no_functional_code :
    ¬ ∃ code : CrossingOccurrence → Bool,
      CommonContextPredictiveCode emptyContinuationEvidence
        rowAssembly columnAssembly crossingDiagonalSignature code := by
  rw [commonContextPredictiveCode_exists_iff_generatedSafe]
  intro safe
  have edgeSafe :=
    (evidenceGeneratedIdentitySafe_iff_edgesPreservePrediction
      (EvidenceOrContextEdge emptyContinuationEvidence
        rowAssembly columnAssembly) crossingDiagonalSignature).1 safe
  have impossible := edgeSafe
    (first := CrossingOccurrence.northWest)
    (second := CrossingOccurrence.northEast)
    (Or.inr (Or.inl rfl))
  simp [crossingDiagonalSignature] at impossible

/-! ## A4 negative fixtures: each operational assumption has content -/

theorem omitting_column_context_allows_row_code :
    ∃ code : CrossingOccurrence → Bool,
      ContinuationPreserving emptyContinuationEvidence code ∧
      Nonempty (UsedContextTransport rowAssembly code) ∧
      KernelIncluded code rowAssembly := by
  refine ⟨rowAssembly, ?_, ?_, ?_⟩
  · intro _ _ impossible
    exact False.elim impossible
  · exact (usedContextTransport_iff_kernelRefinement
      rowAssembly rowAssembly).2 (fun _ _ same => same)
  · intro _ _ same
    exact same

theorem omitting_row_context_allows_column_code :
    ∃ code : CrossingOccurrence → Bool,
      ContinuationPreserving emptyContinuationEvidence code ∧
      Nonempty (UsedContextTransport columnAssembly code) ∧
      KernelIncluded code columnAssembly := by
  refine ⟨columnAssembly, ?_, ?_, ?_⟩
  · intro _ _ impossible
    exact False.elim impossible
  · exact (usedContextTransport_iff_kernelRefinement
      columnAssembly columnAssembly).2 (fun _ _ same => same)
  · intro _ _ same
    exact same

theorem omitting_joint_sufficiency_allows_constant_common_code :
    ∃ code : CrossingOccurrence → Unit,
      ContinuationPreserving emptyContinuationEvidence code ∧
      Nonempty (UsedContextTransport rowAssembly code) ∧
      Nonempty (UsedContextTransport columnAssembly code) := by
  let code : CrossingOccurrence → Unit := fun _ => ()
  refine ⟨code, ?_, ?_, ?_⟩
  · intro _ _ impossible
    exact False.elim impossible
  · exact (usedContextTransport_iff_kernelRefinement
      rowAssembly code).2 (fun _ _ _ => rfl)
  · exact (usedContextTransport_iff_kernelRefinement
      columnAssembly code).2 (fun _ _ _ => rfl)

def totalBoolEvidence : BinaryRelation Bool := fun _ _ => True

theorem omitting_evidence_preservation_allows_exact_behavior_code :
    (∃ code : Bool → Bool,
      Nonempty (UsedContextTransport id code) ∧
      KernelIncluded code id) ∧
      ¬ ContinuationPreserving totalBoolEvidence id := by
  constructor
  · refine ⟨id, ?_, ?_⟩
    · exact (usedContextTransport_iff_kernelRefinement id id).2
        (fun _ _ same => same)
    · intro _ _ same
      exact same
  · intro preserves
    exact Bool.false_ne_true (preserves trivial)

/-- The path-law coordinate, not the constant prediction, causes the no-go. -/
theorem omitting_path_law_coordinate_allows_common_code :
    (∃ code : CrossingOccurrence → Unit,
      CommonContextPredictiveCode emptyContinuationEvidence
        rowAssembly columnAssembly (fun _ => ()) code) ∧
      ¬ ∃ code : CrossingOccurrence → Unit × Bool,
        CommonContextPredictiveCode emptyContinuationEvidence
          rowAssembly columnAssembly
          (JointPredictiveLawSignature (fun _ => ()) crossingDiagonalSignature)
          code := by
  constructor
  · refine ⟨fun _ => (), ?_⟩
    constructor
    · intro _ _ impossible
      exact False.elim impossible
    · exact (usedContextTransport_iff_kernelRefinement
        rowAssembly (fun _ => ())).2 (fun _ _ _ => rfl)
    · exact (usedContextTransport_iff_kernelRefinement
        columnAssembly (fun _ => ())).2 (fun _ _ _ => rfl)
    · intro _ _ _
      rfl
  · rw [commonContextPredictiveCode_exists_iff_generatedSafe]
    intro safe
    have edgeSafe :=
      (evidenceGeneratedIdentitySafe_iff_edgesPreservePrediction
        (EvidenceOrContextEdge emptyContinuationEvidence
          rowAssembly columnAssembly)
        (JointPredictiveLawSignature (fun _ => ()) crossingDiagonalSignature)).1 safe
    have impossible := edgeSafe
      (first := CrossingOccurrence.northWest)
      (second := CrossingOccurrence.northEast)
      (Or.inr (Or.inl rfl))
    have lawImpossible := congrArg Prod.snd impossible
    simp [JointPredictiveLawSignature, crossingDiagonalSignature] at lawImpossible

/-! ## A5: local restrictions and exact joint-law stitching -/

/-- Exact reconstruction of a target from only the used local signature. -/
def ExactLocalTargetStitcher
    {Law : Type uLaw}
    {Local : Type uLocal}
    {Target : Type uJoint}
    (localSignature : Law → Local)
    (target : Law → Target) : Prop :=
  ∃ stitch : EncoderUsedRange localSignature → Target,
    ∀ law, stitch ⟨localSignature law, law, rfl⟩ = target law

/-- Exact local-data stitching is precisely the existing kernel boundary. -/
theorem exactLocalTargetStitcher_iff_kernelInclusion
    {Law : Type uLaw}
    {Local : Type uLocal}
    {Target : Type uJoint}
    (localSignature : Law → Local)
    (target : Law → Target) :
    ExactLocalTargetStitcher localSignature target ↔
      KernelIncluded localSignature target := by
  exact factorization_on_usedRange_iff_kernelInclusion
    localSignature target |>.symm

/-- Reconstructing the law token itself is possible exactly for injective restrictions. -/
theorem exactLocalLawStitcher_iff_injective
    {Law : Type uLaw}
    {Local : Type uLocal}
    (localSignature : Law → Local) :
    ExactLocalTargetStitcher localSignature id ↔
      Function.Injective localSignature := by
  rw [exactLocalTargetStitcher_iff_kernelInclusion]
  constructor
  · intro included left right sameLocal
    exact included sameLocal
  · intro injective left right sameLocal
    exact injective sameLocal

inductive CouplingLaw
  | correlated
  | anticorrelated
  deriving DecidableEq, Repr

/-- Two normalized rational joint laws with opposite correlation. -/
def couplingMass : CouplingLaw → Bool → Bool → ℚ
  | .correlated, false, false => 1 / 2
  | .correlated, true, true => 1 / 2
  | .correlated, _, _ => 0
  | .anticorrelated, false, true => 1 / 2
  | .anticorrelated, true, false => 1 / 2
  | .anticorrelated, _, _ => 0

theorem couplingMass_nonnegative
    (law : CouplingLaw)
    (first second : Bool) :
    0 ≤ couplingMass law first second := by
  cases law <;> cases first <;> cases second <;> norm_num [couplingMass]

theorem couplingMass_normalized (law : CouplingLaw) :
    couplingMass law false false + couplingMass law false true +
      couplingMass law true false + couplingMass law true true = 1 := by
  cases law <;> norm_num [couplingMass]

abbrev LocalMarginalSignature := ℚ × ℚ × ℚ × ℚ

/-- Marginal weights for first=false/true and second=false/true. -/
def localMarginalSignature (law : CouplingLaw) : LocalMarginalSignature :=
  (couplingMass law false false + couplingMass law false true,
    couplingMass law true false + couplingMass law true true,
    couplingMass law false false + couplingMass law true false,
    couplingMass law false true + couplingMass law true true)

theorem coupling_laws_have_identical_local_marginals :
    localMarginalSignature .correlated =
      localMarginalSignature .anticorrelated := by
  norm_num [localMarginalSignature, couplingMass]

theorem coupling_laws_have_different_joint_mass :
    couplingMass .correlated ≠ couplingMass .anticorrelated := by
  intro equalLaw
  have equalAtFalseFalse := congrFun (congrFun equalLaw false) false
  norm_num [couplingMass] at equalAtFalseFalse

/-- Local marginals cannot exactly stitch the admitted joint mass. -/
theorem identical_marginals_no_exact_joint_law_stitcher :
    ¬ ExactLocalTargetStitcher localMarginalSignature couplingMass := by
  rw [exactLocalTargetStitcher_iff_kernelInclusion]
  intro included
  exact coupling_laws_have_different_joint_mass
    (included coupling_laws_have_identical_local_marginals)

/-- An independently testable joint event, absent from either marginal alone. -/
def equalityEventWeight (law : CouplingLaw) : ℚ :=
  couplingMass law false false + couplingMass law true true

def augmentedLocalSignature
    (law : CouplingLaw) : LocalMarginalSignature × ℚ :=
  (localMarginalSignature law, equalityEventWeight law)

theorem augmentedLocalSignature_injective :
    Function.Injective augmentedLocalSignature := by
  intro left right
  cases left <;> cases right <;>
    norm_num [augmentedLocalSignature, equalityEventWeight,
      localMarginalSignature, couplingMass]

/-- Adding one independently observable joint-event coordinate restores exact stitching. -/
theorem joint_event_coordinate_restores_exact_joint_law_stitching :
    ExactLocalTargetStitcher augmentedLocalSignature couplingMass := by
  rw [exactLocalTargetStitcher_iff_kernelInclusion]
  intro left right sameSignature
  exact congrArg couplingMass (augmentedLocalSignature_injective sameSignature)

end OCMaturityCompletionCycle
