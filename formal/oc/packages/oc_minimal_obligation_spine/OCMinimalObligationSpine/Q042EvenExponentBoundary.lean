import OCMinimalObligationSpine.Q042ExponentQuotientTerminalGate

namespace OCMinimalObligationSpine

universe u

/-!
Q042 even-exponent boundary.

The odd branch of the exact all-elements power quotient is already closed for
groups generated by involutions.  This file records the complementary generic
facts needed to reason honestly about the even branch:

* a nontrivial exponent-two image survives every even all-power quotient;
* normal generation by one involution makes the exponent-two quotient have
  exactly the two classes represented by `1` and that involution;
* if `a ∣ b`, the exponent-`b` quotient surjects onto the exponent-`a`
  quotient, so infinitude at one exponent propagates to every multiple.

The concrete `Out(Fₙ)` premises remain source-bound: Bridson--Vogtmann supply
normal generation by one involution for `n ≥ 3`, while the determinant map
supplies the nontrivial exponent-two image.  No theorem below asserts
infinitude at an even exponent without an actual infinite quotient witness.
-/

/--
A finite-word form of normal generation by one involution.

Every element is a finite product of conjugates of the distinguished
involution.  Inverses of these conjugates need not be listed separately,
because an inverse of a conjugate of an involution is the same conjugate.
-/
structure NormallyGeneratedByOneInvolution
    (G : Type u) [Group G] where
  generator : G
  generator_square : generator ^ 2 = 1
  conjugate_word :
    ∀ g : G, ∃ conjugators : List G,
      (conjugators.map
        (fun u : G => u * generator * u⁻¹)).prod = g

/-- A homomorphism into a commutative target kills conjugation. -/
theorem monoidHom_conjugate_eq_of_commutative
    {G H : Type _} [Group G] [Group H]
    (f : G →* H)
    (h_commutative : ∀ x y : H, x * y = y * x)
    (u s : G) :
    f (u * s * u⁻¹) = f s := by
  rw [map_mul, map_mul, map_inv]
  calc
    f u * f s * (f u)⁻¹ =
        f s * f u * (f u)⁻¹ := by
          rw [h_commutative (f u) (f s)]
    _ = f s := by simp

/--
In a commutative exponent-two image, a group normally generated by one
involution has at most two image elements.
-/
theorem normallyGeneratedByOneInvolution_image_eq_one_or_generator
    {G H : Type u} [Group G] [Group H]
    (D : NormallyGeneratedByOneInvolution G)
    (f : G →* H)
    (h_commutative : ∀ x y : H, x * y = y * x)
    (h_exponent_two : ∀ x : H, x ^ 2 = 1) :
    ∀ g : G, f g = 1 ∨ f g = f D.generator := by
  intro g
  rcases D.conjugate_word g with ⟨conjugators, h_word⟩
  have h_words :
      ∀ words : List G,
        f ((words.map
          (fun u : G => u * D.generator * u⁻¹)).prod) = 1 ∨
        f ((words.map
          (fun u : G => u * D.generator * u⁻¹)).prod) =
          f D.generator := by
    intro words
    induction words with
    | nil =>
        simp
    | cons u tail ih =>
        have h_conjugate :
            f (u * D.generator * u⁻¹) = f D.generator :=
          monoidHom_conjugate_eq_of_commutative
            f h_commutative u D.generator
        rcases ih with h_tail_one | h_tail_generator
        · right
          simp [h_conjugate, h_tail_one]
        · left
          have h_generator_mul :
              f D.generator * f D.generator = 1 := by
            simpa [pow_two] using h_exponent_two (f D.generator)
          simpa [h_conjugate, h_tail_generator] using h_generator_mul
  have h_image := h_words conjugators
  simpa [h_word] using h_image

/-- The exact exponent-two quotient is commutative. -/
theorem allPowerQuotient_two_commutative
    {G : Type u} [Group G] :
    ∀ x y : G ⧸ allPowerNormalClosure G 2, x * y = y * x := by
  exact commutative_of_exponent_two
    (allPowerQuotient_exponent (G := G) (p := 2))

/--
The exact exponent-two quotient of a group normally generated by one
involution has no classes other than `1` and the class of that involution.
-/
theorem allPowerQuotient_two_eq_one_or_generator
    {G : Type u} [Group G]
    (D : NormallyGeneratedByOneInvolution G) :
    ∀ q : G ⧸ allPowerNormalClosure G 2,
      q = 1 ∨
        q =
          QuotientGroup.mk' (allPowerNormalClosure G 2) D.generator := by
  let quotientMap : G →* G ⧸ allPowerNormalClosure G 2 :=
    QuotientGroup.mk' (allPowerNormalClosure G 2)
  have h_source_image :
      ∀ g : G,
        quotientMap g = 1 ∨
          quotientMap g = quotientMap D.generator :=
    normallyGeneratedByOneInvolution_image_eq_one_or_generator
      D quotientMap allPowerQuotient_two_commutative
      (allPowerQuotient_exponent (G := G) (p := 2))
  intro q
  rcases QuotientGroup.mk'_surjective
    (allPowerNormalClosure G 2) q with ⟨g, rfl⟩
  exact h_source_image g

/-- Consequently the exact exponent-two quotient is finite. -/
theorem allPowerQuotient_two_finite_of_normallyGeneratedByOneInvolution
    {G : Type u} [Group G]
    (D : NormallyGeneratedByOneInvolution G) :
    Set.Finite
      (Set.univ : Set (G ⧸ allPowerNormalClosure G 2)) := by
  let qGenerator :
      G ⧸ allPowerNormalClosure G 2 :=
    QuotientGroup.mk' (allPowerNormalClosure G 2) D.generator
  refine ((Set.finite_singleton qGenerator).insert
    (1 : G ⧸ allPowerNormalClosure G 2)).subset ?_
  intro q _
  rcases allPowerQuotient_two_eq_one_or_generator D q with hq | hq
  · exact Set.mem_insert_iff.mpr (Or.inl hq)
  · exact Set.mem_insert_iff.mpr
      (Or.inr (Set.mem_singleton_iff.mpr hq))

/--
Any homomorphism killing all source `p`-powers but preserving one element
forces the canonical all-power quotient to be nontrivial.
-/
theorem allPowerQuotient_has_nontrivial_element_of_power_killing_map
    {G H : Type u} [Group G] [Group H]
    (f : G →* H) {p : ℕ}
    (h_kills_powers : ∀ g : G, f (g ^ p) = 1)
    {g : G} (h_survives : f g ≠ 1) :
    ∃ q : G ⧸ allPowerNormalClosure G p, q ≠ 1 := by
  let L : G ⧸ allPowerNormalClosure G p →* H :=
    allPowerQuotientLift f h_kills_powers
  let q : G ⧸ allPowerNormalClosure G p :=
    QuotientGroup.mk' (allPowerNormalClosure G p) g
  refine ⟨q, ?_⟩
  intro hq
  apply h_survives
  have h_factor :=
    DFunLike.congr_fun
      (allPowerQuotientLift_comp_mk' f h_kills_powers) g
  calc
    f g = L q := h_factor.symm
    _ = L 1 := by rw [hq]
    _ = 1 := map_one L

/-- An exponent-two image kills every even source power. -/
theorem exponentTwoImage_kills_even_powers
    {G H : Type u} [Group G] [Group H]
    (f : G →* H) {p : ℕ}
    (h_exponent_two : ∀ h : H, h ^ 2 = 1)
    (h_even : ∃ k : ℕ, p = 2 * k) :
    ∀ g : G, f (g ^ p) = 1 := by
  intro g
  rcases h_even with ⟨k, rfl⟩
  rw [map_pow, pow_mul, h_exponent_two, one_pow]

/--
A nontrivial exponent-two image survives in every even exact all-power
quotient.
-/
theorem allPowerQuotient_even_nontrivial_of_exponentTwoImage
    {G H : Type u} [Group G] [Group H]
    (f : G →* H) {p : ℕ}
    (h_exponent_two : ∀ h : H, h ^ 2 = 1)
    (h_even : ∃ k : ℕ, p = 2 * k)
    {g : G} (h_survives : f g ≠ 1) :
    ∃ q : G ⧸ allPowerNormalClosure G p, q ≠ 1 := by
  exact allPowerQuotient_has_nontrivial_element_of_power_killing_map
    f (exponentTwoImage_kills_even_powers f h_exponent_two h_even)
    h_survives

/--
Under normal generation by one involution and a nontrivial exponent-two
image, the exact exponent-two quotient consists of exactly two distinct
classes.
-/
theorem allPowerQuotient_two_exactly_two_classes
    {G H : Type u} [Group G] [Group H]
    (D : NormallyGeneratedByOneInvolution G)
    (f : G →* H)
    (h_exponent_two : ∀ h : H, h ^ 2 = 1)
    {g : G} (h_nontrivial_image : f g ≠ 1) :
    let qGenerator :
        G ⧸ allPowerNormalClosure G 2 :=
      QuotientGroup.mk' (allPowerNormalClosure G 2) D.generator
    (Set.univ =
        ({1, qGenerator} :
          Set (G ⧸ allPowerNormalClosure G 2))) ∧
      qGenerator ≠ 1 := by
  let quotientMap : G →* G ⧸ allPowerNormalClosure G 2 :=
    QuotientGroup.mk' (allPowerNormalClosure G 2)
  let qGenerator :
      G ⧸ allPowerNormalClosure G 2 :=
    quotientMap D.generator
  have h_target_commutative :
      ∀ x y : H, x * y = y * x :=
    commutative_of_exponent_two h_exponent_two
  have h_generator_survives_in_image :
      f D.generator ≠ 1 := by
    intro h_generator_one
    rcases
      normallyGeneratedByOneInvolution_image_eq_one_or_generator
        D f h_target_commutative h_exponent_two g with
      h_g_one | h_g_generator
    · exact h_nontrivial_image h_g_one
    · exact h_nontrivial_image (h_g_generator.trans h_generator_one)
  have h_kills_squares :
      ∀ x : G, f (x ^ 2) = 1 :=
    exponentTwoImage_kills_even_powers f h_exponent_two ⟨1, rfl⟩
  have h_q_generator_ne_one : qGenerator ≠ 1 := by
    intro hq
    apply h_generator_survives_in_image
    let L : G ⧸ allPowerNormalClosure G 2 →* H :=
      allPowerQuotientLift f h_kills_squares
    have h_factor :=
      DFunLike.congr_fun
        (allPowerQuotientLift_comp_mk' f h_kills_squares)
        D.generator
    calc
      f D.generator = L qGenerator := h_factor.symm
      _ = L 1 := by rw [hq]
      _ = 1 := map_one L
  refine ⟨?_, h_q_generator_ne_one⟩
  ext q
  constructor
  · intro _
    rcases allPowerQuotient_two_eq_one_or_generator D q with hq | hq
    · exact Set.mem_insert_iff.mpr (Or.inl hq)
    · exact Set.mem_insert_iff.mpr
        (Or.inr (Set.mem_singleton_iff.mpr hq))
  · intro _
    trivial

/--
Divisibility reverses the defining normal-closure inclusion:
if `a ∣ b`, every `b`-th power is already an `a`-th power.
-/
theorem allPowerNormalClosure_le_of_dvd
    {G : Type u} [Group G] {a b : ℕ}
    (h_dvd : a ∣ b) :
    allPowerNormalClosure G b ≤ allPowerNormalClosure G a := by
  unfold allPowerNormalClosure
  refine Subgroup.normalClosure_mono ?_
  intro x hx
  rcases hx with ⟨g, rfl⟩
  rcases h_dvd with ⟨k, rfl⟩
  refine ⟨g ^ k, ?_⟩
  calc
    (g ^ k) ^ a = g ^ (k * a) :=
      (pow_mul g k a).symm
    _ = g ^ (a * k) := by
      rw [Nat.mul_comm k a]

/-- The canonical quotient map induced by an exponent divisibility relation. -/
def allPowerQuotientMapOfDvd
    {G : Type u} [Group G] {a b : ℕ}
    (h_dvd : a ∣ b) :
    G ⧸ allPowerNormalClosure G b →*
      G ⧸ allPowerNormalClosure G a :=
  QuotientGroup.map
    (allPowerNormalClosure G b)
    (allPowerNormalClosure G a)
    (MonoidHom.id G)
    (by
      intro x hx
      simpa using allPowerNormalClosure_le_of_dvd
        (G := G) h_dvd hx)

/-- The exponent-divisibility quotient map is surjective. -/
theorem allPowerQuotientMapOfDvd_surjective
    {G : Type u} [Group G] {a b : ℕ}
    (h_dvd : a ∣ b) :
    Function.Surjective
      (allPowerQuotientMapOfDvd (G := G) h_dvd) := by
  intro q
  rcases QuotientGroup.mk'_surjective
    (allPowerNormalClosure G a) q with ⟨g, rfl⟩
  refine ⟨QuotientGroup.mk'
    (allPowerNormalClosure G b) g, ?_⟩
  rw [allPowerQuotientMapOfDvd]
  rw [QuotientGroup.map_mk']
  rfl

/--
Infinitude at one exponent propagates to every multiple of that exponent.
-/
theorem allPowerQuotient_infinite_of_dvd_and_divisor_infinite
    {G : Type u} [Group G] {a b : ℕ}
    (h_dvd : a ∣ b)
    (h_divisor_infinite :
      ¬ Set.Finite
        (Set.univ : Set (G ⧸ allPowerNormalClosure G a))) :
    ¬ Set.Finite
      (Set.univ : Set (G ⧸ allPowerNormalClosure G b)) := by
  intro h_multiple_finite
  let F :=
    allPowerQuotientMapOfDvd (G := G) h_dvd
  have h_range_finite : Set.Finite (Set.range F) := by
    simpa [Set.image_univ] using
      h_multiple_finite.image
        (fun q : G ⧸ allPowerNormalClosure G b => F q)
  have h_range_univ : Set.range F = Set.univ := by
    ext q
    constructor
    · intro _
      trivial
    · intro _
      exact allPowerQuotientMapOfDvd_surjective
        (G := G) h_dvd q
  exact h_divisor_infinite (by
    simpa [h_range_univ] using h_range_finite)

/--
An infinite canonical quotient at a fixed exponent is immediately a genuine
Q042 exact-target witness at that exponent.
-/
def q042_exact_target_of_infinite_allPowerQuotient
    {G : Type u} [Group G] {p : ℕ}
    (h_infinite :
      ¬ Set.Finite
        (Set.univ : Set (G ⧸ allPowerNormalClosure G p))) :
    Q042ExponentTargetAt G p where
  H := G ⧸ allPowerNormalClosure G p
  instH := inferInstance
  witness := allPowerQuotient_infinite_gives_positive_witness h_infinite
  exact_exponent := rfl

/--
Hence one infinite quotient also yields exact Q042 targets at every multiple.
-/
def q042_exact_target_at_multiple_of_infinite_divisor
    {G : Type u} [Group G] {a b : ℕ}
    (h_dvd : a ∣ b)
    (h_divisor_infinite :
      ¬ Set.Finite
        (Set.univ : Set (G ⧸ allPowerNormalClosure G a))) :
    Q042ExponentTargetAt G b :=
  q042_exact_target_of_infinite_allPowerQuotient
    (allPowerQuotient_infinite_of_dvd_and_divisor_infinite
      h_dvd h_divisor_infinite)

end OCMinimalObligationSpine
