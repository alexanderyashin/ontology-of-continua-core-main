/-!
Q014_Q040 scope-transfer gate.

This is a deliberately generic formal contract for source-bound theorem
integration.  A theorem proved on a strict source slice can be used as a
denominator for a larger target, but it promotes to the full target only after
the release graph supplies a coverage/reduction payload.

For the AIM convex-hypersurface question, the source slice is the Riemannian
ambient theorem of Alexander--Kapovitch--Petrunin; the larger target is the
Alexandrov-ambient problem.  The Lean object below makes the missing bridge a
typed obligation rather than a status word.
-/

/--
A scoped theorem plus the exact coverage obligation required to promote it to
the whole domain.

`sourceSlice` is the class where the current theorem is already proved.
`target` is the property required by the full research question.  The field
`coverage_suffices` records the admissible bridge: if the release graph can
prove `coverage`, every target-domain object is routed into the proved slice.
-/
structure ScopeTransferGate (Domain : Type u) where
  sourceSlice : Set Domain
  target : Domain → Prop
  source_proof : ∀ x : Domain, x ∈ sourceSlice → target x
  coverage : Prop
  coverage_suffices : coverage → ∀ x : Domain, x ∈ sourceSlice

/--
Once the coverage/reduction payload is supplied, a scoped theorem becomes a
full-domain theorem.
-/
theorem scopeTransferGate_promotes_to_full_domain
    {Domain : Type u}
    (D : ScopeTransferGate Domain)
    (h_coverage : D.coverage) :
    ∀ x : Domain, D.target x := by
  intro x
  exact D.source_proof x (D.coverage_suffices h_coverage x)

/--
If the current source slice has a witnessed residual object outside it, then
the source-slice theorem alone is not a full-domain coverage proof.

This does not weaken the target claim; it isolates the exact missing research
payload that must be proved before the full target may be counted as solved.
-/
theorem scopeTransferGate_residual_witness_blocks_slice_only_coverage
    {Domain : Type u}
    (D : ScopeTransferGate Domain)
    (h_residual : ∃ x : Domain, x ∉ D.sourceSlice) :
    ¬ (∀ x : Domain, x ∈ D.sourceSlice) := by
  intro h_all_in_slice
  rcases h_residual with ⟨x, hx_not_in_slice⟩
  exact hx_not_in_slice (h_all_in_slice x)

/--
Any admitted coverage payload eliminates the residual-domain predicate.
-/
theorem scopeTransferGate_coverage_eliminates_residual
    {Domain : Type u}
    (D : ScopeTransferGate Domain)
    (h_coverage : D.coverage) :
    ¬ (∃ x : Domain, x ∉ D.sourceSlice) := by
  intro h_residual
  exact scopeTransferGate_residual_witness_blocks_slice_only_coverage D
    h_residual (D.coverage_suffices h_coverage)

end OCMinimalObligationSpine
