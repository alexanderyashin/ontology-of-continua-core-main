import Mathlib.Algebra.Group.Basic
import Mathlib.Data.Fintype.Basic
import Mathlib.Data.Set.Card
import Mathlib.GroupTheory.QuotientGroup.Basic
import Mathlib.GroupTheory.OrderOfElement

namespace OCMinimalObligationSpine

universe u

/-!
Q042_Q009 support lemma.

This is the formal kernel behind the odd-exponent obstruction for the
all-elements power quotient lane:

If a group quotient has exponent `p` and `p` is odd, then the image of every
involution is trivial.  Combined with a source-bound theorem that `Aut(Fₙ)` is
generated by involutions, this proves that the all-`p`-power quotient of
`Out(Fₙ)` cannot be infinite for odd `p`.

The external generation theorem itself is not reproved here; it remains a
source premise cited in the theorem package.
-/

theorem involution_eq_one_of_odd_exponent
    {G : Type _} [Group G] {g : G} {p : ℕ}
    (h_involution : g ^ 2 = 1)
    (h_exponent : g ^ p = 1)
    (h_odd : ∃ k : ℕ, p = 2 * k + 1) :
    g = 1 := by
  rcases h_odd with ⟨k, hk⟩
  have h_even_pow : g ^ (2 * k) = 1 := by
    rw [pow_mul, h_involution, one_pow]
  have h_odd_pow : g ^ (2 * k + 1) = g := by
    rw [pow_succ, h_even_pow, one_mul]
  calc
    g = g ^ (2 * k + 1) := h_odd_pow.symm
    _ = g ^ p := by rw [hk]
    _ = 1 := h_exponent

/--
An explicit finite-word formulation of "generated by involutions".

This avoids hiding the generation premise behind an imported source theorem:
every source element must come with a finite product decomposition, and every
factor in that decomposition must square to one.
-/
def GeneratedByInvolutions (G : Type _) [Group G] : Prop :=
  ∀ g : G, ∃ factors : List G,
    (∀ x : G, x ∈ factors → x ^ 2 = 1) ∧ factors.prod = g

/--
Generation by involutions descends through every surjective group
homomorphism.  This is the formal `Aut(Fₙ) → Out(Fₙ)` bridge needed by Q042:
the images of an involution word are again involutions (or the identity), and
surjectivity supplies a source word for every quotient element.
-/
theorem generatedByInvolutions_of_surjective_monoidHom
    {G H : Type _} [Group G] [Group H]
    (f : G →* H)
    (h_surjective : Function.Surjective f)
    (h_generated : GeneratedByInvolutions G) :
    GeneratedByInvolutions H := by
  have h_map_prod :
      ∀ factors : List G, (factors.map f).prod = f factors.prod := by
    intro factors
    induction factors with
    | nil => simp
    | cons head tail ih => simp [ih]
  intro h
  rcases h_surjective h with ⟨g, rfl⟩
  rcases h_generated g with ⟨factors, h_factors, h_product⟩
  refine ⟨factors.map f, ?_, ?_⟩
  · intro y hy
    rcases List.mem_map.mp hy with ⟨x, hx, rfl⟩
    simpa using congrArg f (h_factors x hx)
  · calc
      (factors.map f).prod = f factors.prod := h_map_prod factors
      _ = f g := by rw [h_product]

/--
Every homomorphism from a group generated by involutions into a group of odd
exponent is pointwise trivial.

The theorem is completely internal.  Applying it to `Aut(Fₙ)` or `Out(Fₙ)`
still requires a separately verified source theorem proving the corresponding
`GeneratedByInvolutions` premise.
-/
theorem monoidHom_eq_one_of_generatedByInvolutions_odd_exponent
    {G H : Type _} [Group G] [Group H]
    (f : G →* H) {p : ℕ}
    (h_generated : GeneratedByInvolutions G)
    (h_exponent : ∀ h : H, h ^ p = 1)
    (h_odd : ∃ k : ℕ, p = 2 * k + 1) :
    ∀ g : G, f g = 1 := by
  have mapped_involution_word_eq_one :
      ∀ factors : List G,
        (∀ x : G, x ∈ factors → x ^ 2 = 1) →
          f factors.prod = 1 := by
    intro factors h_factors
    induction factors with
    | nil =>
        simp
    | cons head tail ih =>
        have h_head_involution : head ^ 2 = 1 :=
          h_factors head (by simp)
        have h_head_image_involution : (f head) ^ 2 = 1 := by
          simpa using congrArg f h_head_involution
        have h_head_image_one : f head = 1 :=
          involution_eq_one_of_odd_exponent
            h_head_image_involution (h_exponent (f head)) h_odd
        have h_tail_image_one : f tail.prod = 1 := by
          apply ih
          intro x hx
          exact h_factors x (by simp [hx])
        simp [h_head_image_one, h_tail_image_one]
  intro g
  rcases h_generated g with ⟨factors, h_factors, h_product⟩
  rw [← h_product]
  exact mapped_involution_word_eq_one factors h_factors

/-- The image of such a homomorphism is the finite singleton `{1}`. -/
theorem monoidHom_range_finite_of_generatedByInvolutions_odd_exponent
    {G H : Type _} [Group G] [Group H]
    (f : G →* H) {p : ℕ}
    (h_generated : GeneratedByInvolutions G)
    (h_exponent : ∀ h : H, h ^ p = 1)
    (h_odd : ∃ k : ℕ, p = 2 * k + 1) :
    Set.Finite (Set.range f) := by
  refine (Set.finite_singleton (1 : H)).subset ?_
  intro y hy
  rcases hy with ⟨g, rfl⟩
  exact Set.mem_singleton_iff.mpr
    (monoidHom_eq_one_of_generatedByInvolutions_odd_exponent
      f h_generated h_exponent h_odd g)

theorem commutative_of_exponent_two
    {G : Type _} [Group G]
    (h_exponent_two : ∀ x : G, x ^ 2 = 1) :
    ∀ x y : G, x * y = y * x := by
  intro x y
  have hx : x * x = 1 := by
    simpa [pow_two] using h_exponent_two x
  have hy : y * y = 1 := by
    simpa [pow_two] using h_exponent_two y
  have hxy : (x * y) * (x * y) = 1 := by
    simpa [pow_two] using h_exponent_two (x * y)
  have hx_inv : x⁻¹ = x := inv_eq_of_mul_eq_one_right hx
  have hy_inv : y⁻¹ = y := inv_eq_of_mul_eq_one_right hy
  have hxy_inv : (x * y)⁻¹ = x * y := inv_eq_of_mul_eq_one_right hxy
  calc
    x * y = (x * y)⁻¹ := hxy_inv.symm
    _ = y⁻¹ * x⁻¹ := mul_inv_rev x y
    _ = y * x := by rw [hy_inv, hx_inv]

/--
If a positive natural number is written as a product `m*a`, then the right
factor `a` is positive.

This tiny arithmetic denominator is used by witness-intake contracts to avoid
manual positivity side-conditions downstream.
-/
theorem right_factor_pos_of_positive_product_eq
    {target m a : ℕ}
    (h_target_pos : 0 < target)
    (h_eq : target = m * a) :
    0 < a := by
  by_contra h_not_pos
  have h_a_zero : a = 0 := Nat.eq_zero_of_not_pos h_not_pos
  have h_target_zero : target = 0 := by
    simpa [h_a_zero] using h_eq
  exact (Nat.ne_of_gt h_target_pos) h_target_zero

theorem order_three_eq_one_of_exponent_mod_three_one
    {G : Type _} [Group G] {g : G} {p : ℕ}
    (h_order_three : g ^ 3 = 1)
    (h_exponent : g ^ p = 1)
    (h_mod : ∃ k : ℕ, p = 3 * k + 1) :
    g = 1 := by
  rcases h_mod with ⟨k, hk⟩
  have h_three_mul : g ^ (3 * k) = 1 := by
    rw [pow_mul, h_order_three, one_pow]
  have h_target : g ^ (3 * k + 1) = g := by
    rw [pow_succ, h_three_mul, one_mul]
  calc
    g = g ^ (3 * k + 1) := h_target.symm
    _ = g ^ p := by rw [hk]
    _ = 1 := h_exponent

theorem order_three_eq_one_of_exponent_mod_three_two
    {G : Type _} [Group G] {g : G} {p : ℕ}
    (h_order_three : g ^ 3 = 1)
    (h_exponent : g ^ p = 1)
    (h_mod : ∃ k : ℕ, p = (3 * k + 1) + 1) :
    g = 1 := by
  rcases h_mod with ⟨k, hk⟩
  have h_three_mul : g ^ (3 * k) = 1 := by
    rw [pow_mul, h_order_three, one_pow]
  have h_prev : g ^ (3 * k + 1) = g := by
    rw [pow_succ, h_three_mul, one_mul]
  have h_target : g ^ ((3 * k + 1) + 1) = g ^ 2 := by
    rw [pow_succ, h_prev]
    simp [pow_two]
  have h_square : g ^ 2 = 1 := by
    calc
      g ^ 2 = g ^ ((3 * k + 1) + 1) := h_target.symm
      _ = g ^ p := by rw [hk]
      _ = 1 := h_exponent
  have h_cube_as_g : g ^ 3 = g := by
    change g ^ (2 + 1) = g
    rw [pow_succ, h_square, one_mul]
  calc
    g = g ^ 3 := h_cube_as_g.symm
    _ = 1 := h_order_three

theorem eq_one_of_zpow_bezout
    {G : Type _} [Group G] {g : G} {q p : ℕ} {a b : ℤ}
    (hq : g ^ q = 1)
    (hp : g ^ p = 1)
    (hbez : a * (q : ℤ) + b * (p : ℤ) = 1) :
    g = 1 := by
  have hqz : g ^ (q : ℤ) = 1 := by
    simpa [zpow_natCast] using hq
  have hpz : g ^ (p : ℤ) = 1 := by
    simpa [zpow_natCast] using hp
  have haq : g ^ (a * (q : ℤ)) = 1 := by
    rw [Int.mul_comm a (q : ℤ), zpow_mul, hqz, one_zpow]
  have hbp : g ^ (b * (p : ℤ)) = 1 := by
    rw [Int.mul_comm b (p : ℤ), zpow_mul, hpz, one_zpow]
  have hsum : g ^ (a * (q : ℤ) + b * (p : ℤ)) = 1 := by
    rw [zpow_add, haq, hbp, one_mul]
  calc
    g = g ^ (1 : ℤ) := by rw [zpow_one]
    _ = g ^ (a * (q : ℤ) + b * (p : ℤ)) := by rw [hbez]
    _ = 1 := hsum

theorem finite_of_surjective_from_fintype_model
    {A B : Type _} [Fintype A] [DecidableEq B] (f : A → B)
    (hf : Function.Surjective f) :
    Set.Finite (Set.univ : Set B) := by
  let _ : Fintype B := Fintype.ofSurjective f hf
  exact Set.toFinite (Set.univ : Set B)

theorem pow_ne_one_of_orderOf_not_dvd
    {G : Type _} [Group G] {g : G} {m p : ℕ}
    (h_order : orderOf g = m)
    (h_not_dvd : ¬ m ∣ p) :
    g ^ p ≠ 1 := by
  intro hp
  have hdiv : orderOf g ∣ p := orderOf_dvd_iff_pow_eq_one.mpr hp
  exact h_not_dvd (by simpa [h_order] using hdiv)

theorem power_eq_offset_of_period_mul_add
    {G : Type _} [Group G] {g : G} {m k d p : ℕ}
    (h_period : g ^ m = 1)
    (h_decomp : p = m * k + d) :
    g ^ p = g ^ d := by
  have h_period_mul : g ^ (m * k) = 1 := by
    rw [pow_mul, h_period, one_pow]
  calc
    g ^ p = g ^ (m * k + d) := by rw [h_decomp]
    _ = g ^ (m * k) * g ^ d := by rw [pow_add]
    _ = g ^ d := by rw [h_period_mul, one_mul]

theorem order_four_power_eq_square_of_mod_four_two
    {G : Type _} [Group G] {g : G} {p : ℕ}
    (h_order_four_power : g ^ 4 = 1)
    (h_mod_four_two : ∃ k : ℕ, p = 4 * k + 2) :
    g ^ p = g ^ 2 := by
  rcases h_mod_four_two with ⟨k, hk⟩
  exact power_eq_offset_of_period_mul_add
    (g := g) (m := 4) (k := k) (d := 2) h_order_four_power hk

theorem order_eight_power_eq_fourth_of_mod_eight_four
    {G : Type _} [Group G] {g : G} {p : ℕ}
    (h_order_eight_power : g ^ 8 = 1)
    (h_mod_eight_four : ∃ k : ℕ, p = 8 * k + 4) :
    g ^ p = g ^ 4 := by
  rcases h_mod_eight_four with ⟨k, hk⟩
  exact power_eq_offset_of_period_mul_add
    (g := g) (m := 8) (k := k) (d := 4) h_order_eight_power hk

theorem monoid_hom_kills_powers_into_exponent_group
    {G H : Type _} [Group G] [Group H] (f : G →* H) {p : ℕ}
    (h_exponent : ∀ h : H, h ^ p = 1) :
    ∀ g : G, f (g ^ p) = 1 := by
  intro g
  rw [map_pow]
  exact h_exponent (f g)

theorem cyclic_power_range_finite_of_power_eq_one
    {G : Type _} [Group G] {h : G} {p : ℕ}
    (h_pos : 0 < p)
    (h_power : h ^ p = 1) :
    Set.Finite (Set.range fun n : ℕ => h ^ n) := by
  have h_subset :
      Set.range (fun n : ℕ => h ^ n) ⊆
        Set.range (fun i : Fin p => h ^ (i : ℕ)) := by
    intro y hy
    rcases hy with ⟨n, rfl⟩
    refine ⟨⟨n % p, Nat.mod_lt n h_pos⟩, ?_⟩
    have h_eq : h ^ n = h ^ (n % p) := by
      calc
        h ^ n = h ^ (p * (n / p) + n % p) := by
          rw [Nat.div_add_mod]
        _ = h ^ (p * (n / p)) * h ^ (n % p) := by
          rw [pow_add]
        _ = (h ^ p) ^ (n / p) * h ^ (n % p) := by
          rw [pow_mul]
        _ = h ^ (n % p) := by
          rw [h_power, one_pow, one_mul]
    exact h_eq.symm
  exact (Set.finite_range (fun i : Fin p => h ^ (i : ℕ))).subset h_subset

theorem exponent_group_has_no_infinite_order_power_orbit
    {G : Type _} [Group G] {h : G} {p : ℕ}
    (h_pos : 0 < p)
    (h_exponent : ∀ g : G, g ^ p = 1) :
    Set.Finite (Set.range fun n : ℕ => h ^ n) := by
  exact cyclic_power_range_finite_of_power_eq_one
    (h := h) h_pos (h_exponent h)

theorem infinite_power_orbit_blocks_exponent_target
    {G : Type _} [Group G] {h : G} {p : ℕ}
    (h_pos : 0 < p)
    (h_infinite_power_orbit : ¬ Set.Finite (Set.range fun n : ℕ => h ^ n)) :
    ¬ (∀ g : G, g ^ p = 1) := by
  intro h_exponent
  exact h_infinite_power_orbit
    (exponent_group_has_no_infinite_order_power_orbit
      (h := h) h_pos h_exponent)

theorem exponent_image_positive_witness_requirements
    {G H : Type _} [Group G] [Group H] (f : G →* H) {p : ℕ}
    (h_exponent : ∀ h : H, h ^ p = 1)
    (h_surjective : Function.Surjective f)
    (h_infinite : ¬ Set.Finite (Set.univ : Set H)) :
    (∀ g : G, f (g ^ p) = 1) ∧
      Function.Surjective f ∧
      ¬ Set.Finite (Set.univ : Set H) := by
  exact ⟨monoid_hom_kills_powers_into_exponent_group f h_exponent,
    h_surjective, h_infinite⟩

theorem finite_target_cannot_be_infinite_power_quotient_witness
    {G H : Type _} [Group G] [Group H] (f : G →* H) {p : ℕ}
    (h_finite : Set.Finite (Set.univ : Set H)) :
    ¬ ((∀ g : G, f (g ^ p) = 1) ∧
      Function.Surjective f ∧
      ¬ Set.Finite (Set.univ : Set H)) := by
  intro h_witness
  exact h_witness.2.2 h_finite

theorem finite_representation_factor_cannot_close_positive_power_quotient
    {G R H : Type _} [Group G] [Group R] [Group H]
    (rho : G →* R) (pi : R →* H) {p : ℕ}
    (h_finite : Set.Finite (Set.univ : Set H)) :
    ¬ ((∀ g : G, (pi.comp rho) (g ^ p) = 1) ∧
      Function.Surjective (pi.comp rho) ∧
      ¬ Set.Finite (Set.univ : Set H)) := by
  exact finite_target_cannot_be_infinite_power_quotient_witness
    (f := pi.comp rho) (p := p) h_finite

theorem exponent_image_with_infinite_range_positive_witness_requirements
    {G H : Type _} [Group G] [Group H] (f : G →* H) {p : ℕ}
    (h_exponent : ∀ h : H, h ^ p = 1)
    (h_infinite_range : ¬ Set.Finite (Set.range f)) :
    (∀ g : G, f (g ^ p) = 1) ∧
      ¬ Set.Finite (Set.range f) := by
  exact ⟨monoid_hom_kills_powers_into_exponent_group f h_exponent,
    h_infinite_range⟩

/--
The exact normal subgroup used by the all-elements exponent-`p` quotient:
the normal closure of `g^p` for every source element `g`.
-/
def allPowerNormalClosure (G : Type _) [Group G] (p : ℕ) : Subgroup G :=
  Subgroup.normalClosure ({x : G | ∃ g : G, g ^ p = x} : Set G)

instance allPowerNormalClosure_normal
    (G : Type _) [Group G] (p : ℕ) : (allPowerNormalClosure G p).Normal := by
  unfold allPowerNormalClosure
  infer_instance

/--
Any homomorphism that kills every source `p`-power kills the whole normal
closure generated by those powers.
-/
theorem allPowerNormalClosure_le_ker_of_kills_powers
    {G H : Type _} [Group G] [Group H] (f : G →* H) {p : ℕ}
    (h_kills_powers : ∀ g : G, f (g ^ p) = 1) :
    allPowerNormalClosure G p ≤ f.ker := by
  unfold allPowerNormalClosure
  refine Subgroup.normalClosure_le_normal ?_
  intro x hx
  rcases hx with ⟨g, rfl⟩
  exact MonoidHom.mem_ker.mpr (h_kills_powers g)

/--
Universal lift from the exact all-elements exponent-`p` quotient.

This is the formal version of the publication/research boundary: a route that
really kills all original `p`-powers must factor through the quotient by their
normal closure.
-/
def allPowerQuotientLift
    {G H : Type _} [Group G] [Group H] (f : G →* H) {p : ℕ}
    (h_kills_powers : ∀ g : G, f (g ^ p) = 1) :
    G ⧸ allPowerNormalClosure G p →* H :=
  QuotientGroup.lift (allPowerNormalClosure G p) f
    (allPowerNormalClosure_le_ker_of_kills_powers f h_kills_powers)

/--
The universal lift composes with the quotient projection to recover the
original homomorphism.
-/
theorem allPowerQuotientLift_comp_mk'
    {G H : Type _} [Group G] [Group H] (f : G →* H) {p : ℕ}
    (h_kills_powers : ∀ g : G, f (g ^ p) = 1) :
    (allPowerQuotientLift f h_kills_powers).comp
        (QuotientGroup.mk' (allPowerNormalClosure G p)) = f := by
  exact QuotientGroup.lift_comp_mk'
    (allPowerNormalClosure G p) f
    (allPowerNormalClosure_le_ker_of_kills_powers f h_kills_powers)

/--
The exact all-elements power quotient has exponent `p`: every element is a
quotient class of some `g`, and `(g^p)` lies in the defining normal closure.
-/
theorem allPowerQuotient_exponent
    {G : Type _} [Group G] {p : ℕ} :
    ∀ q : G ⧸ allPowerNormalClosure G p, q ^ p = 1 := by
  intro q
  rcases QuotientGroup.mk'_surjective (allPowerNormalClosure G p) q with
    ⟨g, hg⟩
  rw [← hg]
  rw [← MonoidHom.map_pow]
  exact (QuotientGroup.eq_one_iff
    (N := allPowerNormalClosure G p) (g ^ p)).mpr (by
      unfold allPowerNormalClosure
      exact Subgroup.subset_normalClosure ⟨g, rfl⟩)

/--
If the source is generated by involutions and `p` is odd, every element of the
exact all-elements exponent-`p` quotient is the identity.
-/
theorem allPowerQuotient_eq_one_of_generatedByInvolutions_odd_exponent
    {G : Type _} [Group G] {p : ℕ}
    (h_generated : GeneratedByInvolutions G)
    (h_odd : ∃ k : ℕ, p = 2 * k + 1) :
    ∀ q : G ⧸ allPowerNormalClosure G p, q = 1 := by
  let quotientMap : G →* G ⧸ allPowerNormalClosure G p :=
    QuotientGroup.mk' (allPowerNormalClosure G p)
  have h_map_trivial :
      ∀ g : G, quotientMap g = 1 :=
    monoidHom_eq_one_of_generatedByInvolutions_odd_exponent
      quotientMap h_generated allPowerQuotient_exponent h_odd
  intro q
  rcases QuotientGroup.mk'_surjective (allPowerNormalClosure G p) q with
    ⟨g, rfl⟩
  exact h_map_trivial g

/--
Consequently the exact all-elements exponent quotient is finite at every odd
exponent for a source generated by involutions.
-/
theorem allPowerQuotient_finite_of_generatedByInvolutions_odd_exponent
    {G : Type _} [Group G] {p : ℕ}
    (h_generated : GeneratedByInvolutions G)
    (h_odd : ∃ k : ℕ, p = 2 * k + 1) :
    Set.Finite
      (Set.univ : Set (G ⧸ allPowerNormalClosure G p)) := by
  refine (Set.finite_singleton
    (1 : G ⧸ allPowerNormalClosure G p)).subset ?_
  intro q _
  exact Set.mem_singleton_iff.mpr
    (allPowerQuotient_eq_one_of_generatedByInvolutions_odd_exponent
      h_generated h_odd q)

/--
Normal closure generated only by `p`-powers of a selected subset of elements.

This models source quotients such as the Bridson--Vogtmann / Malestein--Putman
Nielsen-move quotients: useful shadows, but not the full all-elements quotient.
-/
def selectedPowerNormalClosure
    (G : Type _) [Group G] (Selected : Set G) (p : ℕ) : Subgroup G :=
  Subgroup.normalClosure ({x : G | ∃ g : G, g ∈ Selected ∧ g ^ p = x} : Set G)

instance selectedPowerNormalClosure_normal
    (G : Type _) [Group G] (Selected : Set G) (p : ℕ) :
    (selectedPowerNormalClosure G Selected p).Normal := by
  unfold selectedPowerNormalClosure
  infer_instance

/-- Selected-power relations are a subset of the all-power relations. -/
theorem selectedPowerNormalClosure_le_allPowerNormalClosure
    {G : Type _} [Group G] {Selected : Set G} {p : ℕ} :
    selectedPowerNormalClosure G Selected p ≤ allPowerNormalClosure G p := by
  unfold selectedPowerNormalClosure allPowerNormalClosure
  refine Subgroup.normalClosure_mono ?_
  intro x hx
  rcases hx with ⟨g, _hg_selected, rfl⟩
  exact ⟨g, rfl⟩

/-- The exact all-power quotient is a quotient of every selected-power quotient. -/
def selectedPowerQuotientToAllPowerQuotient
    {G : Type _} [Group G] (Selected : Set G) (p : ℕ) :
    G ⧸ selectedPowerNormalClosure G Selected p →*
      G ⧸ allPowerNormalClosure G p :=
  QuotientGroup.map
    (selectedPowerNormalClosure G Selected p)
    (allPowerNormalClosure G p)
    (MonoidHom.id G)
    (by
      intro x hx
      simpa using
        (selectedPowerNormalClosure_le_allPowerNormalClosure
          (Selected := Selected) (p := p) hx))

/-- The selected-to-all quotient map is surjective. -/
theorem selectedPowerQuotientToAllPowerQuotient_surjective
    {G : Type _} [Group G] (Selected : Set G) (p : ℕ) :
    Function.Surjective
      (selectedPowerQuotientToAllPowerQuotient
        (G := G) Selected p) := by
  intro q
  rcases QuotientGroup.mk'_surjective (allPowerNormalClosure G p) q with
    ⟨g, hg⟩
  refine ⟨QuotientGroup.mk' (selectedPowerNormalClosure G Selected p) g, ?_⟩
  rw [selectedPowerQuotientToAllPowerQuotient]
  rw [QuotientGroup.map_mk']
  exact hg

/--
If a selected-power quotient is finite, then the exact all-power quotient is
finite. This is the admissible finite/no-go direction for selected-power source
quotients.
-/
theorem finite_selectedPowerQuotient_forces_finite_allPowerQuotient
    {G : Type _} [Group G] {Selected : Set G} {p : ℕ}
    (h_finite_selected :
      Set.Finite
        (Set.univ : Set (G ⧸ selectedPowerNormalClosure G Selected p))) :
    Set.Finite (Set.univ : Set (G ⧸ allPowerNormalClosure G p)) := by
  let F :=
    selectedPowerQuotientToAllPowerQuotient
      (G := G) Selected p
  have h_image_finite : Set.Finite (Set.range F) := by
    simpa [Set.image_univ] using h_finite_selected.image F
  have h_range_univ : Set.range F = Set.univ := by
    ext q
    constructor
    · intro _
      trivial
    · intro _
      exact selectedPowerQuotientToAllPowerQuotient_surjective
        (G := G) Selected p q
  simpa [h_range_univ] using h_image_finite

/--
Contrapositive screen: if the exact all-power quotient is infinite, then every
selected-power quotient at the same exponent must also be infinite.
-/
theorem allPowerQuotient_infinite_forces_selectedPowerQuotient_infinite
    {G : Type _} [Group G] {Selected : Set G} {p : ℕ}
    (h_infinite_all :
      ¬ Set.Finite (Set.univ : Set (G ⧸ allPowerNormalClosure G p))) :
    ¬ Set.Finite
      (Set.univ : Set (G ⧸ selectedPowerNormalClosure G Selected p)) := by
  intro h_finite_selected
  exact h_infinite_all
    (finite_selectedPowerQuotient_forces_finite_allPowerQuotient
      (Selected := Selected) (p := p) h_finite_selected)

/--
Typed intake contract for a genuine all-elements exponent-quotient witness.

The Q042 positive route may use shadows and source theorems during search, but
the final positive object must provide these two pieces on the same target:
every target element has exponent `p`, and the actual image/range of the source
homomorphism is infinite.
-/
structure AllElementsExponentQuotientWitnessData
    (G H : Type _) [Group G] [Group H] where
  p : ℕ
  f : G →* H
  exponent_target : ∀ h : H, h ^ p = 1
  infinite_range : ¬ Set.Finite (Set.range f)

/--
Any object passing the all-elements exponent-quotient witness intake
immediately gives the two obligations consumed by the positive Q042 route:
all original `p`-powers die, and the image remains infinite.
-/
theorem all_elements_exponent_quotient_witness_obligations
    {G H : Type _} [Group G] [Group H]
    (D : AllElementsExponentQuotientWitnessData G H) :
    (∀ g : G, D.f (g ^ D.p) = 1) ∧
      ¬ Set.Finite (Set.range D.f) := by
  exact exponent_image_with_infinite_range_positive_witness_requirements
    D.f D.exponent_target D.infinite_range

/--
Direct gate form: a proposed positive route whose image/range is finite cannot
pass the all-elements exponent-quotient witness intake.
-/
theorem all_elements_exponent_quotient_witness_blocks_finite_range
    {G H : Type _} [Group G] [Group H]
    (D : AllElementsExponentQuotientWitnessData G H)
    (h_finite_range : Set.Finite (Set.range D.f)) :
    False := by
  exact D.infinite_range h_finite_range

/--
A group generated by involutions admits no genuine infinite-range
all-elements exponent witness at an odd exponent.
-/
theorem generatedByInvolutions_odd_exponent_blocks_positive_witness
    {G H : Type _} [Group G] [Group H]
    (h_generated : GeneratedByInvolutions G)
    (D : AllElementsExponentQuotientWitnessData G H)
    (h_odd : ∃ k : ℕ, D.p = 2 * k + 1) :
    False := by
  exact D.infinite_range
    (monoidHom_range_finite_of_generatedByInvolutions_odd_exponent
      D.f h_generated D.exponent_target h_odd)

/--
If the exact all-elements power quotient is infinite, its canonical projection
is a genuine positive all-elements exponent-quotient witness.
-/
def allPowerQuotient_infinite_gives_positive_witness
    {G : Type _} [Group G] {p : ℕ}
    (h_infinite_quotient :
      ¬ Set.Finite
        (Set.univ : Set (G ⧸ allPowerNormalClosure G p))) :
    AllElementsExponentQuotientWitnessData
      G (G ⧸ allPowerNormalClosure G p) where
  p := p
  f := QuotientGroup.mk' (allPowerNormalClosure G p)
  exponent_target := allPowerQuotient_exponent
  infinite_range := by
    intro h_finite_range
    apply h_infinite_quotient
    have h_range_univ :
        Set.range (QuotientGroup.mk' (allPowerNormalClosure G p) :
          G → G ⧸ allPowerNormalClosure G p) = Set.univ := by
      ext q
      constructor
      · intro _
        trivial
      · intro _
        exact QuotientGroup.mk'_surjective (allPowerNormalClosure G p) q
    simpa [h_range_univ] using h_finite_range

/--
Conversely, any genuine all-elements exponent-quotient witness forces the
corresponding exact all-power quotient to be infinite.

Indeed the witness homomorphism kills every source `p`-power, hence factors
through `G ⧸ allPowerNormalClosure G p`.  If that exact quotient were finite,
the witness range would be finite, contradicting the intake contract.
-/
theorem allPowerQuotient_infinite_of_positive_witness
    {G H : Type _} [Group G] [Group H]
    (D : AllElementsExponentQuotientWitnessData G H) :
    ¬ Set.Finite
      (Set.univ : Set (G ⧸ allPowerNormalClosure G D.p)) := by
  intro h_finite_quotient
  have h_kills_powers : ∀ g : G, D.f (g ^ D.p) = 1 :=
    (all_elements_exponent_quotient_witness_obligations D).1
  let L : G ⧸ allPowerNormalClosure G D.p →* H :=
    allPowerQuotientLift D.f h_kills_powers
  have h_lift_range_finite : Set.Finite (Set.range L) := by
    simpa [Set.image_univ] using
      h_finite_quotient.image (fun q : G ⧸ allPowerNormalClosure G D.p => L q)
  have h_factor :
      L.comp (QuotientGroup.mk' (allPowerNormalClosure G D.p)) = D.f :=
    allPowerQuotientLift_comp_mk' D.f h_kills_powers
  have h_witness_range_finite : Set.Finite (Set.range D.f) :=
    h_lift_range_finite.subset (by
      intro y hy
      rcases hy with ⟨g, rfl⟩
      refine ⟨QuotientGroup.mk' (allPowerNormalClosure G D.p) g, ?_⟩
      exact (DFunLike.congr_fun h_factor g).symm)
  exact D.infinite_range h_witness_range_finite

/--
Finite canonical all-power quotient blocks every purported genuine positive
witness at the same exponent.
-/
theorem finite_allPowerQuotient_blocks_positive_witness
    {G H : Type _} [Group G] [Group H]
    (D : AllElementsExponentQuotientWitnessData G H)
    (h_finite_quotient :
      Set.Finite
        (Set.univ : Set (G ⧸ allPowerNormalClosure G D.p))) :
    False := by
  exact allPowerQuotient_infinite_of_positive_witness D h_finite_quotient

/--
Every genuine all-elements exponent-quotient witness forces every selected-power
quotient at the same exponent to be infinite.  This is the direct candidate
screen used by selected-power source quotients: a finite selected quotient
blocks the purported positive witness.
-/
theorem positive_witness_forces_selectedPowerQuotient_infinite
    {G H : Type _} [Group G] [Group H]
    {Selected : Set G}
    (D : AllElementsExponentQuotientWitnessData G H) :
    ¬ Set.Finite
      (Set.univ : Set (G ⧸ selectedPowerNormalClosure G Selected D.p)) := by
  exact allPowerQuotient_infinite_forces_selectedPowerQuotient_infinite
    (Selected := Selected)
    (allPowerQuotient_infinite_of_positive_witness D)

/--
Typed finite-obstruction certificate for selected-power source quotients.

Workers can instantiate this with a concrete selected family (for example a
Nielsen-move family) and a proof that the corresponding selected-power quotient
is finite.  The consumer theorem then blocks every purported all-elements
positive witness at the same exponent.
-/
structure SelectedPowerFiniteObstructionData
    (G : Type _) [Group G] where
  Selected : Set G
  p : ℕ
  finite_selected_quotient :
    Set.Finite
      (Set.univ : Set (G ⧸ selectedPowerNormalClosure G Selected p))

/--
Consumer for `SelectedPowerFiniteObstructionData`: a finite selected-power
quotient blocks any genuine all-elements exponent-quotient witness at the same
exponent.
-/
theorem selectedPowerFiniteObstruction_blocks_positive_witness
    {G H : Type _} [Group G] [Group H]
    (O : SelectedPowerFiniteObstructionData G)
    (D : AllElementsExponentQuotientWitnessData G H)
    (h_same_exponent : D.p = O.p) :
    False := by
  have h_selected_infinite :
      ¬ Set.Finite
        (Set.univ : Set (G ⧸ selectedPowerNormalClosure G O.Selected D.p)) :=
    positive_witness_forces_selectedPowerQuotient_infinite
      (Selected := O.Selected) D
  rw [h_same_exponent] at h_selected_infinite
  exact h_selected_infinite O.finite_selected_quotient

/--
The canonical all-power quotient is not just one possible positive route; it is
equivalent to the existence of any genuine all-elements exponent-quotient
witness at the same exponent.

This is the compiled anti-surrogate theorem for Q042: a future proof may use
other constructions, but after the all-elements intake contract is enforced the
remaining mathematical question is exactly infinitude of the canonical quotient.
-/
theorem allPowerQuotient_infinite_iff_exists_positive_witness_at_exponent
    {G : Type u} [Group G] {p : ℕ} :
    (¬ Set.Finite
      (Set.univ : Set (G ⧸ allPowerNormalClosure G p))) ↔
      ∃ (H : Type u) (_ : Group H),
        ∃ D : AllElementsExponentQuotientWitnessData G H, D.p = p := by
  constructor
  · intro h_infinite_quotient
    refine ⟨G ⧸ allPowerNormalClosure G p, inferInstance, ?_⟩
    exact ⟨allPowerQuotient_infinite_gives_positive_witness
      h_infinite_quotient, rfl⟩
  · intro h_exists
    rcases h_exists with ⟨H, instH, D, h_exponent_eq⟩
    letI : Group H := instH
    rw [← h_exponent_eq]
    exact allPowerQuotient_infinite_of_positive_witness D

/--
Abstract record for a "large quotient exists" shadow.

This deliberately does not close the all-elements exponent quotient problem:
the quotient `Q` may be useful prior art or a search source, but it is not yet
the specified exponent-`p` target required by `AllElementsExponentQuotientWitnessData`.
-/
structure QuotientLargenessShadow
    (G Q : Type _) [Group G] [Group Q] where
  q : G →* Q
  quotient_surjective : Function.Surjective q
  large_payload : Prop

/--
Bridge contract for turning an unspecified large quotient shadow into an
admissible all-elements exponent-quotient witness.

This is the formal "no downgrade" gate for SQ-universality-style routes: the
shadow is not consumed directly.  A route must additionally provide one
homomorphism `f : G →* H` into one exponent-`p` target `H`, prove that `f`
factors through the shadow quotient, and prove that the actual range of `f` is
infinite.
-/
structure ShadowToAllElementsExponentFactorization
    (G Q H : Type _) [Group G] [Group Q] [Group H] where
  shadow : QuotientLargenessShadow G Q
  p : ℕ
  f : G →* H
  factors_through_shadow : ∃ h : Q →* H, f = h.comp shadow.q
  exponent_target : ∀ h : H, h ^ p = 1
  infinite_range : ¬ Set.Finite (Set.range f)

/--
Once the missing factorization payload is supplied, the large-quotient shadow
route becomes a genuine all-elements exponent-quotient witness.
-/
def shadow_factorization_to_all_elements_exponent_witness
    {G Q H : Type _} [Group G] [Group Q] [Group H]
    (D : ShadowToAllElementsExponentFactorization G Q H) :
    AllElementsExponentQuotientWitnessData G H where
  p := D.p
  f := D.f
  exponent_target := D.exponent_target
  infinite_range := D.infinite_range

/--
Consumer theorem for the bridge: even when a proof route starts from an
unspecified large quotient, Q042 only receives the standard all-elements
obligations after the explicit exponent-target factorization is present.
-/
theorem shadow_factorization_all_elements_exponent_obligations
    {G Q H : Type _} [Group G] [Group Q] [Group H]
    (D : ShadowToAllElementsExponentFactorization G Q H) :
    (∀ g : G, D.f (g ^ D.p) = 1) ∧
      ¬ Set.Finite (Set.range D.f) := by
  exact all_elements_exponent_quotient_witness_obligations
    (shadow_factorization_to_all_elements_exponent_witness D)

theorem infinite_subrange_forces_infinite_ambient_range
    {A G H : Type _} (f : G → H) (i : A → G)
    (h_infinite_subrange : ¬ Set.Finite (Set.range fun a : A => f (i a))) :
    ¬ Set.Finite (Set.range f) := by
  intro h_finite_range
  apply h_infinite_subrange
  exact h_finite_range.subset (by
    intro y hy
    rcases hy with ⟨a, rfl⟩
    exact ⟨i a, rfl⟩)

theorem ambient_extension_with_infinite_restriction_image_positive_witness
    {A G H : Type _} [Group G] [Group H] (f : G →* H) (i : A → G) {p : ℕ}
    (h_exponent : ∀ h : H, h ^ p = 1)
    (h_infinite_restriction_image :
      ¬ Set.Finite (Set.range fun a : A => f (i a))) :
    (∀ g : G, f (g ^ p) = 1) ∧
      ¬ Set.Finite (Set.range f) := by
  exact exponent_image_with_infinite_range_positive_witness_requirements
    (f := f) (p := p) h_exponent
    (infinite_subrange_forces_infinite_ambient_range (f := fun g : G => f g)
      (i := i) h_infinite_restriction_image)

/--
Q042 Torelli-frontier intake object.

Here `A` is the current encoded Torelli-type source domain and `i : A -> G`
is its inclusion/realization in the ambient group under test.  A genuinely
positive higher-rank frontier route must give an exponent-`p` target and an
infinite image already on this restriction.  The structure deliberately does
not accept a merely large, virtual, abelian or finite shadow without the
all-elements exponent-target payload.
-/
structure TorelliRestrictionExponentWitnessData
    (A G H : Type _) [Group G] [Group H] where
  p : ℕ
  f : G →* H
  inclusion : A → G
  exponent_target : ∀ h : H, h ^ p = 1
  infinite_restriction_image :
    ¬ Set.Finite (Set.range fun a : A => f (inclusion a))

/--
A Torelli-restriction exponent witness is an all-elements exponent-quotient
witness for the ambient group, because the infinite restriction image forces
the full ambient image to be infinite.
-/
def torelli_restriction_to_all_elements_exponent_witness
    {A G H : Type _} [Group G] [Group H]
    (D : TorelliRestrictionExponentWitnessData A G H) :
    AllElementsExponentQuotientWitnessData G H where
  p := D.p
  f := D.f
  exponent_target := D.exponent_target
  infinite_range :=
    infinite_subrange_forces_infinite_ambient_range
      (f := fun g : G => D.f g) (i := D.inclusion)
      D.infinite_restriction_image

/--
Consumer theorem for the higher-rank Torelli frontier: once the restriction
payload is present, the standard all-elements exponent obligations are obtained
without changing the Q042 target.
-/
theorem torelli_restriction_exponent_witness_obligations
    {A G H : Type _} [Group G] [Group H]
    (D : TorelliRestrictionExponentWitnessData A G H) :
    (∀ g : G, D.f (g ^ D.p) = 1) ∧
      ¬ Set.Finite (Set.range D.f) := by
  exact all_elements_exponent_quotient_witness_obligations
    (torelli_restriction_to_all_elements_exponent_witness D)

/--
A finite ambient image makes every encoded Torelli restriction image finite.
This is the formal no-go consumer for finite abelian/Torelli-shadow packages:
such a shadow cannot be consumed as the positive infinity witness.
-/
theorem finite_ambient_image_blocks_infinite_restriction_image
    {A G H : Type _} (f : G → H) (i : A → G)
    (h_finite_range : Set.Finite (Set.range f)) :
    Set.Finite (Set.range fun a : A => f (i a)) := by
  exact h_finite_range.subset (by
    intro y hy
    rcases hy with ⟨a, rfl⟩
    exact ⟨i a, rfl⟩)

/--
Negated predicate form for automated Q042 gates: a finite ambient shadow rules
out the infinite-restriction premise required by the Torelli positive-witness
contract.
-/
theorem finite_ambient_image_not_torelli_infinite_restriction_witness
    {A G H : Type _} (f : G → H) (i : A → G)
    (h_finite_range : Set.Finite (Set.range f)) :
    ¬ (¬ Set.Finite (Set.range fun a : A => f (i a))) := by
  intro h_infinite_restriction
  exact h_infinite_restriction
    (finite_ambient_image_blocks_infinite_restriction_image
      (f := f) (i := i) h_finite_range)

def fiberCodingEquiv {A B : Type _} (f : A → B) :
    A ≃ Sigma (fun b : B => {a : A // f a = b}) where
  toFun a := ⟨f a, ⟨a, rfl⟩⟩
  invFun s := s.2.1
  left_inv a := rfl
  right_inv s := by
    rcases s with ⟨b, a, ha⟩
    cases ha
    rfl

noncomputable def fintypeDomainOfFintypeCodomainAndFibers
    {A B : Type _} [Fintype B] (f : A → B)
    [∀ b : B, Fintype {a : A // f a = b}] : Fintype A :=
  Fintype.ofEquiv (Sigma (fun b : B => {a : A // f a = b}))
    (fiberCodingEquiv f).symm

theorem finite_total_of_finite_quotient_and_uniform_finite_fiber
    {A B K : Type _} [Fintype B] (f : A → B)
    (fiber_equiv : ∀ b : B, {a : A // f a = b} ≃ K)
    [Fintype K] : Set.Finite (Set.univ : Set A) := by
  letI : ∀ b : B, Fintype {a : A // f a = b} := fun b =>
    Fintype.ofEquiv K (fiber_equiv b).symm
  letI : Fintype A := fintypeDomainOfFintypeCodomainAndFibers f
  exact Set.toFinite (Set.univ : Set A)

theorem infinite_total_forces_infinite_uniform_fiber_over_finite_quotient
    {A B K : Type _} [Fintype B] (f : A → B)
    (fiber_equiv : ∀ b : B, {a : A // f a = b} ≃ K)
    (h_total_infinite : ¬ Set.Finite (Set.univ : Set A)) :
    ¬ Nonempty (Fintype K) := by
  intro hK
  letI : Fintype K := hK.some
  exact h_total_infinite
    (finite_total_of_finite_quotient_and_uniform_finite_fiber
      (f := f) fiber_equiv)

theorem power_image_counterexample_blocks_all_elements_factorization
    {G H : Type _} [Group G] [Group H] (f : G →* H) {p : ℕ}
    (h_counterexample : ∃ g : G, f (g ^ p) ≠ 1) :
    ¬ (∀ g : G, f (g ^ p) = 1) := by
  intro h_all_powers_killed
  rcases h_counterexample with ⟨g, hg⟩
  exact hg (h_all_powers_killed g)

theorem selected_power_relations_do_not_suffice_without_all_elements_condition
    {G H : Type _} [Group G] [Group H] (f : G →* H) {p : ℕ}
    {Selected : Set G}
    (_h_selected_powers_killed : ∀ g : G, g ∈ Selected → f (g ^ p) = 1)
    (h_unselected_counterexample : ∃ g : G, g ∉ Selected ∧ f (g ^ p) ≠ 1) :
    ¬ (∀ g : G, f (g ^ p) = 1) := by
  apply power_image_counterexample_blocks_all_elements_factorization (f := f) (p := p)
  rcases h_unselected_counterexample with ⟨g, _hg_not_selected, hg_power_survives⟩
  exact ⟨g, hg_power_survives⟩

theorem rank_two_witness_closes_unqualified_rank_existential
    {P : ℕ → ℕ → Prop}
    (h_rank_two : ∃ p : ℕ, P 2 p) :
    ∃ n p : ℕ, P n p := by
  rcases h_rank_two with ⟨p, hp⟩
  exact ⟨2, p, hp⟩

def twistedConjugateProduct
    {G : Type _} [Group G] (s x : G) : ℕ → G
  | 0 => 1
  | n + 1 => twistedConjugateProduct s x n * (s ^ n * x * (s ^ n)⁻¹)

theorem product_power_eq_twisted_conjugate_product_mul_power
    {G : Type _} [Group G] (x s : G) :
    ∀ n : ℕ, (x * s) ^ n = twistedConjugateProduct s x n * s ^ n := by
  intro n
  induction n with
  | zero =>
      simp [twistedConjugateProduct]
  | succ n ih =>
      calc
        (x * s) ^ (n + 1) = (x * s) ^ n * (x * s) := by
          rw [pow_succ]
        _ = (twistedConjugateProduct s x n * s ^ n) * (x * s) := by
          rw [ih]
        _ = twistedConjugateProduct s x n *
            (s ^ n * x * (s ^ n)⁻¹) * s ^ (n + 1) := by
          rw [pow_succ]
          have hconj :
              s ^ n * x = (s ^ n * x * (s ^ n)⁻¹) * s ^ n := by
            simp [mul_assoc]
          have hstep := congrArg
            (fun y => twistedConjugateProduct s x n * (y * s)) hconj
          simpa only [mul_assoc] using hstep
        _ = twistedConjugateProduct s x (n + 1) * s ^ (n + 1) := by
          simp [twistedConjugateProduct, mul_assoc]

theorem product_power_relation_reduces_to_twisted_conjugate_product
    {G : Type _} [Group G] {x s : G} {p : ℕ}
    (h_product_power : (x * s) ^ p = 1)
    (h_symmetry_power : s ^ p = 1) :
    twistedConjugateProduct s x p = 1 := by
  have h_formula :=
    product_power_eq_twisted_conjugate_product_mul_power (x := x) (s := s) p
  have h_twisted : twistedConjugateProduct s x p * s ^ p = 1 := by
    simpa [h_formula] using h_product_power
  simpa [h_symmetry_power] using h_twisted

theorem twistedConjugateProduct_add_of_left_period
    {G : Type _} [Group G] {s x : G} {n : ℕ}
    (h_period : s ^ n = 1) :
    ∀ m : ℕ,
      twistedConjugateProduct s x (n + m) =
        twistedConjugateProduct s x n * twistedConjugateProduct s x m := by
  intro m
  induction m with
  | zero =>
      simp [twistedConjugateProduct]
  | succ m ih =>
      have hpow : s ^ (n + m) = s ^ m := by
        rw [pow_add, h_period, one_mul]
      calc
        twistedConjugateProduct s x (n + (m + 1)) =
            twistedConjugateProduct s x (n + m) *
              (s ^ (n + m) * x * (s ^ (n + m))⁻¹) := by
          rw [← Nat.add_assoc]
          simp [twistedConjugateProduct]
        _ = (twistedConjugateProduct s x n * twistedConjugateProduct s x m) *
              (s ^ m * x * (s ^ m)⁻¹) := by
          rw [ih, hpow]
        _ = twistedConjugateProduct s x n * twistedConjugateProduct s x (m + 1) := by
          simp [twistedConjugateProduct, mul_assoc]

theorem twistedConjugateProduct_period_mul_eq_block_power
    {G : Type _} [Group G] {s x : G} {m : ℕ}
    (h_period : s ^ m = 1) :
    ∀ k : ℕ,
      twistedConjugateProduct s x (m * k) =
        (twistedConjugateProduct s x m) ^ k := by
  intro k
  induction k with
  | zero =>
      simp [twistedConjugateProduct]
  | succ k ih =>
      have h_period_k : s ^ (m * k) = 1 := by
        rw [pow_mul, h_period, one_pow]
      calc
        twistedConjugateProduct s x (m * (k + 1)) =
            twistedConjugateProduct s x (m * k + m) := by
          rw [Nat.mul_succ]
        _ = twistedConjugateProduct s x (m * k) *
              twistedConjugateProduct s x m := by
          exact twistedConjugateProduct_add_of_left_period
            (s := s) (x := x) (n := m * k) h_period_k m
        _ = (twistedConjugateProduct s x m) ^ (k + 1) := by
          rw [ih, pow_succ]

theorem twistedConjugateProduct_eq_block_power_of_period_dvd
    {G : Type _} [Group G] {s x : G} {m k p : ℕ}
    (h_period : s ^ m = 1)
    (h_decomp : p = m * k) :
    twistedConjugateProduct s x p =
      (twistedConjugateProduct s x m) ^ k := by
  rw [h_decomp]
  exact twistedConjugateProduct_period_mul_eq_block_power
    (s := s) (x := x) h_period k

theorem twistedConjugateProduct_lcm_multiplier_period_block_power
    {G : Type _} [Group G] {s x : G} {m a L k p : ℕ}
    (h_period : s ^ m = 1)
    (h_L : L = m * a)
    (h_p : p = L * k) :
    twistedConjugateProduct s x p =
      (twistedConjugateProduct s x m) ^ (a * k) := by
  exact twistedConjugateProduct_eq_block_power_of_period_dvd
    (s := s) (x := x) h_period (by
      rw [h_p, h_L, Nat.mul_assoc])

theorem mixed_product_power_relation_lcm_multiplier_reduces_to_period_block
    {G : Type _} [Group G] {s x : G} {m a L k p : ℕ}
    (h_product_power : (x * s) ^ p = 1)
    (h_period : s ^ m = 1)
    (h_L : L = m * a)
    (h_p : p = L * k) :
    (twistedConjugateProduct s x m) ^ (a * k) = 1 := by
  have h_decomp : p = m * (a * k) := by
    rw [h_p, h_L, Nat.mul_assoc]
  have h_s_power : s ^ p = 1 := by
    rw [h_decomp, pow_mul, h_period, one_pow]
  have h_twisted :
      twistedConjugateProduct s x p = 1 :=
    product_power_relation_reduces_to_twisted_conjugate_product
      (x := x) (s := s) h_product_power h_s_power
  have h_block :
      twistedConjugateProduct s x p =
        (twistedConjugateProduct s x m) ^ (a * k) :=
    twistedConjugateProduct_eq_block_power_of_period_dvd
      (s := s) (x := x) h_period h_decomp
  rw [h_block] at h_twisted
  exact h_twisted

theorem twistedConjugateProduct_two_eq_mul_conjugate
    {G : Type _} [Group G] (s x : G) :
    twistedConjugateProduct s x 2 = x * (s * x * s⁻¹) := by
  simp [twistedConjugateProduct]

theorem twistedConjugateProduct_two_eq_one_of_conjugates_to_inv
    {G : Type _} [Group G] {s x : G}
    (h_inverts : s * x * s⁻¹ = x⁻¹) :
    twistedConjugateProduct s x 2 = 1 := by
  rw [twistedConjugateProduct_two_eq_mul_conjugate, h_inverts, mul_inv_cancel]

theorem mixed_product_square_eq_one_of_symmetry_inverts
    {G : Type _} [Group G] {s x : G}
    (h_symmetry_square : s ^ 2 = 1)
    (h_inverts : s * x * s⁻¹ = x⁻¹) :
    (x * s) ^ 2 = 1 := by
  have h_formula :=
    product_power_eq_twisted_conjugate_product_mul_power (x := x) (s := s) 2
  have h_block :
      twistedConjugateProduct s x 2 = 1 :=
    twistedConjugateProduct_two_eq_one_of_conjugates_to_inv
      (s := s) (x := x) h_inverts
  rw [h_formula, h_block, h_symmetry_square, one_mul]

theorem mixed_product_even_power_eq_one_of_symmetry_inverts
    {G : Type _} [Group G] {s x : G} {p k : ℕ}
    (h_symmetry_square : s ^ 2 = 1)
    (h_inverts : s * x * s⁻¹ = x⁻¹)
    (h_decomp : p = 2 * k) :
    (x * s) ^ p = 1 := by
  have h_square :
      (x * s) ^ 2 = 1 :=
    mixed_product_square_eq_one_of_symmetry_inverts
      (s := s) (x := x) h_symmetry_square h_inverts
  rw [h_decomp, pow_mul, h_square, one_pow]

theorem twistedConjugateProduct_even_eq_one_of_symmetry_inverts
    {G : Type _} [Group G] {s x : G} {p k : ℕ}
    (h_symmetry_square : s ^ 2 = 1)
    (h_inverts : s * x * s⁻¹ = x⁻¹)
    (h_decomp : p = 2 * k) :
    twistedConjugateProduct s x p = 1 := by
  have h_block :
      twistedConjugateProduct s x 2 = 1 :=
    twistedConjugateProduct_two_eq_one_of_conjugates_to_inv
      (s := s) (x := x) h_inverts
  have h_reduce :
      twistedConjugateProduct s x p =
        (twistedConjugateProduct s x 2) ^ k :=
    twistedConjugateProduct_eq_block_power_of_period_dvd
      (s := s) (x := x) h_symmetry_square h_decomp
  rw [h_reduce, h_block, one_pow]

theorem twistedConjugateProduct_eq_pow_of_all_conjugates_fixed
    {G : Type _} [Group G] {s x : G}
    (h_fixed : ∀ n : ℕ, s ^ n * x * (s ^ n)⁻¹ = x) :
    ∀ n : ℕ, twistedConjugateProduct s x n = x ^ n := by
  intro n
  induction n with
  | zero =>
      simp [twistedConjugateProduct]
  | succ n ih =>
      simp [twistedConjugateProduct, ih, h_fixed n, pow_succ]

theorem twistedConjugateProduct_eq_one_of_fixed_and_power_killed
    {G : Type _} [Group G] {s x : G} {p : ℕ}
    (h_fixed : ∀ n : ℕ, s ^ n * x * (s ^ n)⁻¹ = x)
    (h_x_power : x ^ p = 1) :
    twistedConjugateProduct s x p = 1 := by
  rw [twistedConjugateProduct_eq_pow_of_all_conjugates_fixed
    (s := s) (x := x) h_fixed p, h_x_power]

theorem mixed_product_power_eq_one_of_fixed_conjugates_and_component_powers
    {G : Type _} [Group G] {s x : G} {p : ℕ}
    (h_fixed : ∀ n : ℕ, s ^ n * x * (s ^ n)⁻¹ = x)
    (h_x_power : x ^ p = 1)
    (h_s_power : s ^ p = 1) :
    (x * s) ^ p = 1 := by
  have h_formula :=
    product_power_eq_twisted_conjugate_product_mul_power (x := x) (s := s) p
  have h_twisted :
      twistedConjugateProduct s x p = 1 :=
      twistedConjugateProduct_eq_one_of_fixed_and_power_killed
      (s := s) (x := x) h_fixed h_x_power
  rw [h_formula, h_twisted, h_s_power, one_mul]

theorem twistedConjugateProduct_three_eq_mul_conjugate_mul_conjugate_square
    {G : Type _} [Group G] (s x : G) :
    twistedConjugateProduct s x 3 =
      x * (s * x * s⁻¹) * (s ^ 2 * x * (s ^ 2)⁻¹) := by
  simp [twistedConjugateProduct, mul_assoc]

theorem twistedConjugateProduct_three_block_power_of_order_three
    {G : Type _} [Group G] {s x : G} {p k : ℕ}
    (h_period : s ^ 3 = 1)
    (h_decomp : p = 3 * k) :
    twistedConjugateProduct s x p =
      (x * (s * x * s⁻¹) * (s ^ 2 * x * (s ^ 2)⁻¹)) ^ k := by
  have h_block :
      twistedConjugateProduct s x p =
        (twistedConjugateProduct s x 3) ^ k :=
    twistedConjugateProduct_eq_block_power_of_period_dvd
      (s := s) (x := x) h_period h_decomp
  rw [h_block, twistedConjugateProduct_three_eq_mul_conjugate_mul_conjugate_square]

theorem mixed_product_power_relation_reduces_to_three_orbit_block
    {G : Type _} [Group G] {s x : G} {p k : ℕ}
    (h_product_power : (x * s) ^ p = 1)
    (h_period : s ^ 3 = 1)
    (h_decomp : p = 3 * k) :
    (x * (s * x * s⁻¹) * (s ^ 2 * x * (s ^ 2)⁻¹)) ^ k = 1 := by
  have h_s_power : s ^ p = 1 := by
    rw [h_decomp, pow_mul, h_period, one_pow]
  have h_twisted :
      twistedConjugateProduct s x p = 1 :=
    product_power_relation_reduces_to_twisted_conjugate_product
      (x := x) (s := s) h_product_power h_s_power
  have h_block :
      twistedConjugateProduct s x p =
        (x * (s * x * s⁻¹) * (s ^ 2 * x * (s ^ 2)⁻¹)) ^ k :=
    twistedConjugateProduct_three_block_power_of_order_three
      (s := s) (x := x) h_period h_decomp
  rw [h_block] at h_twisted
  exact h_twisted

theorem twistedConjugateProduct_three_eq_cycle_product
    {G : Type _} [Group G] {s x y z : G}
    (h_first : s * x * s⁻¹ = y)
    (h_second : s * y * s⁻¹ = z) :
    twistedConjugateProduct s x 3 = x * y * z := by
  rw [twistedConjugateProduct_three_eq_mul_conjugate_mul_conjugate_square]
  have h_square : s ^ 2 * x * (s ^ 2)⁻¹ = z := by
    calc
      s ^ 2 * x * (s ^ 2)⁻¹ = s * (s * x * s⁻¹) * s⁻¹ := by
        simp [pow_two, mul_assoc]
      _ = s * y * s⁻¹ := by rw [h_first]
      _ = z := h_second
  rw [h_first, h_square]

theorem mixed_product_power_relation_reduces_to_three_cycle_product
    {G : Type _} [Group G] {s x y z : G} {p k : ℕ}
    (h_product_power : (x * s) ^ p = 1)
    (h_period : s ^ 3 = 1)
    (h_decomp : p = 3 * k)
    (h_first : s * x * s⁻¹ = y)
    (h_second : s * y * s⁻¹ = z) :
    (x * y * z) ^ k = 1 := by
  have h_block :
      (x * (s * x * s⁻¹) * (s ^ 2 * x * (s ^ 2)⁻¹)) ^ k = 1 :=
    mixed_product_power_relation_reduces_to_three_orbit_block
      (s := s) (x := x) h_product_power h_period h_decomp
  have h_cycle :
      x * (s * x * s⁻¹) * (s ^ 2 * x * (s ^ 2)⁻¹) = x * y * z := by
    have h_square : s ^ 2 * x * (s ^ 2)⁻¹ = z := by
      calc
        s ^ 2 * x * (s ^ 2)⁻¹ = s * (s * x * s⁻¹) * s⁻¹ := by
          simp [pow_two, mul_assoc]
        _ = s * y * s⁻¹ := by rw [h_first]
        _ = z := h_second
    rw [h_first, h_square]
  rw [h_cycle] at h_block
  exact h_block

theorem twistedConjugateProduct_four_eq_cycle_product
    {G : Type _} [Group G] {s x y z w : G}
    (h_first : s * x * s⁻¹ = y)
    (h_second : s * y * s⁻¹ = z)
    (h_third : s * z * s⁻¹ = w) :
    twistedConjugateProduct s x 4 = x * y * z * w := by
  have h_square : s ^ 2 * x * (s ^ 2)⁻¹ = z := by
    calc
      s ^ 2 * x * (s ^ 2)⁻¹ = s * (s * x * s⁻¹) * s⁻¹ := by
        simp [pow_two, mul_assoc]
      _ = s * y * s⁻¹ := by rw [h_first]
      _ = z := h_second
  have h_cube : s ^ 3 * x * (s ^ 3)⁻¹ = w := by
    calc
      s ^ 3 * x * (s ^ 3)⁻¹ = s * (s ^ 2 * x * (s ^ 2)⁻¹) * s⁻¹ := by
        simp [pow_succ, mul_assoc]
      _ = s * z * s⁻¹ := by rw [h_square]
      _ = w := h_third
  simp [twistedConjugateProduct, h_first, h_square, h_cube, mul_assoc]

theorem mixed_product_power_relation_reduces_to_four_cycle_product
    {G : Type _} [Group G] {s x y z w : G} {p k : ℕ}
    (h_product_power : (x * s) ^ p = 1)
    (h_period : s ^ 4 = 1)
    (h_decomp : p = 4 * k)
    (h_first : s * x * s⁻¹ = y)
    (h_second : s * y * s⁻¹ = z)
    (h_third : s * z * s⁻¹ = w) :
    (x * y * z * w) ^ k = 1 := by
  have h_block :
      (twistedConjugateProduct s x 4) ^ k = 1 := by
    simpa using mixed_product_power_relation_lcm_multiplier_reduces_to_period_block
      (s := s) (x := x) (m := 4) (a := 1) (L := 4) (k := k) (p := p)
      h_product_power h_period rfl h_decomp
  have h_cycle :
      twistedConjugateProduct s x 4 = x * y * z * w :=
    twistedConjugateProduct_four_eq_cycle_product
      (s := s) (x := x) (y := y) (z := z) (w := w)
      h_first h_second h_third
  rw [h_cycle] at h_block
  exact h_block

/-- Ordered noncommutative product of a finite orbit fragment. -/
def finiteOrbitProduct
    {G : Type _} [Group G] (a : ℕ → G) : ℕ → G
  | 0 => 1
  | n + 1 => finiteOrbitProduct a n * a n

/--
If the first `m` conjugates of `x` by powers of `s` are listed by `a`, the
twisted conjugate product is exactly the ordered product of that finite orbit.

This is the general finite-cycle kernel behind the earlier explicit period
three and period four witness-test relations.
-/
theorem twistedConjugateProduct_eq_finiteOrbitProduct_of_pointwise_orbit
    {G : Type _} [Group G] {s x : G} {a : ℕ → G} :
    ∀ m : ℕ,
      (∀ i : ℕ, i < m → s ^ i * x * (s ^ i)⁻¹ = a i) →
      twistedConjugateProduct s x m = finiteOrbitProduct a m := by
  intro m
  induction m with
  | zero =>
      intro _h_orbit
      simp [twistedConjugateProduct, finiteOrbitProduct]
  | succ m ih =>
      intro h_orbit
      have h_prefix :
          twistedConjugateProduct s x m = finiteOrbitProduct a m := by
        apply ih
        intro i hi
        exact h_orbit i (Nat.lt_trans hi (Nat.lt_succ_self m))
      have h_last : s ^ m * x * (s ^ m)⁻¹ = a m :=
        h_orbit m (Nat.lt_succ_self m)
      simp [twistedConjugateProduct, finiteOrbitProduct, h_prefix, h_last]

/--
General finite-orbit residual relation.  In a quotient killing `(x*s)^p`, if
`s` has period `m`, `L=m*a_mult`, and `p=L*k`, then the residual mixed-word
constraint is the `(a_mult*k)`-th power of the ordered orbit product.
-/
theorem mixed_product_power_relation_reduces_to_finite_orbit_product
    {G : Type _} [Group G] {s x : G} {orbit : ℕ → G}
    {m a_mult L k p : ℕ}
    (h_product_power : (x * s) ^ p = 1)
    (h_period : s ^ m = 1)
    (h_L : L = m * a_mult)
    (h_p : p = L * k)
    (h_orbit : ∀ i : ℕ, i < m → s ^ i * x * (s ^ i)⁻¹ = orbit i) :
    (finiteOrbitProduct orbit m) ^ (a_mult * k) = 1 := by
  have h_block :
      (twistedConjugateProduct s x m) ^ (a_mult * k) = 1 :=
    mixed_product_power_relation_lcm_multiplier_reduces_to_period_block
      (s := s) (x := x) (m := m) (a := a_mult) (L := L) (k := k) (p := p)
      h_product_power h_period h_L h_p
  have h_orbit_product :
      twistedConjugateProduct s x m = finiteOrbitProduct orbit m :=
    twistedConjugateProduct_eq_finiteOrbitProduct_of_pointwise_orbit
      (s := s) (x := x) (a := orbit) m h_orbit
  rw [h_orbit_product] at h_block
  exact h_block

def malesteinPutmanPrimePowerDivisor (n q e k : ℕ) : Prop :=
  q ^ e ∣ k ∧ q ^ e > q * (q - 1) * (n - 1)

theorem lcm_frontier_multiplier_retains_mp_prime_power_divisor
    {n q e L k p : ℕ}
    (h_mp : malesteinPutmanPrimePowerDivisor n q e k)
    (h_p : p = L * k) :
    q ^ e ∣ p ∧ q ^ e > q * (q - 1) * (n - 1) := by
  constructor
  · rw [h_p]
    exact dvd_mul_of_dvd_right h_mp.1 L
  · exact h_mp.2

theorem q042_first_candidate_mp_prime_power_divisor :
    malesteinPutmanPrimePowerDivisor 3 2 3 8 := by
  simp [malesteinPutmanPrimePowerDivisor]

theorem q042_first_candidate_lcm_multiplier_retains_mp_divisor :
    2 ^ 3 ∣ 96 ∧ 2 ^ 3 > 2 * (2 - 1) * (3 - 1) := by
  exact lcm_frontier_multiplier_retains_mp_prime_power_divisor
    (n := 3) (q := 2) (e := 3) (L := 12) (k := 8) (p := 96)
    q042_first_candidate_mp_prime_power_divisor rfl

/--
First bounded Q042 candidate bridge for the general finite-orbit kernel.

For `n=3`, the lcm frontier has `L=12`; the first Malestein-Putman multiplier
screen uses `k_MP=8`, hence `p=96`.  Any finite symmetry period `m` admitted by
`12 = m*a` contributes the ordered orbit-product residual relation with
exponent `a*8`.
-/
theorem q042_first_candidate_general_finite_orbit_product_relation
    {G : Type _} [Group G] {s x : G} {orbit : ℕ → G} {m a : ℕ}
    (h_product_power : (x * s) ^ 96 = 1)
    (h_period : s ^ m = 1)
    (h_L : 12 = m * a)
    (h_orbit : ∀ i : ℕ, i < m → s ^ i * x * (s ^ i)⁻¹ = orbit i) :
    (finiteOrbitProduct orbit m) ^ (a * 8) = 1 := by
  exact mixed_product_power_relation_reduces_to_finite_orbit_product
    (s := s) (x := x) (orbit := orbit) (m := m) (a_mult := a)
    (L := 12) (k := 8) (p := 96)
    h_product_power h_period h_L rfl h_orbit

/--
Machine-checkable intake shape for a first-candidate finite-orbit witness.

A proposed non-linear standard-generator witness for the `n=3`, `p=96`
frontier is not usable by the residual kernel until it supplies these fields.
The structure deliberately records proof obligations, not just names.
-/
structure Q042FirstCandidateFiniteOrbitWitnessData
    (G : Type _) [Group G] where
  s : G
  x : G
  orbit : ℕ → G
  m : ℕ
  a : ℕ
  product_power : (x * s) ^ 96 = 1
  period : s ^ m = 1
  lcm_decomposition : 12 = m * a
  orbit_pointwise : ∀ i : ℕ, i < m → s ^ i * x * (s ^ i)⁻¹ = orbit i

/--
Any object passing the first-candidate witness intake shape immediately yields
the residual finite-orbit constraint consumed by the Q042 frontier.
-/
theorem q042_first_candidate_witness_data_residual_relation
    {G : Type _} [Group G]
    (D : Q042FirstCandidateFiniteOrbitWitnessData G) :
    (finiteOrbitProduct D.orbit D.m) ^ (D.a * 8) = 1 := by
  exact q042_first_candidate_general_finite_orbit_product_relation
    (s := D.s) (x := D.x) (orbit := D.orbit) (m := D.m) (a := D.a)
    D.product_power D.period D.lcm_decomposition D.orbit_pointwise

/--
The residual exponent in an admitted first-candidate Q042 witness is positive.

This removes a manual side-condition from the candidate filter: because the
intake carries `12 = m*a`, the multiplier `a` cannot be zero, hence `a*8` is
positive.
-/
theorem q042_first_candidate_witness_data_residual_exponent_positive
    {G : Type _} [Group G]
    (D : Q042FirstCandidateFiniteOrbitWitnessData G) :
    0 < D.a * 8 := by
  have h_a_pos : 0 < D.a :=
    right_factor_pos_of_positive_product_eq
      (target := 12) (m := D.m) (a := D.a)
      (by decide) D.lcm_decomposition
  exact Nat.mul_pos h_a_pos (by decide)

/--
Any admitted first-candidate witness has finite cyclic power range for its
finite-orbit product shadow.

This is the machine-checkable filter that prevents an infinite-order
orbit-product shadow from being mistaken for a positive exponent-quotient
witness.
-/
theorem q042_first_candidate_witness_data_orbit_product_power_range_finite
    {G : Type _} [Group G]
    (D : Q042FirstCandidateFiniteOrbitWitnessData G) :
    Set.Finite
      (Set.range fun n : ℕ => (finiteOrbitProduct D.orbit D.m) ^ n) := by
  exact cyclic_power_range_finite_of_power_eq_one
    (h := finiteOrbitProduct D.orbit D.m)
    (q042_first_candidate_witness_data_residual_exponent_positive D)
    (q042_first_candidate_witness_data_residual_relation D)

/--
Contrapositive screening form for Q042 candidate intake: a proposed witness with
an infinite cyclic power range in the finite-orbit product shadow cannot satisfy
the compiled first-candidate witness data.
-/
theorem q042_first_candidate_witness_data_blocks_infinite_orbit_product_shadow
    {G : Type _} [Group G]
    (D : Q042FirstCandidateFiniteOrbitWitnessData G)
    (h_infinite_orbit_product_shadow :
      ¬ Set.Finite
        (Set.range fun n : ℕ => (finiteOrbitProduct D.orbit D.m) ^ n)) :
    False := by
  exact h_infinite_orbit_product_shadow
    (q042_first_candidate_witness_data_orbit_product_power_range_finite
      D)

/--
Direct no-go verdict form for automated gates: the finite-orbit product shadow
of an admitted first-candidate witness is not an infinite cyclic-power shadow.

This is the same mathematical content as the blocking theorem above, exposed as
a negated predicate so downstream classifiers do not need to infer the verdict
from a `False` conclusion.
-/
theorem q042_first_candidate_witness_data_not_infinite_orbit_product_shadow
    {G : Type _} [Group G]
    (D : Q042FirstCandidateFiniteOrbitWitnessData G) :
    ¬
      (¬ Set.Finite
        (Set.range fun n : ℕ => (finiteOrbitProduct D.orbit D.m) ^ n)) := by
  intro h_infinite_orbit_product_shadow
  exact q042_first_candidate_witness_data_blocks_infinite_orbit_product_shadow
    D h_infinite_orbit_product_shadow

/-- Explicit orbit list for a three-cycle `x -> y -> z`. -/
def q042ThreeCycleOrbit {G : Type _} (x y z : G) : ℕ → G
  | 0 => x
  | 1 => y
  | _ + 2 => z

/-- Explicit orbit list for a four-cycle `x -> y -> z -> w`. -/
def q042FourCycleOrbit {G : Type _} (x y z w : G) : ℕ → G
  | 0 => x
  | 1 => y
  | 2 => z
  | _ + 3 => w

theorem finiteOrbitProduct_threeCycleOrbit
    {G : Type _} [Group G] (x y z : G) :
    finiteOrbitProduct (q042ThreeCycleOrbit x y z) 3 = x * y * z := by
  simp [finiteOrbitProduct, q042ThreeCycleOrbit, mul_assoc]

theorem finiteOrbitProduct_fourCycleOrbit
    {G : Type _} [Group G] (x y z w : G) :
    finiteOrbitProduct (q042FourCycleOrbit x y z w) 4 = x * y * z * w := by
  simp [finiteOrbitProduct, q042FourCycleOrbit, mul_assoc]

theorem q042_first_candidate_period_three_cycle_relation_via_general_orbit
    {G : Type _} [Group G] {s x y z : G}
    (h_product_power : (x * s) ^ 96 = 1)
    (h_period : s ^ 3 = 1)
    (h_first : s * x * s⁻¹ = y)
    (h_second : s * y * s⁻¹ = z) :
    (x * y * z) ^ 32 = 1 := by
  have h_general :
      (finiteOrbitProduct (q042ThreeCycleOrbit x y z) 3) ^ (4 * 8) = 1 := by
    apply q042_first_candidate_general_finite_orbit_product_relation
      (s := s) (x := x) (orbit := q042ThreeCycleOrbit x y z)
      (m := 3) (a := 4)
    · exact h_product_power
    · exact h_period
    · rfl
    · intro i hi
      cases i with
      | zero =>
          simp [q042ThreeCycleOrbit]
      | succ i =>
          cases i with
          | zero =>
              simpa [q042ThreeCycleOrbit] using h_first
          | succ i =>
              cases i with
              | zero =>
                  have h_square : s ^ 2 * x * (s ^ 2)⁻¹ = z := by
                    calc
                      s ^ 2 * x * (s ^ 2)⁻¹ = s * (s * x * s⁻¹) * s⁻¹ := by
                        simp [pow_two, mul_assoc]
                      _ = s * y * s⁻¹ := by rw [h_first]
                      _ = z := h_second
                  simpa [q042ThreeCycleOrbit] using h_square
              | succ i =>
                  have h_ge : 3 ≤ Nat.succ (Nat.succ (Nat.succ i)) :=
                    Nat.succ_le_succ
                      (Nat.succ_le_succ
                        (Nat.succ_le_succ (Nat.zero_le i)))
                  exact False.elim ((Nat.not_lt_of_ge h_ge) hi)
  simpa [finiteOrbitProduct_threeCycleOrbit, mul_assoc] using h_general

theorem q042_first_candidate_period_four_cycle_relation_via_general_orbit
    {G : Type _} [Group G] {s x y z w : G}
    (h_product_power : (x * s) ^ 96 = 1)
    (h_period : s ^ 4 = 1)
    (h_first : s * x * s⁻¹ = y)
    (h_second : s * y * s⁻¹ = z)
    (h_third : s * z * s⁻¹ = w) :
    (x * y * z * w) ^ 24 = 1 := by
  have h_general :
      (finiteOrbitProduct (q042FourCycleOrbit x y z w) 4) ^ (3 * 8) = 1 := by
    apply q042_first_candidate_general_finite_orbit_product_relation
      (s := s) (x := x) (orbit := q042FourCycleOrbit x y z w)
      (m := 4) (a := 3)
    · exact h_product_power
    · exact h_period
    · rfl
    · intro i hi
      cases i with
      | zero =>
          simp [q042FourCycleOrbit]
      | succ i =>
          cases i with
          | zero =>
              simpa [q042FourCycleOrbit] using h_first
          | succ i =>
              cases i with
              | zero =>
                  have h_square : s ^ 2 * x * (s ^ 2)⁻¹ = z := by
                    calc
                      s ^ 2 * x * (s ^ 2)⁻¹ = s * (s * x * s⁻¹) * s⁻¹ := by
                        simp [pow_two, mul_assoc]
                      _ = s * y * s⁻¹ := by rw [h_first]
                      _ = z := h_second
                  simpa [q042FourCycleOrbit] using h_square
              | succ i =>
                  cases i with
                  | zero =>
                      have h_square : s ^ 2 * x * (s ^ 2)⁻¹ = z := by
                        calc
                          s ^ 2 * x * (s ^ 2)⁻¹ = s * (s * x * s⁻¹) * s⁻¹ := by
                            simp [pow_two, mul_assoc]
                          _ = s * y * s⁻¹ := by rw [h_first]
                          _ = z := h_second
                      have h_cube : s ^ 3 * x * (s ^ 3)⁻¹ = w := by
                        calc
                          s ^ 3 * x * (s ^ 3)⁻¹ = s * (s ^ 2 * x * (s ^ 2)⁻¹) * s⁻¹ := by
                            simp [pow_succ, mul_assoc]
                          _ = s * z * s⁻¹ := by rw [h_square]
                          _ = w := h_third
                      simpa [q042FourCycleOrbit] using h_cube
                  | succ i =>
                      have h_ge : 4 ≤ Nat.succ (Nat.succ (Nat.succ (Nat.succ i))) :=
                        Nat.succ_le_succ
                          (Nat.succ_le_succ
                            (Nat.succ_le_succ
                              (Nat.succ_le_succ (Nat.zero_le i))))
                      exact False.elim ((Nat.not_lt_of_ge h_ge) hi)
  simpa [finiteOrbitProduct_fourCycleOrbit, mul_assoc] using h_general

theorem q042_first_candidate_period_three_cycle_relation_exponent
    {G : Type _} [Group G] {s x y z : G}
