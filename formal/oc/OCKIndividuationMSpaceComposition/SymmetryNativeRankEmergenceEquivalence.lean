import OCKIndividuationMSpaceComposition.SymmetryNativeIntrinsicDimensionBridge
import Mathlib.Tactic

namespace OCKIndividuationMSpaceComposition

universe uIndex uCarrier

namespace PrimitiveDistinction

namespace DisjointDistinctionFamily

variable {Index : Type uIndex} {Carrier : Type uCarrier}
variable [Fintype Index] [DecidableEq Index]
variable [Fintype Carrier] [DecidableEq Carrier]

/-!
# Exact native rank-birth criterion

The generic finite-rank theorem gives a one-way implication from
non-generation to rank growth.  For the native closure generated by actual
pair swaps of a pairwise-disjoint family, the closure normal form is exactly
the seed.  That lets us close the converse as well: a candidate raises rank
by one exactly when it is not already generated.

This is the strongest dimension-birth statement justified by this native
model.  It is not exported as a theorem about arbitrary OC compositions;
outside this realised disjoint family, the composition/closure and exchange
premises remain separate scientific obligations.
-/

theorem nativeReversal_rank_insert_eq_rank_of_generated
    (family : DisjointDistinctionFamily Index Carrier)
    (seed : Finset Index) (index : Index)
    (generated : index ∈ family.nativeReversalClosure seed) :
    (family.nativeReversalFinitaryClosure).rank (insert index seed) =
      (family.nativeReversalFinitaryClosure).rank seed := by
  have indexMember : index ∈ seed := by
    rw [← family.nativeReversalClosure_eq_seed seed]
    exact generated
  rw [Finset.insert_eq_of_mem indexMember]

theorem nativeReversal_rank_birth_iff_not_in_native_closure
    (family : DisjointDistinctionFamily Index Carrier)
    (seed : Finset Index) (index : Index) :
    (family.nativeReversalFinitaryClosure).rank (insert index seed) =
        (family.nativeReversalFinitaryClosure).rank seed + 1 ↔
      index ∉ family.nativeReversalClosure seed := by
  constructor
  · intro growth generated
    have indexMember : index ∈ seed := by
      rw [← family.nativeReversalClosure_eq_seed seed]
      exact generated
    rw [Finset.insert_eq_of_mem indexMember] at growth
    omega
  · intro notGenerated
    have notMember : index ∉ seed := by
      intro indexMember
      apply notGenerated
      rw [family.nativeReversalClosure_eq_seed seed]
      exact indexMember
    exact family.nativeReversalFinitaryClosure_rank_insert_eq_add_one_of_not_mem
      seed index notMember

end DisjointDistinctionFamily

end PrimitiveDistinction

end OCKIndividuationMSpaceComposition
