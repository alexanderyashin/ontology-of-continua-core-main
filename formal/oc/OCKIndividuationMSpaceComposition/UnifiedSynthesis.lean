import OCKIndividuationMSpaceComposition.ConstitutiveBridge
import OCKIndividuationMSpaceComposition.StrongestUniversalization
import OCKIndividuationMSpaceComposition.UniversalDynamics

namespace OCKIndividuationMSpaceComposition

open OCMaturityCompletionCycle

universe
  uIndex uChild uParent uOccurrence uView

/-!
# Minimal semantic seams for the general synthesis

This module does not introduce a new K ontology and does not redefine M-space.
It packages two bridges that were previously only adjacent in the corpus:

1. evidence-respecting occurrence presentations descend uniquely to the
   operational identity quotient; and
2. an explicitly realized constitutive seed generates a discrete deterministic
   reachability envelope whose endpoints remain realized and admissible.

The second construction is a neutral reachability layer.  It is not an
identification with historical M-space, and it does not cover branching,
stochastic path measures or physical boundary histories.
-/

/--
A projection of occurrences that is constant on the supplied evidence edges.
The equivalence closure generated by those edges is handled by the existing
operational-token quotient theorem.
-/
structure OperationalProjectionContract
    {Occurrence : Type uOccurrence}
    (evidence : BinaryRelation Occurrence)
    (View : Type uView) where
  project : Occurrence → View
  respectsEvidence : ∀ ⦃left right⦄,
    evidence left right → project left = project right

/-- An evidence-respecting projection has one and only one token-level lift. -/
theorem operationalProjection_existsUnique
    {Occurrence : Type uOccurrence}
    {evidence : BinaryRelation Occurrence}
    {View : Type uView}
    (contract : OperationalProjectionContract evidence View) :
    ∃! lifted : OperationalToken evidence → View,
      ∀ occurrence,
        lifted (operationalTokenOf evidence occurrence) =
          contract.project occurrence :=
  operationalToken_lift_unique
    contract.project contract.respectsEvidence

/--
An explicit presentation connecting occurrences to constitutive child
configurations and parent states.  Both maps must respect the same evidence
used to generate operational identity.  This is a seam contract, not a theorem
that every object supplies such a presentation.
-/
structure OperationalConstitutionPresentation
    {Occurrence : Type uOccurrence}
    (evidence : BinaryRelation Occurrence)
    {Index : Type uIndex}
    {ChildState : Index → Type uChild}
    {ParentState : Type uParent}
    (bridge : ConstitutiveBridge Index ChildState ParentState) where
  configurationOf : Occurrence → JointConfiguration Index ChildState
  parentOf : Occurrence → ParentState
  realizes : ∀ occurrence,
    bridge.realizes (configurationOf occurrence) (parentOf occurrence)
  configurationRespectsEvidence : ∀ ⦃left right⦄,
    evidence left right → configurationOf left = configurationOf right
  parentRespectsEvidence : ∀ ⦃left right⦄,
    evidence left right → parentOf left = parentOf right

/-- Every presented occurrence has an available realized parent fiber. -/
theorem OperationalConstitutionPresentation.parentAvailable
    {Occurrence : Type uOccurrence}
    {evidence : BinaryRelation Occurrence}
    {Index : Type uIndex}
    {ChildState : Index → Type uChild}
    {ParentState : Type uParent}
    {bridge : ConstitutiveBridge Index ChildState ParentState}
    (presentation : OperationalConstitutionPresentation evidence bridge)
    (occurrence : Occurrence) :
    ParentConfigurationAvailable bridge (presentation.parentOf occurrence) := by
  exact ⟨
    ⟨presentation.configurationOf occurrence,
      presentation.realizes occurrence⟩⟩

/--
The child configuration and parent state both descend uniquely to operational
identity tokens when the presentation respects evidence.
-/
theorem OperationalConstitutionPresentation.descendsToOperationalToken
    {Occurrence : Type uOccurrence}
    {evidence : BinaryRelation Occurrence}
    {Index : Type uIndex}
    {ChildState : Index → Type uChild}
    {ParentState : Type uParent}
    {bridge : ConstitutiveBridge Index ChildState ParentState}
    (presentation : OperationalConstitutionPresentation evidence bridge) :
    (∃! configurationOfToken :
        OperationalToken evidence → JointConfiguration Index ChildState,
      ∀ occurrence,
        configurationOfToken (operationalTokenOf evidence occurrence) =
          presentation.configurationOf occurrence) ∧
    (∃! parentOfToken : OperationalToken evidence → ParentState,
      ∀ occurrence,
        parentOfToken (operationalTokenOf evidence occurrence) =
          presentation.parentOf occurrence) := by
  constructor
  · exact operationalToken_lift_unique
      presentation.configurationOf
      presentation.configurationRespectsEvidence
  · exact operationalToken_lift_unique
      presentation.parentOf
      presentation.parentRespectsEvidence

/-- One explicitly realized starting point for constitutive dynamics. -/
structure ConstitutiveSeed
    {Index : Type uIndex}
    {ChildState : Index → Type uChild}
    {ParentState : Type uParent}
    (bridge : ConstitutiveBridge Index ChildState ParentState) where
  configuration : JointConfiguration Index ChildState
  parent : ParentState
  realizes : bridge.realizes configuration parent

/--
Finite discrete reachability generated by repeated application of one
constitutive transition.  The predicate records endpoint reachability and does
not erase the realization proof carried by the seed and transition.
-/
inductive ConstitutiveReachable
    {Index : Type uIndex}
    {ChildState : Index → Type uChild}
    {ParentState : Type uParent}
    {bridge : ConstitutiveBridge Index ChildState ParentState}
    (transition : ConstitutiveTransition bridge)
    (seed : ConstitutiveSeed bridge) :
    JointConfiguration Index ChildState → ParentState → Prop
  | base : ConstitutiveReachable transition seed
      seed.configuration seed.parent
  | step {configuration parent} :
      ConstitutiveReachable transition seed configuration parent →
      ConstitutiveReachable transition seed
        (fun index => transition.childStep index (configuration index))
        (transition.parentStep parent)

/-- Every reachable endpoint still realizes its parent. -/
theorem constitutiveReachable_realizes
    {Index : Type uIndex}
    {ChildState : Index → Type uChild}
    {ParentState : Type uParent}
    {bridge : ConstitutiveBridge Index ChildState ParentState}
    (transition : ConstitutiveTransition bridge)
    (seed : ConstitutiveSeed bridge)
    {configuration : JointConfiguration Index ChildState}
    {parent : ParentState}
    (reachable : ConstitutiveReachable transition seed configuration parent) :
    bridge.realizes configuration parent := by
  induction reachable with
  | base => exact seed.realizes
  | step previous inductionHypothesis =>
      exact transition.preserves inductionHypothesis

/-- Every reachable endpoint is constitutively admissible. -/
theorem constitutiveReachable_admissible
    {Index : Type uIndex}
    {ChildState : Index → Type uChild}
    {ParentState : Type uParent}
    {bridge : ConstitutiveBridge Index ChildState ParentState}
    (transition : ConstitutiveTransition bridge)
    (seed : ConstitutiveSeed bridge)
    {configuration : JointConfiguration Index ChildState}
    {parent : ParentState}
    (reachable : ConstitutiveReachable transition seed configuration parent) :
    bridge.admissible configuration :=
  bridge.realizes_admissible
    (constitutiveReachable_realizes transition seed reachable)

/-- The neutral endpoint envelope generated by the seed and transition. -/
def ConstitutiveReachabilityEnvelope
    {Index : Type uIndex}
    {ChildState : Index → Type uChild}
    {ParentState : Type uParent}
    {bridge : ConstitutiveBridge Index ChildState ParentState}
    (transition : ConstitutiveTransition bridge)
    (seed : ConstitutiveSeed bridge) :=
  {endpoint : JointConfiguration Index ChildState × ParentState //
    ConstitutiveReachable transition seed endpoint.1 endpoint.2}

/-- A reached endpoint supplies constructive availability of its parent fiber. -/
theorem reachabilityEnvelope_parentAvailable
    {Index : Type uIndex}
    {ChildState : Index → Type uChild}
    {ParentState : Type uParent}
    {bridge : ConstitutiveBridge Index ChildState ParentState}
    (transition : ConstitutiveTransition bridge)
    (seed : ConstitutiveSeed bridge)
    (endpoint : ConstitutiveReachabilityEnvelope transition seed) :
    ParentConfigurationAvailable bridge endpoint.1.2 := by
  exact ⟨
    ⟨endpoint.1.1,
      constitutiveReachable_realizes transition seed endpoint.2⟩⟩

end OCKIndividuationMSpaceComposition
