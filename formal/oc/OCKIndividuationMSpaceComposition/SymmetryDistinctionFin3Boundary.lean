import OCKIndividuationMSpaceComposition.SymmetryPrimitiveDistinctionExtension
import Mathlib.Data.Fin.Basic
import Mathlib.Data.Fintype.Basic
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.NormNum

namespace OCKIndividuationMSpaceComposition

/-!
# A finite countermodel to unconditional global C₂ emergence

The local two-point axis generated by a primitive distinction always carries
the derived C₂ action.  This module proves that the action cannot in general be
promoted to the whole ambient carrier: `Fin 3` contains a primitive distinction
but admits no fixed-point-free involution at all.

This is stronger than observing that the canonical pair transposition fixes a
third point.  It rules out every possible global fixed-point-free involution on
the countermodel, so no theorem from bare primitive distinction to global C₂
can hold without an additional premise excluding or pairing the complement.
-/

/-- A primitive distinction embedded in a three-point carrier. -/
def finThreePrimitiveDistinction : PrimitiveDistinction (Fin 3) where
  first := 0
  second := 1
  separated := by decide

/-- No fixed-point-free involution exists on a three-element carrier. -/
theorem noFixedPointFreeInvolutionFinThree :
    ¬ Nonempty (FixedPointFreeInvolution (Fin 3)) := by
  rintro ⟨symmetry⟩
  have actionInjective : Function.Injective symmetry.action :=
    symmetry.action.injective
  generalize atZero : symmetry.action 0 = imageZero
  fin_cases imageZero
  · exact symmetry.fixedPointFree 0 atZero
  · have atOne : symmetry.action 1 = 0 := by
      have recovered := symmetry.involutive 0
      rw [atZero] at recovered
      simpa using recovered
    generalize atTwo : symmetry.action 2 = imageTwo
    fin_cases imageTwo
    · have impossible : (2 : Fin 3) = 1 :=
        actionInjective (atTwo.trans atOne.symm)
      have values := congrArg Fin.val impossible
      norm_num at values
    · have impossible : (2 : Fin 3) = 0 :=
        actionInjective (atTwo.trans atZero.symm)
      have values := congrArg Fin.val impossible
      norm_num at values
    · exact symmetry.fixedPointFree 2 atTwo
  · have atTwo : symmetry.action 2 = 0 := by
      have recovered := symmetry.involutive 0
      rw [atZero] at recovered
      simpa using recovered
    generalize atOne : symmetry.action 1 = imageOne
    fin_cases imageOne
    · have impossible : (1 : Fin 3) = 2 :=
        actionInjective (atOne.trans atTwo.symm)
      have values := congrArg Fin.val impossible
      norm_num at values
    · exact symmetry.fixedPointFree 1 atOne
    · have impossible : (1 : Fin 3) = 0 :=
        actionInjective (atOne.trans atZero.symm)
      have values := congrArg Fin.val impossible
      norm_num at values

/-- Bare primitive distinction therefore cannot imply a global free
involution uniformly over ambient carriers. -/
theorem primitiveDistinction_does_not_force_globalFreeInvolution :
    Nonempty (PrimitiveDistinction (Fin 3)) ∧
      ¬ Nonempty (FixedPointFreeInvolution (Fin 3)) :=
  ⟨⟨finThreePrimitiveDistinction⟩,
    noFixedPointFreeInvolutionFinThree⟩

/-- The same countermodel still has the fully derived local C₂ torsor on its
generated two-point axis. -/
noncomputable def finThreeLocalR3Torsor :
    R3C2OrientationTorsorInterface
      finThreePrimitiveDistinction.Axis Unit Unit :=
  finThreePrimitiveDistinction.toR3Torsor

/-- The canonical ambient pair swap exposes the obstruction concretely by
fixing the third point. -/
theorem finThreePairSwap_fixesThird :
    finThreePrimitiveDistinction.pairSwap 2 = 2 := by
  exact finThreePrimitiveDistinction.pairSwap_outside 2 (by decide) (by decide)

/-- Consequently the distinguished pair does not cover the carrier. -/
theorem finThreeDistinction_not_covering :
    ¬ finThreePrimitiveDistinction.CoversCarrier := by
  intro covers
  rcases covers 2 with first | second
  · have values := congrArg Fin.val first
    norm_num [finThreePrimitiveDistinction] at values
  · have values := congrArg Fin.val second
    norm_num [finThreePrimitiveDistinction] at values

end OCKIndividuationMSpaceComposition
