import OCKIndividuationMSpaceComposition.SymmetryPrimitiveDistinction
import Mathlib.Data.Fin.Basic
import Mathlib.Data.Fintype.Fin
import Mathlib.Data.Finset.Card
import Mathlib.Tactic.FinCases

namespace OCKIndividuationMSpaceComposition

namespace IntrinsicDimensionBoundary

/-!
# Why closure alone does not yet produce intrinsic dimension

OC already contains least generated closures, notably `GeneratedKernel` and
equivalence closure.  It is therefore natural to test whether an abstract
closure of distinction tokens is enough to define dimension as the cardinality
of a maximal irreducible family.

This finite countermodel answers no.  The closure below is extensive,
monotone and idempotent.  Nevertheless it has two inclusion-maximal independent
families with different cardinalities.  Thus the ordinary closure laws do not
make "number of independent distinctions" an invariant.  A further exchange
law, or another premise strong enough to imply exchange, is genuinely missing.

No vectors, coordinates, bases, matroids or finrank occur in the definitions.
-/

/-- The three abstract distinction tokens in the countermodel. -/
abbrev Token := Fin 3

/-- Token `0` generates the entire finite distinction family; otherwise a
seed family generates only itself. -/
def fanClosure (seed : Finset Token) : Finset Token :=
  if (0 : Token) ∈ seed then Finset.univ else seed

/-- Extensivity, expressed without importing any linear abstraction. -/
def ClosureExtensive (closure : Finset Token → Finset Token) : Prop :=
  ∀ seed, seed ⊆ closure seed

/-- Monotonicity of generation. -/
def ClosureMonotone (closure : Finset Token → Finset Token) : Prop :=
  ∀ ⦃first second⦄, first ⊆ second → closure first ⊆ closure second

/-- Closing an already closed family changes nothing. -/
def ClosureIdempotent (closure : Finset Token → Finset Token) : Prop :=
  ∀ seed, closure (closure seed) = closure seed

/-- A family is closure-independent when none of its members is generated by
the remaining members. -/
def ClosureIndependent (closure : Finset Token → Finset Token)
    (family : Finset Token) : Prop :=
  ∀ token ∈ family, token ∉ closure (family.erase token)

/-- Add-one maximality is the exact finite notion needed here. -/
def ClosureMaximalIndependent (closure : Finset Token → Finset Token)
    (family : Finset Token) : Prop :=
  ClosureIndependent closure family ∧
    ∀ token ∉ family, ¬ ClosureIndependent closure (insert token family)

theorem fanClosure_extensive : ClosureExtensive fanClosure := by
  intro seed
  by_cases generatesAll : (0 : Token) ∈ seed
  · simp [fanClosure, generatesAll]
  · simp [fanClosure, generatesAll]

theorem fanClosure_monotone : ClosureMonotone fanClosure := by
  intro first second subset
  by_cases firstGeneratesAll : (0 : Token) ∈ first
  · have secondGeneratesAll : (0 : Token) ∈ second := subset firstGeneratesAll
    simp [fanClosure, firstGeneratesAll, secondGeneratesAll]
  · by_cases secondGeneratesAll : (0 : Token) ∈ second
    · simp [fanClosure, firstGeneratesAll, secondGeneratesAll]
    · simpa [fanClosure, firstGeneratesAll, secondGeneratesAll] using subset

theorem fanClosure_idempotent : ClosureIdempotent fanClosure := by
  intro seed
  by_cases generatesAll : (0 : Token) ∈ seed
  · simp [fanClosure, generatesAll]
  · simp [fanClosure, generatesAll]

/-- The generating token alone is a maximal independent family. -/
theorem fanClosure_singleton_zero_maximal :
    ClosureMaximalIndependent fanClosure {0} := by
  constructor
  · intro token tokenMember
    have tokenZero : token = 0 := by simpa using tokenMember
    subst token
    simp [fanClosure]
  · intro token tokenNotMember independent
    fin_cases token
    · simp at tokenNotMember
    · have generated := independent 1 (by simp)
      exact generated (by simp [fanClosure])
    · have generated := independent 2 (by simp)
      exact generated (by simp [fanClosure])

/-- The two non-generating tokens also form a maximal independent family. -/
theorem fanClosure_pair_one_two_maximal :
    ClosureMaximalIndependent fanClosure {1, 2} := by
  constructor
  · intro token tokenMember
    fin_cases token <;> simp [fanClosure] at tokenMember ⊢
  · intro token tokenNotMember independent
    fin_cases token
    · have generated := independent 1 (by simp)
      exact generated (by simp [fanClosure])
    · simp at tokenNotMember
    · simp at tokenNotMember

theorem fanClosure_maximal_cardinalities_differ :
    ({0} : Finset Token).card ≠ ({1, 2} : Finset Token).card := by
  decide

/-- Exact impossibility theorem: even all three ordinary closure laws do not
make maximal-independent cardinality unique.  Hence intrinsic OC dimension
cannot yet be defined as that cardinality from closure alone. -/
theorem closure_laws_do_not_force_wellDefined_rank :
    ∃ closure : Finset Token → Finset Token,
      ClosureExtensive closure ∧
      ClosureMonotone closure ∧
      ClosureIdempotent closure ∧
      ∃ first second : Finset Token,
        ClosureMaximalIndependent closure first ∧
        ClosureMaximalIndependent closure second ∧
        first.card ≠ second.card := by
  exact ⟨fanClosure, fanClosure_extensive, fanClosure_monotone,
    fanClosure_idempotent, {0}, {1, 2},
    fanClosure_singleton_zero_maximal,
    fanClosure_pair_one_two_maximal,
    fanClosure_maximal_cardinalities_differ⟩

/-- Steinitz-style exchange is stated as a candidate missing premise, not
assumed as part of distinction. -/
def ClosureExchange (closure : Finset Token → Finset Token) : Prop :=
  ∀ seed first second,
    first ∈ closure (insert second seed) →
    first ∉ closure seed →
    second ∈ closure (insert first seed)

/-- The countermodel fails exchange.  This pinpoints why its maximal
independent families can have different sizes. -/
theorem fanClosure_fails_exchange : ¬ ClosureExchange fanClosure := by
  intro exchange
  have impossible := exchange ∅ (1 : Token) (0 : Token)
    (by simp [fanClosure]) (by simp [fanClosure])
  simpa [fanClosure] using impossible

end IntrinsicDimensionBoundary

end OCKIndividuationMSpaceComposition
