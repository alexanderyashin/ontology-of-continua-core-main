import OCKIndividuationMSpaceComposition.SymmetryIntrinsicFinitaryRank
import OCKIndividuationMSpaceComposition.SymmetryExchangeAugmentation
import Mathlib.Tactic

namespace OCKIndividuationMSpaceComposition

namespace IntrinsicFinitaryRank

open IntrinsicComponentRank
open IntrinsicDimensionExchangeAugmentation

/-!
# Exact rank of the finite joint-generation witness

The triangle closure is the smallest concrete exchange model in the corpus
with genuine two-source generation.  This module computes its rank exactly:
two roots are independent and have rank two, while the third point is already
generated by that pair and therefore adds no rank.  The result makes the
joint-generation countermodel quantitative instead of leaving it as a purely
qualitative obstruction.
-/

theorem triangle_pair_independent :
    triangleFinitaryClosure.Independent ({0, 1} : Finset TriangleToken) := by
  intro token tokenMember
  fin_cases token <;>
    simp [triangleFinitaryClosure, triangleClosure] at tokenMember ⊢

theorem triangle_rank_pair :
    triangleFinitaryClosure.rank ({0, 1} : Finset TriangleToken) = 2 := by
  rw [rank_eq_card_of_independent
    triangleFinitaryClosure triangle_pair_independent]
  decide

theorem triangle_third_generated_by_pair :
    (2 : TriangleToken) ∈
      triangleFinitaryClosure.close ({0, 1} : Finset TriangleToken) := by
  simp [triangleFinitaryClosure, triangleClosure]

theorem triangle_rank_pair_with_generated_third :
    triangleFinitaryClosure.rank
        (insert (2 : TriangleToken) ({0, 1} : Finset TriangleToken)) = 2 := by
  rw [rank_insert_eq_of_generated triangleFinitaryClosure
    ({0, 1} : Finset TriangleToken) 2 triangle_third_generated_by_pair,
    triangle_rank_pair]

theorem triangle_insert_third_does_not_raise_rank :
    triangleFinitaryClosure.rank
        (insert (2 : TriangleToken) ({0, 1} : Finset TriangleToken)) =
      triangleFinitaryClosure.rank ({0, 1} : Finset TriangleToken) := by
  rw [triangle_rank_pair_with_generated_third, triangle_rank_pair]

theorem triangle_rank_univ :
    triangleFinitaryClosure.rank (Finset.univ : Finset TriangleToken) = 2 := by
  have insert_eq_univ :
      insert (2 : TriangleToken) ({0, 1} : Finset TriangleToken) =
        (Finset.univ : Finset TriangleToken) := by
    ext token
    fin_cases token <;> simp
  rw [← insert_eq_univ]
  exact triangle_rank_pair_with_generated_third

theorem triangle_joint_generation_rank_boundary :
    (2 : TriangleToken) ∈ triangleClosure ({0, 1} : Finset TriangleToken) ∧
    (2 : TriangleToken) ∉ triangleClosure ({0} : Finset TriangleToken) ∧
    (2 : TriangleToken) ∉ triangleClosure ({1} : Finset TriangleToken) ∧
    triangleFinitaryClosure.rank ({0, 1} : Finset TriangleToken) = 2 ∧
    triangleFinitaryClosure.rank (Finset.univ : Finset TriangleToken) = 2 := by
  exact ⟨by simp [triangleClosure],
    by simp [triangleClosure],
    by simp [triangleClosure],
    triangle_rank_pair,
    triangle_rank_univ⟩

end IntrinsicFinitaryRank

end OCKIndividuationMSpaceComposition
