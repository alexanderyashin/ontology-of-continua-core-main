import OCKIndividuationMSpaceComposition.SymmetryIntrinsicFinitaryRank
import Mathlib.Algebra.Group.Subgroup.Lattice

namespace OCKIndividuationMSpaceComposition

namespace BooleanCompositionRank

/-!
# Exchange and rank from reversible Boolean composition

This module identifies a concrete algebraic point at which relative closure
rank can emerge.  The tokens are admissible reversible transformations.
Composition is assumed total, associative, commutative and unital, and every
transformation self-cancels.  These hypotheses describe an elementary Boolean
composition law without importing vectors, coordinates, matroids or
`finrank`.

The hypotheses are substantive.  A generic family of OC distinctions has not
yet been proved to carry this composition.  The result is therefore a bounded
finite-universe Boolean-subgroup realization theorem: once admissible
reversals compose in this way, subgroup generation gives a closure satisfying
exchange, and the previous finite-family rank theorem applies.  The interface
is sufficient, not claimed proof-theoretically minimal: `CommGroup` provides
inverse structure that follows from a weaker commutative monoid plus
self-cancellation, and `Fintype Token` is used to materialize the whole
generated subgroup as a `Finset`.
-/

universe uToken

/-- A commutative reversible composition in which every element is its own
inverse.  Extending `CommGroup` exposes that composition is total and
reversible; `self_cancel` exposes the exponent-two premise rather than hiding
it in a vector-space interface.  This sufficient interface is deliberately
not labelled minimal. -/
class BooleanComposition (Token : Type uToken) extends CommGroup Token where
  self_cancel : ∀ token : Token, token * token = 1

variable {Token : Type uToken} [DecidableEq Token] [Fintype Token]
variable [BooleanComposition Token]

/-- In a Boolean composition every admissible transformation is its own
inverse. -/
theorem boolean_inv_eq_self (token : Token) : token⁻¹ = token := by
  calc
    token⁻¹ = token⁻¹ * 1 := (mul_one token⁻¹).symm
    _ = token⁻¹ * (token * token) := by
      rw [BooleanComposition.self_cancel]
    _ = (token⁻¹ * token) * token := by rw [mul_assoc]
    _ = token := by simp

/-- The subgroup generated by one Boolean-composition element contains only
the identity and that element.  This is the explicit parity step used by the
exchange proof. -/
theorem closure_singleton_cases
    (generator element : Token)
    (generated : element ∈ Subgroup.closure ({generator} : Set Token)) :
    element = 1 ∨ element = generator := by
  induction generated using Subgroup.closure_induction with
  | mem current currentMember =>
      right
      simpa using currentMember
  | one => exact Or.inl rfl
  | mul first second _ _ firstCases secondCases =>
      rcases firstCases with firstOne | firstGenerator <;>
        rcases secondCases with secondOne | secondGenerator
      · left
        simp [firstOne, secondOne]
      · right
        simp [firstOne, secondGenerator]
      · right
        simp [firstGenerator, secondOne]
      · left
        simp [firstGenerator, secondGenerator,
          BooleanComposition.self_cancel]
  | inv current _ currentCases =>
      rcases currentCases with currentOne | currentGenerator
      · left
        simp [currentOne]
      · right
        simpa [currentGenerator] using boolean_inv_eq_self generator

/-- Finite readback of the subgroup generated by a finite family of
admissible reversals.  Finiteness is used only to materialize the closure as a
`Finset` for the existing finite-family rank interface. -/
noncomputable def generatedClose (seed : Finset Token) : Finset Token := by
  classical
  exact Finset.univ.filter
    (fun token => token ∈ Subgroup.closure (↑seed : Set Token))

@[simp]
theorem mem_generatedClose {seed : Finset Token} {token : Token} :
    token ∈ generatedClose seed ↔
      token ∈ Subgroup.closure (↑seed : Set Token) := by
  classical
  simp [generatedClose]

theorem generatedClose_extensive (seed : Finset Token) :
    seed ⊆ generatedClose seed := by
  intro token tokenMember
  rw [mem_generatedClose]
  exact Subgroup.subset_closure tokenMember

theorem generatedClose_monotone
    {first second : Finset Token}
    (subset : first ⊆ second) :
    generatedClose first ⊆ generatedClose second := by
  intro token tokenGenerated
  rw [mem_generatedClose] at tokenGenerated ⊢
  exact Subgroup.closure_mono subset tokenGenerated

theorem generatedClose_idempotent (seed : Finset Token) :
    generatedClose (generatedClose seed) = generatedClose seed := by
  classical
  ext token
  rw [mem_generatedClose, mem_generatedClose]
  have carrierEquality :
      (↑(generatedClose seed) : Set Token) =
        Subgroup.closure (↑seed : Set Token) := by
    ext current
    simp
  rw [carrierEquality, Subgroup.closure_eq]

/-- Boolean composition forces the Steinitz-style exchange law.  The proof
does not appeal to a vector space: the decisive step is cancellation of the
single possible occurrence of `second` in the generated two-element factor. -/
theorem generatedClose_exchange
    (seed : Finset Token) (first second : Token)
    (firstGenerated : first ∈ generatedClose (insert second seed))
    (firstNew : first ∉ generatedClose seed) :
    second ∈ generatedClose (insert first seed) := by
  classical
  rw [mem_generatedClose] at firstGenerated firstNew ⊢
  have insertedCarrier :
      (↑(insert second seed) : Set Token) =
        ({second} : Set Token) ∪ (↑seed : Set Token) := by
    ext token
    simp
  rw [insertedCarrier, Subgroup.closure_union,
    Subgroup.mem_sup] at firstGenerated
  rcases firstGenerated with
    ⟨singletonPart, singletonGenerated, seedPart, seedGenerated,
      composition⟩
  rcases closure_singleton_cases second singletonPart singletonGenerated with
    singletonOne | singletonSecond
  · subst singletonPart
    have seedPartEq : seedPart = first := by
      simpa using composition
    have firstInSeedClosure :
        first ∈ Subgroup.closure (↑seed : Set Token) := by
      simpa [seedPartEq] using seedGenerated
    exact False.elim (firstNew firstInSeedClosure)
  · subst singletonPart
    have seedClosureMonotone :
        Subgroup.closure (↑seed : Set Token) ≤
          Subgroup.closure (↑(insert first seed) : Set Token) :=
      Subgroup.closure_mono (by
        intro token tokenMember
        exact Finset.mem_insert_of_mem tokenMember)
    have seedPartTarget :
        seedPart ∈ Subgroup.closure (↑(insert first seed) : Set Token) :=
      seedClosureMonotone seedGenerated
    have firstTarget :
        first ∈ Subgroup.closure (↑(insert first seed) : Set Token) :=
      Subgroup.subset_closure (Finset.mem_insert_self first seed)
    have productTarget :
        first * seedPart ∈
          Subgroup.closure (↑(insert first seed) : Set Token) :=
      Subgroup.mul_mem _ firstTarget seedPartTarget
    have productBack : first * seedPart = second := by
      calc
        first * seedPart = (second * seedPart) * seedPart := by
          rw [composition]
        _ = second * (seedPart * seedPart) := by rw [mul_assoc]
        _ = second := by
          rw [BooleanComposition.self_cancel, mul_one]
    simpa [productBack] using productTarget

/-- The finite generated-subgroup closure induced by Boolean composition. -/
noncomputable def booleanGeneratedClosure :
    IntrinsicFinitaryRank.FinitaryDistinctionClosure Token where
  close := generatedClose
  extensive := generatedClose_extensive
  monotone := by
    intro first second subset
    exact generatedClose_monotone subset
  idempotent := generatedClose_idempotent
  exchange := generatedClose_exchange

/-- In the finite-universe Boolean-subgroup realization, a genuinely new
admissible reversal increases relative generated-composition rank by exactly
one. -/
theorem rank_insert_eq_add_one_of_not_generated
    (seed : Finset Token) (token : Token)
    (notGenerated : token ∉ generatedClose seed) :
    booleanGeneratedClosure.rank (insert token seed) =
      booleanGeneratedClosure.rank seed + 1 := by
  exact booleanGeneratedClosure.rank_insert_eq_add_one_of_not_generated
    seed token (by simpa [booleanGeneratedClosure] using notGenerated)

end BooleanCompositionRank

end OCKIndividuationMSpaceComposition
