import OCKIndividuationMSpaceComposition.SymmetryExchangeAugmentation

namespace OCKIndividuationMSpaceComposition

namespace IntrinsicFinitaryRank

/-!
# Zero rank and the first genuinely new distinction

The finite rank interface has an exact base case that should remain explicit in
the canonical theorem spine.  The empty seed has rank zero.  A singleton has
rank zero precisely when its element is already generated by the empty seed;
otherwise the exchange theorem makes its rank exactly one.

This is the smallest rigorous form of “a new dimension is born”: the word
“new” is the independent non-generation premise, not a renamed field in a
definition.  No global OC dimension or physical interpretation is asserted.
-/

universe uToken

variable {Token : Type uToken} [DecidableEq Token]

/-- The empty observed seed has no nonempty independent subfamily. -/
theorem FinitaryDistinctionClosure.rank_empty_eq_zero
    (closure : FinitaryDistinctionClosure Token) :
    closure.rank ∅ = 0 := by
  classical
  unfold FinitaryDistinctionClosure.rank
  simp

/-- A singleton generated from the empty seed contributes no rank. -/
theorem FinitaryDistinctionClosure.rank_singleton_eq_zero_of_generated_empty
    (closure : FinitaryDistinctionClosure Token) (token : Token)
    (generated : token ∈ closure.close ∅) :
    closure.rank ({token} : Finset Token) = 0 := by
  have rankInsertion :=
    IntrinsicDimensionExchangeAugmentation.rank_insert_eq_of_generated
      closure ∅ token generated
  simpa [closure.rank_empty_eq_zero] using rankInsertion

/-- A singleton whose token is not generated by the empty seed has rank one. -/
theorem FinitaryDistinctionClosure.rank_singleton_eq_one_of_not_generated_empty
    (closure : FinitaryDistinctionClosure Token) (token : Token)
    (notGenerated : token ∉ closure.close ∅) :
    closure.rank ({token} : Finset Token) = 1 := by
  have rankInsertion :=
    closure.rank_insert_eq_add_one_of_not_generated ∅ token notGenerated
  simpa [closure.rank_empty_eq_zero] using rankInsertion

/-- Exact singleton dichotomy: rank one is equivalent to irreducibility from
the empty seed. -/
theorem FinitaryDistinctionClosure.rank_singleton_eq_one_iff_not_generated_empty
    (closure : FinitaryDistinctionClosure Token) (token : Token) :
    closure.rank ({token} : Finset Token) = 1 ↔
      token ∉ closure.close ∅ := by
  constructor
  · intro rankOne generated
    have rankZero :=
      closure.rank_singleton_eq_zero_of_generated_empty token generated
    omega
  · exact closure.rank_singleton_eq_one_of_not_generated_empty token

/-- A singleton has rank exactly zero or one, with the branch determined by the
same generation test; no third value is possible. -/
theorem FinitaryDistinctionClosure.rank_singleton_eq_zero_or_one
    (closure : FinitaryDistinctionClosure Token) (token : Token) :
    closure.rank ({token} : Finset Token) = 0 ∨
      closure.rank ({token} : Finset Token) = 1 := by
  by_cases generated : token ∈ closure.close ∅
  · exact Or.inl
      (closure.rank_singleton_eq_zero_of_generated_empty token generated)
  · exact Or.inr
      (closure.rank_singleton_eq_one_of_not_generated_empty token generated)

end IntrinsicFinitaryRank

end OCKIndividuationMSpaceComposition
