import OCKIndividuationMSpaceComposition.SymmetryPlaneInteraction
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.LinearCombination
import Mathlib.Tactic.Ring

namespace OCKIndividuationMSpaceComposition

universe uValue uLeft uRight

/-!
# Four character layers generated by two independent distinction planes

Two primitive distinctions supply two coordinate reversals.  The product
plane therefore has four one-dimensional characters of the Boolean
two-plane symmetry: even/even, odd/even, even/odd and odd/odd.  This file
does not assume a representation interface or hide the four-state action in
a definition.  It defines the four orbit averages explicitly and proves
their parity and reconstruction laws.  The transported theorem at the end
connects the calculation to the two generated axes from
`SymmetryPlaneInteraction`.

The division by four is deliberate: a field of characteristic zero is the
minimal scalar hypothesis used by this normalized decomposition.  In
characteristic two the unnormalised orbit sums remain available elsewhere,
but these four projections are not asserted to split the observable.
-/

section BooleanTwoPlane

/-- Reversal of the first Boolean coordinate. -/
def boolFlipFirst : Bool × Bool → Bool × Bool :=
  fun point => (Bool.not point.1, point.2)

/-- Reversal of the second Boolean coordinate. -/
def boolFlipSecond : Bool × Bool → Bool × Bool :=
  fun point => (point.1, Bool.not point.2)

@[simp] theorem boolFlipFirst_involutive (point : Bool × Bool) :
    boolFlipFirst (boolFlipFirst point) = point := by
  rcases point with ⟨first, second⟩
  cases first <;> cases second <;> rfl

@[simp] theorem boolFlipSecond_involutive (point : Bool × Bool) :
    boolFlipSecond (boolFlipSecond point) = point := by
  rcases point with ⟨first, second⟩
  cases first <;> cases second <;> rfl

theorem boolFlipFirst_second_commute (point : Bool × Bool) :
    boolFlipFirst (boolFlipSecond point) =
      boolFlipSecond (boolFlipFirst point) := by
  cases point <;> rfl

/-- The invariant/invariant character projection. -/
def boolEvenEvenPart {Value : Type uValue} [Field Value] [CharZero Value]
    (observable : Bool × Bool → Value) (point : Bool × Bool) : Value :=
  (observable point + observable (boolFlipFirst point) +
      observable (boolFlipSecond point) +
      observable (boolFlipFirst (boolFlipSecond point))) / 4

/-- The first-odd, second-even character projection. -/
def boolOddEvenPart {Value : Type uValue} [Field Value] [CharZero Value]
    (observable : Bool × Bool → Value) (point : Bool × Bool) : Value :=
  (observable point - observable (boolFlipFirst point) +
      observable (boolFlipSecond point) -
      observable (boolFlipFirst (boolFlipSecond point))) / 4

/-- The first-even, second-odd character projection. -/
def boolEvenOddPart {Value : Type uValue} [Field Value] [CharZero Value]
    (observable : Bool × Bool → Value) (point : Bool × Bool) : Value :=
  (observable point + observable (boolFlipFirst point) -
      observable (boolFlipSecond point) -
      observable (boolFlipFirst (boolFlipSecond point))) / 4

/-- The odd/odd character projection. -/
def boolOddOddPart {Value : Type uValue} [Field Value] [CharZero Value]
    (observable : Bool × Bool → Value) (point : Bool × Bool) : Value :=
  (observable point - observable (boolFlipFirst point) -
      observable (boolFlipSecond point) +
      observable (boolFlipFirst (boolFlipSecond point))) / 4

/-- The four normalized character layers reconstruct every observable. -/
theorem bool_character_parts_sum
    {Value : Type uValue} [Field Value] [CharZero Value]
    (observable : Bool × Bool → Value) (point : Bool × Bool) :
    boolEvenEvenPart observable point +
        boolOddEvenPart observable point +
        boolEvenOddPart observable point +
        boolOddOddPart observable point = observable point := by
  unfold boolEvenEvenPart boolOddEvenPart boolEvenOddPart boolOddOddPart
  field_simp
  ring

/-- The even/even layer is invariant under both coordinate reversals. -/
theorem boolEvenEvenPart_flipFirst
    {Value : Type uValue} [Field Value] [CharZero Value]
    (observable : Bool × Bool → Value) (point : Bool × Bool) :
    boolEvenEvenPart observable (boolFlipFirst point) =
      boolEvenEvenPart observable point := by
  rcases point with ⟨first, second⟩
  cases first <;> cases second <;>
    simp [boolEvenEvenPart, boolFlipFirst, boolFlipSecond] <;> ring

theorem boolEvenEvenPart_flipSecond
    {Value : Type uValue} [Field Value] [CharZero Value]
    (observable : Bool × Bool → Value) (point : Bool × Bool) :
    boolEvenEvenPart observable (boolFlipSecond point) =
      boolEvenEvenPart observable point := by
  rcases point with ⟨first, second⟩
  cases first <;> cases second <;>
    simp [boolEvenEvenPart, boolFlipFirst, boolFlipSecond] <;> ring

/-- The first-odd/second-even layer changes sign only under first reversal. -/
theorem boolOddEvenPart_flipFirst
    {Value : Type uValue} [Field Value] [CharZero Value]
    (observable : Bool × Bool → Value) (point : Bool × Bool) :
    boolOddEvenPart observable (boolFlipFirst point) =
      - boolOddEvenPart observable point := by
  rcases point with ⟨first, second⟩
  cases first <;> cases second <;>
    simp [boolOddEvenPart, boolFlipFirst, boolFlipSecond] <;> ring

theorem boolOddEvenPart_flipSecond
    {Value : Type uValue} [Field Value] [CharZero Value]
    (observable : Bool × Bool → Value) (point : Bool × Bool) :
    boolOddEvenPart observable (boolFlipSecond point) =
      boolOddEvenPart observable point := by
  rcases point with ⟨first, second⟩
  cases first <;> cases second <;>
    simp [boolOddEvenPart, boolFlipFirst, boolFlipSecond] <;> ring

/-- The first-even/second-odd layer changes sign only under second reversal. -/
theorem boolEvenOddPart_flipFirst
    {Value : Type uValue} [Field Value] [CharZero Value]
    (observable : Bool × Bool → Value) (point : Bool × Bool) :
    boolEvenOddPart observable (boolFlipFirst point) =
      boolEvenOddPart observable point := by
  rcases point with ⟨first, second⟩
  cases first <;> cases second <;>
    simp [boolEvenOddPart, boolFlipFirst, boolFlipSecond] <;> ring

theorem boolEvenOddPart_flipSecond
    {Value : Type uValue} [Field Value] [CharZero Value]
    (observable : Bool × Bool → Value) (point : Bool × Bool) :
    boolEvenOddPart observable (boolFlipSecond point) =
      - boolEvenOddPart observable point := by
  rcases point with ⟨first, second⟩
  cases first <;> cases second <;>
    simp [boolEvenOddPart, boolFlipFirst, boolFlipSecond] <;> ring

/-- The odd/odd layer changes sign under either coordinate reversal. -/
theorem boolOddOddPart_flipFirst
    {Value : Type uValue} [Field Value] [CharZero Value]
    (observable : Bool × Bool → Value) (point : Bool × Bool) :
    boolOddOddPart observable (boolFlipFirst point) =
      - boolOddOddPart observable point := by
  rcases point with ⟨first, second⟩
  cases first <;> cases second <;>
    simp [boolOddOddPart, boolFlipFirst, boolFlipSecond] <;> ring

theorem boolOddOddPart_flipSecond
    {Value : Type uValue} [Field Value] [CharZero Value]
    (observable : Bool × Bool → Value) (point : Bool × Bool) :
    boolOddOddPart observable (boolFlipSecond point) =
      - boolOddOddPart observable point := by
  rcases point with ⟨first, second⟩
  cases first <;> cases second <;>
    simp [boolOddOddPart, boolFlipFirst, boolFlipSecond] <;> ring

/-- The character projections are the unique parity-respecting decomposition
of an observable.  Thus the four layers are not merely four convenient
formulas: any reconstruction with the same four parity laws has exactly
these components. -/
theorem bool_character_decomposition_unique
    {Value : Type uValue} [Field Value] [CharZero Value]
    (observable evenEven oddEven evenOdd oddOdd : Bool × Bool → Value)
    (reconstruct : ∀ point,
      evenEven point + oddEven point + evenOdd point + oddOdd point =
        observable point)
    (evenEven_first : ∀ point,
      evenEven (boolFlipFirst point) = evenEven point)
    (evenEven_second : ∀ point,
      evenEven (boolFlipSecond point) = evenEven point)
    (oddEven_first : ∀ point,
      oddEven (boolFlipFirst point) = - oddEven point)
    (oddEven_second : ∀ point,
      oddEven (boolFlipSecond point) = oddEven point)
    (evenOdd_first : ∀ point,
      evenOdd (boolFlipFirst point) = evenOdd point)
    (evenOdd_second : ∀ point,
      evenOdd (boolFlipSecond point) = - evenOdd point)
    (oddOdd_first : ∀ point,
      oddOdd (boolFlipFirst point) = - oddOdd point)
    (oddOdd_second : ∀ point,
      oddOdd (boolFlipSecond point) = - oddOdd point) :
    (∀ point, evenEven point = boolEvenEvenPart observable point) ∧
    (∀ point, oddEven point = boolOddEvenPart observable point) ∧
    (∀ point, evenOdd point = boolEvenOddPart observable point) ∧
    (∀ point, oddOdd point = boolOddOddPart observable point) := by
  have decomposition_at : ∀ point,
      evenEven point + oddEven point + evenOdd point + oddOdd point =
        observable point := reconstruct
  constructor
  · intro point
    have h0 := decomposition_at point
    have h1 := decomposition_at (boolFlipFirst point)
    rw [evenEven_first point, oddEven_first point,
      evenOdd_first point, oddOdd_first point] at h1
    have h1' :
        evenEven point - oddEven point + evenOdd point - oddOdd point =
          observable (boolFlipFirst point) := by
      simpa [sub_eq_add_neg] using h1
    have h2 := decomposition_at (boolFlipSecond point)
    rw [evenEven_second point, oddEven_second point,
      evenOdd_second point, oddOdd_second point] at h2
    have h2' :
        evenEven point + oddEven point - evenOdd point - oddOdd point =
          observable (boolFlipSecond point) := by
      simpa [sub_eq_add_neg] using h2
    have h3 := decomposition_at (boolFlipFirst (boolFlipSecond point))
    rw [evenEven_first (boolFlipSecond point),
      evenEven_second point,
      oddEven_first (boolFlipSecond point), oddEven_second point,
      evenOdd_first (boolFlipSecond point), evenOdd_second point,
      oddOdd_first (boolFlipSecond point), oddOdd_second point] at h3
    have h3' :
        evenEven point - oddEven point - evenOdd point + oddOdd point =
          observable (boolFlipFirst (boolFlipSecond point)) := by
      simpa [sub_eq_add_neg] using h3
    change evenEven point =
      (observable point + observable (boolFlipFirst point) +
        observable (boolFlipSecond point) +
        observable (boolFlipFirst (boolFlipSecond point))) / 4
    apply (eq_div_iff (by norm_num : (4 : Value) ≠ 0)).2
    linear_combination h0 + h1' + h2' + h3'
  · constructor
    · intro point
      have h0 := decomposition_at point
      have h1 := decomposition_at (boolFlipFirst point)
      rw [evenEven_first point, oddEven_first point,
        evenOdd_first point, oddOdd_first point] at h1
      have h1' :
          evenEven point - oddEven point + evenOdd point - oddOdd point =
            observable (boolFlipFirst point) := by
        simpa [sub_eq_add_neg] using h1
      have h2 := decomposition_at (boolFlipSecond point)
      rw [evenEven_second point, oddEven_second point,
        evenOdd_second point, oddOdd_second point] at h2
      have h2' :
          evenEven point + oddEven point - evenOdd point - oddOdd point =
            observable (boolFlipSecond point) := by
        simpa [sub_eq_add_neg] using h2
      have h3 := decomposition_at (boolFlipFirst (boolFlipSecond point))
      rw [evenEven_first (boolFlipSecond point),
        evenEven_second point,
        oddEven_first (boolFlipSecond point), oddEven_second point,
        evenOdd_first (boolFlipSecond point), evenOdd_second point,
        oddOdd_first (boolFlipSecond point), oddOdd_second point] at h3
      have h3' :
          evenEven point - oddEven point - evenOdd point + oddOdd point =
            observable (boolFlipFirst (boolFlipSecond point)) := by
        simpa [sub_eq_add_neg] using h3
      change oddEven point =
        (observable point - observable (boolFlipFirst point) +
          observable (boolFlipSecond point) -
          observable (boolFlipFirst (boolFlipSecond point))) / 4
      apply (eq_div_iff (by norm_num : (4 : Value) ≠ 0)).2
      linear_combination h0 - h1' + h2' - h3'
    · constructor
      · intro point
        have h0 := decomposition_at point
        have h1 := decomposition_at (boolFlipFirst point)
        rw [evenEven_first point, oddEven_first point,
          evenOdd_first point, oddOdd_first point] at h1
        have h1' :
            evenEven point - oddEven point + evenOdd point - oddOdd point =
              observable (boolFlipFirst point) := by
          simpa [sub_eq_add_neg] using h1
        have h2 := decomposition_at (boolFlipSecond point)
        rw [evenEven_second point, oddEven_second point,
          evenOdd_second point, oddOdd_second point] at h2
        have h2' :
            evenEven point + oddEven point - evenOdd point - oddOdd point =
              observable (boolFlipSecond point) := by
          simpa [sub_eq_add_neg] using h2
        have h3 := decomposition_at (boolFlipFirst (boolFlipSecond point))
        rw [evenEven_first (boolFlipSecond point),
          evenEven_second point,
          oddEven_first (boolFlipSecond point), oddEven_second point,
          evenOdd_first (boolFlipSecond point), evenOdd_second point,
          oddOdd_first (boolFlipSecond point), oddOdd_second point] at h3
        have h3' :
            evenEven point - oddEven point - evenOdd point + oddOdd point =
              observable (boolFlipFirst (boolFlipSecond point)) := by
          simpa [sub_eq_add_neg] using h3
        change evenOdd point =
          (observable point + observable (boolFlipFirst point) -
            observable (boolFlipSecond point) -
            observable (boolFlipFirst (boolFlipSecond point))) / 4
        apply (eq_div_iff (by norm_num : (4 : Value) ≠ 0)).2
        linear_combination h0 + h1' - h2' - h3'
      · intro point
        have h0 := decomposition_at point
        have h1 := decomposition_at (boolFlipFirst point)
        rw [evenEven_first point, oddEven_first point,
          evenOdd_first point, oddOdd_first point] at h1
        have h1' :
            evenEven point - oddEven point + evenOdd point - oddOdd point =
              observable (boolFlipFirst point) := by
          simpa [sub_eq_add_neg] using h1
        have h2 := decomposition_at (boolFlipSecond point)
        rw [evenEven_second point, oddEven_second point,
          evenOdd_second point, oddOdd_second point] at h2
        have h2' :
            evenEven point + oddEven point - evenOdd point - oddOdd point =
              observable (boolFlipSecond point) := by
          simpa [sub_eq_add_neg] using h2
        have h3 := decomposition_at (boolFlipFirst (boolFlipSecond point))
        rw [evenEven_first (boolFlipSecond point),
          evenEven_second point,
          oddEven_first (boolFlipSecond point), oddEven_second point,
          evenOdd_first (boolFlipSecond point), evenOdd_second point,
          oddOdd_first (boolFlipSecond point), oddOdd_second point] at h3
        have h3' :
            evenEven point - oddEven point - evenOdd point + oddOdd point =
              observable (boolFlipFirst (boolFlipSecond point)) := by
          simpa [sub_eq_add_neg] using h3
        change oddOdd point =
          (observable point - observable (boolFlipFirst point) -
            observable (boolFlipSecond point) +
            observable (boolFlipFirst (boolFlipSecond point))) / 4
        apply (eq_div_iff (by norm_num : (4 : Value) ≠ 0)).2
        linear_combination h0 - h1' - h2' + h3'

end BooleanTwoPlane

section PrimitiveTwoPlane

namespace PrimitiveDistinction

/-- Pull an observable on a generated two-axis plane back to Boolean
coordinates.  The equivalence is the explicit base-relative equivalence
from the two primitive distinctions, not an assumed four-state interface. -/
noncomputable def planeObservableToBool
    {Left : Type uLeft} {Right : Type uRight}
    {Value : Type uValue}
    (left : PrimitiveDistinction Left)
    (right : PrimitiveDistinction Right)
    (observable : PrimitiveDistinctionPlane left right → Value) :
    Bool × Bool → Value :=
  fun coordinate =>
    observable ((left.generatedPlaneEquivBoolProduct right).symm coordinate)

/-- A character projection transported from Boolean coordinates to the
generated product plane. -/
noncomputable def planeEvenEvenPart
    {Left : Type uLeft} {Right : Type uRight}
    {Value : Type uValue} [Field Value] [CharZero Value]
    (left : PrimitiveDistinction Left)
    (right : PrimitiveDistinction Right)
    (observable : PrimitiveDistinctionPlane left right → Value)
    (point : PrimitiveDistinctionPlane left right) : Value :=
  boolEvenEvenPart (planeObservableToBool left right observable)
    (left.generatedPlaneEquivBoolProduct right point)

noncomputable def planeOddEvenPart
    {Left : Type uLeft} {Right : Type uRight}
    {Value : Type uValue} [Field Value] [CharZero Value]
    (left : PrimitiveDistinction Left)
    (right : PrimitiveDistinction Right)
    (observable : PrimitiveDistinctionPlane left right → Value)
    (point : PrimitiveDistinctionPlane left right) : Value :=
  boolOddEvenPart (planeObservableToBool left right observable)
    (left.generatedPlaneEquivBoolProduct right point)

noncomputable def planeEvenOddPart
    {Left : Type uLeft} {Right : Type uRight}
    {Value : Type uValue} [Field Value] [CharZero Value]
    (left : PrimitiveDistinction Left)
    (right : PrimitiveDistinction Right)
    (observable : PrimitiveDistinctionPlane left right → Value)
    (point : PrimitiveDistinctionPlane left right) : Value :=
  boolEvenOddPart (planeObservableToBool left right observable)
    (left.generatedPlaneEquivBoolProduct right point)

noncomputable def planeOddOddPart
    {Left : Type uLeft} {Right : Type uRight}
    {Value : Type uValue} [Field Value] [CharZero Value]
    (left : PrimitiveDistinction Left)
    (right : PrimitiveDistinction Right)
    (observable : PrimitiveDistinctionPlane left right → Value)
    (point : PrimitiveDistinctionPlane left right) : Value :=
  boolOddOddPart (planeObservableToBool left right observable)
    (left.generatedPlaneEquivBoolProduct right point)

/-- The four transported character layers reconstruct the plane observable. -/
theorem plane_character_parts_sum
    {Left : Type uLeft} {Right : Type uRight}
    {Value : Type uValue} [Field Value] [CharZero Value]
    (left : PrimitiveDistinction Left)
    (right : PrimitiveDistinction Right)
    (observable : PrimitiveDistinctionPlane left right → Value)
    (point : PrimitiveDistinctionPlane left right) :
    planeEvenEvenPart left right observable point +
        planeOddEvenPart left right observable point +
        planeEvenOddPart left right observable point +
        planeOddOddPart left right observable point =
      observable point := by
  have decomposition :=
    bool_character_parts_sum
      (planeObservableToBool left right observable)
      (left.generatedPlaneEquivBoolProduct right point)
  simpa [planeEvenEvenPart, planeOddEvenPart, planeEvenOddPart,
    planeOddOddPart, planeObservableToBool] using decomposition

/-- The first coordinate action has the expected character signs on the
transported layers. -/
theorem plane_evenEvenPart_first_invariant
    {Left : Type uLeft} {Right : Type uRight}
    {Value : Type uValue} [Field Value] [CharZero Value]
    (left : PrimitiveDistinction Left)
    (right : PrimitiveDistinction Right)
    (observable : PrimitiveDistinctionPlane left right → Value)
    (point : PrimitiveDistinctionPlane left right) :
    planeEvenEvenPart left right observable
        ((left.firstPlaneInvolution right).action point) =
    planeEvenEvenPart left right observable point := by
  simp only [planeEvenEvenPart]
  rw [generatedPlane_first_coordinate_reversal]
  exact boolEvenEvenPart_flipFirst
    (planeObservableToBool left right observable)
    (left.generatedPlaneEquivBoolProduct right point)

theorem plane_evenEvenPart_second_invariant
    {Left : Type uLeft} {Right : Type uRight}
    {Value : Type uValue} [Field Value] [CharZero Value]
    (left : PrimitiveDistinction Left)
    (right : PrimitiveDistinction Right)
    (observable : PrimitiveDistinctionPlane left right → Value)
    (point : PrimitiveDistinctionPlane left right) :
    planeEvenEvenPart left right observable
        ((left.secondPlaneInvolution right).action point) =
      planeEvenEvenPart left right observable point := by
  simp only [planeEvenEvenPart]
  rw [generatedPlane_second_coordinate_reversal]
  exact boolEvenEvenPart_flipSecond
    (planeObservableToBool left right observable)
    (left.generatedPlaneEquivBoolProduct right point)

/-- The odd/even layer is the first-coordinate odd character. -/
theorem plane_oddEvenPart_first_odd
    {Left : Type uLeft} {Right : Type uRight}
    {Value : Type uValue} [Field Value] [CharZero Value]
    (left : PrimitiveDistinction Left)
    (right : PrimitiveDistinction Right)
    (observable : PrimitiveDistinctionPlane left right → Value)
    (point : PrimitiveDistinctionPlane left right) :
    planeOddEvenPart left right observable
        ((left.firstPlaneInvolution right).action point) =
      - planeOddEvenPart left right observable point := by
  simp only [planeOddEvenPart]
  rw [generatedPlane_first_coordinate_reversal]
  exact boolOddEvenPart_flipFirst
    (planeObservableToBool left right observable)
    (left.generatedPlaneEquivBoolProduct right point)

theorem plane_oddEvenPart_second_invariant
    {Left : Type uLeft} {Right : Type uRight}
    {Value : Type uValue} [Field Value] [CharZero Value]
    (left : PrimitiveDistinction Left)
    (right : PrimitiveDistinction Right)
    (observable : PrimitiveDistinctionPlane left right → Value)
    (point : PrimitiveDistinctionPlane left right) :
    planeOddEvenPart left right observable
        ((left.secondPlaneInvolution right).action point) =
      planeOddEvenPart left right observable point := by
  simp only [planeOddEvenPart]
  rw [generatedPlane_second_coordinate_reversal]
  exact boolOddEvenPart_flipSecond
    (planeObservableToBool left right observable)
    (left.generatedPlaneEquivBoolProduct right point)

/-- The even/odd layer is the second-coordinate odd character. -/
theorem plane_evenOddPart_second_odd
    {Left : Type uLeft} {Right : Type uRight}
    {Value : Type uValue} [Field Value] [CharZero Value]
    (left : PrimitiveDistinction Left)
    (right : PrimitiveDistinction Right)
    (observable : PrimitiveDistinctionPlane left right → Value)
    (point : PrimitiveDistinctionPlane left right) :
    planeEvenOddPart left right observable
        ((left.secondPlaneInvolution right).action point) =
      - planeEvenOddPart left right observable point := by
  simp only [planeEvenOddPart]
  rw [generatedPlane_second_coordinate_reversal]
  exact boolEvenOddPart_flipSecond
    (planeObservableToBool left right observable)
    (left.generatedPlaneEquivBoolProduct right point)

theorem plane_evenOddPart_first_invariant
    {Left : Type uLeft} {Right : Type uRight}
    {Value : Type uValue} [Field Value] [CharZero Value]
    (left : PrimitiveDistinction Left)
    (right : PrimitiveDistinction Right)
    (observable : PrimitiveDistinctionPlane left right → Value)
    (point : PrimitiveDistinctionPlane left right) :
    planeEvenOddPart left right observable
        ((left.firstPlaneInvolution right).action point) =
      planeEvenOddPart left right observable point := by
  simp only [planeEvenOddPart]
  rw [generatedPlane_first_coordinate_reversal]
  exact boolEvenOddPart_flipFirst
    (planeObservableToBool left right observable)
    (left.generatedPlaneEquivBoolProduct right point)

/-- The odd/odd layer is odd under both coordinate reversals. -/
theorem plane_oddOddPart_second_odd
    {Left : Type uLeft} {Right : Type uRight}
    {Value : Type uValue} [Field Value] [CharZero Value]
    (left : PrimitiveDistinction Left)
    (right : PrimitiveDistinction Right)
    (observable : PrimitiveDistinctionPlane left right → Value)
    (point : PrimitiveDistinctionPlane left right) :
    planeOddOddPart left right observable
        ((left.secondPlaneInvolution right).action point) =
      - planeOddOddPart left right observable point := by
  simp only [planeOddOddPart]
  rw [generatedPlane_second_coordinate_reversal]
  exact boolOddOddPart_flipSecond
    (planeObservableToBool left right observable)
    (left.generatedPlaneEquivBoolProduct right point)

theorem plane_oddOddPart_first_odd
    {Left : Type uLeft} {Right : Type uRight}
    {Value : Type uValue} [Field Value] [CharZero Value]
    (left : PrimitiveDistinction Left)
    (right : PrimitiveDistinction Right)
    (observable : PrimitiveDistinctionPlane left right → Value)
    (point : PrimitiveDistinctionPlane left right) :
    planeOddOddPart left right observable
        ((left.firstPlaneInvolution right).action point) =
      - planeOddOddPart left right observable point := by
  simp only [planeOddOddPart]
  rw [generatedPlane_first_coordinate_reversal]
  exact boolOddOddPart_flipFirst
    (planeObservableToBool left right observable)
    (left.generatedPlaneEquivBoolProduct right point)

end PrimitiveDistinction

end PrimitiveTwoPlane

end OCKIndividuationMSpaceComposition
