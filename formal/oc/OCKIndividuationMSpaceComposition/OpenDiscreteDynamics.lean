import Mathlib.Algebra.Order.BigOperators.Group.Finset
import Mathlib.Algebra.Field.GeomSum
import Mathlib.Algebra.Order.Ring.Abs
import Mathlib.Data.Rat.Defs
import Mathlib.Order.WellFounded
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.Ring
import Mathlib.Tactic.FieldSimp

namespace OCKIndividuationMSpaceComposition

/-!
Finite-time mechanics for a scalar observable of an open system.  The split
between endogenous increment and external forcing is explicit, because the
observed state trajectory alone does not in general identify that split.
-/

/-- A discrete open dynamics with an endogenous increment and external forcing. -/
structure OpenDiscreteDynamics where
  initial : ℚ
  endogenous : ℕ → ℚ
  forcing : ℕ → ℚ

def OpenDiscreteDynamics.increment (model : OpenDiscreteDynamics) (t : ℕ) : ℚ :=
  model.endogenous t + model.forcing t

/-- The observable state generated by the declared open dynamics. -/
def OpenDiscreteDynamics.state (model : OpenDiscreteDynamics) : ℕ → ℚ
  | 0 => model.initial
  | t + 1 => model.state t + model.increment t

@[simp] theorem OpenDiscreteDynamics.state_zero (model : OpenDiscreteDynamics) :
    model.state 0 = model.initial := rfl

@[simp] theorem OpenDiscreteDynamics.state_succ
    (model : OpenDiscreteDynamics) (t : ℕ) :
    model.state (t + 1) = model.state t + model.increment t := rfl

/-- Exact finite-horizon balance: stock equals initial stock plus all net flow. -/
theorem OpenDiscreteDynamics.state_eq_initial_add_sum
    (model : OpenDiscreteDynamics) (horizon : ℕ) :
    model.state horizon =
      model.initial + ∑ t ∈ Finset.range horizon, model.increment t := by
  induction horizon with
  | zero => simp
  | succ horizon ih =>
      rw [model.state_succ, ih]
      simp only [Finset.sum_range_succ]
      ring

/-- Cumulative net flow over a window beginning at `start`. -/
def OpenDiscreteDynamics.windowFlow
    (model : OpenDiscreteDynamics) (start horizon : ℕ) : ℚ :=
  ∑ offset ∈ Finset.range horizon, model.increment (start + offset)

/-- Exact window balance, valid for nonstationary endogenous flow and forcing. -/
theorem OpenDiscreteDynamics.state_add_eq_state_add_windowFlow
    (model : OpenDiscreteDynamics) (start horizon : ℕ) :
    model.state (start + horizon) =
      model.state start + model.windowFlow start horizon := by
  induction horizon with
  | zero => simp [OpenDiscreteDynamics.windowFlow]
  | succ horizon ih =>
      rw [Nat.add_succ, model.state_succ, ih]
      simp only [OpenDiscreteDynamics.windowFlow, Finset.sum_range_succ]
      ring

/-- A return to the same observed stock forces zero cumulative net flow. -/
theorem OpenDiscreteDynamics.cycle_implies_zero_windowFlow
    (model : OpenDiscreteDynamics) (start period : ℕ)
    (returns : model.state (start + period) = model.state start) :
    model.windowFlow start period = 0 := by
  rw [model.state_add_eq_state_add_windowFlow] at returns
  linarith

/-- First crossing of a declared observable threshold. -/
def OpenDiscreteDynamics.CrossesAt
    (model : OpenDiscreteDynamics) (threshold : ℚ) (t : ℕ) : Prop :=
  threshold ≤ model.state t ∧
    ∀ earlier, earlier < t → model.state earlier < threshold

/-- A first threshold crossing, when it exists, is unique. -/
theorem OpenDiscreteDynamics.crossesAt_unique
    (model : OpenDiscreteDynamics) (threshold : ℚ) {first second : ℕ}
    (firstCrossing : model.CrossesAt threshold first)
    (secondCrossing : model.CrossesAt threshold second) :
    first = second := by
  rcases lt_trichotomy first second with before | equal | after
  · exact False.elim ((not_lt_of_ge firstCrossing.1) (secondCrossing.2 first before))
  · exact equal
  · exact False.elim ((not_lt_of_ge secondCrossing.1) (firstCrossing.2 second after))

/-- Reaching a threshold at any finite time yields a mathematically first crossing. -/
theorem OpenDiscreteDynamics.first_crossing_exists_of_reaches
    (model : OpenDiscreteDynamics) (threshold : ℚ) (horizon : ℕ)
    (reaches : threshold ≤ model.state horizon) :
    ∃ first, model.CrossesAt threshold first := by
  let predicate : ℕ → Prop := fun t => threshold ≤ model.state t
  have existsPredicate : ∃ t, predicate t := ⟨horizon, reaches⟩
  let first := Nat.find existsPredicate
  refine ⟨first, Nat.find_spec existsPredicate, ?_⟩
  intro earlier earlierBefore
  have notReached : ¬ predicate earlier := Nat.find_min existsPredicate earlierBefore
  exact lt_of_not_ge notReached

/-- Agreement of two trajectories on every observation through a finite horizon. -/
def PrefixAgree {α : Type*} (x y : ℕ → α) (horizon : ℕ) : Prop :=
  ∀ t, t ≤ horizon → x t = y t

/--
Quantitative no-go: without a bound on hidden forcing, an arbitrary next-step
gap is compatible with exactly the same finite observed history.
-/
theorem finite_prefix_allows_arbitrary_next_gap
    (horizon : ℕ) (gap : ℚ) :
    ∃ x y : ℕ → ℚ,
      PrefixAgree x y horizon ∧
      y (horizon + 1) - x (horizon + 1) = gap := by
  let x : ℕ → ℚ := fun _ => 0
  let y : ℕ → ℚ := fun t => if t ≤ horizon then 0 else gap
  refine ⟨x, y, ?_, ?_⟩
  · intro t observed
    simp [x, y, observed]
  · have notObserved : ¬ horizon + 1 ≤ horizon := Nat.not_succ_le_self horizon
    simp [x, y, notObserved]

/-- One unit per step represented as endogenous change. -/
def endogenousUnitDynamics : OpenDiscreteDynamics where
  initial := 0
  endogenous := fun _ => 1
  forcing := fun _ => 0

/-- The same observable unit increment represented entirely as external forcing. -/
def forcingUnitDynamics : OpenDiscreteDynamics where
  initial := 0
  endogenous := fun _ => 0
  forcing := fun _ => 1

/-- The two different causal decompositions generate the same complete trajectory. -/
theorem endogenous_and_forcing_unit_trajectories_equal (t : ℕ) :
    endogenousUnitDynamics.state t = forcingUnitDynamics.state t := by
  induction t with
  | zero => rfl
  | succ t ih =>
      rw [OpenDiscreteDynamics.state_succ, OpenDiscreteDynamics.state_succ, ih]
      norm_num [OpenDiscreteDynamics.increment, endogenousUnitDynamics,
        forcingUnitDynamics]

/-- The observationally equivalent models disagree about endogenous lineage. -/
theorem equal_trajectory_does_not_identify_endogenous_flow :
    endogenousUnitDynamics.endogenous 0 ≠ forcingUnitDynamics.endogenous 0 := by
  norm_num [endogenousUnitDynamics, forcingUnitDynamics]

/-- A scalar update map is contractive with declared factor `rho`. -/
def IsContraction (rho : ℚ) (update : ℚ → ℚ) : Prop :=
  ∀ first second,
    |update first - update second| ≤ rho * |first - second|

/-- Iteration without forcing, kept explicit to expose the finite horizon. -/
def iterateState (update : ℚ → ℚ) : ℕ → ℚ → ℚ
  | 0, initial => initial
  | horizon + 1, initial => update (iterateState update horizon initial)

/--
Positive predictive theorem: a contraction suppresses initial-state error at
the exact geometric rate `rho^horizon`.
-/
theorem contraction_geometric_error_bound
    (update : ℚ → ℚ) (rho : ℚ)
    (rhoNonnegative : 0 ≤ rho)
    (contractive : IsContraction rho update)
    (horizon : ℕ) (first second : ℚ) :
    |iterateState update horizon first - iterateState update horizon second| ≤
      rho ^ horizon * |first - second| := by
  induction horizon with
  | zero => simp [iterateState]
  | succ horizon ih =>
      calc
        |iterateState update (horizon + 1) first -
            iterateState update (horizon + 1) second| =
            |update (iterateState update horizon first) -
              update (iterateState update horizon second)| := by rfl
        _ ≤ rho *
              |iterateState update horizon first - iterateState update horizon second| :=
            contractive _ _
        _ ≤ rho * (rho ^ horizon * |first - second|) :=
            mul_le_mul_of_nonneg_left ih rhoNonnegative
        _ = rho ^ (horizon + 1) * |first - second| := by ring

/-- Iteration with an additive time-dependent external forcing. -/
def forcedIterateState
    (update : ℚ → ℚ) (forcing : ℕ → ℚ) : ℕ → ℚ → ℚ
  | 0, initial => initial
  | horizon + 1, initial =>
      update (forcedIterateState update forcing horizon initial) + forcing horizon

/-- Recursive worst-case envelope for initial error and bounded forcing error. -/
def robustErrorEnvelope (rho disturbance initialError : ℚ) : ℕ → ℚ
  | 0 => initialError
  | horizon + 1 => rho * robustErrorEnvelope rho disturbance initialError horizon + disturbance

/--
Robust positive theorem: under a `rho`-contraction and a per-step forcing
discrepancy bounded by `disturbance`, forecast error stays below the recursively
computable robust envelope.
-/
theorem forced_contraction_error_bound
    (update : ℚ → ℚ) (rho disturbance : ℚ)
    (rhoNonnegative : 0 ≤ rho)
    (contractive : IsContraction rho update)
    (firstForcing secondForcing : ℕ → ℚ)
    (forcingBound : ∀ t, |firstForcing t - secondForcing t| ≤ disturbance)
    (horizon : ℕ) (first second : ℚ) :
    |forcedIterateState update firstForcing horizon first -
        forcedIterateState update secondForcing horizon second| ≤
      robustErrorEnvelope rho disturbance |first - second| horizon := by
  induction horizon with
  | zero => simp [forcedIterateState, robustErrorEnvelope]
  | succ horizon ih =>
      have triangle :
          |(update (forcedIterateState update firstForcing horizon first) + firstForcing horizon) -
              (update (forcedIterateState update secondForcing horizon second) + secondForcing horizon)| ≤
            |update (forcedIterateState update firstForcing horizon first) -
                update (forcedIterateState update secondForcing horizon second)| +
              |firstForcing horizon - secondForcing horizon| := by
        rw [show
          (update (forcedIterateState update firstForcing horizon first) + firstForcing horizon) -
              (update (forcedIterateState update secondForcing horizon second) + secondForcing horizon) =
            (update (forcedIterateState update firstForcing horizon first) -
              update (forcedIterateState update secondForcing horizon second)) +
            (firstForcing horizon - secondForcing horizon) by ring]
        exact abs_add_le _ _
      calc
        |forcedIterateState update firstForcing (horizon + 1) first -
            forcedIterateState update secondForcing (horizon + 1) second| ≤
            |update (forcedIterateState update firstForcing horizon first) -
                update (forcedIterateState update secondForcing horizon second)| +
              |firstForcing horizon - secondForcing horizon| := triangle
        _ ≤ rho *
              |forcedIterateState update firstForcing horizon first -
                forcedIterateState update secondForcing horizon second| + disturbance :=
            add_le_add (contractive _ _) (forcingBound horizon)
        _ ≤ rho * robustErrorEnvelope rho disturbance |first - second| horizon + disturbance :=
            by simpa [add_comm] using
              (add_le_add_right (mul_le_mul_of_nonneg_left ih rhoNonnegative) disturbance)
        _ = robustErrorEnvelope rho disturbance |first - second| (horizon + 1) := rfl

/-- Left-recursive identity for a finite geometric resource sum. -/
theorem rho_mul_geometric_sum_add_one (rho : ℚ) (horizon : ℕ) :
    rho * (∑ k ∈ Finset.range horizon, rho ^ k) + 1 =
      ∑ k ∈ Finset.range (horizon + 1), rho ^ k := by
  induction horizon with
  | zero => simp
  | succ horizon ih =>
      simp only [Finset.sum_range_succ] at ih ⊢
      rw [pow_succ]
      nlinarith

/-- Closed form of the robust envelope: geometric decay plus accumulated forcing. -/
theorem robustErrorEnvelope_eq_geometric_sum
    (rho disturbance initialError : ℚ) (horizon : ℕ) :
    robustErrorEnvelope rho disturbance initialError horizon =
      rho ^ horizon * initialError +
        disturbance * (∑ k ∈ Finset.range horizon, rho ^ k) := by
  induction horizon with
  | zero => simp [robustErrorEnvelope]
  | succ horizon ih =>
      rw [robustErrorEnvelope, ih, ← rho_mul_geometric_sum_add_one]
      ring

/-! ## Closed plateau under contractive forcing -/

/-- If `0 ≤ rho < 1`, the finite forced envelope is uniformly bounded by the
steady-state plateau `initialError + disturbance / (1-rho)`. -/
theorem robustErrorEnvelope_le_contracting_plateau
    (rho disturbance initialError : ℚ)
    (rhoNonnegative : 0 ≤ rho)
    (rhoLessThanOne : rho < 1)
    (disturbanceNonnegative : 0 ≤ disturbance)
    (initialErrorNonnegative : 0 ≤ initialError)
    (horizon : ℕ) :
    robustErrorEnvelope rho disturbance initialError horizon ≤
      initialError + disturbance / (1 - rho) := by
  have denominatorPositive : 0 < 1 - rho := sub_pos.mpr rhoLessThanOne
  induction horizon with
  | zero =>
      simp [robustErrorEnvelope]
      have fractionNonnegative : 0 ≤ disturbance / (1 - rho) :=
        div_nonneg disturbanceNonnegative (le_of_lt denominatorPositive)
      linarith
  | succ horizon ih =>
      rw [robustErrorEnvelope]
      have recursiveBound :
          rho * robustErrorEnvelope rho disturbance initialError horizon + disturbance ≤
            rho * (initialError + disturbance / (1 - rho)) + disturbance := by
        exact add_le_add (mul_le_mul_of_nonneg_left ih rhoNonnegative) (le_refl _)
      calc
        rho * robustErrorEnvelope rho disturbance initialError horizon + disturbance ≤
            rho * (initialError + disturbance / (1 - rho)) + disturbance := recursiveBound
        _ ≤ initialError + disturbance / (1 - rho) := by
          have fractionIdentity :
              (1 - rho) * (disturbance / (1 - rho)) = disturbance := by
            field_simp [ne_of_gt denominatorPositive]
          nlinarith [denominatorPositive, initialErrorNonnegative,
            disturbanceNonnegative, fractionIdentity]

end OCKIndividuationMSpaceComposition
