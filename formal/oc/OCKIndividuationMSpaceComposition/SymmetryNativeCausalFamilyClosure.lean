import OCKIndividuationMSpaceComposition.ConstraintGeneratedObject
import Mathlib.Data.Finset.Basic

namespace OCKIndividuationMSpaceComposition

universe uMechanism uIntervention uOutcome

/-!
# What the existing OC causal kernel does and does not generate

`GeneratedKernel` is an actual OC construction: it is the least carrier
reachable from one provenance root through typed internal difference
witnesses.  This file lifts that construction to a finite family of roots and
proves its exact closure laws.

The result is deliberately diagnostic.  Family generation is the union of
singleton causal kernels.  Therefore the present OC causal primitive supplies
component/connectedness closure, but it cannot express a genuinely joint
generator in which a target is produced only by a combination of two roots.
That missing multi-source law is an explicit premise still required before a
general intrinsic dimension can be claimed.

No exchange, matroid, vector, coordinate, or rank structure is introduced.
-/

namespace ActiveConstraintModel

variable {Mechanism : Type uMechanism}
variable {Intervention : Type uIntervention}
variable {Outcome : Type uOutcome}

/-! ## Transitivity of the already-defined one-root kernel -/

theorem generatedKernel_trans
    (model : ActiveConstraintModel Mechanism Intervention Outcome)
    {root middle target : Mechanism}
    (first : GeneratedKernel model root middle)
    (second : GeneratedKernel model middle target) :
    GeneratedKernel model root target := by
  induction second with
  | ofRoot => exact first
  | ofInternalDependency previous dependency inductionHypothesis =>
      exact .ofInternalDependency inductionHypothesis dependency

/-! ## Finite-family causal generation -/

def familyGenerated
    (model : ActiveConstraintModel Mechanism Intervention Outcome)
    (seed : Set Mechanism) (target : Mechanism) : Prop :=
  ∃ root ∈ seed, GeneratedKernel model root target

theorem familyGenerated_of_root
    (model : ActiveConstraintModel Mechanism Intervention Outcome)
    (root : Mechanism) :
    familyGenerated model ({root} : Set Mechanism) root := by
  exact ⟨root, by simp, .ofRoot⟩

theorem familyGenerated_mono
    (model : ActiveConstraintModel Mechanism Intervention Outcome)
    {first second : Set Mechanism}
    (subset : first ⊆ second) {target : Mechanism} :
    familyGenerated model first target →
      familyGenerated model second target := by
  rintro ⟨root, rootMember, generated⟩
  exact ⟨root, subset rootMember, generated⟩

theorem familyGenerated_extensive
    (model : ActiveConstraintModel Mechanism Intervention Outcome)
    {seed : Set Mechanism} {root : Mechanism}
    (rootMember : root ∈ seed) :
    familyGenerated model seed root := by
  exact ⟨root, rootMember, .ofRoot⟩

theorem familyGenerated_trans
    (model : ActiveConstraintModel Mechanism Intervention Outcome)
    {seed : Set Mechanism} {middle target : Mechanism}
    (first : familyGenerated model seed middle)
    (second : familyGenerated model ({middle} : Set Mechanism) target) :
    familyGenerated model seed target := by
  rcases first with ⟨root, rootMember, rootMiddle⟩
  rcases second with ⟨candidate, candidateMember, middleTarget⟩
  have candidateEq : candidate = middle := by simpa using candidateMember
  subst candidate
  exact ⟨root, rootMember,
    generatedKernel_trans model rootMiddle middleTarget⟩

theorem familyGenerated_idempotent
    (model : ActiveConstraintModel Mechanism Intervention Outcome)
    (seed : Set Mechanism) (target : Mechanism) :
    (∃ middle,
      familyGenerated model seed middle ∧
        familyGenerated model ({middle} : Set Mechanism) target) ↔
      familyGenerated model seed target := by
  constructor
  · rintro ⟨middle, first, second⟩
    exact familyGenerated_trans model first second
  · rintro ⟨root, rootMember, generated⟩
    exact ⟨root, familyGenerated_extensive model rootMember,
      ⟨root, by simp, generated⟩⟩

/-! ## Exact singleton-generation boundary -/

theorem familyGenerated_is_singleton_generated
    (model : ActiveConstraintModel Mechanism Intervention Outcome)
    (seed : Set Mechanism) (target : Mechanism) :
    familyGenerated model seed target ↔
      ∃ root ∈ seed,
        familyGenerated model ({root} : Set Mechanism) target := by
  constructor
  · rintro ⟨root, rootMember, generated⟩
    exact ⟨root, rootMember, ⟨root, by simp, generated⟩⟩
  · rintro ⟨root, rootMember, singletonGenerated⟩
    rcases singletonGenerated with ⟨candidate, candidateMember, generated⟩
    have candidateEq : candidate = root := by simpa using candidateMember
    subst candidate
    exact ⟨root, rootMember, generated⟩

/-- A target is genuinely jointly generated by a finite seed only if it is
generated by the seed but by no singleton member.  This is the exact
multi-source phenomenon required by native composition. -/
def JointlyGeneratedBy
    (model : ActiveConstraintModel Mechanism Intervention Outcome)
    (seed : Finset Mechanism) (target : Mechanism) : Prop :=
  familyGenerated model (↑seed : Set Mechanism) target ∧
    ∀ root ∈ seed,
      ¬ familyGenerated model ({root} : Set Mechanism) target

theorem familyGenerated_has_no_genuine_joint_generator
    (model : ActiveConstraintModel Mechanism Intervention Outcome) :
    ¬ ∃ (seed : Finset Mechanism) (target : Mechanism),
      JointlyGeneratedBy model seed target := by
  rintro ⟨seed, target, jointly⟩
  rcases (familyGenerated_is_singleton_generated model
    (↑seed : Set Mechanism) target).mp jointly.1 with
    ⟨root, rootMember, singletonGenerated⟩
  exact jointly.2 root (by exact rootMember) singletonGenerated

/-! ## Explicit connection to the current causal primitive -/

theorem internalDependency_is_one_step_familyGenerated
    (model : ActiveConstraintModel Mechanism Intervention Outcome)
    {root target : Mechanism}
    (dependency : InternalDependency model root target) :
    familyGenerated model ({root} : Set Mechanism) target := by
  exact ⟨root, by simp, .ofInternalDependency .ofRoot dependency⟩

theorem familyGenerated_contains_only_typed_kernel_paths
    (model : ActiveConstraintModel Mechanism Intervention Outcome)
    {seed : Set Mechanism} {target : Mechanism}
    (generated : familyGenerated model seed target) :
    ∃ root ∈ seed, GeneratedKernel model root target :=
  generated

end ActiveConstraintModel

end OCKIndividuationMSpaceComposition
