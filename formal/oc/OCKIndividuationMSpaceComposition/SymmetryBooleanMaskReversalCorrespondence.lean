import OCKIndividuationMSpaceComposition.SymmetryNativeReversalClosure
import Mathlib.Algebra.Group.Subgroup.Finite

namespace OCKIndividuationMSpaceComposition

universe uIndex uCarrier

namespace PrimitiveDistinction

/-!
# Boolean masks and the native reversal subgroup

For a pairwise-disjoint finite family, `maskPermutationProduct` is not only
an ambient permutation presentation.  Its selected coordinates generate the
same subgroup used by `nativeReversalClosure`.  This file records that
correspondence without introducing a second action or a coordinate carrier.

The correspondence is intentionally one-sided at the subgroup level: a mask
product is shown to be an element of the subgroup generated by the selected
local reversals.  Faithfulness is read back at displayed first endpoints, so
different masks cannot be hidden by subgroup relations.  No claim is made
that arbitrary primitive distinctions commute or that every ambient
permutation is represented by a mask.
-/

namespace DisjointDistinctionFamily

variable {Index : Type uIndex} {Carrier : Type uCarrier}
variable [Fintype Index] [DecidableEq Index]
variable [Fintype Carrier] [DecidableEq Carrier]

/-! ## Subgroup membership and native closure readback -/

/-- The permutation selected by a mask is an element of the actual subgroup
generated by precisely the local reversals selected by that mask. -/
theorem maskPermutationProduct_mem_reversalSubgroup
    (family : DisjointDistinctionFamily Index Carrier)
    (mask : Index -> Bool) :
    family.maskPermutationProduct mask ∈
      family.reversalSubgroup (selectedIndices mask) := by
  rw [family.maskPermutationProduct_eq_maskPermutation]
  unfold maskPermutation
  apply Subgroup.noncommProd_mem
    (family.reversalSubgroup (selectedIndices mask))
  intro index indexMember
  apply Subgroup.subset_closure
  exact ⟨index, indexMember, rfl⟩

/-- A mask bit is exactly the membership of that local reversal in the native
subgroup-generated index closure for the mask's selected seed. -/
theorem mask_bit_iff_native_reversalGenerated
    (family : DisjointDistinctionFamily Index Carrier)
    (mask : Index -> Bool) (index : Index) :
    mask index = true ↔
      family.reversalGenerated (selectedIndices mask) index := by
  calc
    mask index = true ↔ index ∈ selectedIndices mask := by
      simp [selectedIndices]
    _ ↔ index ∈ family.nativeReversalClosure (selectedIndices mask) := by
      rw [family.nativeReversalClosure_eq_seed]
    _ ↔ family.reversalGenerated (selectedIndices mask) index :=
      family.mem_nativeReversalClosure

/-! ## Equality and endpoint faithfulness -/

/-- Equal masks give the same subgroup element/action, and equality of the
resulting actual actions recovers equality of the masks. -/
theorem mask_eq_iff_maskPermutationProduct_eq
    (family : DisjointDistinctionFamily Index Carrier)
    (first second : Index -> Bool) :
    first = second ↔
      family.maskPermutationProduct first =
        family.maskPermutationProduct second := by
  constructor
  · intro equal
    subst second
    rfl
  · intro equal
    exact family.maskPermutationProduct_injective equal

/-- If two masks differ, some displayed first endpoint separates their
actions: it belongs to exactly one of the two permutation supports.  This is
the endpoint form of the no-hidden-relations property. -/
theorem mask_ne_has_endpoint_support_witness
    (family : DisjointDistinctionFamily Index Carrier)
    {first second : Index -> Bool} (different : first ≠ second) :
    ∃ index : Index,
      ((family.distinction index).first ∈
          (family.maskPermutationProduct first).support ∧
        (family.distinction index).first ∉
          (family.maskPermutationProduct second).support) ∨
      ((family.distinction index).first ∈
          (family.maskPermutationProduct second).support ∧
        (family.distinction index).first ∉
          (family.maskPermutationProduct first).support) := by
  classical
  by_contra noWitness
  have endpointIff : ∀ index : Index,
      ((family.distinction index).first ∈
          (family.maskPermutationProduct first).support) ↔
        ((family.distinction index).first ∈
          (family.maskPermutationProduct second).support) := by
    intro index
    by_cases firstMember :
        (family.distinction index).first ∈
          (family.maskPermutationProduct first).support
    · by_cases secondMember :
          (family.distinction index).first ∈
            (family.maskPermutationProduct second).support
      · exact iff_of_true firstMember secondMember
      · exfalso
        apply noWitness
        exact ⟨index, Or.inl ⟨firstMember, secondMember⟩⟩
    · by_cases secondMember :
          (family.distinction index).first ∈
            (family.maskPermutationProduct second).support
      · exfalso
        apply noWitness
        exact ⟨index, Or.inr ⟨secondMember, firstMember⟩⟩
      · exact iff_of_false firstMember secondMember
  apply different
  funext index
  apply Bool.eq_iff_iff.mpr
  constructor
  · intro selected
    have firstMember :=
      (family.first_mem_support_maskPermutationProduct_iff first index).2
        selected
    have secondMember := (endpointIff index).mp firstMember
    exact
      (family.first_mem_support_maskPermutationProduct_iff second index).1
        secondMember
  · intro selected
    have secondMember :=
      (family.first_mem_support_maskPermutationProduct_iff second index).2
        selected
    have firstMember := (endpointIff index).mpr secondMember
    exact
      (family.first_mem_support_maskPermutationProduct_iff first index).1
        firstMember

end DisjointDistinctionFamily

end PrimitiveDistinction

end OCKIndividuationMSpaceComposition
