import OCKIndividuationMSpaceComposition.LevelClassification

namespace OCKIndividuationMSpaceComposition

universe uObject uObject'

/-!
# Recursive multi-level composition

The minimal universal representation of composition is not a fixed tree type
or a fixed K ladder.  A domain supplies one local relation saying that a finite
family of children realizes a parent.  A decomposition step replaces exactly
one parent occurrence inside an arbitrary list context by such a family.  The
reflexive-transitive closure of this local rewrite is the derived multi-level
composition relation.

This presentation makes hierarchy an output.  It permits arbitrary finite
depth, branching, repeated occurrences and multiple valid decompositions.  It
does not identify decomposition with token identity, observational
equivalence, causal constitution, or normative validity.
-/

/-- A domain-supplied claim that a finite child family realizes one parent. -/
abbrev RealizesChildren (Object : Type uObject) := List Object → Object → Prop

/-- Replace one parent, in any finite list context, by a realizing child family. -/
inductive DecompositionStep
    {Object : Type uObject}
    (realizes : RealizesChildren Object) :
    List Object → List Object → Prop
  | replace (before children after : List Object) (parent : Object) :
      realizes children parent →
      DecompositionStep realizes
        (before ++ [parent] ++ after)
        (before ++ children ++ after)

/--
The full finite multi-level decomposition relation.  This is the least
reflexive-transitive relation generated by local child-for-parent rewrites.
-/
abbrev MultiLevelDecomposition
    {Object : Type uObject}
    (realizes : RealizesChildren Object) :=
  RelationReachable (DecompositionStep realizes)

/-- A parent always has its zero-step presentation. -/
theorem multiLevelDecomposition_refl
    {Object : Type uObject}
    (realizes : RealizesChildren Object)
    (objects : List Object) :
    MultiLevelDecomposition realizes objects objects :=
  .root

/-- Every local realization is one admitted multi-level decomposition step. -/
theorem local_realization_is_multiLevelDecomposition
    {Object : Type uObject}
    {realizes : RealizesChildren Object}
    {children : List Object}
    {parent : Object}
    (witness : realizes children parent) :
    MultiLevelDecomposition realizes [parent] children := by
  apply RelationReachable.tail RelationReachable.root
  simpa using
    (DecompositionStep.replace
      (realizes := realizes) [] children [] parent witness)

/-- Multi-level decomposition composes by ordinary reachability transitivity. -/
theorem multiLevelDecomposition_trans
    {Object : Type uObject}
    {realizes : RealizesChildren Object}
    {first middle last : List Object}
    (firstMiddle : MultiLevelDecomposition realizes first middle)
    (middleLast : MultiLevelDecomposition realizes middle last) :
    MultiLevelDecomposition realizes first last :=
  relationReachable_trans firstMiddle middleLast

/-- A local rewrite remains a local rewrite after adding a common list context. -/
theorem decompositionStep_in_context
    {Object : Type uObject}
    {realizes : RealizesChildren Object}
    {first second : List Object}
    (left right : List Object)
    (step : DecompositionStep realizes first second) :
    DecompositionStep realizes
      (left ++ first ++ right)
      (left ++ second ++ right) := by
  cases step with
  | replace before children after parent witness =>
      simpa [List.append_assoc] using
        (DecompositionStep.replace
          (realizes := realizes)
          (left ++ before)
          children
          (after ++ right)
          parent
          witness)

/-- Every finite multi-level decomposition is stable under a common context. -/
theorem multiLevelDecomposition_in_context
    {Object : Type uObject}
    {realizes : RealizesChildren Object}
    {first second : List Object}
    (left right : List Object)
    (decomposition : MultiLevelDecomposition realizes first second) :
    MultiLevelDecomposition realizes
      (left ++ first ++ right)
      (left ++ second ++ right) := by
  induction decomposition with
  | root => exact .root
  | tail previous step inductionHypothesis =>
      exact .tail inductionHypothesis
        (decompositionStep_in_context left right step)

/--
Substitution theorem: an already decomposed family may itself be decomposed,
and the two stages are exactly one multi-level decomposition.
-/
theorem multiLevel_substitution
    {Object : Type uObject}
    {realizes : RealizesChildren Object}
    {parent : Object}
    {intermediate terminal : List Object}
    (parentToIntermediate :
      MultiLevelDecomposition realizes [parent] intermediate)
    (intermediateToTerminal :
      MultiLevelDecomposition realizes intermediate terminal) :
    MultiLevelDecomposition realizes [parent] terminal :=
  multiLevelDecomposition_trans parentToIntermediate intermediateToTerminal

/-!
## Predicate preservation through arbitrary finite composition

The local child rule is enough to propagate any invariant through the full
reflexive-transitive decomposition closure.  This is the exact bridge needed
to lift a one-level constitutive witness to an object-of-objects hierarchy; it
does not turn decomposition into token identity or make the decomposition
canonical.
-/

/-- A predicate on objects is preserved by every admitted local realization. -/
def RealizationPreserves
    {Object : Type uObject}
    (realizes : RealizesChildren Object)
    (invariant : Object → Prop) : Prop :=
  ∀ {children parent},
    realizes children parent →
    invariant parent →
    ∀ child ∈ children, invariant child

/-- One decomposition step preserves a pointwise list invariant. -/
theorem decompositionStep_preserves_forall
    {Object : Type uObject}
    {realizes : RealizesChildren Object}
    {invariant : Object → Prop}
    (preserves : RealizationPreserves realizes invariant)
    {first second : List Object}
    (step : DecompositionStep realizes first second)
    (firstInvariant : ∀ object ∈ first, invariant object) :
    ∀ object ∈ second, invariant object := by
  cases step with
  | replace before children after parent witness =>
      intro object objectInSecond
      simp only [List.mem_append] at objectInSecond
      rcases objectInSecond with objectInBeforeOrChildren | objectInAfter
      · rcases objectInBeforeOrChildren with objectInBefore | objectInChildren
        · apply firstInvariant object
          simp only [List.mem_append, List.mem_singleton]
          exact Or.inl (Or.inl objectInBefore)
        · have parentInvariant : invariant parent := by
            apply firstInvariant parent
            simp only [List.mem_append, List.mem_singleton]
            exact Or.inl (Or.inr trivial)
          exact preserves witness parentInvariant object objectInChildren
      · apply firstInvariant object
        simp only [List.mem_append, List.mem_singleton]
        exact Or.inr objectInAfter

/-- Every terminal occurrence of any finite decomposition inherits the invariant. -/
theorem multiLevelDecomposition_preserves_forall
    {Object : Type uObject}
    {realizes : RealizesChildren Object}
    {invariant : Object → Prop}
    (preserves : RealizationPreserves realizes invariant)
    {first terminal : List Object}
    (decomposition : MultiLevelDecomposition realizes first terminal)
    (firstInvariant : ∀ object ∈ first, invariant object) :
    ∀ object ∈ terminal, invariant object := by
  induction decomposition with
  | root => exact firstInvariant
  | tail previous step inductionHypothesis =>
      exact decompositionStep_preserves_forall preserves step
        inductionHypothesis

/-- Singleton specialization: a carrier parent yields only carrier terminals. -/
theorem multiLevelDecomposition_from_parent_preserves
    {Object : Type uObject}
    {realizes : RealizesChildren Object}
    {invariant : Object → Prop}
    (preserves : RealizationPreserves realizes invariant)
    {parent : Object}
    {terminal : List Object}
    (decomposition : MultiLevelDecomposition realizes [parent] terminal)
    (parentInvariant : invariant parent) :
    ∀ object ∈ terminal, invariant object := by
  apply multiLevelDecomposition_preserves_forall preserves decomposition
  intro object objectInSingleton
  have objectEq : object = parent := by
    simpa using objectInSingleton
  simpa [objectEq] using parentInvariant

/-!
## Naturality under realization-preserving maps
-/

/-- A typed map preserves local composition witnesses. -/
def RealizationPreserving
    {Object : Type uObject}
    {Object' : Type uObject'}
    (sourceRealizes : RealizesChildren Object)
    (targetRealizes : RealizesChildren Object')
    (transform : Object → Object') : Prop :=
  ∀ {children parent},
    sourceRealizes children parent →
      targetRealizes (children.map transform) (transform parent)

/-- A realization-preserving map sends every local rewrite to a local rewrite. -/
theorem DecompositionStep.map
    {Object : Type uObject}
    {Object' : Type uObject'}
    {sourceRealizes : RealizesChildren Object}
    {targetRealizes : RealizesChildren Object'}
    {transform : Object → Object'}
    (preserves :
      RealizationPreserving sourceRealizes targetRealizes transform)
    {first second : List Object}
    (step : DecompositionStep sourceRealizes first second) :
    DecompositionStep targetRealizes
      (first.map transform) (second.map transform) := by
  cases step with
  | replace before children after parent witness =>
      simpa using
        (DecompositionStep.replace
          (realizes := targetRealizes)
          (before.map transform)
          (children.map transform)
          (after.map transform)
          (transform parent)
          (preserves witness))

/-- Multi-level composition commutes with every realization-preserving map. -/
theorem MultiLevelDecomposition.map
    {Object : Type uObject}
    {Object' : Type uObject'}
    {sourceRealizes : RealizesChildren Object}
    {targetRealizes : RealizesChildren Object'}
    {transform : Object → Object'}
    (preserves :
      RealizationPreserving sourceRealizes targetRealizes transform)
    {first second : List Object}
    (decomposition : MultiLevelDecomposition sourceRealizes first second) :
    MultiLevelDecomposition targetRealizes
      (first.map transform) (second.map transform) := by
  induction decomposition with
  | root => exact .root
  | tail previous step inductionHypothesis =>
      exact .tail inductionHypothesis (step.map preserves)

/-!
## Arbitrary finite depth
-/

/-- One local rule unfolds every positive natural label by one predecessor. -/
def PredecessorRealization : RealizesChildren Nat :=
  fun children parent => ∃ predecessor, parent = predecessor + 1 ∧
    children = [predecessor]

/-- Every natural height generates a valid finite chain down to zero. -/
theorem predecessor_chain_reaches_zero :
    ∀ height : Nat,
      MultiLevelDecomposition PredecessorRealization [height] [0] := by
  intro height
  induction height with
  | zero => exact .root
  | succ height inductionHypothesis =>
      apply multiLevelDecomposition_trans
        (middle := [height])
      · exact local_realization_is_multiLevelDecomposition
          ⟨height, by simp, rfl⟩
      · exact inductionHypothesis

/-- The generic finite theory therefore has no maximum decomposition depth. -/
theorem arbitrary_finite_composition_depth
    (height : Nat) :
    MultiLevelDecomposition PredecessorRealization [height] [0] :=
  predecessor_chain_reaches_zero height

/-!
## Explicit non-uniqueness
-/

inductive DecompositionObject
  | parent
  | leftA
  | leftB
  | rightA
  | rightB
deriving DecidableEq, Repr

def TwoDecompositionRealization :
    RealizesChildren DecompositionObject :=
  fun children object =>
    (children = [DecompositionObject.leftA, DecompositionObject.leftB] ∧
      object = DecompositionObject.parent) ∨
    (children = [DecompositionObject.rightA, DecompositionObject.rightB] ∧
      object = DecompositionObject.parent)

theorem parent_has_two_valid_decompositions :
    MultiLevelDecomposition TwoDecompositionRealization
      [DecompositionObject.parent]
      [DecompositionObject.leftA, DecompositionObject.leftB] ∧
    MultiLevelDecomposition TwoDecompositionRealization
      [DecompositionObject.parent]
      [DecompositionObject.rightA, DecompositionObject.rightB] := by
  constructor
  · exact local_realization_is_multiLevelDecomposition
      (Or.inl ⟨rfl, rfl⟩)
  · exact local_realization_is_multiLevelDecomposition
      (Or.inr ⟨rfl, rfl⟩)

theorem the_two_decompositions_are_distinct :
    [DecompositionObject.leftA, DecompositionObject.leftB] ≠
      [DecompositionObject.rightA, DecompositionObject.rightB] := by
  intro equal
  have headsEqual :
      DecompositionObject.leftA = DecompositionObject.rightA :=
    List.cons.inj equal |>.1
  contradiction

/--
The same parent may therefore admit distinct child families.  Composition
alone does not determine a canonical decomposition or token identity.
-/
theorem composition_does_not_force_unique_decomposition :
    ∃ first second : List DecompositionObject,
      first ≠ second ∧
      MultiLevelDecomposition TwoDecompositionRealization
        [DecompositionObject.parent] first ∧
      MultiLevelDecomposition TwoDecompositionRealization
        [DecompositionObject.parent] second :=
  ⟨[DecompositionObject.leftA, DecompositionObject.leftB],
    [DecompositionObject.rightA, DecompositionObject.rightB],
    the_two_decompositions_are_distinct,
    parent_has_two_valid_decompositions.1,
    parent_has_two_valid_decompositions.2⟩

end OCKIndividuationMSpaceComposition
