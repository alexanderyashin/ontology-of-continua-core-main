import OCKIndividuationMSpaceComposition.SymmetryFoundationsCore

namespace OCKIndividuationMSpaceComposition

universe uCarrier uObservable

/-!
# Invariants, quotient observables, and a precise symmetry-breaking test

The previous module constructs the two-point axis generated by a
fixed-point-free involution.  This module proves the next semantic step: an
observable descends to the axis quotient exactly when it is invariant under
the action.  Conversely, an observable that distinguishes the two endpoints
of one axis cannot factor through that quotient.  The latter is a formal,
model-independent symmetry-breaking certificate.

No empirical or universal physical claim is made.  The carrier, action and
observable are explicit inputs, so a concrete OC model must still provide
those inputs and its evidence separately.
-/

/-- An observable is invariant when the action leaves its value unchanged. -/
def InvariantObservable {Carrier : Type uCarrier} {Observable : Type uObservable}
    (symmetry : FixedPointFreeInvolution Carrier)
    (observable : Carrier → Observable) : Prop :=
  ∀ x, observable (symmetry.action x) = observable x

/-- A value-level observable is constant on every generated axis. -/
theorem invariant_observable_on_axis {Carrier : Type uCarrier}
    {Observable : Type uObservable}
    (symmetry : FixedPointFreeInvolution Carrier)
    (observable : Carrier → Observable)
    (invariant : InvariantObservable symmetry observable)
    {x y : Carrier} (same : sameAxis symmetry x y) :
    observable y = observable x := by
  rcases same with rfl | same
  · rfl
  · subst y
    exact invariant x

/-- The unique quotient observable induced by an invariant observable. -/
def invariantObservableFactor {Carrier : Type uCarrier}
    {Observable : Type uObservable}
    (symmetry : FixedPointFreeInvolution Carrier)
    (observable : Carrier → Observable)
    (invariant : InvariantObservable symmetry observable) :
    AxisQuotient symmetry → Observable :=
  Quotient.lift observable (by
    intro left right same
    exact (invariant_observable_on_axis symmetry observable invariant same).symm)

@[simp] theorem invariantObservableFactor_spec {Carrier : Type uCarrier}
    {Observable : Type uObservable}
    (symmetry : FixedPointFreeInvolution Carrier)
    (observable : Carrier → Observable)
    (invariant : InvariantObservable symmetry observable) (x : Carrier) :
    invariantObservableFactor symmetry observable invariant (axisClass symmetry x) =
      observable x :=
  rfl

/-- Every invariant observable factors through the axis quotient. -/
theorem invariant_observable_factors_through_axis_quotient
    {Carrier : Type uCarrier} {Observable : Type uObservable}
    (symmetry : FixedPointFreeInvolution Carrier)
    (observable : Carrier → Observable)
    (invariant : InvariantObservable symmetry observable) :
    ∃ factor : AxisQuotient symmetry → Observable,
      ∀ x, factor (axisClass symmetry x) = observable x :=
  ⟨invariantObservableFactor symmetry observable invariant,
    invariantObservableFactor_spec symmetry observable invariant⟩

/-- Exact characterization: an observable factors through the axis quotient
if and only if it is invariant under the generating action. -/
theorem invariant_observable_iff_axis_quotient_factor
    {Carrier : Type uCarrier} {Observable : Type uObservable}
    (symmetry : FixedPointFreeInvolution Carrier)
    (observable : Carrier → Observable) :
    InvariantObservable symmetry observable ↔
      ∃ factor : AxisQuotient symmetry → Observable,
        ∀ x, factor (axisClass symmetry x) = observable x := by
  constructor
  · intro invariant
    exact invariant_observable_factors_through_axis_quotient
      symmetry observable invariant
  · rintro ⟨factor, specification⟩ x
    calc
      observable (symmetry.action x) = factor (axisClass symmetry (symmetry.action x)) :=
        (specification (symmetry.action x)).symm
      _ = factor (axisClass symmetry x) :=
        congrArg factor (action_preserves_axis_class symmetry x)
      _ = observable x := specification x

/-- Any factor through the quotient is unique on all quotient classes. -/
theorem axis_quotient_factor_unique
    {Carrier : Type uCarrier} {Observable : Type uObservable}
    (symmetry : FixedPointFreeInvolution Carrier)
    (observable : Carrier → Observable)
    {factor₁ factor₂ : AxisQuotient symmetry → Observable}
    (spec₁ : ∀ x, factor₁ (axisClass symmetry x) = observable x)
    (spec₂ : ∀ x, factor₂ (axisClass symmetry x) = observable x) :
    factor₁ = factor₂ := by
  funext quotient
  refine Quotient.inductionOn quotient ?_
  intro x
  calc
    factor₁ (axisClass symmetry x) = observable x := spec₁ x
    _ = factor₂ (axisClass symmetry x) := (spec₂ x).symm

/-- An observable breaks the generated symmetry at `x` when it distinguishes
the two endpoints of that axis. -/
def SymmetryBreakingWitness {Carrier : Type uCarrier} {Observable : Type uObservable}
    (symmetry : FixedPointFreeInvolution Carrier)
    (observable : Carrier → Observable) (x : Carrier) : Prop :=
  observable (symmetry.action x) ≠ observable x

theorem invariant_observable_has_no_breaking_witness
    {Carrier : Type uCarrier} {Observable : Type uObservable}
    (symmetry : FixedPointFreeInvolution Carrier)
    (observable : Carrier → Observable)
    (invariant : InvariantObservable symmetry observable) (x : Carrier) :
    ¬ SymmetryBreakingWitness symmetry observable x := by
  intro breaking
  exact breaking (invariant x)

/-- A breaking witness forbids any quotient factor, even if the factor is only
required to agree on represented carrier points. -/
theorem symmetry_breaking_forbids_axis_quotient_factor
    {Carrier : Type uCarrier} {Observable : Type uObservable}
    (symmetry : FixedPointFreeInvolution Carrier)
    (observable : Carrier → Observable) (x : Carrier)
    (breaking : SymmetryBreakingWitness symmetry observable x) :
    ¬ ∃ factor : AxisQuotient symmetry → Observable,
        ∀ y, factor (axisClass symmetry y) = observable y := by
  rintro ⟨factor, specification⟩
  apply breaking
  calc
    observable (symmetry.action x) = factor (axisClass symmetry (symmetry.action x)) :=
      (specification (symmetry.action x)).symm
    _ = factor (axisClass symmetry x) :=
      congrArg factor (action_preserves_axis_class symmetry x)
    _ = observable x := specification x

end OCKIndividuationMSpaceComposition
