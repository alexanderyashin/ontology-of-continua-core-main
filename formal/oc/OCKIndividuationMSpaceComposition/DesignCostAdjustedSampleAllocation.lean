import OCKIndividuationMSpaceComposition.InverseSqrtSampleAllocation

namespace OCKIndividuationMSpaceComposition

open scoped BigOperators

/-!
# Dependence- and cost-adjusted sample allocation

This module transports the inverse-square-root allocation theorem from
independent-equivalent counts to heterogeneous raw-trace costs and registered
design effects.  The change of variables is proved exactly; the raw laboratory
planner therefore inherits the earlier strict optimum rather than introducing
an unrelated heuristic.
-/

/-- Effective count under a registered multiplicative design effect. -/
noncomputable def effectiveCountFromRaw
    (rawCount designEffect : ℝ) : ℝ :=
  rawCount / designEffect

/-- Monetary/compute/storage spend generated by a raw count. -/
def rawSamplingSpend (unitCost rawCount : ℝ) : ℝ :=
  unitCost * rawCount

/-- Width coefficient after expressing the experiment in spend rather than
raw-count coordinates. -/
noncomputable def designCostAdjustedWidthCoefficient
    (widthCoefficient designEffect unitCost : ℝ) : ℝ :=
  widthCoefficient * Real.sqrt (designEffect * unitCost)

/-- Exact coordinate change: a design-effect-corrected raw-count width equals
an ordinary inverse-square-root width in spend coordinates. -/
theorem raw_effective_width_eq_costAdjusted_spend_width
    (widthCoefficient designEffect unitCost rawCount : ℝ)
    (designEffectPositive : 0 < designEffect)
    (unitCostPositive : 0 < unitCost)
    (rawCountPositive : 0 < rawCount) :
    inverseSqrtAllocationCost widthCoefficient
        (effectiveCountFromRaw rawCount designEffect) =
      inverseSqrtAllocationCost
        (designCostAdjustedWidthCoefficient
          widthCoefficient designEffect unitCost)
        (rawSamplingSpend unitCost rawCount) := by
  unfold inverseSqrtAllocationCost effectiveCountFromRaw
    designCostAdjustedWidthCoefficient rawSamplingSpend
  rw [Real.sqrt_div (le_of_lt rawCountPositive)]
  rw [Real.sqrt_mul (le_of_lt designEffectPositive)]
  rw [Real.sqrt_mul (le_of_lt unitCostPositive)]
  have sqrtDesignNonzero : Real.sqrt designEffect ≠ 0 := by positivity
  have sqrtCostNonzero : Real.sqrt unitCost ≠ 0 := by positivity
  have sqrtRawNonzero : Real.sqrt rawCount ≠ 0 := by positivity
  field_simp

/-- The adjusted coefficient is positive whenever all physical inputs are
positive. -/
theorem designCostAdjustedWidthCoefficient_positive
    (widthCoefficient designEffect unitCost : ℝ)
    (widthCoefficientPositive : 0 < widthCoefficient)
    (designEffectPositive : 0 < designEffect)
    (unitCostPositive : 0 < unitCost) :
    0 < designCostAdjustedWidthCoefficient
      widthCoefficient designEffect unitCost := by
  unfold designCostAdjustedWidthCoefficient
  positivity

/-- A root-free cube-balance certificate in spend coordinates proves the
unique global optimum for heterogeneous design effects and unit costs. -/
theorem adjusted_spend_cube_balance_certifies_unique_raw_plan
    {Index : Type} [Fintype Index] [Nonempty Index]
    (widthCoefficient designEffect unitCost : Index → ℝ)
    (candidateSpend competitorSpend : Index → ℝ)
    (reference : Index)
    (widthCoefficientPositive : ∀ index, 0 < widthCoefficient index)
    (designEffectPositive : ∀ index, 0 < designEffect index)
    (unitCostPositive : ∀ index, 0 < unitCost index)
    (candidateSpendPositive : ∀ index, 0 < candidateSpend index)
    (competitorSpendPositive : ∀ index, 0 < competitorSpend index)
    (cubeBalance : ∀ index,
      designCostAdjustedWidthCoefficient
          (widthCoefficient index) (designEffect index) (unitCost index) ^ 2 *
          candidateSpend reference ^ 3 =
        designCostAdjustedWidthCoefficient
          (widthCoefficient reference) (designEffect reference)
            (unitCost reference) ^ 2 * candidateSpend index ^ 3)
    (competitorBudget :
      (∑ index, competitorSpend index) ≤ ∑ index, candidateSpend index)
    (different : competitorSpend ≠ candidateSpend) :
    (∑ index, inverseSqrtAllocationCost
        (designCostAdjustedWidthCoefficient
          (widthCoefficient index) (designEffect index) (unitCost index))
        (candidateSpend index)) <
      ∑ index, inverseSqrtAllocationCost
        (designCostAdjustedWidthCoefficient
          (widthCoefficient index) (designEffect index) (unitCost index))
        (competitorSpend index) := by
  apply cube_balance_certificate_unique_allocation_optimum
    (fun index => designCostAdjustedWidthCoefficient
      (widthCoefficient index) (designEffect index) (unitCost index))
    candidateSpend competitorSpend reference
  · intro index
    exact designCostAdjustedWidthCoefficient_positive
      (widthCoefficient index) (designEffect index) (unitCost index)
      (widthCoefficientPositive index) (designEffectPositive index)
      (unitCostPositive index)
  · exact candidateSpendPositive
  · exact competitorSpendPositive
  · exact cubeBalance
  · exact competitorBudget
  · exact different

/-- Spend allocation converts back to a raw-count plan without changing total
registered spend. -/
theorem spend_to_raw_count_exact
    (unitCost spend : ℝ) (unitCostNonzero : unitCost ≠ 0) :
    rawSamplingSpend unitCost (spend / unitCost) = spend := by
  unfold rawSamplingSpend
  field_simp

/-- The cube-balance condition in spend coordinates has an equivalent
root-free raw-count form. -/
theorem adjusted_spend_cube_balance_iff_raw_balance
    (leftWidth rightWidth leftDesign rightDesign leftCost rightCost
      leftRaw rightRaw : ℝ)
    (leftDesignNonnegative : 0 ≤ leftDesign)
    (rightDesignNonnegative : 0 ≤ rightDesign)
    (leftCostNonnegative : 0 ≤ leftCost)
    (rightCostNonnegative : 0 ≤ rightCost) :
    designCostAdjustedWidthCoefficient leftWidth leftDesign leftCost ^ 2 *
        rawSamplingSpend rightCost rightRaw ^ 3 =
      designCostAdjustedWidthCoefficient rightWidth rightDesign rightCost ^ 2 *
        rawSamplingSpend leftCost leftRaw ^ 3 ↔
      leftWidth ^ 2 * leftDesign * leftCost * rightCost ^ 3 * rightRaw ^ 3 =
        rightWidth ^ 2 * rightDesign * rightCost * leftCost ^ 3 *
          leftRaw ^ 3 := by
  have leftSquare : (Real.sqrt (leftDesign * leftCost)) ^ 2 =
      leftDesign * leftCost :=
    Real.sq_sqrt (mul_nonneg leftDesignNonnegative leftCostNonnegative)
  have rightSquare : (Real.sqrt (rightDesign * rightCost)) ^ 2 =
      rightDesign * rightCost :=
    Real.sq_sqrt (mul_nonneg rightDesignNonnegative rightCostNonnegative)
  unfold designCostAdjustedWidthCoefficient rawSamplingSpend
  simp only [mul_pow]
  rw [leftSquare, rightSquare]
  ring

end OCKIndividuationMSpaceComposition
