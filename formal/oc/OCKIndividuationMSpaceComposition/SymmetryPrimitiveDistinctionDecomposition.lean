import OCKIndividuationMSpaceComposition.SymmetryPrimitiveDistinction
import Mathlib.Tactic.Ring

namespace OCKIndividuationMSpaceComposition

universe uCarrier uScalar

/-!
# Invariant and odd decomposition generated by a primitive distinction

A primitive distinction already derives a canonical swap on its generated
two-point axis.  Over any characteristic-zero field, every scalar observable
on that axis therefore splits canonically into an invariant (even) part and an
anti-invariant (odd) part.  This module proves existence, transformation laws,
reconstruction, trivial intersection and uniqueness of that splitting.

No ambient action is assumed.  The decomposition is local to the axis cut out
by the two unequal endpoints, exactly matching the global-extension boundary
proved elsewhere.
-/

namespace PrimitiveDistinction

/-- An observable is even when the derived endpoint swap preserves it. -/
def EvenObservable {Carrier : Type uCarrier} {Scalar : Type uScalar}
    (distinction : PrimitiveDistinction Carrier)
    (observable : distinction.Axis → Scalar) : Prop :=
  ∀ point, observable (distinction.axisSwap point) = observable point

/-- An observable is odd when the derived endpoint swap negates it. -/
def OddObservable {Carrier : Type uCarrier} {Scalar : Type uScalar}
    [Neg Scalar] (distinction : PrimitiveDistinction Carrier)
    (observable : distinction.Axis → Scalar) : Prop :=
  ∀ point, observable (distinction.axisSwap point) = -observable point

/-- Reynolds projection onto the invariant component for the derived C₂
action. -/
noncomputable def generatedEvenPart
    {Carrier : Type uCarrier} {Scalar : Type uScalar}
    [Field Scalar] [CharZero Scalar]
    (distinction : PrimitiveDistinction Carrier)
    (observable : distinction.Axis → Scalar) : distinction.Axis → Scalar :=
  fun point =>
    (observable point + observable (distinction.axisSwap point)) / 2

/-- Projection onto the sign/odd component for the derived C₂ action. -/
noncomputable def generatedOddPart
    {Carrier : Type uCarrier} {Scalar : Type uScalar}
    [Field Scalar] [CharZero Scalar]
    (distinction : PrimitiveDistinction Carrier)
    (observable : distinction.Axis → Scalar) : distinction.Axis → Scalar :=
  fun point =>
    (observable point - observable (distinction.axisSwap point)) / 2

/-- The Reynolds component is invariant under the derived swap. -/
theorem generatedEvenPart_invariant
    {Carrier : Type uCarrier} {Scalar : Type uScalar}
    [Field Scalar] [CharZero Scalar]
    (distinction : PrimitiveDistinction Carrier)
    (observable : distinction.Axis → Scalar) :
    distinction.EvenObservable
      (distinction.generatedEvenPart observable) := by
  intro point
  simp only [generatedEvenPart, distinction.axisSwap_involutive point]
  ring

/-- The complementary component transforms by the non-trivial sign
character. -/
theorem generatedOddPart_antiInvariant
    {Carrier : Type uCarrier} {Scalar : Type uScalar}
    [Field Scalar] [CharZero Scalar]
    (distinction : PrimitiveDistinction Carrier)
    (observable : distinction.Axis → Scalar) :
    distinction.OddObservable
      (distinction.generatedOddPart observable) := by
  intro point
  simp only [generatedOddPart, distinction.axisSwap_involutive point]
  ring

/-- Every observable is exactly the sum of its invariant and odd parts. -/
theorem generated_even_odd_reconstruction
    {Carrier : Type uCarrier} {Scalar : Type uScalar}
    [Field Scalar] [CharZero Scalar]
    (distinction : PrimitiveDistinction Carrier)
    (observable : distinction.Axis → Scalar) (point : distinction.Axis) :
    distinction.generatedEvenPart observable point +
        distinction.generatedOddPart observable point = observable point := by
  simp only [generatedEvenPart, generatedOddPart]
  ring

/-- The even and odd subspaces meet only at zero. -/
theorem even_and_odd_observable_is_zero
    {Carrier : Type uCarrier} {Scalar : Type uScalar}
    [Field Scalar] [CharZero Scalar]
    (distinction : PrimitiveDistinction Carrier)
    (observable : distinction.Axis → Scalar)
    (even : distinction.EvenObservable observable)
    (odd : distinction.OddObservable observable) :
    ∀ point, observable point = 0 := by
  intro point
  have agreement : observable point = -observable point := by
    calc
      observable point = observable (distinction.axisSwap point) :=
        (even point).symm
      _ = -observable point := odd point
  have doubled : observable point + observable point = 0 := by
    calc
      observable point + observable point =
          -observable point + observable point :=
        congrArg (fun value => value + observable point) agreement
      _ = 0 := neg_add_cancel (observable point)
  have twoTimes : (2 : Scalar) * observable point = 0 := by
    simpa [two_mul] using doubled
  exact (mul_eq_zero.mp twoTimes).resolve_left (by norm_num)

/-- The invariant/odd splitting is unique. -/
theorem generated_even_odd_decomposition_unique
    {Carrier : Type uCarrier} {Scalar : Type uScalar}
    [Field Scalar] [CharZero Scalar]
    (distinction : PrimitiveDistinction Carrier)
    (observable evenPart oddPart : distinction.Axis → Scalar)
    (even : distinction.EvenObservable evenPart)
    (odd : distinction.OddObservable oddPart)
    (reconstruct : ∀ point, evenPart point + oddPart point = observable point) :
    (∀ point,
        evenPart point = distinction.generatedEvenPart observable point) ∧
      (∀ point,
        oddPart point = distinction.generatedOddPart observable point) := by
  constructor
  · intro point
    have atSwap := reconstruct (distinction.axisSwap point)
    rw [even point, odd point] at atSwap
    have atSwap' : evenPart point - oddPart point =
        observable (distinction.axisSwap point) := by
      simpa [sub_eq_add_neg] using atSwap
    have atPoint := reconstruct point
    change evenPart point =
      (observable point + observable (distinction.axisSwap point)) / 2
    apply (eq_div_iff (by norm_num : (2 : Scalar) ≠ 0)).2
    calc
      evenPart point * 2 =
          (evenPart point + oddPart point) +
            (evenPart point - oddPart point) := by ring
      _ = observable point +
          observable (distinction.axisSwap point) := by rw [atPoint, atSwap']
  · intro point
    have atSwap := reconstruct (distinction.axisSwap point)
    rw [even point, odd point] at atSwap
    have atSwap' : evenPart point - oddPart point =
        observable (distinction.axisSwap point) := by
      simpa [sub_eq_add_neg] using atSwap
    have atPoint := reconstruct point
    change oddPart point =
      (observable point - observable (distinction.axisSwap point)) / 2
    apply (eq_div_iff (by norm_num : (2 : Scalar) ≠ 0)).2
    calc
      oddPart point * 2 =
          (evenPart point + oddPart point) -
            (evenPart point - oddPart point) := by ring
      _ = observable point -
          observable (distinction.axisSwap point) := by rw [atPoint, atSwap']

/-- On a generated two-point axis, every invariant observable is constant.
This converts orbit invariance into an exact information-loss statement. -/
theorem evenObservable_constant
    {Carrier : Type uCarrier} {Scalar : Type uScalar}
    (distinction : PrimitiveDistinction Carrier)
    (observable : distinction.Axis → Scalar)
    (even : distinction.EvenObservable observable) :
    ∀ first second, observable first = observable second := by
  intro first second
  rcases distinction.axis_cases first with rfl | rfl <;>
    rcases distinction.axis_cases second with rfl | rfl
  · rfl
  · simpa using (even distinction.axisFirst).symm
  · simpa using even distinction.axisFirst
  · rfl

/-- The base-dependent Boolean polarity has a scalar sign realization which
is genuinely odd under the derived swap. -/
noncomputable def generatedSignedPolarity
    {Carrier : Type uCarrier} {Scalar : Type uScalar}
    [Field Scalar] [CharZero Scalar]
    (distinction : PrimitiveDistinction Carrier) : distinction.Axis → Scalar :=
  fun point => if distinction.generatedPolarity point then 1 else -1

theorem generatedSignedPolarity_odd
    {Carrier : Type uCarrier} {Scalar : Type uScalar}
    [Field Scalar] [CharZero Scalar]
    (distinction : PrimitiveDistinction Carrier) :
    distinction.OddObservable
      (distinction.generatedSignedPolarity (Scalar := Scalar)) := by
  intro point
  have flips : distinction.generatedPolarity (distinction.axisSwap point) =
      Bool.not (distinction.generatedPolarity point) := by
    simpa [generatedPolarity, toR3Torsor] using
      r3OrientationEquivBool_reverse distinction.toR3Torsor
        distinction.axisFirst point
  simp only [generatedSignedPolarity, flips]
  cases distinction.generatedPolarity point <;> simp

end PrimitiveDistinction

end OCKIndividuationMSpaceComposition
