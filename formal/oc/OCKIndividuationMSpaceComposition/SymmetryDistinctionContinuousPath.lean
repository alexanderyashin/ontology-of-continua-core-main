import OCKIndividuationMSpaceComposition.SymmetryDistinctionOrderedAxis
import Mathlib.Analysis.Convex.PathConnected

namespace OCKIndividuationMSpaceComposition

universe uCarrier

namespace PrimitiveDistinction

/-!
# From an affine distinction to a continuous path

An ordered affine parameter line still does not by itself assert continuity.
Here the carrier is explicitly supplied as a real topological vector space.
Mathlib's straight segment then turns the two distinguished endpoints into a
continuous path.  The path is injective because the primitive distinction has
nonzero displacement, its range is connected, and endpoint-label reversal is
exactly path reversal.

This is the first topological layer.  It does not derive a topology from bare
distinction, and it does not assert metric completeness, compact completion or
an intrinsic continuum structure for arbitrary OC carriers.
-/

section RealTopologicalRealization

open Set
open scoped unitInterval

variable {V : Type uCarrier} [AddCommGroup V] [Module ℝ V]
  [TopologicalSpace V] [ContinuousAdd V] [ContinuousSMul ℝ V]

/-- The straight continuous path selected by a real topological-vector-space
realization of the distinguished endpoints. -/
def distinctionPath (distinction : PrimitiveDistinction V) :
    Path distinction.first distinction.second :=
  Path.segment distinction.first distinction.second

/-- The bundled path agrees pointwise with the affine parameterization. -/
theorem distinctionPath_apply (distinction : PrimitiveDistinction V)
    (t : unitInterval) :
    distinction.distinctionPath t =
      affineAxisPoint distinction (t : ℝ) := by
  simp [distinctionPath, affineAxisPoint, displacement,
    AffineMap.lineMap_apply_module]
  module

/-- A path generated by a genuine distinction never folds back on itself. -/
theorem distinctionPath_injective (distinction : PrimitiveDistinction V) :
    Function.Injective distinction.distinctionPath := by
  intro firstParameter secondParameter equality
  apply Subtype.ext
  apply affineAxisPoint_injective (K := ℝ) distinction
  simpa only [← distinction.distinctionPath_apply] using equality

/-- The continuous image of the unit interval is connected. -/
theorem distinctionPath_range_connected
    (distinction : PrimitiveDistinction V) :
    IsConnected (Set.range distinction.distinctionPath) :=
  isConnected_range distinction.distinctionPath.continuous

/-- Exchanging the displayed poles reverses, rather than changes, the
underlying straight path. -/
theorem reverseLabels_distinctionPath
    (distinction : PrimitiveDistinction V) :
    distinction.distinctionPath.symm =
      distinction.reverseLabels.distinctionPath := by
  simp [distinctionPath, reverseLabels]

/-- The unit-interval midpoint. -/
noncomputable def unitMidpoint : unitInterval :=
  ⟨(1 / 2 : ℝ), by constructor <;> norm_num⟩

/-- The path midpoint is exactly the affine midpoint fixed by label reversal. -/
theorem distinctionPath_unitMidpoint
    (distinction : PrimitiveDistinction V) :
    distinction.distinctionPath unitMidpoint =
      affineMidpoint (K := ℝ) distinction := by
  rw [distinctionPath_apply]
  rfl

/-- The continuous segment strictly extends the original two-point generated
axis: its midpoint is in the path range but is neither endpoint. -/
theorem distinctionPath_has_strict_internal_point
    (distinction : PrimitiveDistinction V) :
    ∃ point ∈ Set.range distinction.distinctionPath,
      point ≠ distinction.first ∧ point ≠ distinction.second := by
  refine ⟨affineMidpoint (K := ℝ) distinction, ?_,
    affineMidpoint_outside (K := ℝ) distinction⟩
  exact ⟨unitMidpoint, distinction.distinctionPath_unitMidpoint⟩

end RealTopologicalRealization

end PrimitiveDistinction

end OCKIndividuationMSpaceComposition
