import OCKIndividuationMSpaceComposition.QuantitativeContextTransport
import OCKIndividuationMSpaceComposition.ThresholdActivatedGovernanceHazard
import OCKIndividuationMSpaceComposition.UniversalPredictiveDynamics
import OCKIndividuationMSpaceComposition.PopulationObservationBounds

namespace OCKIndividuationMSpaceComposition

/-!
# Defect-response dynamics and experimental identifiability

The evidence defect is not itself a behavioral law.  This module supplies the
smallest registered response family that yields numerical predictions and then
states exactly what data identify it.  The clipped affine family is a domain
adapter, not a universal empirical assertion of OC.
-/

/-- Unclipped affine response used for identification algebra. -/
def affineDefectResponse (baseline sensitivity defect : ℚ) : ℚ :=
  baseline + sensitivity * defect

/-- Probability-valued affine response, clipped to the unit interval. -/
def clippedAffineDefectResponse
    (baseline sensitivity defect : ℚ) : ℚ :=
  max 0 (min 1 (affineDefectResponse baseline sensitivity defect))

/-- Time-indexed conditional hazard generated by a registered defect trace. -/
def defectDrivenHazard
    (baseline sensitivity : ℚ) (defect : ℕ → ℚ) (t : ℕ) : ℚ :=
  clippedAffineDefectResponse baseline sensitivity (defect t)

theorem clippedAffineDefectResponse_bounds
    (baseline sensitivity defect : ℚ) :
    0 ≤ clippedAffineDefectResponse baseline sensitivity defect ∧
      clippedAffineDefectResponse baseline sensitivity defect ≤ 1 := by
  constructor
  · exact le_max_left _ _
  · apply max_le
    · norm_num
    · exact min_le_left _ _

theorem defectDrivenHazard_valid
    (baseline sensitivity : ℚ) (defect : ℕ → ℚ) :
    ValidBarrierHazard (defectDrivenHazard baseline sensitivity defect) := by
  intro t
  exact clippedAffineDefectResponse_bounds baseline sensitivity (defect t)

theorem clippedAffineDefectResponse_eq_affine_of_interior
    {baseline sensitivity defect : ℚ}
    (nonnegative : 0 ≤ affineDefectResponse baseline sensitivity defect)
    (atMostOne : affineDefectResponse baseline sensitivity defect ≤ 1) :
    clippedAffineDefectResponse baseline sensitivity defect =
      affineDefectResponse baseline sensitivity defect := by
  simp [clippedAffineDefectResponse, min_eq_right atMostOne,
    max_eq_right nonnegative]

theorem affineDefectResponse_mono
    {baseline sensitivity first second : ℚ}
    (sensitivityNonnegative : 0 ≤ sensitivity)
    (defectOrder : first ≤ second) :
    affineDefectResponse baseline sensitivity first ≤
      affineDefectResponse baseline sensitivity second := by
  unfold affineDefectResponse
  simpa [add_comm] using
    (add_le_add_left
      (mul_le_mul_of_nonneg_left defectOrder sensitivityNonnegative) baseline)

theorem clippedAffineDefectResponse_mono
    {baseline sensitivity first second : ℚ}
    (sensitivityNonnegative : 0 ≤ sensitivity)
    (defectOrder : first ≤ second) :
    clippedAffineDefectResponse baseline sensitivity first ≤
      clippedAffineDefectResponse baseline sensitivity second := by
  have rawOrder := affineDefectResponse_mono (baseline := baseline)
    sensitivityNonnegative defectOrder
  exact max_le_max le_rfl (min_le_min le_rfl rawOrder)

theorem affineDefectResponse_strict_mono
    {baseline sensitivity first second : ℚ}
    (sensitivityPositive : 0 < sensitivity)
    (defectOrder : first < second) :
    affineDefectResponse baseline sensitivity first <
      affineDefectResponse baseline sensitivity second := by
  unfold affineDefectResponse
  simpa [add_comm] using
    (add_lt_add_left
      (mul_lt_mul_of_pos_left defectOrder sensitivityPositive) baseline)

/-- Exact finite-horizon prediction for a constant registered defect. -/
theorem constantDefect_barrierCdf
    (baseline sensitivity defect : ℚ) (horizon : ℕ) :
    barrierCdf
        (defectDrivenHazard baseline sensitivity (fun _ => defect)) horizon =
      1 - (1 - clippedAffineDefectResponse baseline sensitivity defect) ^ horizon := by
  change barrierCdf
      (constantBarrierHazard
        (clippedAffineDefectResponse baseline sensitivity defect)) horizon = _
  exact constantBarrierHazard_cdf _ _

/-- Interior version with the unclipped affine hazard visible in the formula. -/
theorem constantDefect_barrierCdf_of_interior
    {baseline sensitivity defect : ℚ}
    (nonnegative : 0 ≤ affineDefectResponse baseline sensitivity defect)
    (atMostOne : affineDefectResponse baseline sensitivity defect ≤ 1)
    (horizon : ℕ) :
    barrierCdf
        (defectDrivenHazard baseline sensitivity (fun _ => defect)) horizon =
      1 - (1 - affineDefectResponse baseline sensitivity defect) ^ horizon := by
  rw [constantDefect_barrierCdf,
    clippedAffineDefectResponse_eq_affine_of_interior nonnegative atMostOne]

/-- Finite-horizon CDF sensitivity to a constant-hazard estimation error. -/
theorem constantBarrierCdf_error_le_horizon_mul_hazardError
    (first second : ℚ)
    (firstBounds : 0 ≤ first ∧ first ≤ 1)
    (secondBounds : 0 ≤ second ∧ second ≤ 1)
    (horizon : ℕ) :
    |barrierCdf (constantBarrierHazard first) horizon -
        barrierCdf (constantBarrierHazard second) horizon| ≤
      (horizon : ℚ) * |first - second| := by
  rw [constantBarrierHazard_cdf, constantBarrierHazard_cdf]
  have firstBaseNonnegative : 0 ≤ 1 - first := sub_nonneg.mpr firstBounds.2
  have secondBaseNonnegative : 0 ≤ 1 - second := sub_nonneg.mpr secondBounds.2
  have firstBaseAbsLe : |1 - first| ≤ 1 := by
    rw [abs_of_nonneg firstBaseNonnegative]
    linarith [firstBounds.1]
  have secondBaseAbsLe : |1 - second| ≤ 1 := by
    rw [abs_of_nonneg secondBaseNonnegative]
    linarith [secondBounds.1]
  have maximumNonnegative : 0 ≤ max |1 - first| |1 - second| :=
    (abs_nonneg _).trans (le_max_left _ _)
  have maximumAtMostOne : max |1 - first| |1 - second| ≤ 1 :=
    max_le firstBaseAbsLe secondBaseAbsLe
  have maximumPowerAtMostOne :
      max |1 - first| |1 - second| ^ (horizon - 1) ≤ 1 :=
    pow_le_one₀ maximumNonnegative maximumAtMostOne
  have powerDifference := abs_pow_sub_pow_le
    (a := (1 - first : ℚ)) (b := (1 - second : ℚ)) (n := horizon)
  calc
    |(1 - (1 - first) ^ horizon) - (1 - (1 - second) ^ horizon)| =
        |(1 - first) ^ horizon - (1 - second) ^ horizon| := by
      rw [abs_sub_comm]
      congr 1
      ring
    _ ≤ |(1 - first) - (1 - second)| * (horizon : ℚ) *
        max |1 - first| |1 - second| ^ (horizon - 1) := powerDifference
    _ ≤ |(1 - first) - (1 - second)| * (horizon : ℚ) * 1 := by
      exact mul_le_mul_of_nonneg_left maximumPowerAtMostOne
        (mul_nonneg (abs_nonneg _) (by positivity))
    _ = (horizon : ℚ) * |first - second| := by
      rw [show (1 - first) - (1 - second) = -(first - second) by ring,
        abs_neg]
      ring

/-- Sensitivity recovered from two distinct registered defect levels. -/
def twoPointSensitivityEstimate
    (firstDefect secondDefect firstHazard secondHazard : ℚ) : ℚ :=
  (secondHazard - firstHazard) / (secondDefect - firstDefect)

/-- Baseline recovered after the two-point sensitivity estimate. -/
def twoPointBaselineEstimate
    (firstDefect secondDefect firstHazard secondHazard : ℚ) : ℚ :=
  firstHazard -
    twoPointSensitivityEstimate
      firstDefect secondDefect firstHazard secondHazard * firstDefect

/-- Two distinct noiseless interior design points exactly identify the affine law. -/
theorem two_distinct_defect_levels_identify_affine_response
    (baseline sensitivity firstDefect secondDefect : ℚ)
    (distinct : firstDefect ≠ secondDefect) :
    twoPointSensitivityEstimate firstDefect secondDefect
        (affineDefectResponse baseline sensitivity firstDefect)
        (affineDefectResponse baseline sensitivity secondDefect) = sensitivity ∧
      twoPointBaselineEstimate firstDefect secondDefect
        (affineDefectResponse baseline sensitivity firstDefect)
        (affineDefectResponse baseline sensitivity secondDefect) = baseline := by
  have denominator : secondDefect - firstDefect ≠ 0 :=
    sub_ne_zero.mpr distinct.symm
  constructor
  · unfold twoPointSensitivityEstimate affineDefectResponse
    field_simp [denominator]
    ring
  · unfold twoPointBaselineEstimate
    rw [(show twoPointSensitivityEstimate firstDefect secondDefect
        (affineDefectResponse baseline sensitivity firstDefect)
        (affineDefectResponse baseline sensitivity secondDefect) = sensitivity by
      unfold twoPointSensitivityEstimate affineDefectResponse
      field_simp [denominator]
      ring)]
    unfold affineDefectResponse
    ring

/--
No-go for model checking with only two levels: every pair of outcomes at
distinct defects has an exact affine interpolant, whether or not the unknown
global response is affine.
-/
theorem any_two_distinct_points_admit_exact_affine_fit
    (firstDefect secondDefect firstHazard secondHazard : ℚ)
    (distinct : firstDefect ≠ secondDefect) :
    let sensitivity := twoPointSensitivityEstimate
      firstDefect secondDefect firstHazard secondHazard
    let baseline := twoPointBaselineEstimate
      firstDefect secondDefect firstHazard secondHazard
    affineDefectResponse baseline sensitivity firstDefect = firstHazard ∧
      affineDefectResponse baseline sensitivity secondDefect = secondHazard := by
  have denominator : secondDefect - firstDefect ≠ 0 :=
    sub_ne_zero.mpr distinct.symm
  dsimp only
  constructor
  · unfold affineDefectResponse twoPointBaselineEstimate
    ring
  · unfold affineDefectResponse twoPointBaselineEstimate
    unfold twoPointSensitivityEstimate
    field_simp [denominator]
    ring

/-- Division-free three-point compatibility condition for one affine law. -/
def ThreePointAffineCompatible
    (firstDefect secondDefect thirdDefect
      firstHazard secondHazard thirdHazard : ℚ) : Prop :=
  (secondHazard - firstHazard) * (thirdDefect - firstDefect) =
    (thirdHazard - firstHazard) * (secondDefect - firstDefect)

theorem affine_response_is_threePointCompatible
    (baseline sensitivity firstDefect secondDefect thirdDefect : ℚ) :
    ThreePointAffineCompatible firstDefect secondDefect thirdDefect
      (affineDefectResponse baseline sensitivity firstDefect)
      (affineDefectResponse baseline sensitivity secondDefect)
      (affineDefectResponse baseline sensitivity thirdDefect) := by
  unfold ThreePointAffineCompatible affineDefectResponse
  ring

/-- A registered three-point curvature violation refutes the affine adapter. -/
theorem threePoint_incompatibility_refutes_affine_response
    (firstDefect secondDefect thirdDefect
      firstHazard secondHazard thirdHazard : ℚ)
    (incompatible : ¬ ThreePointAffineCompatible
      firstDefect secondDefect thirdDefect
      firstHazard secondHazard thirdHazard) :
    ¬ ∃ baseline sensitivity,
      affineDefectResponse baseline sensitivity firstDefect = firstHazard ∧
      affineDefectResponse baseline sensitivity secondDefect = secondHazard ∧
      affineDefectResponse baseline sensitivity thirdDefect = thirdHazard := by
  rintro ⟨baseline, sensitivity, first, second, third⟩
  apply incompatible
  rw [← first, ← second, ← third]
  exact affine_response_is_threePointCompatible
    baseline sensitivity firstDefect secondDefect thirdDefect

/-- No-go: one defect level cannot identify both affine parameters. -/
theorem one_defect_level_does_not_identify_affine_response
    (observedHazard defect : ℚ) :
    affineDefectResponse observedHazard 0 defect =
        affineDefectResponse (observedHazard - defect) 1 defect ∧
      (observedHazard, (0 : ℚ)) ≠ (observedHazard - defect, (1 : ℚ)) := by
  constructor
  · unfold affineDefectResponse
    ring
  · intro equalPair
    have slopeEquality := congrArg Prod.snd equalPair
    norm_num at slopeEquality

/-- Linear interpolation between two registered hazard endpoints. -/
def twoPointInterpolate (weight first second : ℚ) : ℚ :=
  (1 - weight) * first + weight * second

theorem twoPointInterpolate_bounds
    {weight first second : ℚ}
    (weightNonnegative : 0 ≤ weight)
    (weightAtMostOne : weight ≤ 1)
    (firstBounds : 0 ≤ first ∧ first ≤ 1)
    (secondBounds : 0 ≤ second ∧ second ≤ 1) :
    0 ≤ twoPointInterpolate weight first second ∧
      twoPointInterpolate weight first second ≤ 1 := by
  have leftWeightNonnegative : 0 ≤ 1 - weight :=
    sub_nonneg.mpr weightAtMostOne
  constructor
  · unfold twoPointInterpolate
    exact add_nonneg
      (mul_nonneg leftWeightNonnegative firstBounds.1)
      (mul_nonneg weightNonnegative secondBounds.1)
  · have firstSlack : 0 ≤ (1 - weight) * (1 - first) :=
      mul_nonneg leftWeightNonnegative (sub_nonneg.mpr firstBounds.2)
    have secondSlack : 0 ≤ weight * (1 - second) :=
      mul_nonneg weightNonnegative (sub_nonneg.mpr secondBounds.2)
    unfold twoPointInterpolate
    nlinarith

theorem affine_response_interpolates_exactly
    (baseline sensitivity weight firstDefect secondDefect : ℚ) :
    twoPointInterpolate weight
        (affineDefectResponse baseline sensitivity firstDefect)
        (affineDefectResponse baseline sensitivity secondDefect) =
      affineDefectResponse baseline sensitivity
        (twoPointInterpolate weight firstDefect secondDefect) := by
  unfold twoPointInterpolate affineDefectResponse
  ring

/-- General endpoint-error propagation, including extrapolation. -/
theorem twoPointInterpolate_error_bound
    (weight trueFirst trueSecond estimatedFirst estimatedSecond epsilon : ℚ)
    (firstError : |estimatedFirst - trueFirst| ≤ epsilon)
    (secondError : |estimatedSecond - trueSecond| ≤ epsilon) :
    |twoPointInterpolate weight estimatedFirst estimatedSecond -
        twoPointInterpolate weight trueFirst trueSecond| ≤
      (|1 - weight| + |weight|) * epsilon := by
  have identity :
      twoPointInterpolate weight estimatedFirst estimatedSecond -
          twoPointInterpolate weight trueFirst trueSecond =
        (1 - weight) * (estimatedFirst - trueFirst) +
          weight * (estimatedSecond - trueSecond) := by
    unfold twoPointInterpolate
    ring
  rw [identity]
  calc
    |(1 - weight) * (estimatedFirst - trueFirst) +
        weight * (estimatedSecond - trueSecond)| ≤
        |(1 - weight) * (estimatedFirst - trueFirst)| +
          |weight * (estimatedSecond - trueSecond)| := abs_add_le _ _
    _ = |1 - weight| * |estimatedFirst - trueFirst| +
        |weight| * |estimatedSecond - trueSecond| := by
      rw [abs_mul, abs_mul]
    _ ≤ |1 - weight| * epsilon + |weight| * epsilon :=
      add_le_add
        (mul_le_mul_of_nonneg_left firstError (abs_nonneg _))
        (mul_le_mul_of_nonneg_left secondError (abs_nonneg _))
    _ = (|1 - weight| + |weight|) * epsilon := by ring

/-- Interpolation inside the designed bracket does not amplify endpoint error. -/
theorem twoPointInterpolate_interior_error_bound
    (weight trueFirst trueSecond estimatedFirst estimatedSecond epsilon : ℚ)
    (weightNonnegative : 0 ≤ weight)
    (weightAtMostOne : weight ≤ 1)
    (firstError : |estimatedFirst - trueFirst| ≤ epsilon)
    (secondError : |estimatedSecond - trueSecond| ≤ epsilon) :
    |twoPointInterpolate weight estimatedFirst estimatedSecond -
        twoPointInterpolate weight trueFirst trueSecond| ≤ epsilon := by
  have general := twoPointInterpolate_error_bound weight
    trueFirst trueSecond estimatedFirst estimatedSecond epsilon
    firstError secondError
  rw [abs_of_nonneg (sub_nonneg.mpr weightAtMostOne),
    abs_of_nonneg weightNonnegative] at general
  convert general using 1
  all_goals ring

/--
Operational prediction bound: endpoint hazard error `epsilon` implies at most
`horizon * epsilon` error in the finite-horizon barrier CDF anywhere inside
the registered two-point design bracket.
-/
theorem interpolated_barrierCdf_error_bound
    (weight trueFirst trueSecond estimatedFirst estimatedSecond epsilon : ℚ)
    (weightNonnegative : 0 ≤ weight)
    (weightAtMostOne : weight ≤ 1)
    (trueFirstBounds : 0 ≤ trueFirst ∧ trueFirst ≤ 1)
    (trueSecondBounds : 0 ≤ trueSecond ∧ trueSecond ≤ 1)
    (estimatedFirstBounds : 0 ≤ estimatedFirst ∧ estimatedFirst ≤ 1)
    (estimatedSecondBounds : 0 ≤ estimatedSecond ∧ estimatedSecond ≤ 1)
    (firstError : |estimatedFirst - trueFirst| ≤ epsilon)
    (secondError : |estimatedSecond - trueSecond| ≤ epsilon)
    (horizon : ℕ) :
    |barrierCdf
          (constantBarrierHazard
            (twoPointInterpolate weight estimatedFirst estimatedSecond)) horizon -
        barrierCdf
          (constantBarrierHazard
            (twoPointInterpolate weight trueFirst trueSecond)) horizon| ≤
      (horizon : ℚ) * epsilon := by
  have trueBounds := twoPointInterpolate_bounds
    weightNonnegative weightAtMostOne trueFirstBounds trueSecondBounds
  have estimatedBounds := twoPointInterpolate_bounds
    weightNonnegative weightAtMostOne estimatedFirstBounds estimatedSecondBounds
  have hazardError := twoPointInterpolate_interior_error_bound
    weight trueFirst trueSecond estimatedFirst estimatedSecond epsilon
    weightNonnegative weightAtMostOne firstError secondError
  have cdfError := constantBarrierCdf_error_le_horizon_mul_hazardError
    (twoPointInterpolate weight estimatedFirst estimatedSecond)
    (twoPointInterpolate weight trueFirst trueSecond)
    estimatedBounds trueBounds horizon
  exact cdfError.trans
    (mul_le_mul_of_nonneg_left hazardError (by positivity))

/-- Mature finite-family concentration budget specialized to two design endpoints. -/
theorem two_defect_endpoint_sample_budget
    (sampleSize : ℕ) (epsilon delta : ℝ)
    (epsilonPositive : 0 < epsilon)
    (deltaPositive : 0 < delta)
    (logBudget : Real.log (4 / delta) ≤
      2 * (sampleSize : ℝ) * epsilon ^ 2) :
    UniformConcentrationCertificate sampleSize 2 epsilon delta := by
  apply uniformConcentrationCertificate_of_log_budget
    sampleSize 2 epsilon delta epsilonPositive deltaPositive (by norm_num)
  norm_num at logBudget ⊢
  exact logBudget

/-- Three-level concentration budget for the first falsifiable affine-form check. -/
theorem three_defect_level_sample_budget
    (sampleSize : ℕ) (epsilon delta : ℝ)
    (epsilonPositive : 0 < epsilon)
    (deltaPositive : 0 < delta)
    (logBudget : Real.log (6 / delta) ≤
      2 * (sampleSize : ℝ) * epsilon ^ 2) :
    UniformConcentrationCertificate sampleSize 3 epsilon delta := by
  apply uniformConcentrationCertificate_of_log_budget
    sampleSize 3 epsilon delta epsilonPositive deltaPositive (by norm_num)
  norm_num at logBudget ⊢
  exact logBudget

/-- Defect aliasing with different outcomes rules out a defect-only exact predictor. -/
theorem defect_collision_no_exact_outcome_predictor
    {World Outcome : Type}
    (defect : World → ℚ) (outcome : World → Outcome)
    (left right : World)
    (sameDefect : defect left = defect right)
    (differentOutcome : outcome left ≠ outcome right) :
    ¬ ∃ predictor : ℚ → Outcome,
      ∀ world, predictor (defect world) = outcome world :=
  observation_collision_no_exact_predictor
    defect outcome left right sameDefect differentOutcome

/-- Quantitative minimax corollary: at most one of an aliased outcome pair is correct. -/
theorem defect_collision_pair_correct_count_le_one
    {World Outcome : Type} [DecidableEq Outcome]
    (defect : World → ℚ) (outcome : World → Outcome)
    (predictor : ℚ → Outcome)
    (left right : World)
    (sameDefect : defect left = defect right)
    (differentOutcome : outcome left ≠ outcome right) :
    ZeroOneCorrect (predictor (defect left)) (outcome left) +
        ZeroOneCorrect (predictor (defect right)) (outcome right) ≤ 1 :=
  observation_collision_pair_correct_count_le_one
    defect outcome predictor left right sameDefect differentOutcome

