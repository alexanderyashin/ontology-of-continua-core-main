import OCKIndividuationMSpaceComposition.UniversalDynamics

namespace OCKIndividuationMSpaceComposition

universe uState uInput uState' uInput' uState'' uInput''

/-!
# A derived path-space for open dynamics

`DerivedMSpace` is the proof-carrying space of finite histories generated by a
*specified* initial state and a *specified* input-labelled transition law.  It
is therefore downstream of a dynamical model and its boundary/interface
choices.  It is neither the historical, prose-level M-Space nor the existing
`MSpaceFiber` of admissible representational lifts.

The construction records more than an endpoint: different input histories can
reach the same endpoint, and one history can branch to different endpoints.
Those two possibilities are exhibited by finite countermodels below.
-/

/-- Finite proof-carrying histories of an input-labelled open transition law. -/
inductive OpenHistory
    {State : Type uState}
    {Input : Type uInput}
    (transition : State → Input → State → Prop)
    (initial : State) : State → Type (max uState uInput)
  | start : OpenHistory transition initial initial
  | extend {current next : State} :
      OpenHistory transition initial current →
      (input : Input) →
      transition current input next →
      OpenHistory transition initial next

/-- The derived M-space contains an endpoint together with a history proving it. -/
abbrev DerivedMSpace
    {State : Type uState}
    {Input : Type uInput}
    (transition : State → Input → State → Prop)
    (initial : State) :=
  Σ endpoint, OpenHistory transition initial endpoint

/-- Propositional endpoint reachability after finitely many labelled steps. -/
inductive OpenReachable
    {State : Type uState}
    {Input : Type uInput}
    (transition : State → Input → State → Prop)
    (initial : State) : State → Prop
  | initial : OpenReachable transition initial initial
  | step {current next : State} :
      OpenReachable transition initial current →
      (input : Input) →
      transition current input next →
      OpenReachable transition initial next

namespace OpenHistory

/-- Number of transitions in a finite open history. -/
def length
    {State : Type uState}
    {Input : Type uInput}
    {transition : State → Input → State → Prop}
    {initial endpoint : State} :
    OpenHistory transition initial endpoint → Nat
  | .start => 0
  | .extend previous _ _ => previous.length + 1

/-- Reverse chronological input trace; sufficient to distinguish histories. -/
def inputTrace
    {State : Type uState}
    {Input : Type uInput}
    {transition : State → Input → State → Prop}
    {initial endpoint : State} :
    OpenHistory transition initial endpoint → List Input
  | .start => []
  | .extend previous input _ => input :: previous.inputTrace

/-- Every proof-carrying history has a propositionally reachable endpoint. -/
theorem reachable
    {State : Type uState}
    {Input : Type uInput}
    {transition : State → Input → State → Prop}
    {initial endpoint : State}
    (history : OpenHistory transition initial endpoint) :
    OpenReachable transition initial endpoint := by
  induction history with
  | start => exact .initial
  | extend previous input edge inductionHypothesis =>
      exact .step inductionHypothesis input edge

/--
Concatenate a prefix history with a continuation whose initial state is the
prefix endpoint.  This is the path-space analogue of process composition.
-/
def append
    {State : Type uState}
    {Input : Type uInput}
    {transition : State → Input → State → Prop}
    {initial middle endpoint : State}
    (prefixHistory : OpenHistory transition initial middle) :
    OpenHistory transition middle endpoint →
      OpenHistory transition initial endpoint
  | .start => prefixHistory
  | .extend continuation input edge =>
      .extend (prefixHistory.append continuation) input edge

/-- Appending histories adds their transition lengths. -/
theorem length_append
    {State : Type uState}
    {Input : Type uInput}
    {transition : State → Input → State → Prop}
    {initial middle endpoint : State}
    (prefixHistory : OpenHistory transition initial middle)
    (continuation : OpenHistory transition middle endpoint) :
    (prefixHistory.append continuation).length =
      prefixHistory.length + continuation.length := by
  induction continuation with
  | start => simp [append, length]
  | extend previous input edge inductionHypothesis =>
      simp only [append, length, inductionHypothesis, Nat.add_assoc]

/-- The reverse-chronological trace of an append is continuation then prefix. -/
theorem inputTrace_append
    {State : Type uState}
    {Input : Type uInput}
    {transition : State → Input → State → Prop}
    {initial middle endpoint : State}
    (prefixHistory : OpenHistory transition initial middle)
    (continuation : OpenHistory transition middle endpoint) :
    (prefixHistory.append continuation).inputTrace =
      continuation.inputTrace ++ prefixHistory.inputTrace := by
  induction continuation with
  | start => simp [append, inputTrace]
  | extend previous input edge inductionHypothesis =>
      simp only [append, inputTrace, inductionHypothesis, List.cons_append]

/-- A typed prefix witness retains the intermediate endpoint and continuation. -/
structure PrefixOf
    {State : Type uState}
    {Input : Type uInput}
    {transition : State → Input → State → Prop}
    {initial endpoint : State}
    (prefixPoint : DerivedMSpace transition initial)
    (whole : OpenHistory transition initial endpoint) : Type (max uState uInput) where
  continuation : OpenHistory transition prefixPoint.1 endpoint
  factors : prefixPoint.2.append continuation = whole

/-- Every history is a prefix of itself, with a zero-step continuation. -/
def prefixOf_self
    {State : Type uState}
    {Input : Type uInput}
    {transition : State → Input → State → Prop}
    {initial endpoint : State}
    (history : OpenHistory transition initial endpoint) :
    PrefixOf ⟨endpoint, history⟩ history := by
  exact ⟨.start, rfl⟩

/-- A state predicate is transition-invariant when every labelled step preserves it. -/
def PreservesInvariant
    {State : Type uState}
    {Input : Type uInput}
    (transition : State → Input → State → Prop)
    (invariant : State → Prop) : Prop :=
  ∀ ⦃current next⦄ (input),
    invariant current → transition current input next → invariant next

/-- Every generated history preserves every transition invariant true initially. -/
theorem invariant
    {State : Type uState}
    {Input : Type uInput}
    {transition : State → Input → State → Prop}
    {initial endpoint : State}
    {invariant : State → Prop}
    (history : OpenHistory transition initial endpoint)
    (initialInvariant : invariant initial)
    (preserved : PreservesInvariant transition invariant) :
    invariant endpoint := by
  induction history with
  | start => exact initialInvariant
  | extend previous input edge inductionHypothesis =>
      exact preserved input inductionHypothesis edge

end OpenHistory

/-- Every point of the derived M-space has a reachable endpoint. -/
theorem DerivedMSpace.endpoint_reachable
    {State : Type uState}
    {Input : Type uInput}
    {transition : State → Input → State → Prop}
    {initial : State}
    (point : DerivedMSpace transition initial) :
    OpenReachable transition initial point.1 :=
  point.2.reachable

/-- Every point of the derived M-space satisfies an initially true invariant. -/
theorem DerivedMSpace.endpoint_invariant
    {State : Type uState}
    {Input : Type uInput}
    {transition : State → Input → State → Prop}
    {initial : State}
    {invariant : State → Prop}
    (initialInvariant : invariant initial)
    (preserved : OpenHistory.PreservesInvariant transition invariant)
    (point : DerivedMSpace transition initial) :
    invariant point.1 :=
  point.2.invariant initialInvariant preserved

/-!
## Naturality under transition morphisms
-/

/-- A typed morphism of open transition systems, including the input interface. -/
structure OpenTransitionMorphism
    {State : Type uState}
    {Input : Type uInput}
    {State' : Type uState'}
    {Input' : Type uInput'}
    (transition : State → Input → State → Prop)
    (transition' : State' → Input' → State' → Prop) where
  stateMap : State → State'
  inputMap : Input → Input'
  preserves : ∀ ⦃current next⦄ (input),
    transition current input next →
      transition' (stateMap current) (inputMap input) (stateMap next)

namespace OpenTransitionMorphism

/-- Identity morphism of an open transition system. -/
def identity
    {State : Type uState}
    {Input : Type uInput}
    (transition : State → Input → State → Prop) :
    OpenTransitionMorphism transition transition where
  stateMap := id
  inputMap := id
  preserves := by intro current next input edge; exact edge

/-- Composition of typed open-transition morphisms. -/
def comp
    {State : Type uState}
    {Input : Type uInput}
    {State' : Type uState'}
    {Input' : Type uInput'}
    {State'' : Type uState''}
    {Input'' : Type uInput''}
    {transition : State → Input → State → Prop}
    {transition' : State' → Input' → State' → Prop}
    {transition'' : State'' → Input'' → State'' → Prop}
    (later : OpenTransitionMorphism transition' transition'')
    (earlier : OpenTransitionMorphism transition transition') :
    OpenTransitionMorphism transition transition'' where
  stateMap := later.stateMap ∘ earlier.stateMap
  inputMap := later.inputMap ∘ earlier.inputMap
  preserves := by
    intro current next input edge
    exact later.preserves (earlier.inputMap input) (earlier.preserves input edge)

end OpenTransitionMorphism

namespace OpenHistory

/-- Map an entire proof-carrying history along a transition morphism. -/
def map
    {State : Type uState}
    {Input : Type uInput}
    {State' : Type uState'}
    {Input' : Type uInput'}
    {transition : State → Input → State → Prop}
    {transition' : State' → Input' → State' → Prop}
    (morphism : OpenTransitionMorphism transition transition')
    {initial endpoint : State} :
    OpenHistory transition initial endpoint →
      OpenHistory transition' (morphism.stateMap initial)
        (morphism.stateMap endpoint)
  | .start => .start
  | .extend previous input edge =>
      .extend (previous.map morphism) (morphism.inputMap input)
        (morphism.preserves input edge)

/-- Mapping a proof-carrying history along the identity morphism changes
nothing, including its dependent endpoint index. -/
theorem map_identity
    {State : Type uState}
    {Input : Type uInput}
    {transition : State → Input → State → Prop}
    {initial endpoint : State}
    (history : OpenHistory transition initial endpoint) :
    history.map (OpenTransitionMorphism.identity transition) = history := by
  induction history with
  | start => rfl
  | extend previous input edge inductionHypothesis =>
      simp only [map]
      change
        (previous.map (OpenTransitionMorphism.identity transition)).extend input
            ((OpenTransitionMorphism.identity transition).preserves input edge) =
          previous.extend input edge
      rw [inductionHypothesis]

/-- Mapping a history preserves its number of transitions. -/
theorem length_map
    {State : Type uState}
    {Input : Type uInput}
    {State' : Type uState'}
    {Input' : Type uInput'}
    {transition : State → Input → State → Prop}
    {transition' : State' → Input' → State' → Prop}
    (morphism : OpenTransitionMorphism transition transition')
    {initial endpoint : State}
    (history : OpenHistory transition initial endpoint) :
    (history.map morphism).length = history.length := by
  induction history with
  | start => rfl
  | extend previous input edge inductionHypothesis =>
      simp only [map, length]
      exact congrArg (fun value => value + 1) inductionHypothesis

/-- Mapping a history maps exactly its observable input trace. -/
theorem inputTrace_map
    {State : Type uState}
    {Input : Type uInput}
    {State' : Type uState'}
    {Input' : Type uInput'}
    {transition : State → Input → State → Prop}
    {transition' : State' → Input' → State' → Prop}
    (morphism : OpenTransitionMorphism transition transition')
    {initial endpoint : State}
    (history : OpenHistory transition initial endpoint) :
    (history.map morphism).inputTrace =
      history.inputTrace.map morphism.inputMap := by
  induction history with
  | start => rfl
  | extend previous input edge inductionHypothesis =>
      simp only [map, inputTrace, List.map_cons]
      exact congrArg (List.cons (morphism.inputMap input)) inductionHypothesis

/-- Input-trace naturality under composition of transition morphisms. -/
theorem inputTrace_map_comp
    {State : Type uState}
    {Input : Type uInput}
    {State' : Type uState'}
    {Input' : Type uInput'}
    {State'' : Type uState''}
    {Input'' : Type uInput''}
    {transition : State → Input → State → Prop}
    {transition' : State' → Input' → State' → Prop}
    {transition'' : State'' → Input'' → State'' → Prop}
    (later : OpenTransitionMorphism transition' transition'')
    (earlier : OpenTransitionMorphism transition transition')
    {initial endpoint : State}
    (history : OpenHistory transition initial endpoint) :
    ((history.map earlier).map later).inputTrace =
      (history.map (later.comp earlier)).inputTrace := by
  rw [inputTrace_map, inputTrace_map, inputTrace_map]
  simp only [OpenTransitionMorphism.comp, List.map_map]

/-- Mapping proof-carrying histories is functorial under morphism composition. -/
theorem map_comp
    {State : Type uState}
    {Input : Type uInput}
    {State' : Type uState'}
    {Input' : Type uInput'}
    {State'' : Type uState''}
    {Input'' : Type uInput''}
    {transition : State → Input → State → Prop}
    {transition' : State' → Input' → State' → Prop}
    {transition'' : State'' → Input'' → State'' → Prop}
    (later : OpenTransitionMorphism transition' transition'')
    (earlier : OpenTransitionMorphism transition transition')
    {initial endpoint : State}
    (history : OpenHistory transition initial endpoint) :
    (history.map earlier).map later =
      history.map (later.comp earlier) := by
  induction history with
  | start => rfl
  | extend previous input edge inductionHypothesis =>
      simp only [map, OpenTransitionMorphism.comp, Function.comp_apply]
      rw [inductionHypothesis]
      rfl

end OpenHistory

/-- The induced map on proof-carrying derived M-spaces. -/
def DerivedMSpace.map
    {State : Type uState}
    {Input : Type uInput}
    {State' : Type uState'}
    {Input' : Type uInput'}
    {transition : State → Input → State → Prop}
    {transition' : State' → Input' → State' → Prop}
    (morphism : OpenTransitionMorphism transition transition')
    {initial : State} :
    DerivedMSpace transition initial →
      DerivedMSpace transition' (morphism.stateMap initial) :=
  fun point => ⟨morphism.stateMap point.1, point.2.map morphism⟩

/-- The induced map on a derived M-space preserves every dependent point
exactly under the identity transition morphism. -/
theorem DerivedMSpace.map_identity
    {State : Type uState}
    {Input : Type uInput}
    {transition : State → Input → State → Prop}
    {initial : State}
    (point : DerivedMSpace transition initial) :
    point.map (OpenTransitionMorphism.identity transition) = point := by
  rcases point with ⟨endpoint, history⟩
  apply Sigma.ext
  · rfl
  · exact heq_of_eq history.map_identity

/-- The induced map on derived M-spaces is functorial under composition. -/
theorem DerivedMSpace.map_comp
    {State : Type uState}
    {Input : Type uInput}
    {State' : Type uState'}
    {Input' : Type uInput'}
    {State'' : Type uState''}
    {Input'' : Type uInput''}
    {transition : State → Input → State → Prop}
    {transition' : State' → Input' → State' → Prop}
    {transition'' : State'' → Input'' → State'' → Prop}
    (later : OpenTransitionMorphism transition' transition'')
    (earlier : OpenTransitionMorphism transition transition')
    {initial : State}
    (point : DerivedMSpace transition initial) :
    (point.map earlier).map later =
      point.map (later.comp earlier) := by
  rcases point with ⟨endpoint, history⟩
  apply Sigma.ext
  · rfl
  · exact heq_of_eq (history.map_comp later earlier)

/-- The derived M-space map sends each endpoint through the state map. -/
theorem DerivedMSpace.map_endpoint
    {State : Type uState}
    {Input : Type uInput}
    {State' : Type uState'}
    {Input' : Type uInput'}
    {transition : State → Input → State → Prop}
    {transition' : State' → Input' → State' → Prop}
    (morphism : OpenTransitionMorphism transition transition')
    {initial : State}
    (point : DerivedMSpace transition initial) :
    (point.map morphism).1 = morphism.stateMap point.1 :=
  rfl

/-- Endpoint naturality: induced derived-space maps compose exactly on states. -/
theorem DerivedMSpace.map_comp_endpoint
    {State : Type uState}
    {Input : Type uInput}
    {State' : Type uState'}
    {Input' : Type uInput'}
    {State'' : Type uState''}
    {Input'' : Type uInput''}
    {transition : State → Input → State → Prop}
    {transition' : State' → Input' → State' → Prop}
    {transition'' : State'' → Input'' → State'' → Prop}
    (later : OpenTransitionMorphism transition' transition'')
    (earlier : OpenTransitionMorphism transition transition')
    {initial : State}
    (point : DerivedMSpace transition initial) :
    ((point.map earlier).map later).1 =
      (point.map (later.comp earlier)).1 :=
  rfl

/-- Trace naturality: induced derived-space maps compose on input observations. -/
theorem DerivedMSpace.map_comp_inputTrace
    {State : Type uState}
    {Input : Type uInput}
    {State' : Type uState'}
    {Input' : Type uInput'}
    {State'' : Type uState''}
    {Input'' : Type uInput''}
    {transition : State → Input → State → Prop}
    {transition' : State' → Input' → State' → Prop}
    {transition'' : State'' → Input'' → State'' → Prop}
    (later : OpenTransitionMorphism transition' transition'')
    (earlier : OpenTransitionMorphism transition transition')
    {initial : State}
    (point : DerivedMSpace transition initial) :
    (((point.map earlier).map later).2).inputTrace =
      ((point.map (later.comp earlier)).2).inputTrace :=
  point.2.inputTrace_map_comp later earlier

/-!
## Finite countermodels: branching and path multiplicity
-/

/-- Four states suffice for a branch followed by reconvergence. -/
inductive BranchState
  | root
  | left
  | right
  | join
  deriving DecidableEq

/-- Labels retain which branch and merge edge was taken. -/
inductive BranchInput
  | chooseLeft
  | chooseRight
  | mergeLeft
  | mergeRight
  deriving DecidableEq

/-- A finite input-labelled branch/reconvergence transition system. -/
inductive branchTransition : BranchState → BranchInput → BranchState → Prop
  | chooseLeft : branchTransition .root .chooseLeft .left
  | chooseRight : branchTransition .root .chooseRight .right
  | mergeLeft : branchTransition .left .mergeLeft .join
  | mergeRight : branchTransition .right .mergeRight .join

/-- The initial state has a history to the left endpoint. -/
def leftBranchHistory :
    OpenHistory branchTransition BranchState.root BranchState.left :=
  .extend .start .chooseLeft .chooseLeft

/-- The same initial state has a history to the right endpoint. -/
def rightBranchHistory :
    OpenHistory branchTransition BranchState.root BranchState.right :=
  .extend .start .chooseRight .chooseRight

/-- A single derived M-space can therefore branch to distinct endpoints. -/
theorem derivedMSpace_has_branching_endpoints :
    ∃ leftPoint rightPoint :
        DerivedMSpace branchTransition BranchState.root,
      leftPoint.1 ≠ rightPoint.1 :=
  ⟨⟨.left, leftBranchHistory⟩, ⟨.right, rightBranchHistory⟩, by decide⟩

/-- Left-branch history that subsequently reaches the join. -/
def leftJoinHistory :
    OpenHistory branchTransition BranchState.root BranchState.join :=
  .extend leftBranchHistory .mergeLeft .mergeLeft

/-- Right-branch history that reaches the same join. -/
def rightJoinHistory :
    OpenHistory branchTransition BranchState.root BranchState.join :=
  .extend rightBranchHistory .mergeRight .mergeRight

/-- Distinct input histories can have exactly the same endpoint. -/
theorem multiple_histories_same_endpoint :
    leftJoinHistory ≠ rightJoinHistory := by
  intro historiesEqual
  have tracesEqual := congrArg OpenHistory.inputTrace historiesEqual
  simp [leftJoinHistory, rightJoinHistory, leftBranchHistory,
    rightBranchHistory, OpenHistory.inputTrace] at tracesEqual

/-- The reconvergent histories are both length two, so length alone is insufficient. -/
theorem reconvergent_histories_same_length :
    leftJoinHistory.length = rightJoinHistory.length := by
  rfl

end OCKIndividuationMSpaceComposition
