import OCKIndividuationMSpaceComposition.SymmetryCandidateInterfaces
import OCKIndividuationMSpaceComposition.SymmetryAxisCoaxis
import OCKIndividuationMSpaceComposition.SymmetryInvariantQuotient

namespace OCKIndividuationMSpaceComposition

universe uOrientation uAxis uIdentity uObservable

/-!
# Resolving the R3 candidate as a C₂ torsor

The R3 interface already assumes a free involutive reversal and transitivity
on the pair of orientations.  Those hypotheses are exactly enough to enter
the proved symmetry core.  This file performs that translation and derives
the consequences which were previously left implicit.

The result is deliberately sharp: the orientation carrier is one two-point
orbit, its orbit quotient has one class, invariant observables are constant,
and a nonconstant observable is equivalent to a concrete symmetry-breaking
witness.  The separately typed `axisOf` and `identityOf` fields remain
unidentified; no coercion between them is introduced.
-/

/-- The R3 reversal is a genuine fixed-point-free involution. -/
def r3FixedPointFreeInvolution
    {Orientation : Type uOrientation} {Axis : Type uAxis}
    {Identity : Type uIdentity}
    (candidate : R3C2OrientationTorsorInterface Orientation Axis Identity) :
    FixedPointFreeInvolution Orientation where
  action :=
    { toFun := candidate.reverse
      invFun := candidate.reverse
      left_inv := candidate.reverseInvolutive
      right_inv := candidate.reverseInvolutive }
  involutive := candidate.reverseInvolutive
  fixedPointFree := candidate.reverseFree

/-- Pair transitivity says that the axis generated by any orientation is the
whole R3 orientation carrier. -/
theorem r3_axis_eq_univ
    {Orientation : Type uOrientation} {Axis : Type uAxis}
    {Identity : Type uIdentity}
    (candidate : R3C2OrientationTorsorInterface Orientation Axis Identity)
    (orientation : Orientation) :
    axis (r3FixedPointFreeInvolution candidate) orientation = Set.univ := by
  ext other
  constructor
  · intro _
    trivial
  · intro _
    exact candidate.pairTransitive orientation other

/-- Every two orientations represent the same orbit class. -/
theorem r3_axisClass_unique
    {Orientation : Type uOrientation} {Axis : Type uAxis}
    {Identity : Type uIdentity}
    (candidate : R3C2OrientationTorsorInterface Orientation Axis Identity)
    (left right : Orientation) :
    axisClass (r3FixedPointFreeInvolution candidate) left =
      axisClass (r3FixedPointFreeInvolution candidate) right :=
  (axisClass_eq_iff_sameAxis (r3FixedPointFreeInvolution candidate)
    left right).2 (candidate.pairTransitive left right)

/-- The R3 orbit quotient has exactly one equivalence class. -/
theorem r3_axisQuotient_subsingleton
    {Orientation : Type uOrientation} {Axis : Type uAxis}
    {Identity : Type uIdentity}
    (candidate : R3C2OrientationTorsorInterface Orientation Axis Identity)
    (left right : AxisQuotient (r3FixedPointFreeInvolution candidate)) :
    left = right := by
  refine Quotient.inductionOn₂ left right ?_
  intro first second
  exact r3_axisClass_unique candidate first second

/-- An invariant observable on an R3 torsor is globally constant. -/
theorem r3_invariant_observable_constant
    {Orientation : Type uOrientation} {Axis : Type uAxis}
    {Identity : Type uIdentity} {Observable : Type uObservable}
    (candidate : R3C2OrientationTorsorInterface Orientation Axis Identity)
    (observable : Orientation → Observable)
    (invariant : InvariantObservable
      (r3FixedPointFreeInvolution candidate) observable)
    (left right : Orientation) :
    observable right = observable left :=
  invariant_observable_on_axis (r3FixedPointFreeInvolution candidate)
    observable invariant (candidate.pairTransitive left right)

/-- On the two-orientation torsor, nonconstancy is exactly the existence of a
symmetry-breaking witness. -/
theorem r3_observable_nonconstant_iff_breaking_witness
    {Orientation : Type uOrientation} {Axis : Type uAxis}
    {Identity : Type uIdentity} {Observable : Type uObservable}
    (candidate : R3C2OrientationTorsorInterface Orientation Axis Identity)
    (observable : Orientation → Observable) :
    (∃ left right, observable right ≠ observable left) ↔
      ∃ orientation,
        SymmetryBreakingWitness (r3FixedPointFreeInvolution candidate)
          observable orientation := by
  constructor
  · rintro ⟨left, right, different⟩
    rcases candidate.pairTransitive left right with same | reversed
    · exact (different (congrArg observable same)).elim
    · subst right
      exact ⟨left, different⟩
  · rintro ⟨orientation, breaking⟩
    exact ⟨orientation, candidate.reverse orientation, breaking⟩

/-- Every R3 orientation supplies a coorientation of its unique axis. -/
theorem r3_axis_has_coaxis
    {Orientation : Type uOrientation} {Axis : Type uAxis}
    {Identity : Type uIdentity}
    (candidate : R3C2OrientationTorsorInterface Orientation Axis Identity)
    (orientation : Orientation) :
    Nonempty (AxisCoaxis (r3FixedPointFreeInvolution candidate) orientation) :=
  ⟨baseAxisCoaxis (r3FixedPointFreeInvolution candidate) orientation⟩

/-- The R3 coaxis is defined only up to reversal; no chosen coaxis can be
invariant under the reversal which defines it. -/
theorem r3_coaxis_not_reversal_invariant
    {Orientation : Type uOrientation} {Axis : Type uAxis}
    {Identity : Type uIdentity}
    (candidate : R3C2OrientationTorsorInterface Orientation Axis Identity)
    {orientation : Orientation}
    (coaxis : AxisCoaxis (r3FixedPointFreeInvolution candidate) orientation) :
    ¬ ∀ point,
      axisSwap (r3FixedPointFreeInvolution candidate) orientation point ∈
          coaxis.positive ↔
        point ∈ coaxis.positive :=
  axisCoaxis_not_swap_invariant coaxis

end OCKIndividuationMSpaceComposition
