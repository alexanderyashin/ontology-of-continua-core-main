import OCKIndividuationMSpaceComposition.SymmetryFaithfulCommutingFamily
import OCKIndividuationMSpaceComposition.SymmetryFiniteCubeRankRealization

namespace OCKIndividuationMSpaceComposition

universe uIndex uCarrier

namespace PrimitiveDistinction

open FiniteCubeRankRealization
open BooleanCompositionRank
open DisjointDistinctionFamily

/-!
# Rank carried by a faithful family of primitive reversals

The Boolean rank in `SymmetryFiniteCubeRankRealization` is useful only if its
coordinates can be identified with transformations already generated by
primitive distinctions.  This file makes that identification explicit.

For a faithful commuting family, the singleton Boolean mask at an index acts
as exactly the corresponding ambient pair transposition.  The complete mask
action is injective, so its `2^n` states and its `n` singleton directions are
not a coordinate convention: they are read back from the actual carrier
permutations.  The rank statement remains a rank of the induced finite
Boolean model, not a claim that arbitrary OC carriers have an intrinsic
dimension.  The latter still needs a scientifically grounded closure and the
exchange boundary recorded in `SymmetryIntrinsicDimensionBoundary`.
-/

namespace FaithfulCommutingDistinctionFamily

variable {Index : Type uIndex} {Carrier : Type uCarrier}
variable [Fintype Index] [DecidableEq Index]
variable [Fintype Carrier] [DecidableEq Carrier]

/-! ## Actual singleton directions -/

/-- The singleton mask has exactly one selected index. -/
theorem selectedIndices_coordinateMask
    (index : Index) :
    selectedIndices (coordinateMask index) = ({index} : Finset Index) := by
  classical
  ext current
  simp only [selectedIndices, Finset.mem_filter, Finset.mem_univ, true_and,
    Finset.mem_singleton]
  change (Multiplicative.toAdd (coordinateMask index)) current = true ↔
    current = index
  simp [coordinateMask]

/-! The actual transformation of a singleton mask is its local reversal. -/
theorem maskPermutation_coordinateMask
    (family : FaithfulCommutingDistinctionFamily Index Carrier)
    (index : Index) :
    family.toDisjoint.maskPermutation (coordinateMask index) =
      pairSwapEquiv (family.distinction index) := by
  classical
  rw [DisjointDistinctionFamily.maskPermutation,
    selectedIndices_coordinateMask]
  rfl

/-! The local reversal map is injective, rather than merely indexed. -/

theorem pairSwapEquiv_injective
    (family : FaithfulCommutingDistinctionFamily Index Carrier) :
    Function.Injective
      (fun index : Index =>
        (pairSwapEquiv (family.distinction index) : Equiv.Perm Carrier)) := by
  intro first second equal
  by_contra different
  apply (family.pairSwapDistinct different)
  have functionsEqual := congrArg Equiv.toFun equal
  simpa [pairSwapEquiv] using functionsEqual

/-- The set of local ambient reversals has one member per family index. -/
noncomputable def localSwapFamily
    (family : FaithfulCommutingDistinctionFamily Index Carrier) :
    Finset (Equiv.Perm Carrier) :=
  Finset.univ.image (fun index : Index =>
    (pairSwapEquiv (family.distinction index) : Equiv.Perm Carrier))

theorem localSwapFamily_card
    (family : FaithfulCommutingDistinctionFamily Index Carrier) :
    (family.localSwapFamily).card = Fintype.card Index := by
  classical
  simpa [localSwapFamily] using
    (Finset.card_image_of_injective
      (s := (Finset.univ : Finset Index))
      (f := fun index : Index =>
        (pairSwapEquiv (family.distinction index) : Equiv.Perm Carrier))
      (pairSwapEquiv_injective family))

/-! ## Faithful Boolean action on actual transformations -/

/-- Every Boolean state is an actual carrier permutation, and distinct states
remain distinct after the primitive family acts on the carrier. -/
theorem actualMaskAction_injective
    (family : FaithfulCommutingDistinctionFamily Index Carrier) :
    Function.Injective family.toDisjoint.maskPermutation :=
  family.toDisjoint.maskPermutation_injective

/-- The actual carrier action contains exactly `2^n` states.  This is the
faithful image theorem for the primitive family, not an externally supplied
Cartesian carrier. -/
theorem actualMaskAction_range_card
    (family : FaithfulCommutingDistinctionFamily Index Carrier) :
    Set.ncard (Set.range family.toDisjoint.maskPermutation) =
      2 ^ Fintype.card Index := by
  exact family.toDisjoint.card_maskPermutation_range

/-- Singleton Boolean directions are read back as the actual local swaps. -/
theorem coordinateMask_action_eq_localSwap
    (family : FaithfulCommutingDistinctionFamily Index Carrier) :
    (Finset.univ.image (fun index : Index =>
      family.toDisjoint.maskPermutation (coordinateMask index))) =
      family.localSwapFamily := by
  classical
  ext transformation
  constructor
  · intro member
    rcases Finset.mem_image.mp member with ⟨index, _, rfl⟩
    simp [maskPermutation_coordinateMask, localSwapFamily]
  · intro member
    rw [localSwapFamily] at member
    rcases Finset.mem_image.mp member with ⟨index, _, rfl⟩
    apply Finset.mem_image.mpr
    exact ⟨index, Finset.mem_univ _,
      maskPermutation_coordinateMask family index⟩

/-! ## Rank readback -/

/-- The induced actual action has the same finite Boolean rank as its
primitive singleton directions.  The rank is computed on the reversible
mask algebra and transported to the carrier by the proved faithful action. -/
theorem actualPrimitiveDirection_rank
    (family : FaithfulCommutingDistinctionFamily Index Carrier) :
    booleanGeneratedClosure.rank
        (fullCoordinateFamily (Index := Index)) =
      family.localSwapFamily.card := by
  rw [booleanGeneratedClosure_fullCoordinateFamily_rank,
    family.localSwapFamily_card]

end FaithfulCommutingDistinctionFamily

end PrimitiveDistinction

end OCKIndividuationMSpaceComposition
