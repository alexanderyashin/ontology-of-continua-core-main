import OCKIndividuationMSpaceComposition.SymmetryTorsorClassification
import OCKIndividuationMSpaceComposition.SymmetryCanonicalSeparator
import OCKIndividuationMSpaceComposition.SymmetrySignRepresentation

namespace OCKIndividuationMSpaceComposition

universe uOrientation uAxis uIdentity

/-!
# R1, R2 and R3 as layers of one C₂ symmetry structure

The earlier comparison surface listed three readings separately.  The proved
core now permits a sharper result.  Starting from the explicit R3 hypotheses,
the same free involution produces all three mathematical layers:

* R3 is the two-point torsor and its reversal dynamics;
* R1 is its invariant orbit boundary together with a base-relative separator;
* R2/coaxis is its odd Boolean sign representation.

The boundary is invariant, while the separator and sign are exchanged by the
non-trivial action.  Hence the sign cannot descend through the invariant
quotient.  These are compatible views of one object, not interchangeable
claims and not competing choices of formalism.
-/

/-- The concrete R1 layer generated from an R3 torsor and one base
orientation. -/
def r3CanonicalSeparator
    {Orientation : Type uOrientation} {Axis : Type uAxis}
    {Identity : Type uIdentity}
    (candidate : R3C2OrientationTorsorInterface Orientation Axis Identity)
    (base : Orientation) :=
  coreR1CanonicalSeparator (r3FixedPointFreeInvolution candidate) base

/-- The concrete odd-sign layer generated from the same R3 data. -/
noncomputable def r3AxisSignPairing
    {Orientation : Type uOrientation} {Axis : Type uAxis}
    {Identity : Type uIdentity}
    (candidate : R3C2OrientationTorsorInterface Orientation Axis Identity)
    (base : Orientation) :=
  baseAxisSignPairing (r3FixedPointFreeInvolution candidate) base

/-- Every orientation is a point of the unique R3 axis generated by the
basepoint. -/
theorem r3_orientation_mem_base_axis
    {Orientation : Type uOrientation} {Axis : Type uAxis}
    {Identity : Type uIdentity}
    (candidate : R3C2OrientationTorsorInterface Orientation Axis Identity)
    (base orientation : Orientation) :
    orientation ∈ axis (r3FixedPointFreeInvolution candidate) base := by
  rw [r3_axis_eq_univ]
  trivial

/-- Regard any R3 orientation as a point of the unique base axis. -/
def r3AxisPoint
    {Orientation : Type uOrientation} {Axis : Type uAxis}
    {Identity : Type uIdentity}
    (candidate : R3C2OrientationTorsorInterface Orientation Axis Identity)
    (base orientation : Orientation) :
    axis (r3FixedPointFreeInvolution candidate) base :=
  ⟨orientation, r3_orientation_mem_base_axis candidate base orientation⟩

/-- The intrinsic pointed-torsor coordinate and the local coaxis sign are
the same Boolean coordinate. -/
theorem r3_sign_coordinate_agrees
    {Orientation : Type uOrientation} {Axis : Type uAxis}
    {Identity : Type uIdentity}
    (candidate : R3C2OrientationTorsorInterface Orientation Axis Identity)
    (base orientation : Orientation) :
    (r3AxisSignPairing candidate base).sign
        (r3AxisPoint candidate base orientation) =
      r3OrientationEquivBool candidate base orientation := by
  rcases candidate.pairTransitive base orientation with same | partner
  · subst orientation
    rw [r3OrientationEquivBool_base]
    exact baseAxisSignPairing_seed
      (r3FixedPointFreeInvolution candidate) base
  · subst orientation
    rw [r3OrientationEquivBool_partner]
    exact baseAxisSignPairing_partner
      (r3FixedPointFreeInvolution candidate) base

/-- The R1 separator is exactly the false fiber of the R2/R3 sign
coordinate. -/
theorem r3_separator_iff_sign_false
    {Orientation : Type uOrientation} {Axis : Type uAxis}
    {Identity : Type uIdentity}
    (candidate : R3C2OrientationTorsorInterface Orientation Axis Identity)
    (base orientation : Orientation) :
    (r3CanonicalSeparator candidate base).separator orientation ↔
      r3OrientationEquivBool candidate base orientation = false := by
  change orientation = base ↔
    r3OrientationEquivBool candidate base orientation = false
  exact (r3OrientationEquivBool_false_iff candidate base orientation).symm

/-- The R1 boundary projection forgets orientation: every point of the R3
torsor has the same orbit boundary. -/
theorem r3_boundary_projection_constant
    {Orientation : Type uOrientation} {Axis : Type uAxis}
    {Identity : Type uIdentity}
    (candidate : R3C2OrientationTorsorInterface Orientation Axis Identity)
    (base orientation : Orientation) :
    (r3CanonicalSeparator candidate base).projection orientation =
      (r3CanonicalSeparator candidate base).boundary :=
  r3_axisClass_unique candidate orientation base

/-- Reversal preserves the R1 boundary while negating the R2/R3 sign. -/
theorem r3_reversal_preserves_boundary_and_negates_sign
    {Orientation : Type uOrientation} {Axis : Type uAxis}
    {Identity : Type uIdentity}
    (candidate : R3C2OrientationTorsorInterface Orientation Axis Identity)
    (base orientation : Orientation) :
    (r3CanonicalSeparator candidate base).projection
        (candidate.reverse orientation) =
        (r3CanonicalSeparator candidate base).projection orientation ∧
      r3OrientationEquivBool candidate base (candidate.reverse orientation) =
        Bool.not (r3OrientationEquivBool candidate base orientation) := by
  constructor
  · exact action_preserves_axis_class
      (r3FixedPointFreeInvolution candidate) orientation
  · exact r3OrientationEquivBool_reverse candidate base orientation

/-- The complete layer relation at one point: invariant boundary, relative
separator and odd sign are simultaneously compatible. -/
theorem r3_r1_r2_r3_layer_synthesis
    {Orientation : Type uOrientation} {Axis : Type uAxis}
    {Identity : Type uIdentity}
    (candidate : R3C2OrientationTorsorInterface Orientation Axis Identity)
    (base orientation : Orientation) :
    (r3CanonicalSeparator candidate base).projection orientation =
        (r3CanonicalSeparator candidate base).boundary ∧
      ((r3CanonicalSeparator candidate base).separator orientation ↔
        (r3AxisSignPairing candidate base).sign
          (r3AxisPoint candidate base orientation) = false) ∧
      (r3AxisSignPairing candidate base).sign
          (r3AxisPoint candidate base (candidate.reverse orientation)) =
        Bool.not ((r3AxisSignPairing candidate base).sign
          (r3AxisPoint candidate base orientation)) := by
  refine ⟨r3_boundary_projection_constant candidate base orientation, ?_, ?_⟩
  · rw [r3_sign_coordinate_agrees]
    exact r3_separator_iff_sign_false candidate base orientation
  · rw [r3_sign_coordinate_agrees, r3_sign_coordinate_agrees]
    exact r3OrientationEquivBool_reverse candidate base orientation

/-- The odd sign layer cannot be reconstructed from the invariant R1 orbit
boundary. -/
theorem r3_sign_does_not_factor_through_boundary
    {Orientation : Type uOrientation} {Axis : Type uAxis}
    {Identity : Type uIdentity}
    (candidate : R3C2OrientationTorsorInterface Orientation Axis Identity)
    (base : Orientation) :
    ¬ ∃ factor :
        AxisQuotient
          (axisSwapInvolution (r3FixedPointFreeInvolution candidate) base) →
            Bool,
      ∀ point,
        factor (axisClass
          (axisSwapInvolution (r3FixedPointFreeInvolution candidate) base)
          point) =
        (r3AxisSignPairing candidate base).sign point :=
  axisSignPairing_forbids_quotient_factor
    (r3AxisSignPairing candidate base)
    (r3AxisPoint candidate base base)

end OCKIndividuationMSpaceComposition
