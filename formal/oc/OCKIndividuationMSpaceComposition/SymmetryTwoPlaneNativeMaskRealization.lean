import OCKIndividuationMSpaceComposition.SymmetryTwoPlaneKleinFourNaturality

namespace OCKIndividuationMSpaceComposition

universe uLeft uRight

namespace PrimitiveDistinction

/-!
# Native realization of the two-plane mask algebra

`planeMaskAction` is the concrete Boolean algebra from M34.  This file
conjugates it along the already-proved generated-plane equivalence, so the
four transformations act on the actual product of the two primitive axes.
The conjugation is explicit and therefore cannot add transformations or hide a
carrier-level assumption.  The first and second primitive reversals are the
two singleton masks, and the realized carrier action has exactly four distinct
maps.
-/

/-- Conjugate a Boolean mask action to the product carrier generated by two
primitive distinctions. -/
noncomputable def generatedPlaneMaskAction
    {Left : Type uLeft} {Right : Type uRight}
    (left : PrimitiveDistinction Left)
    (right : PrimitiveDistinction Right)
    (mask : PlaneCoordinate)
    (point : PrimitiveDistinctionPlane left right) :
    PrimitiveDistinctionPlane left right :=
  (left.generatedPlaneEquivBoolProduct right).symm
    (planeMaskAction mask
      ((left.generatedPlaneEquivBoolProduct right) point))

theorem generatedPlaneMaskAction_coordinate_readback
    {Left : Type uLeft} {Right : Type uRight}
    (left : PrimitiveDistinction Left)
    (right : PrimitiveDistinction Right)
    (mask : PlaneCoordinate)
    (point : PrimitiveDistinctionPlane left right) :
    (left.generatedPlaneEquivBoolProduct right)
        (generatedPlaneMaskAction left right mask point) =
      planeMaskAction mask
        ((left.generatedPlaneEquivBoolProduct right) point) := by
  simp [generatedPlaneMaskAction]

theorem generatedPlaneMaskAction_self
    {Left : Type uLeft} {Right : Type uRight}
    (left : PrimitiveDistinction Left)
    (right : PrimitiveDistinction Right)
    (mask : PlaneCoordinate)
    (point : PrimitiveDistinctionPlane left right) :
    generatedPlaneMaskAction left right mask
        (generatedPlaneMaskAction left right mask point) = point := by
  apply (left.generatedPlaneEquivBoolProduct right).injective
  rw [generatedPlaneMaskAction_coordinate_readback,
    generatedPlaneMaskAction_coordinate_readback,
    planeMaskAction_self]

theorem generatedPlaneMaskAction_comp
    {Left : Type uLeft} {Right : Type uRight}
    (left : PrimitiveDistinction Left)
    (right : PrimitiveDistinction Right)
    (first second : PlaneCoordinate)
    (point : PrimitiveDistinctionPlane left right) :
    generatedPlaneMaskAction left right first
        (generatedPlaneMaskAction left right second point) =
      generatedPlaneMaskAction left right
        (Bool.xor first.1 second.1, Bool.xor first.2 second.2) point := by
  apply (left.generatedPlaneEquivBoolProduct right).injective
  rw [generatedPlaneMaskAction_coordinate_readback,
    generatedPlaneMaskAction_coordinate_readback,
    generatedPlaneMaskAction_coordinate_readback,
    planeMaskAction_comp]

theorem generatedPlaneMaskAction_commute
    {Left : Type uLeft} {Right : Type uRight}
    (left : PrimitiveDistinction Left)
    (right : PrimitiveDistinction Right)
    (first second : PlaneCoordinate)
    (point : PrimitiveDistinctionPlane left right) :
    generatedPlaneMaskAction left right first
        (generatedPlaneMaskAction left right second point) =
      generatedPlaneMaskAction left right second
        (generatedPlaneMaskAction left right first point) := by
  rw [generatedPlaneMaskAction_comp, generatedPlaneMaskAction_comp]
  rcases first with ⟨firstFirst, firstSecond⟩
  rcases second with ⟨secondFirst, secondSecond⟩
  cases firstFirst <;> cases firstSecond <;>
    cases secondFirst <;> cases secondSecond <;> rfl

theorem generatedPlaneMaskAction_injective
    {Left : Type uLeft} {Right : Type uRight}
    (left : PrimitiveDistinction Left)
    (right : PrimitiveDistinction Right) :
    Function.Injective
      (generatedPlaneMaskAction left right) := by
  intro first second equal
  apply planeMaskAction_injective
  funext coordinate
  have readback := congrArg
    (fun action =>
      (fun coordinate =>
        (left.generatedPlaneEquivBoolProduct right)
          (action ((left.generatedPlaneEquivBoolProduct right).symm coordinate))))
    equal
  simpa [generatedPlaneMaskAction] using congrFun readback coordinate

/-- The native two-plane action family is the image of the explicit four-mask
set. -/
noncomputable def generatedPlaneMaskActionFamily
    {Left : Type uLeft} {Right : Type uRight}
    (left : PrimitiveDistinction Left)
    (right : PrimitiveDistinction Right) :
    Finset (PrimitiveDistinctionPlane left right →
      PrimitiveDistinctionPlane left right) := by
  classical
  exact planeMaskSet.image (generatedPlaneMaskAction left right)

theorem generatedPlaneMaskActionFamily_card
    {Left : Type uLeft} {Right : Type uRight}
    (left : PrimitiveDistinction Left)
    (right : PrimitiveDistinction Right) :
    (generatedPlaneMaskActionFamily left right).card = 4 := by
  classical
  rw [generatedPlaneMaskActionFamily]
  rw [Finset.card_image_of_injective
    (s := planeMaskSet)
    (f := generatedPlaneMaskAction left right)
    (generatedPlaneMaskAction_injective left right)]
  decide

/-! ## Readback of the two primitive generators -/

theorem generatedPlaneMaskAction_first
    {Left : Type uLeft} {Right : Type uRight}
    (left : PrimitiveDistinction Left)
    (right : PrimitiveDistinction Right)
    (point : PrimitiveDistinctionPlane left right) :
    generatedPlaneMaskAction left right planeFirstMask point =
      (left.firstPlaneInvolution right).action point := by
  apply (left.generatedPlaneEquivBoolProduct right).injective
  calc
    (left.generatedPlaneEquivBoolProduct right)
        (generatedPlaneMaskAction left right planeFirstMask point) =
      planeMaskAction planeFirstMask
        ((left.generatedPlaneEquivBoolProduct right) point) :=
      generatedPlaneMaskAction_coordinate_readback left right planeFirstMask point
    _ = (left.generatedPlaneEquivBoolProduct right)
        ((left.firstPlaneInvolution right).action point) := by
      exact (generatedPlane_first_as_mask left right point).symm

theorem generatedPlaneMaskAction_second
    {Left : Type uLeft} {Right : Type uRight}
    (left : PrimitiveDistinction Left)
    (right : PrimitiveDistinction Right)
    (point : PrimitiveDistinctionPlane left right) :
    generatedPlaneMaskAction left right planeSecondMask point =
      (left.secondPlaneInvolution right).action point := by
  apply (left.generatedPlaneEquivBoolProduct right).injective
  calc
    (left.generatedPlaneEquivBoolProduct right)
        (generatedPlaneMaskAction left right planeSecondMask point) =
      planeMaskAction planeSecondMask
        ((left.generatedPlaneEquivBoolProduct right) point) :=
      generatedPlaneMaskAction_coordinate_readback left right planeSecondMask point
    _ = (left.generatedPlaneEquivBoolProduct right)
        ((left.secondPlaneInvolution right).action point) := by
      exact (generatedPlane_second_as_mask left right point).symm

theorem generatedPlaneMaskAction_both
    {Left : Type uLeft} {Right : Type uRight}
    (left : PrimitiveDistinction Left)
    (right : PrimitiveDistinction Right)
    (point : PrimitiveDistinctionPlane left right) :
    generatedPlaneMaskAction left right planeBothMask point =
      (left.firstPlaneInvolution right).action
        ((left.secondPlaneInvolution right).action point) := by
  apply (left.generatedPlaneEquivBoolProduct right).injective
  calc
    (left.generatedPlaneEquivBoolProduct right)
        (generatedPlaneMaskAction left right planeBothMask point) =
      planeMaskAction planeBothMask
        ((left.generatedPlaneEquivBoolProduct right) point) :=
      generatedPlaneMaskAction_coordinate_readback left right planeBothMask point
    _ = (left.generatedPlaneEquivBoolProduct right)
        ((left.firstPlaneInvolution right).action
          ((left.secondPlaneInvolution right).action point)) := by
      exact (generatedPlane_composite_as_both_mask left right point).symm

end PrimitiveDistinction

end OCKIndividuationMSpaceComposition
