import OCKIndividuationMSpaceComposition.SymmetryFoundationsCore

namespace OCKIndividuationMSpaceComposition

universe u

/-!
# The distinction as a coorientation of its generated axis

The two-point symmetry core proves that a distinction generated by a free
involution has a balanced axis.  This file makes the corresponding "axis of
the axis" intuition precise without pretending that an orientation is
canonical.

Relative to a chosen endpoint `x`, its axis has two complementary sides:
the endpoint `x` and its image under the involution.  The canonical axis swap
exchanges the sides.  An `AxisCoaxis` is therefore an odd predicate on the
axis: applying the swap negates the predicate.  Choosing a coaxis breaks the
endpoint-exchange symmetry, and the final theorem proves that no coaxis can at
the same time be invariant under that swap.

Thus the axis is canonical as an orbit, while its coorientation is defined
only up to reversal.  No global orientation of the carrier is assumed.
-/

/-- The side of the generated axis containing its chosen endpoint. -/
def axisPositiveSide {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier) :
    Set (axis symmetry x) :=
  {y | y.1 = x}

/-- The opposite side of the generated axis. -/
def axisNegativeSide {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier) :
    Set (axis symmetry x) :=
  {y | y.1 = symmetry.action x}

@[simp] theorem mem_axisPositiveSide_iff {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier)
    (y : axis symmetry x) :
    y ∈ axisPositiveSide symmetry x ↔ y.1 = x :=
  Iff.rfl

@[simp] theorem mem_axisNegativeSide_iff {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier)
    (y : axis symmetry x) :
    y ∈ axisNegativeSide symmetry x ↔ y.1 = symmetry.action x :=
  Iff.rfl

/-- Every point of the generated axis lies on one of its two sides. -/
theorem axis_side_dichotomy {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier)
    (y : axis symmetry x) :
    y ∈ axisPositiveSide symmetry x ∨
      y ∈ axisNegativeSide symmetry x :=
  y.2

/-- No point lies on both sides of a free two-point axis. -/
theorem axis_sides_exclusive {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier)
    (y : axis symmetry x) :
    ¬ (y ∈ axisPositiveSide symmetry x ∧
      y ∈ axisNegativeSide symmetry x) := by
  rintro ⟨positive, negative⟩
  apply symmetry.fixedPointFree x
  calc
    symmetry.action x = y.1 := negative.symm
    _ = x := positive

/-- The negative side is exactly the complement of the positive side inside
the generated axis. -/
theorem axis_negative_iff_not_positive {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier)
    (y : axis symmetry x) :
    y ∈ axisNegativeSide symmetry x ↔
      y ∉ axisPositiveSide symmetry x := by
  constructor
  · intro negative positive
    exact axis_sides_exclusive symmetry x y ⟨positive, negative⟩
  · intro notPositive
    rcases axis_side_dichotomy symmetry x y with positive | negative
    · exact (notPositive positive).elim
    · exact negative

/-- The canonical axis swap sends the positive side to the negative side. -/
theorem axisSwap_positive_iff_negative {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier)
    (y : axis symmetry x) :
    axisSwap symmetry x y ∈ axisPositiveSide symmetry x ↔
      y ∈ axisNegativeSide symmetry x := by
  change symmetry.action y.1 = x ↔ y.1 = symmetry.action x
  constructor
  · intro swapped
    calc
      y.1 = symmetry.action (symmetry.action y.1) :=
        (symmetry.involutive y.1).symm
      _ = symmetry.action x := congrArg symmetry.action swapped
  · intro negative
    calc
      symmetry.action y.1 = symmetry.action (symmetry.action x) :=
        congrArg symmetry.action negative
      _ = x := symmetry.involutive x

/-- The canonical axis swap sends the negative side to the positive side. -/
theorem axisSwap_negative_iff_positive {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier)
    (y : axis symmetry x) :
    axisSwap symmetry x y ∈ axisNegativeSide symmetry x ↔
      y ∈ axisPositiveSide symmetry x := by
  change symmetry.action y.1 = symmetry.action x ↔ y.1 = x
  constructor
  · intro equality
    exact symmetry.action.injective equality
  · exact congrArg symmetry.action

/-- A coaxis is a binary coorientation which is reversed by the canonical
swap of the axis. -/
structure AxisCoaxis {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier) where
  positive : Set (axis symmetry x)
  flips : ∀ y,
    axisSwap symmetry x y ∈ positive ↔ y ∉ positive

/-- Choosing the seed endpoint produces one coorientation of its axis. -/
def baseAxisCoaxis {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier) :
    AxisCoaxis symmetry x where
  positive := axisPositiveSide symmetry x
  flips := by
    intro y
    exact (axisSwap_positive_iff_negative symmetry x y).trans
      (axis_negative_iff_not_positive symmetry x y)

theorem baseAxisCoaxis_marks_seed_positive {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier) :
    (⟨x, axis_mem_left symmetry x⟩ : axis symmetry x) ∈
      (baseAxisCoaxis symmetry x).positive :=
  rfl

theorem baseAxisCoaxis_marks_partner_negative {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier) :
    (⟨symmetry.action x, axis_mem_right symmetry x⟩ : axis symmetry x) ∉
      (baseAxisCoaxis symmetry x).positive := by
  intro equality
  exact symmetry.fixedPointFree x equality

/-- Reversing a coaxis exchanges which side is called positive. -/
def reverseAxisCoaxis {Carrier : Type u}
    {symmetry : FixedPointFreeInvolution Carrier} {x : Carrier}
    (coaxis : AxisCoaxis symmetry x) : AxisCoaxis symmetry x where
  positive := {y | y ∉ coaxis.positive}
  flips := by
    intro y
    exact not_congr (coaxis.flips y)

/-- Reversing a coaxis twice restores the original side pointwise. -/
theorem reverseAxisCoaxis_twice {Carrier : Type u}
    {symmetry : FixedPointFreeInvolution Carrier} {x : Carrier}
    (coaxis : AxisCoaxis symmetry x) (y : axis symmetry x) :
    y ∈ (reverseAxisCoaxis (reverseAxisCoaxis coaxis)).positive ↔
      y ∈ coaxis.positive := by
  change ¬¬ (y ∈ coaxis.positive) ↔ y ∈ coaxis.positive
  exact Classical.not_not

/-- A coorientation necessarily breaks the endpoint-exchange symmetry: an odd
side predicate cannot also be invariant under the same swap. -/
theorem axisCoaxis_not_swap_invariant {Carrier : Type u}
    {symmetry : FixedPointFreeInvolution Carrier} {x : Carrier}
    (coaxis : AxisCoaxis symmetry x) :
    ¬ ∀ y,
      axisSwap symmetry x y ∈ coaxis.positive ↔ y ∈ coaxis.positive := by
  intro invariant
  let seed : axis symmetry x := ⟨x, axis_mem_left symmetry x⟩
  by_cases seedPositive : seed ∈ coaxis.positive
  · have swappedPositive : axisSwap symmetry x seed ∈ coaxis.positive :=
      (invariant seed).2 seedPositive
    exact (coaxis.flips seed).1 swappedPositive seedPositive
  · have swappedPositive : axisSwap symmetry x seed ∈ coaxis.positive :=
      (coaxis.flips seed).2 seedPositive
    exact seedPositive ((invariant seed).1 swappedPositive)

end OCKIndividuationMSpaceComposition
