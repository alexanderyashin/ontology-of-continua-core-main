import OCKIndividuationMSpaceComposition.UniversalDynamics

namespace OCKIndividuationMSpaceComposition

universe uState uContext uView

/-!
# Context-relative level classification

This module replaces a universal fixed ladder by a derived construction.  A
scientific axis supplies a typed local step relation.  Finite reachability is
the portable part; mutually reachable states form one level class.  The
resulting quotient may be finite, infinite, linear, branching, or trivial.

No theorem below identifies observational resolution, compositional depth,
time scale, and autonomy.  They are different admissible axes and can induce
incompatible partitions on the same carrier.  Consequently a historical
`K0`--`K12` ladder is a source-bound coordinate system, not a universal count
of ontological levels.
-/

/-- Finite reflexive-transitive reachability generated by a local step. -/
inductive RelationReachable
    {State : Type uState}
    (step : State → State → Prop)
    (start : State) : State → Prop
  | root : RelationReachable step start start
  | tail {current next} :
      RelationReachable step start current →
      step current next →
      RelationReachable step start next

/-- Reachability is transitive. -/
theorem relationReachable_trans
    {State : Type uState}
    {step : State → State → Prop}
    {first middle last : State}
    (firstToMiddle : RelationReachable step first middle)
    (middleToLast : RelationReachable step middle last) :
    RelationReachable step first last := by
  induction middleToLast with
  | root => exact firstToMiddle
  | tail previous edge inductionHypothesis =>
      exact .tail inductionHypothesis edge

/-- Reachability is the least step-closed predicate containing its root. -/
theorem relationReachable_is_least
    {State : Type uState}
    {step : State → State → Prop}
    {start : State}
    {carrier : State → Prop}
    (containsStart : carrier start)
    (closed : ∀ ⦃current next⦄,
      carrier current → step current next → carrier next) :
    ∀ ⦃state⦄, RelationReachable step start state → carrier state := by
  intro state reachable
  induction reachable with
  | root => exact containsStart
  | tail previous edge inductionHypothesis =>
      exact closed inductionHypothesis edge

/-- Two states occupy one derived level exactly when each reaches the other. -/
def MutuallyReachable
    {State : Type uState}
    (step : State → State → Prop)
    (first second : State) : Prop :=
  RelationReachable step first second ∧
    RelationReachable step second first

theorem mutuallyReachable_refl
    {State : Type uState}
    (step : State → State → Prop)
    (state : State) :
    MutuallyReachable step state state :=
  ⟨.root, .root⟩

theorem mutuallyReachable_symm
    {State : Type uState}
    {step : State → State → Prop}
    {first second : State}
    (sameLevel : MutuallyReachable step first second) :
    MutuallyReachable step second first :=
  ⟨sameLevel.2, sameLevel.1⟩

theorem mutuallyReachable_trans
    {State : Type uState}
    {step : State → State → Prop}
    {first middle last : State}
    (firstMiddle : MutuallyReachable step first middle)
    (middleLast : MutuallyReachable step middle last) :
    MutuallyReachable step first last :=
  ⟨relationReachable_trans firstMiddle.1 middleLast.1,
    relationReachable_trans middleLast.2 firstMiddle.2⟩

/-- The canonical strongly-connected-component setoid of a scientific axis. -/
def reachabilitySetoid
    {State : Type uState}
    (step : State → State → Prop) : Setoid State where
  r := MutuallyReachable step
  iseqv := ⟨mutuallyReachable_refl step,
    mutuallyReachable_symm, mutuallyReachable_trans⟩

/-- The level type derived from an axis is its mutual-reachability quotient. -/
abbrev DerivedLevel
    {State : Type uState}
    (step : State → State → Prop) :=
  Quotient (reachabilitySetoid step)

/-- Send a state to its derived level class. -/
def derivedLevel
    {State : Type uState}
    (step : State → State → Prop)
    (state : State) : DerivedLevel step :=
  Quotient.mk (reachabilitySetoid step) state

/-- Mutual reachability is sufficient for equality of level classes. -/
theorem derivedLevel_eq_of_mutuallyReachable
    {State : Type uState}
    {step : State → State → Prop}
    {first second : State}
    (sameLevel : MutuallyReachable step first second) :
    derivedLevel step first = derivedLevel step second :=
  Quotient.sound sameLevel

/--
Reachability between representatives is invariant under changing either
representative inside its mutual-reachability class.
-/
theorem relationReachable_iff_of_mutuallyReachable
    {State : Type uState}
    {step : State → State → Prop}
    {first first' last last' : State}
    (sameFirst : MutuallyReachable step first first')
    (sameLast : MutuallyReachable step last last') :
    RelationReachable step first last ↔
      RelationReachable step first' last' := by
  constructor
  · intro path
    exact relationReachable_trans sameFirst.2
      (relationReachable_trans path sameLast.1)
  · intro path
    exact relationReachable_trans sameFirst.1
      (relationReachable_trans path sameLast.2)

/-- Reachability descends to a well-defined precedence relation on levels. -/
def derivedLevelPrecedes
    {State : Type uState}
    (step : State → State → Prop) :
    DerivedLevel step → DerivedLevel step → Prop :=
  fun first last =>
    Quotient.liftOn₂ first last
      (fun firstRepresentative lastRepresentative =>
        RelationReachable step firstRepresentative lastRepresentative)
      (by
        intro first last first' last' sameFirst sameLast
        apply propext
        exact relationReachable_iff_of_mutuallyReachable
          sameFirst sameLast)

@[simp] theorem derivedLevelPrecedes_mk
    {State : Type uState}
    {step : State → State → Prop}
    (first last : State) :
    derivedLevelPrecedes step
        (derivedLevel step first) (derivedLevel step last) ↔
      RelationReachable step first last := by
  rfl

/-- Derived level precedence is reflexive. -/
theorem derivedLevelPrecedes_refl
    {State : Type uState}
    (step : State → State → Prop)
    (level : DerivedLevel step) :
    derivedLevelPrecedes step level level := by
  refine Quotient.inductionOn level ?_
  intro representative
  exact RelationReachable.root

/-- Derived level precedence is transitive. -/
theorem derivedLevelPrecedes_trans
    {State : Type uState}
    {step : State → State → Prop}
    {first middle last : DerivedLevel step}
    (firstMiddle : derivedLevelPrecedes step first middle)
    (middleLast : derivedLevelPrecedes step middle last) :
    derivedLevelPrecedes step first last := by
  induction first using Quotient.inductionOn with
  | _ firstRepresentative =>
      induction middle using Quotient.inductionOn with
      | _ middleRepresentative =>
          induction last using Quotient.inductionOn with
          | _ lastRepresentative =>
              exact relationReachable_trans firstMiddle middleLast

/-- Mutual precedence is equality after strongly connected states are collapsed. -/
theorem derivedLevelPrecedes_antisymm
    {State : Type uState}
    {step : State → State → Prop}
    {first last : DerivedLevel step}
    (forward : derivedLevelPrecedes step first last)
    (backward : derivedLevelPrecedes step last first) :
    first = last := by
  induction first using Quotient.inductionOn with
  | _ firstRepresentative =>
      induction last using Quotient.inductionOn with
      | _ lastRepresentative =>
          exact Quotient.sound ⟨forward, backward⟩

/-- The three order laws show that the quotient is a genuine partial order. -/
theorem derivedLevelPrecedence_is_partial_order
    {State : Type uState}
    (step : State → State → Prop) :
    (∀ level : DerivedLevel step,
      derivedLevelPrecedes step level level) ∧
    (∀ first middle last : DerivedLevel step,
      derivedLevelPrecedes step first middle →
      derivedLevelPrecedes step middle last →
      derivedLevelPrecedes step first last) ∧
    (∀ first last : DerivedLevel step,
      derivedLevelPrecedes step first last →
      derivedLevelPrecedes step last first →
      first = last) :=
  ⟨derivedLevelPrecedes_refl step,
    fun _ _ _ => derivedLevelPrecedes_trans,
    fun _ _ => derivedLevelPrecedes_antisymm⟩

/-- Two-way precedence collapses to equality in the derived level quotient. -/
theorem derivedLevel_antisymmetric_on_representatives
    {State : Type uState}
    {step : State → State → Prop}
    {first second : State}
    (forward : RelationReachable step first second)
    (backward : RelationReachable step second first) :
    derivedLevel step first = derivedLevel step second :=
  derivedLevel_eq_of_mutuallyReachable ⟨forward, backward⟩

/-!
## Observation-indexed partitions
-/

/-- A declared family of context-indexed observations. -/
structure ContextualObservation
    (Context : Type uContext)
    (State : Type uState)
    (View : Type uView) where
  observe : Context → State → View

/-- States are observationally equivalent when every declared context agrees. -/
def ObservationallyEquivalent
    {Context : Type uContext}
    {State : Type uState}
    {View : Type uView}
    (observation : ContextualObservation Context State View)
    (first second : State) : Prop :=
  ∀ context, observation.observe context first =
    observation.observe context second

/-- Every declared observation family induces an equivalence relation. -/
def observationalSetoid
    {Context : Type uContext}
    {State : Type uState}
    {View : Type uView}
    (observation : ContextualObservation Context State View) : Setoid State where
  r := ObservationallyEquivalent observation
  iseqv := by
    constructor
    · intro state context
      rfl
    · intro first second same context
      exact (same context).symm
    · intro first second third firstSecond secondThird context
      exact (firstSecond context).trans (secondThird context)

/-- A fully separating finite observation family with exactly `n` tokens. -/
def discreteFiniteObservation (n : Nat) :
    ContextualObservation Unit (Fin n) (Fin n) where
  observe := fun _ state => state

theorem discreteFiniteObservation_equivalent_iff
    {n : Nat}
    {first second : Fin n} :
    ObservationallyEquivalent (discreteFiniteObservation n) first second ↔
      first = second := by
  constructor
  · intro same
    exact same ()
  · intro same
    subst second
    intro _
    rfl

/--
For every natural `n`, an observation doctrine whose quotient has exactly the
shape `Fin n` exists.  Hence no particular finite number, including thirteen,
is forced by the generic mechanics.
-/
def discreteFiniteObservationQuotientEquiv (n : Nat) :
    Quotient (observationalSetoid (discreteFiniteObservation n)) ≃ Fin n where
  toFun := Quotient.lift id (by
    intro first second same
    exact discreteFiniteObservation_equivalent_iff.mp same)
  invFun := fun state =>
    Quotient.mk (observationalSetoid (discreteFiniteObservation n)) state
  left_inv := by
    intro quotientState
    refine Quotient.inductionOn quotientState ?_
    intro state
    rfl
  right_inv := by
    intro state
    rfl

/-!
## Exact finite-atlas criteria

An atlas is exhaustive only relative to one already declared axis relation.
The criterion is surjectivity onto its derived quotient; exactness additionally
requires one representative per level.  This supplies the precise local sense
in which a K0--K12 atlas could be complete without making thirteen universal.
-/

/-- A finite atlas lists one state representative at each of its indices. -/
abbrev FiniteLevelAtlas (State : Type uState) (n : Nat) := Fin n → State

/-- Every derived level occurs in the finite atlas. -/
def AtlasExhaustive
    {State : Type uState}
    (step : State → State → Prop)
    {n : Nat}
    (atlas : FiniteLevelAtlas State n) : Prop :=
  Function.Surjective (fun index => derivedLevel step (atlas index))

/-- Every level occurs exactly once in the finite atlas. -/
def AtlasExact
    {State : Type uState}
    (step : State → State → Prop)
    {n : Nat}
    (atlas : FiniteLevelAtlas State n) : Prop :=
  Function.Bijective (fun index => derivedLevel step (atlas index))

theorem atlasExact_iff_exhaustive_and_no_duplicate_levels
    {State : Type uState}
    (step : State → State → Prop)
    {n : Nat}
    (atlas : FiniteLevelAtlas State n) :
    AtlasExact step atlas ↔
      AtlasExhaustive step atlas ∧
      ∀ first second,
        derivedLevel step (atlas first) = derivedLevel step (atlas second) →
          first = second := by
  constructor
  · rintro ⟨injective, surjective⟩
    exact ⟨surjective, injective⟩
  · rintro ⟨surjective, injective⟩
    exact ⟨injective, surjective⟩

theorem atlasExact_implies_exhaustive
    {State : Type uState}
    {step : State → State → Prop}
    {n : Nat}
    {atlas : FiniteLevelAtlas State n}
    (exact : AtlasExact step atlas) :
    AtlasExhaustive step atlas :=
  exact.2

/-!
## A branching level shape

The diamond is the smallest explicit witness that a valid level structure need
not be a ladder.
-/

inductive DiamondLevel
  | root
  | left
  | right
  | top
deriving DecidableEq

inductive DiamondStep : DiamondLevel → DiamondLevel → Prop
  | rootLeft : DiamondStep .root .left
  | rootRight : DiamondStep .root .right
  | leftTop : DiamondStep .left .top
  | rightTop : DiamondStep .right .top

def diamondLeftRegion : DiamondLevel → Prop :=
  fun state => state = .left ∨ state = .top

def diamondRightRegion : DiamondLevel → Prop :=
  fun state => state = .right ∨ state = .top

theorem diamondLeftRegion_closed :
    ∀ ⦃current next⦄,
      diamondLeftRegion current → DiamondStep current next →
        diamondLeftRegion next := by
  intro current next currentIn edge
  cases edge <;> simp [diamondLeftRegion] at currentIn ⊢

theorem diamondRightRegion_closed :
    ∀ ⦃current next⦄,
      diamondRightRegion current → DiamondStep current next →
        diamondRightRegion next := by
  intro current next currentIn edge
  cases edge <;> simp [diamondRightRegion] at currentIn ⊢

theorem diamond_left_does_not_reach_right :
    ¬ RelationReachable DiamondStep .left .right := by
  intro path
  have inRegion : diamondLeftRegion .right :=
    relationReachable_is_least
      (carrier := diamondLeftRegion)
      (by simp [diamondLeftRegion])
      diamondLeftRegion_closed path
  simpa [diamondLeftRegion] using inRegion

theorem diamond_right_does_not_reach_left :
    ¬ RelationReachable DiamondStep .right .left := by
  intro path
  have inRegion : diamondRightRegion .left :=
    relationReachable_is_least
      (carrier := diamondRightRegion)
      (by simp [diamondRightRegion])
      diamondRightRegion_closed path
  simpa [diamondRightRegion] using inRegion

theorem diamond_has_incomparable_levels :
    ¬ RelationReachable DiamondStep .left .right ∧
      ¬ RelationReachable DiamondStep .right .left :=
  ⟨diamond_left_does_not_reach_right,
    diamond_right_does_not_reach_left⟩

/-!
## Independent axes on one carrier
-/

def FirstCoordinateEquivalent
    (first second : Bool × Bool) : Prop :=
  first.1 = second.1

def SecondCoordinateEquivalent
    (first second : Bool × Bool) : Prop :=
  first.2 = second.2

/-- One pair can agree on the first scientific axis and disagree on the second. -/
theorem first_axis_does_not_determine_second :
    FirstCoordinateEquivalent (false, false) (false, true) ∧
      ¬ SecondCoordinateEquivalent (false, false) (false, true) := by
  constructor <;>
    simp [FirstCoordinateEquivalent, SecondCoordinateEquivalent]

/-- Conversely, agreement on the second axis need not imply agreement on the first. -/
theorem second_axis_does_not_determine_first :
    SecondCoordinateEquivalent (false, false) (true, false) ∧
      ¬ FirstCoordinateEquivalent (false, false) (true, false) := by
  constructor <;>
    simp [FirstCoordinateEquivalent, SecondCoordinateEquivalent]

/--
The two explicit witnesses rule out a generic refinement implication in either
direction.  Collapsing axes to one scalar therefore needs an additional domain
theorem; it is not supplied by the universal language.
-/
theorem scientific_axes_can_be_incomparable :
    (∃ first second,
      FirstCoordinateEquivalent first second ∧
        ¬ SecondCoordinateEquivalent first second) ∧
    (∃ first second,
      SecondCoordinateEquivalent first second ∧
        ¬ FirstCoordinateEquivalent first second) :=
  ⟨⟨(false, false), (false, true),
      first_axis_does_not_determine_second⟩,
    ⟨(false, false), (true, false),
      second_axis_does_not_determine_first⟩⟩

end OCKIndividuationMSpaceComposition
