import OCKIndividuationMSpaceComposition.SymmetryPrimitiveDistinction
import OCKIndividuationMSpaceComposition.SymmetryTorsorTransport

namespace OCKIndividuationMSpaceComposition

universe uSource uTarget uFinal

/-!
# Naturality of the symmetry generated by a primitive distinction

The previous primitive-distinction result derives a two-point axis and its
swap without assuming an action.  This module proves that the construction is
natural.  An arbitrary ambient function which sends the two source endpoints
to the two target endpoints restricts to an equivalence of the generated
axes.  If endpoint order is preserved, the equivalence preserves polarity; if
endpoint order is reversed, it negates polarity.

No injectivity, surjectivity, involution, freeness, transitivity or C₂ action
is assumed of the ambient function.  Those properties on the generated axes
follow solely from the two endpoint equations and endpoint separation.
-/

namespace PrimitiveDistinction

/-- An ambient function preserving the displayed endpoint order.  It carries
no bijectivity or symmetry premise. -/
structure OrderPreservingMap
    {Source : Type uSource} {Target : Type uTarget}
    (source : PrimitiveDistinction Source)
    (target : PrimitiveDistinction Target) where
  toFun : Source → Target
  map_first : toFun source.first = target.first
  map_second : toFun source.second = target.second

namespace OrderPreservingMap

/-- Restriction of an endpoint-preserving ambient map to the generated axes. -/
def axisMap
    {Source : Type uSource} {Target : Type uTarget}
    {source : PrimitiveDistinction Source}
    {target : PrimitiveDistinction Target}
    (map : OrderPreservingMap source target) : source.Axis → target.Axis :=
  fun point =>
    ⟨map.toFun point.1, by
      rcases point.property with first | second
      · left
        simpa [first] using map.map_first
      · right
        simpa [second] using map.map_second⟩

@[simp] theorem axisMap_first
    {Source : Type uSource} {Target : Type uTarget}
    {source : PrimitiveDistinction Source}
    {target : PrimitiveDistinction Target}
    (map : OrderPreservingMap source target) :
    map.axisMap source.axisFirst = target.axisFirst := by
  apply Subtype.ext
  exact map.map_first

@[simp] theorem axisMap_second
    {Source : Type uSource} {Target : Type uTarget}
    {source : PrimitiveDistinction Source}
    {target : PrimitiveDistinction Target}
    (map : OrderPreservingMap source target) :
    map.axisMap source.axisSecond = target.axisSecond := by
  apply Subtype.ext
  exact map.map_second

/-- The restricted map is injective although the ambient function need not be. -/
theorem axisMap_injective
    {Source : Type uSource} {Target : Type uTarget}
    {source : PrimitiveDistinction Source}
    {target : PrimitiveDistinction Target}
    (map : OrderPreservingMap source target) :
    Function.Injective map.axisMap := by
  intro left right equality
  rcases source.axis_cases left with rfl | rfl <;>
    rcases source.axis_cases right with rfl | rfl
  · rfl
  · rw [map.axisMap_first, map.axisMap_second] at equality
    exact False.elim (target.axisFirst_ne_axisSecond equality)
  · rw [map.axisMap_second, map.axisMap_first] at equality
    exact False.elim (target.axisFirst_ne_axisSecond equality.symm)
  · rfl

/-- The restricted map is surjective because both target-axis points occur. -/
theorem axisMap_surjective
    {Source : Type uSource} {Target : Type uTarget}
    {source : PrimitiveDistinction Source}
    {target : PrimitiveDistinction Target}
    (map : OrderPreservingMap source target) :
    Function.Surjective map.axisMap := by
  intro point
  rcases target.axis_cases point with rfl | rfl
  · exact ⟨source.axisFirst, map.axisMap_first⟩
  · exact ⟨source.axisSecond, map.axisMap_second⟩

/-- Hence every endpoint-preserving ambient function canonically induces an
equivalence of the generated axes. -/
noncomputable def axisEquiv
    {Source : Type uSource} {Target : Type uTarget}
    {source : PrimitiveDistinction Source}
    {target : PrimitiveDistinction Target}
    (map : OrderPreservingMap source target) : source.Axis ≃ target.Axis :=
  Equiv.ofBijective map.axisMap
    ⟨map.axisMap_injective, map.axisMap_surjective⟩

/-- The derived swap is natural under endpoint-order-preserving maps. -/
theorem axisMap_swap
    {Source : Type uSource} {Target : Type uTarget}
    {source : PrimitiveDistinction Source}
    {target : PrimitiveDistinction Target}
    (map : OrderPreservingMap source target) (point : source.Axis) :
    map.axisMap (source.axisSwap point) =
      target.axisSwap (map.axisMap point) := by
  rcases source.axis_cases point with rfl | rfl <;> simp

/-- The induced axis map is therefore an equivariant map of the derived R3
torsors, rather than a newly assumed R3 interface. -/
noncomputable def toR3EquivariantMap
    {Source : Type uSource} {Target : Type uTarget}
    {source : PrimitiveDistinction Source}
    {target : PrimitiveDistinction Target}
    (map : OrderPreservingMap source target) :
    R3EquivariantMap source.toR3Torsor target.toR3Torsor where
  toFun := map.axisMap
  equivariant := map.axisMap_swap

/-- Pointed polarity is preserved when endpoint order is preserved. -/
theorem generatedPolarity_natural
    {Source : Type uSource} {Target : Type uTarget}
    {source : PrimitiveDistinction Source}
    {target : PrimitiveDistinction Target}
    (map : OrderPreservingMap source target) (point : source.Axis) :
    target.generatedPolarity (map.axisMap point) =
      source.generatedPolarity point := by
  rcases source.axis_cases point with rfl | rfl <;> simp

/-- The endpoint equations determine the restricted axis map uniquely. -/
theorem axisMap_unique
    {Source : Type uSource} {Target : Type uTarget}
    {source : PrimitiveDistinction Source}
    {target : PrimitiveDistinction Target}
    (map : OrderPreservingMap source target)
    (candidate : source.Axis → target.Axis)
    (atFirst : candidate source.axisFirst = target.axisFirst)
    (atSecond : candidate source.axisSecond = target.axisSecond) :
    candidate = map.axisMap := by
  funext point
  rcases source.axis_cases point with rfl | rfl
  · simpa using atFirst
  · simpa using atSecond

/-! ## Identity and composition of the induced axis maps -/

/-- The identity endpoint-preserving map induces the identity on the generated
two-point axis.  This is a derived identity law, not an extra action premise. -/
def identity
    {Carrier : Type uSource}
    (distinction : PrimitiveDistinction Carrier) :
    OrderPreservingMap distinction distinction where
  toFun := fun point => point
  map_first := rfl
  map_second := rfl

@[simp] theorem axisMap_identity
    {Carrier : Type uSource}
    {distinction : PrimitiveDistinction Carrier} :
    (identity distinction).axisMap = id := by
  funext point
  apply Subtype.ext
  rfl

/-- Composition of endpoint-preserving ambient maps remains endpoint
preserving. -/
def comp
    {Source : Type uSource} {Target : Type uTarget}
    {Final : Type uFinal}
    {source : PrimitiveDistinction Source}
    {target : PrimitiveDistinction Target}
    {final : PrimitiveDistinction Final}
    (first : OrderPreservingMap source target)
    (second : OrderPreservingMap target final) :
    OrderPreservingMap source final where
  toFun := second.toFun ∘ first.toFun
  map_first := by
    simp [Function.comp, first.map_first, second.map_first]
  map_second := by
    simp [Function.comp, first.map_second, second.map_second]

@[simp] theorem axisMap_comp
    {Source : Type uSource} {Target : Type uTarget}
    {Final : Type uFinal}
    {source : PrimitiveDistinction Source}
    {target : PrimitiveDistinction Target}
    {final : PrimitiveDistinction Final}
    (first : OrderPreservingMap source target)
    (second : OrderPreservingMap target final) :
    (comp first second).axisMap = second.axisMap ∘ first.axisMap := by
  funext point
  apply Subtype.ext
  rfl

end OrderPreservingMap

/-- An ambient function reversing the displayed endpoint order.  Again, no
bijection or symmetry action is assumed. -/
structure OrderReversingMap
    {Source : Type uSource} {Target : Type uTarget}
    (source : PrimitiveDistinction Source)
    (target : PrimitiveDistinction Target) where
  toFun : Source → Target
  map_first : toFun source.first = target.second
  map_second : toFun source.second = target.first

namespace OrderReversingMap

/-- Restriction of an endpoint-reversing ambient map to generated axes. -/
def axisMap
    {Source : Type uSource} {Target : Type uTarget}
    {source : PrimitiveDistinction Source}
    {target : PrimitiveDistinction Target}
    (map : OrderReversingMap source target) : source.Axis → target.Axis :=
  fun point =>
    ⟨map.toFun point.1, by
      rcases point.property with first | second
      · right
        simpa [first] using map.map_first
      · left
        simpa [second] using map.map_second⟩

@[simp] theorem axisMap_first
    {Source : Type uSource} {Target : Type uTarget}
    {source : PrimitiveDistinction Source}
    {target : PrimitiveDistinction Target}
    (map : OrderReversingMap source target) :
    map.axisMap source.axisFirst = target.axisSecond := by
  apply Subtype.ext
  exact map.map_first

@[simp] theorem axisMap_second
    {Source : Type uSource} {Target : Type uTarget}
    {source : PrimitiveDistinction Source}
    {target : PrimitiveDistinction Target}
    (map : OrderReversingMap source target) :
    map.axisMap source.axisSecond = target.axisFirst := by
  apply Subtype.ext
  exact map.map_second

theorem axisMap_injective
    {Source : Type uSource} {Target : Type uTarget}
    {source : PrimitiveDistinction Source}
    {target : PrimitiveDistinction Target}
    (map : OrderReversingMap source target) :
    Function.Injective map.axisMap := by
  intro left right equality
  rcases source.axis_cases left with rfl | rfl <;>
    rcases source.axis_cases right with rfl | rfl
  · rfl
  · rw [map.axisMap_first, map.axisMap_second] at equality
    exact False.elim (target.axisFirst_ne_axisSecond equality.symm)
  · rw [map.axisMap_second, map.axisMap_first] at equality
    exact False.elim (target.axisFirst_ne_axisSecond equality)
  · rfl

theorem axisMap_surjective
    {Source : Type uSource} {Target : Type uTarget}
    {source : PrimitiveDistinction Source}
    {target : PrimitiveDistinction Target}
    (map : OrderReversingMap source target) :
    Function.Surjective map.axisMap := by
  intro point
  rcases target.axis_cases point with rfl | rfl
  · exact ⟨source.axisSecond, map.axisMap_second⟩
  · exact ⟨source.axisFirst, map.axisMap_first⟩

noncomputable def axisEquiv
    {Source : Type uSource} {Target : Type uTarget}
    {source : PrimitiveDistinction Source}
    {target : PrimitiveDistinction Target}
    (map : OrderReversingMap source target) : source.Axis ≃ target.Axis :=
  Equiv.ofBijective map.axisMap
    ⟨map.axisMap_injective, map.axisMap_surjective⟩

/-- Reversing endpoint order still commutes with the unpointed derived swap. -/
theorem axisMap_swap
    {Source : Type uSource} {Target : Type uTarget}
    {source : PrimitiveDistinction Source}
    {target : PrimitiveDistinction Target}
    (map : OrderReversingMap source target) (point : source.Axis) :
    map.axisMap (source.axisSwap point) =
      target.axisSwap (map.axisMap point) := by
  rcases source.axis_cases point with rfl | rfl <;> simp

noncomputable def toR3EquivariantMap
    {Source : Type uSource} {Target : Type uTarget}
    {source : PrimitiveDistinction Source}
    {target : PrimitiveDistinction Target}
    (map : OrderReversingMap source target) :
    R3EquivariantMap source.toR3Torsor target.toR3Torsor where
  toFun := map.axisMap
  equivariant := map.axisMap_swap

/-- Reversing endpoint order negates the pointed polarity coordinate.  This is
the exact mathematical meaning of "canonical only up to orientation". -/
theorem generatedPolarity_antinatural
    {Source : Type uSource} {Target : Type uTarget}
    {source : PrimitiveDistinction Source}
    {target : PrimitiveDistinction Target}
    (map : OrderReversingMap source target) (point : source.Axis) :
    target.generatedPolarity (map.axisMap point) =
      Bool.not (source.generatedPolarity point) := by
  rcases source.axis_cases point with rfl | rfl <;> simp

theorem axisMap_unique
    {Source : Type uSource} {Target : Type uTarget}
    {source : PrimitiveDistinction Source}
    {target : PrimitiveDistinction Target}
    (map : OrderReversingMap source target)
    (candidate : source.Axis → target.Axis)
    (atFirst : candidate source.axisFirst = target.axisSecond)
    (atSecond : candidate source.axisSecond = target.axisFirst) :
    candidate = map.axisMap := by
  funext point
  rcases source.axis_cases point with rfl | rfl
  · simpa using atFirst
  · simpa using atSecond

/-! ## Parity of endpoint-order composition -/

/- Two endpoint reversals compose to an endpoint-preserving map.  This is the
mathematical parity law behind the generated C₂ action: no involution is
assumed here; the endpoint equations force the parity change. -/
def comp
    {Source : Type uSource} {Target : Type uTarget}
    {Final : Type uFinal}
    {source : PrimitiveDistinction Source}
    {target : PrimitiveDistinction Target}
    {final : PrimitiveDistinction Final}
    (first : OrderReversingMap source target)
    (second : OrderReversingMap target final) :
    OrderPreservingMap source final where
  toFun := second.toFun ∘ first.toFun
  map_first := by
    simp [Function.comp, first.map_first, second.map_second]
  map_second := by
    simp [Function.comp, first.map_second, second.map_first]

@[simp] theorem axisMap_comp
    {Source : Type uSource} {Target : Type uTarget}
    {Final : Type uFinal}
    {source : PrimitiveDistinction Source}
    {target : PrimitiveDistinction Target}
    {final : PrimitiveDistinction Final}
    (first : OrderReversingMap source target)
    (second : OrderReversingMap target final) :
    (comp first second).axisMap = second.axisMap ∘ first.axisMap := by
  funext point
  apply Subtype.ext
  rfl

/- Two reversals restore the pointed polarity.  The conclusion is inherited
from the preserving composition, rather than inserted as an assumption. -/
theorem generatedPolarity_comp
    {Source : Type uSource} {Target : Type uTarget}
    {Final : Type uFinal}
    {source : PrimitiveDistinction Source}
    {target : PrimitiveDistinction Target}
    {final : PrimitiveDistinction Final}
    (first : OrderReversingMap source target)
    (second : OrderReversingMap target final)
    (point : source.Axis) :
    final.generatedPolarity ((comp first second).axisMap point) =
      source.generatedPolarity point := by
  exact OrderPreservingMap.generatedPolarity_natural (comp first second) point

end OrderReversingMap

end PrimitiveDistinction

end OCKIndividuationMSpaceComposition
