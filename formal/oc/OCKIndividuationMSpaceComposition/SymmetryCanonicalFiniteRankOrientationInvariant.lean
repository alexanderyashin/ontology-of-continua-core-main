import OCKIndividuationMSpaceComposition.SymmetryCanonicalFiniteRankRealization
import OCKIndividuationMSpaceComposition.SymmetryNativeActionRank

namespace OCKIndividuationMSpaceComposition

universe uIndex uCarrier

namespace PrimitiveDistinction

/-!
# Orientation invariance of the canonical finite rank

`PrimitiveDistinction` stores an ordered pair only as a presentation.  The
ambient operation generated by that pair is the unordered transposition.  This
file makes that distinction explicit at the level of a finite family: reverse
the two endpoint labels in every family member, preserve disjointness, and
prove that the resulting Boolean action and its finite image are unchanged.

The result is a symmetry statement about representation, not a new assumption
of pole-exchange, a global dimension theorem, or a claim that every OC carrier
contains the canonical finite family.
-/

namespace DisjointDistinctionFamily

variable {Index : Type uIndex} {Carrier : Type uCarrier}
variable [Fintype Index] [DecidableEq Index]
variable [Fintype Carrier] [DecidableEq Carrier]

/-! ## Reversing all displayed orientations -/

/-- Reverse the presentation labels of every primitive distinction in a
pairwise-disjoint family.  No support or transitivity premise is added. -/
def reverseLabelsFamily
    (family : DisjointDistinctionFamily Index Carrier) :
    DisjointDistinctionFamily Index Carrier where
  distinction := fun index => (family.distinction index).reverseLabels
  supportsDisjoint := by
    intro first second different
    rcases family.supportsDisjoint different with
      ⟨firstFirst, firstSecond, secondFirst, secondSecond⟩
    exact ⟨secondSecond, secondFirst, firstSecond, firstFirst⟩

theorem reverseLabelsFamily_distinction
    (family : DisjointDistinctionFamily Index Carrier) (index : Index) :
    (family.reverseLabelsFamily).distinction index =
      (family.distinction index).reverseLabels :=
  rfl

/-- Each reversed local swap is definitionally the same ambient permutation as
the original one. -/
theorem reverseLabelsFamily_pairSwapEquiv
    (family : DisjointDistinctionFamily Index Carrier) (index : Index) :
    (pairSwapEquiv (family.reverseLabelsFamily.distinction index) :
        Equiv.Perm Carrier) =
      pairSwapEquiv (family.distinction index) := by
  apply Equiv.ext
  intro point
  simpa [pairSwapEquiv, reverseLabelsFamily] using
    congrFun (PrimitiveDistinction.pairSwap_reverseLabels
      (family.distinction index)) point

/-- The finite mask action is invariant under simultaneous endpoint relabeling
of every family member. -/
theorem reverseLabelsFamily_maskPermutation
    (family : DisjointDistinctionFamily Index Carrier) (mask : Index -> Bool) :
    family.reverseLabelsFamily.maskPermutation mask =
      family.maskPermutation mask := by
  classical
  unfold maskPermutation
  apply Finset.noncommProd_congr rfl
  intro index _
  exact family.reverseLabelsFamily_pairSwapEquiv index

/-- The factorized Boolean product presentation is invariant under the same
orientation reversal. -/
theorem reverseLabelsFamily_maskFactor
    (family : DisjointDistinctionFamily Index Carrier) (mask : Index -> Bool)
    (index : Index) :
    maskFactor family.reverseLabelsFamily mask index =
      maskFactor family mask index := by
  classical
  by_cases selected : mask index = true
  · simpa [maskFactor, selected] using
      family.reverseLabelsFamily_pairSwapEquiv index
  · simp [maskFactor, selected]

theorem reverseLabelsFamily_maskPermutationProduct
    (family : DisjointDistinctionFamily Index Carrier) (mask : Index -> Bool) :
    family.reverseLabelsFamily.maskPermutationProduct mask =
      family.maskPermutationProduct mask := by
  classical
  unfold maskPermutationProduct
  apply Finset.noncommProd_congr rfl
  intro index _
  exact family.reverseLabelsFamily_maskFactor mask index

/-! ## Cardinal and rank consequences -/

/-- Orientation does not change the number of actual Boolean transformations. -/
theorem reverseLabelsFamily_mask_range_card
    (family : DisjointDistinctionFamily Index Carrier) :
    Set.ncard (Set.range family.reverseLabelsFamily.maskPermutation) =
      Set.ncard (Set.range family.maskPermutation) := by
  have functionsEqual :
      family.reverseLabelsFamily.maskPermutation = family.maskPermutation := by
    funext mask
    exact family.reverseLabelsFamily_maskPermutation mask
  rw [functionsEqual]

/-- The factorized product has the same image cardinality after relabeling. -/
theorem reverseLabelsFamily_maskPermutationProduct_range_card
    (family : DisjointDistinctionFamily Index Carrier) :
    Set.ncard (Set.range family.reverseLabelsFamily.maskPermutationProduct) =
      Set.ncard (Set.range family.maskPermutationProduct) := by
  have functionsEqual :
      family.reverseLabelsFamily.maskPermutationProduct =
        family.maskPermutationProduct := by
    funext mask
    exact family.reverseLabelsFamily_maskPermutationProduct mask
  rw [functionsEqual]

/-! The rank itself is unchanged because it is computed from the actual
permutation image, not from the displayed endpoint labels. -/

theorem reverseLabelsFamily_symmetryAlgebraLogRank
    (family : DisjointDistinctionFamily Index Carrier) :
    symmetryAlgebraLogRank family.reverseLabelsFamily =
      symmetryAlgebraLogRank family := by
  unfold symmetryAlgebraLogRank
  rw [family.reverseLabelsFamily_maskPermutationProduct_range_card]

end DisjointDistinctionFamily

namespace CanonicalFiniteFamily

open DisjointDistinctionFamily

/-- The canonical adjacent-pair realization retains its `2^n` actual states
after all endpoint labels are reversed. -/
theorem canonical_reverseLabels_mask_range_card (n : Nat) :
    Set.ncard (Set.range
      (reverseLabelsFamily (canonicalDisjointFamily n)).maskPermutation) =
      2 ^ n := by
  rw [reverseLabelsFamily_mask_range_card]
  exact canonical_actual_mask_range_card n

/-- The canonical rank witness is independent of which endpoint of each pair
is displayed first. -/
theorem canonical_reverseLabels_product_range_card (n : Nat) :
    Set.ncard (Set.range
      (reverseLabelsFamily (canonicalDisjointFamily n)).maskPermutationProduct) =
      2 ^ n := by
  rw [reverseLabelsFamily_maskPermutationProduct_range_card]
  exact canonical_actual_product_range_card n

theorem canonical_reverseLabels_action_log_rank (n : Nat) :
    symmetryAlgebraLogRank
        (reverseLabelsFamily (canonicalDisjointFamily n)) = n := by
  rw [reverseLabelsFamily_symmetryAlgebraLogRank,
    symmetryAlgebraLogRank_eq_card]
  simp

end CanonicalFiniteFamily

end PrimitiveDistinction

end OCKIndividuationMSpaceComposition
