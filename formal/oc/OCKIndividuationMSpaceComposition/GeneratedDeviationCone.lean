import OCKIndividuationMSpaceComposition.KMEnterpriseRelationalDeviationCone
import Mathlib.Algebra.BigOperators.Ring.Finset
import Mathlib.Tactic.Linarith

namespace OCKIndividuationMSpaceComposition

open scoped BigOperators

/-!
# Generator mechanics for deviation cones

A deviation cone can be generated by typed event-incidence vectors with
nonnegative multiplicities.  The theorem is carrier- and domain-agnostic: it
applies to any score surface whose event generators preserve the selected
coordinate's relative order.
-/

universe uCarrier uGenerator

def generatedDeviation
    {Carrier : Type uCarrier} {Generator : Type uGenerator}
    [Fintype Generator]
    (generator : Generator → Carrier → Int)
    (weight : Generator → Nat) : Carrier → Int :=
  fun carrier => ∑ event, (weight event : Int) * generator event carrier

def GeneratorFamilyPreservesSelected
    {Carrier : Type uCarrier} {Generator : Type uGenerator}
    (generator : Generator → Carrier → Int) (selected : Carrier) : Prop :=
  ∀ event other, generator event other ≤ generator event selected

theorem generated_deviation_preserves_selected_order
    {Carrier : Type uCarrier} {Generator : Type uGenerator}
    [Fintype Generator]
    (generator : Generator → Carrier → Int)
    (weight : Generator → Nat) (selected : Carrier)
    (preserves : GeneratorFamilyPreservesSelected generator selected) :
    ∀ other,
      generatedDeviation generator weight other ≤
        generatedDeviation generator weight selected := by
  intro other
  unfold generatedDeviation
  apply Finset.sum_le_sum
  intro event _
  exact mul_le_mul_of_nonneg_left (preserves event other) (by positivity)

def StrictScoreDominant
    {Carrier : Type uCarrier} (profile : Carrier → Int) (selected : Carrier) : Prop :=
  ∀ other, other ≠ selected → profile other < profile selected

def addScoreProfiles
    {Carrier : Type uCarrier} (left right : Carrier → Int) : Carrier → Int :=
  fun carrier => left carrier + right carrier

/-- Positive universal theorem: every nonnegative multiset of safe generators
preserves a strict selected-coordinate margin. -/
theorem generated_cone_preserves_strict_score_dominance
    {Carrier : Type uCarrier} {Generator : Type uGenerator}
    [Fintype Generator]
    (planned : Carrier → Int) (generator : Generator → Carrier → Int)
    (weight : Generator → Nat) (selected : Carrier)
    (base : StrictScoreDominant planned selected)
    (preserves : GeneratorFamilyPreservesSelected generator selected) :
    StrictScoreDominant
      (addScoreProfiles planned (generatedDeviation generator weight)) selected := by
  intro other different
  have baseStrict := base other different
  have deviationLe :=
    generated_deviation_preserves_selected_order
      generator weight selected preserves other
  simp only [addScoreProfiles]
  linarith

def repeatedGeneratorDeviation
    {Carrier : Type uCarrier} {Generator : Type uGenerator}
    (generator : Generator → Carrier → Int) (event : Generator)
    (multiplicity : Nat) : Carrier → Int :=
  fun carrier => (multiplicity : Int) * generator event carrier

/-- Sharp no-go: if one generator advances a competitor faster than selected,
some finite repetition overturns every finite planned score margin. -/
theorem dangerous_generator_eventually_overturns_every_finite_margin
    {Carrier : Type uCarrier} {Generator : Type uGenerator}
    (planned : Carrier → Int) (generator : Generator → Carrier → Int)
    (event : Generator) (selected competitor : Carrier)
    (different : competitor ≠ selected)
    (dangerous : generator event selected < generator event competitor) :
    ∃ multiplicity : Nat,
      ¬ StrictScoreDominant
        (addScoreProfiles planned
          (repeatedGeneratorDeviation generator event multiplicity)) selected := by
  obtain ⟨multiplicity, exceedsMargin⟩ :=
    exists_nat_gt (planned selected - planned competitor)
  refine ⟨multiplicity, ?_⟩
  intro stillDominant
  have claimed := stillDominant competitor different
  have unitAdvantage :
      1 ≤ generator event competitor - generator event selected := by
    omega
  have multiplicityNonnegative : 0 ≤ (multiplicity : Int) := by positivity
  have multiplicityLeAdvantage :
      (multiplicity : Int) ≤
        (multiplicity : Int) *
          (generator event competitor - generator event selected) := by
    simpa using mul_le_mul_of_nonneg_left unitAdvantage multiplicityNonnegative
  have marginOvertaken :
      planned selected - planned competitor <
        (multiplicity : Int) *
          (generator event competitor - generator event selected) :=
    lt_of_lt_of_le exceedsMargin multiplicityLeAdvantage
  simp only [addScoreProfiles, repeatedGeneratorDeviation] at claimed
  linarith

/-- Enterprise adapter: a generated safe family yields the relational cone
premise used by the operational carrier theorem. -/
theorem enterprise_generated_deviation_is_relational
    {Generator : Type uGenerator} [Fintype Generator]
    (generator : Generator → EnterpriseCarrier → Int)
    (weight : Generator → Nat) (selected : EnterpriseCarrier)
    (preserves : GeneratorFamilyPreservesSelected generator selected) :
    DeviationConePreservesSelected
      (generatedDeviation generator weight) selected :=
  generated_deviation_preserves_selected_order
    generator weight selected preserves

end OCKIndividuationMSpaceComposition
