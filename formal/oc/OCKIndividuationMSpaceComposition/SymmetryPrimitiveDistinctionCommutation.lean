import OCKIndividuationMSpaceComposition.SymmetryPrimitiveDistinction

namespace OCKIndividuationMSpaceComposition

universe uCarrier

namespace PrimitiveDistinction

/-!
# Commutation boundary for primitive pair swaps

The canonical ambient `pairSwap` is an honest transposition: it exchanges the
distinguished pair and fixes every other carrier point.  This file records the
smallest commutation facts needed before treating several primitive
distinctions as a Boolean composition.

The positive results are deliberately one-sided.  Equal unordered supports
give the same transposition, and disjoint supports give commuting
transpositions.  A three-point overlap gives a sharp non-commutation witness.
No claim is made that arbitrary primitive distinctions commute, or that the
ambient carrier is generated by the displayed pairs.
-/

/-- The two presentations describe the same unordered pair of carrier points. -/
def SameUnorderedSupport {Carrier : Type uCarrier}
    (left right : PrimitiveDistinction Carrier) : Prop :=
  (left.first = right.first ∧ left.second = right.second) ∨
    (left.first = right.second ∧ left.second = right.first)

/-- Every endpoint of one displayed pair is different from every endpoint of
the other displayed pair. -/
def SupportsDisjoint {Carrier : Type uCarrier}
    (left right : PrimitiveDistinction Carrier) : Prop :=
  left.first ≠ right.first ∧
    left.first ≠ right.second ∧
    left.second ≠ right.first ∧
    left.second ≠ right.second

/-- Package the canonical ambient transposition as an equivalence. -/
noncomputable def pairSwapEquiv {Carrier : Type uCarrier}
    (distinction : PrimitiveDistinction Carrier) :
    Carrier ≃ Carrier where
  toFun := distinction.pairSwap
  invFun := distinction.pairSwap
  left_inv := distinction.pairSwap_involutive
  right_inv := distinction.pairSwap_involutive

/-- Equality of the displayed endpoints in the same order, or in reversed
order, gives equality of the ambient transpositions. -/
theorem pairSwap_eq_of_sameUnorderedSupport
    {Carrier : Type uCarrier}
    (left right : PrimitiveDistinction Carrier)
    (same : SameUnorderedSupport left right) :
    left.pairSwap = right.pairSwap := by
  rcases same with ⟨firstEq, secondEq⟩ | ⟨firstEq, secondEq⟩
  · funext point
    simp only [pairSwap]
    rw [firstEq, secondEq]
  · funext point
    by_cases pointFirst : point = right.first
    · subst point
      simp [pairSwap, firstEq, secondEq, right.separated]
    · by_cases pointSecond : point = right.second
      · subst point
        simp [pairSwap, firstEq, secondEq, right.separated,
          Ne.symm right.separated]
      · simp [pairSwap, firstEq, secondEq, pointFirst, pointSecond]

/-- Disjoint endpoint supports yield commuting ambient transpositions. -/
theorem pairSwap_commute_of_supportsDisjoint
    {Carrier : Type uCarrier}
    (left right : PrimitiveDistinction Carrier)
    (disjoint : SupportsDisjoint left right) :
    Function.Commute left.pairSwap right.pairSwap := by
  intro point
  rcases disjoint with ⟨leftFirstRightFirst, leftFirstRightSecond,
    leftSecondRightFirst, leftSecondRightSecond⟩
  by_cases pointLeftFirst : point = left.first
  · subst point
    rw [right.pairSwap_outside left.first leftFirstRightFirst
          leftFirstRightSecond,
      left.pairSwap_first,
      right.pairSwap_outside left.second leftSecondRightFirst
          leftSecondRightSecond]
  · by_cases pointLeftSecond : point = left.second
    · subst point
      rw [right.pairSwap_outside left.second leftSecondRightFirst
            leftSecondRightSecond,
        left.pairSwap_second,
        right.pairSwap_outside left.first leftFirstRightFirst
            leftFirstRightSecond]
    · by_cases pointRightFirst : point = right.first
      · subst point
        rw [left.pairSwap_outside right.first
              leftFirstRightFirst.symm leftSecondRightFirst.symm,
          right.pairSwap_first,
          left.pairSwap_outside right.second
              leftFirstRightSecond.symm leftSecondRightSecond.symm]
      · by_cases pointRightSecond : point = right.second
        · subst point
          rw [left.pairSwap_outside right.second
                leftFirstRightSecond.symm leftSecondRightSecond.symm,
            right.pairSwap_second,
            left.pairSwap_outside right.first
                leftFirstRightFirst.symm leftSecondRightFirst.symm]
        · simp only [right.pairSwap_outside point pointRightFirst
              pointRightSecond,
            left.pairSwap_outside point pointLeftFirst
              pointLeftSecond]

/-- Three distinct points with one shared endpoint are a sharp overlap witness:
the two transpositions do not commute. -/
theorem pairSwap_noncommute_of_three_distinct_points
    {Carrier : Type uCarrier}
    (first middle last : Carrier)
    (firstNeMiddle : first ≠ middle)
    (middleNeLast : middle ≠ last)
    (firstNeLast : first ≠ last) :
    ¬ Function.Commute
      (pairSwap (⟨first, middle, firstNeMiddle⟩ : PrimitiveDistinction Carrier))
      (pairSwap (⟨middle, last, middleNeLast⟩ : PrimitiveDistinction Carrier)) := by
  let left : PrimitiveDistinction Carrier :=
    ⟨first, middle, firstNeMiddle⟩
  let right : PrimitiveDistinction Carrier :=
    ⟨middle, last, middleNeLast⟩
  intro commute
  have atFirst := commute first
  rw [right.pairSwap_outside first firstNeMiddle firstNeLast,
    left.pairSwap_first,
    right.pairSwap_first] at atFirst
  exact middleNeLast atFirst

/-- Concrete `Fin 3` instance of the three-point overlap obstruction. -/
theorem fin3_overlap_pairSwaps_noncommute :
    ¬ Function.Commute
      (pairSwap (⟨0, 1, by decide⟩ : PrimitiveDistinction (Fin 3)))
      (pairSwap (⟨1, 2, by decide⟩ : PrimitiveDistinction (Fin 3))) := by
  exact pairSwap_noncommute_of_three_distinct_points
    (0 : Fin 3) (1 : Fin 3) (2 : Fin 3)
    (by decide) (by decide) (by decide)

end PrimitiveDistinction

end OCKIndividuationMSpaceComposition
