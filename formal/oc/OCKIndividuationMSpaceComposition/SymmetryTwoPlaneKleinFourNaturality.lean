import OCKIndividuationMSpaceComposition.SymmetryTwoPlaneKleinFourMask

namespace OCKIndividuationMSpaceComposition

namespace PrimitiveDistinction

/-!
# Exchange naturality of the concrete two-plane algebra

`SymmetryTwoPlaneKleinFourMask` realizes the four transformations generated by
two primitive axes.  Here the coordinate exchange is treated as an actual
conjugation of that action.  Thus the identity and simultaneous mask are fixed,
the two singleton generators are exchanged, and composition is preserved.
No global permutation of an arbitrary OC carrier is inferred.
-/

/-- Coordinate exchange conjugates a mask action to the action of the
exchanged mask. -/
theorem planeMaskAction_coordinateSwap_natural
    (mask point : PlaneCoordinate) :
    boolCoordinateSwap
        (planeMaskAction mask (boolCoordinateSwap point)) =
      planeMaskAction (boolCoordinateSwap mask) point := by
  rcases mask with ⟨maskFirst, maskSecond⟩
  rcases point with ⟨pointFirst, pointSecond⟩
  cases maskFirst <;> cases maskSecond <;>
    cases pointFirst <;> cases pointSecond <;> rfl

/-- Conjugation by coordinate exchange preserves the zero mask. -/
theorem boolCoordinateSwap_zero_mask :
    boolCoordinateSwap planeZeroMask = planeZeroMask := by
  rfl

/-- Conjugation by coordinate exchange preserves the simultaneous mask. -/
theorem boolCoordinateSwap_both_mask :
    boolCoordinateSwap planeBothMask = planeBothMask := by
  rfl

/-- Conjugation exchanges the two primitive singleton generators. -/
theorem boolCoordinateSwap_first_mask :
    boolCoordinateSwap planeFirstMask = planeSecondMask := by
  rfl

theorem boolCoordinateSwap_second_mask :
    boolCoordinateSwap planeSecondMask = planeFirstMask := by
  rfl

/-- The explicit four-mask carrier is closed under coordinate exchange. -/
theorem planeMaskSet_coordinateSwap_closed :
    planeMaskSet.image boolCoordinateSwap = planeMaskSet := by
  decide

end PrimitiveDistinction

end OCKIndividuationMSpaceComposition
