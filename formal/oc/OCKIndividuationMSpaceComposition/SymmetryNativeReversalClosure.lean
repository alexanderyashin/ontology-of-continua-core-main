import OCKIndividuationMSpaceComposition.SymmetryNativeActionRank
import OCKIndividuationMSpaceComposition.SymmetryIntrinsicFinitaryRank
import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.Tactic

namespace OCKIndividuationMSpaceComposition

universe uIndex uCarrier

namespace PrimitiveDistinction

/-!
# A native closure induced by disjoint reversible distinctions

`DisjointDistinctionFamily` already gives actual carrier permutations.  This
module defines the finite closure of a seed of those local reversals by the
subgroup they generate, then proves what that closure really is: for a
pairwise-disjoint family, a local reversal belongs to the generated subgroup
exactly when its index belongs to the seed.

This is the missing semantic bridge between the realised permutation algebra
and the finite intrinsic-rank interface.  The closure is not defined to be
the identity closure; it is defined from subgroup generation in the actual
ambient permutation group.  The identity form is a theorem of disjoint
support and endpoint faithfulness.  Consequently extensivity, idempotence,
monotonicity and exchange are derived for this native model, and its finite
rank equals both the number of local distinctions and the logarithmic size of
the realised Boolean action.

The result remains deliberately bounded: pairwise disjoint support is the
native premise used here.  A general OC composition law still needs to prove
such a premise (or a different exchange-producing law) from its own
semantics.
-/

namespace DisjointDistinctionFamily

variable {Index : Type uIndex} {Carrier : Type uCarrier}
variable [Fintype Index] [DecidableEq Index]
variable [Fintype Carrier] [DecidableEq Carrier]

/-! ## The actual subgroup generated by a seed of local reversals -/

def reversalGeneratorSet
    (family : DisjointDistinctionFamily Index Carrier)
    (seed : Finset Index) : Set (Equiv.Perm Carrier) :=
  {permutation |
    ∃ index, index ∈ seed ∧
      permutation = pairSwapEquiv (family.distinction index)}

noncomputable def reversalSubgroup
    (family : DisjointDistinctionFamily Index Carrier)
    (seed : Finset Index) : Subgroup (Equiv.Perm Carrier) :=
  Subgroup.closure (family.reversalGeneratorSet seed)

def reversalGenerated
    (family : DisjointDistinctionFamily Index Carrier)
    (seed : Finset Index) (index : Index) : Prop :=
  (pairSwapEquiv (family.distinction index) : Equiv.Perm Carrier) ∈
    family.reversalSubgroup seed

omit [Fintype Index] [DecidableEq Index] [Fintype Carrier] [DecidableEq Carrier] in
theorem reversalGenerated_of_mem
    (family : DisjointDistinctionFamily Index Carrier)
    {seed : Finset Index} {index : Index}
    (indexMember : index ∈ seed) :
    family.reversalGenerated seed index := by
  apply Subgroup.subset_closure
  exact ⟨index, indexMember, rfl⟩

/-! ## Stabilizers expose the non-generation direction -/

def fixesPointSubgroup
    (point : Carrier) : Subgroup (Equiv.Perm Carrier) where
  carrier := {permutation | permutation point = point}
  one_mem' := by rfl
  mul_mem' := by
    intro first second firstFixed secondFixed
    change (first * second) point = point
    change first (second point) = point
    rw [secondFixed, firstFixed]
  inv_mem' := by
    intro permutation fixed
    have transported := congrArg (fun value => permutation⁻¹ value) fixed
    change permutation⁻¹ point = point
    simpa using transported.symm

theorem reversalSubgroup_le_fixesPoint_of_not_mem
    (family : DisjointDistinctionFamily Index Carrier)
    {seed : Finset Index} (index : Index)
    (indexNotMember : index ∉ seed) :
    family.reversalSubgroup seed ≤
      fixesPointSubgroup (family.distinction index).first := by
  apply (Subgroup.closure_le _).2
  intro permutation member
  rcases member with ⟨other, otherMember, rfl⟩
  apply family.pairSwapEquiv_fixes_other_first
  intro equal
  apply indexNotMember
  exact equal ▸ otherMember

theorem reversal_notGenerated_of_not_mem
    (family : DisjointDistinctionFamily Index Carrier)
    {seed : Finset Index} {index : Index}
    (indexNotMember : index ∉ seed) :
    ¬ family.reversalGenerated seed index := by
  intro generated
  have fixed :=
    (family.reversalSubgroup_le_fixesPoint_of_not_mem index indexNotMember)
      generated
  change (pairSwapEquiv (family.distinction index) : Equiv.Perm Carrier)
      (family.distinction index).first =
      (family.distinction index).first at fixed
  have fixed' : (family.distinction index).pairSwap
      (family.distinction index).first =
      (family.distinction index).first := by
    simpa [pairSwapEquiv] using fixed
  rw [(family.distinction index).pairSwap_first] at fixed'
  exact (family.distinction index).separated fixed'.symm

/-! ## The induced finite closure and its exact normal form -/

noncomputable def nativeReversalClosure
    (family : DisjointDistinctionFamily Index Carrier)
    (seed : Finset Index) : Finset Index :=
  by
    classical
    exact Finset.univ.filter (family.reversalGenerated seed)

omit [DecidableEq Index] [Fintype Carrier] [DecidableEq Carrier] in
@[simp] theorem mem_nativeReversalClosure
    (family : DisjointDistinctionFamily Index Carrier)
    {seed : Finset Index} {index : Index} :
    index ∈ family.nativeReversalClosure seed ↔
      family.reversalGenerated seed index := by
  classical
  simp [nativeReversalClosure]

theorem nativeReversalClosure_eq_seed
    (family : DisjointDistinctionFamily Index Carrier)
    (seed : Finset Index) :
    family.nativeReversalClosure seed = seed := by
  classical
  ext index
  rw [mem_nativeReversalClosure]
  constructor
  · intro generated
    by_contra indexNotMember
    exact family.reversal_notGenerated_of_not_mem indexNotMember generated
  · exact family.reversalGenerated_of_mem

/-! The native subgroup closure is an exchange closure, by theorem. -/

noncomputable def nativeReversalFinitaryClosure
    (family : DisjointDistinctionFamily Index Carrier) :
    IntrinsicFinitaryRank.FinitaryDistinctionClosure Index where
  close := family.nativeReversalClosure
  extensive := by
    intro seed
    rw [family.nativeReversalClosure_eq_seed seed]
  monotone := by
    intro first second subset
    rw [family.nativeReversalClosure_eq_seed first,
      family.nativeReversalClosure_eq_seed second]
    exact subset
  idempotent := by
    intro seed
    rw [family.nativeReversalClosure_eq_seed seed,
      family.nativeReversalClosure_eq_seed seed]
  exchange := by
    intro seed first second firstGenerated firstNew
    change first ∈ family.nativeReversalClosure (insert second seed) at firstGenerated
    change first ∉ family.nativeReversalClosure seed at firstNew
    rw [family.nativeReversalClosure_eq_seed (insert second seed)] at firstGenerated
    rw [family.nativeReversalClosure_eq_seed seed] at firstNew
    rw [family.nativeReversalClosure_eq_seed (insert first seed)]
    rcases Finset.mem_insert.mp firstGenerated with equal | inSeed
    · exact Finset.mem_insert.mpr (Or.inl equal.symm)
    · exact (firstNew inSeed).elim

theorem nativeReversalFinitaryClosure_rank_eq_card
    (family : DisjointDistinctionFamily Index Carrier)
    (seed : Finset Index) :
    (family.nativeReversalFinitaryClosure).rank seed = seed.card := by
  classical
  unfold IntrinsicFinitaryRank.FinitaryDistinctionClosure.rank
  apply le_antisymm
  · apply Finset.sup_le
    intro candidate candidateMember
    exact Finset.card_le_card
      (Finset.mem_powerset.mp (Finset.mem_filter.mp candidateMember).1)
  · apply Finset.le_sup
    have seedIndependent :
        (family.nativeReversalFinitaryClosure).Independent seed := by
      intro index _ generated
      change index ∈ family.nativeReversalClosure (seed.erase index) at generated
      rw [family.nativeReversalClosure_eq_seed (seed.erase index)] at generated
      simp at generated
    exact Finset.mem_filter.mpr
      ⟨Finset.mem_powerset.mpr (by exact subset_rfl), seedIndependent⟩

/-! ## The rank/action identification for the native disjoint family -/

theorem nativeReversalFinitaryClosure_rank_univ_eq_action_log_rank
    (family : DisjointDistinctionFamily Index Carrier) :
    (family.nativeReversalFinitaryClosure).rank Finset.univ =
      symmetryAlgebraLogRank family := by
  rw [family.nativeReversalFinitaryClosure_rank_eq_card,
    symmetryAlgebraLogRank_eq_card]
  simp

end DisjointDistinctionFamily

/-! ## Carrier relabeling and naturality of the native closure

The closure above is built from actual carrier permutations.  We therefore
record its behavior under a faithful relabeling of the carrier, rather than
leaving rank invariance as a cardinality coincidence.  The transport map is
conjugation by the relabeling equivalence; the endpoint swap equation is
proved pointwise.  The finite closure itself is unchanged because the
membership characterization is a theorem of the transported family, not a
new closure axiom.
-/

namespace NativeCarrierTransport

variable {Index : Type uIndex} {Carrier : Type uCarrier}
variable [Fintype Index] [DecidableEq Index]
variable [Fintype Carrier] [DecidableEq Carrier]

variable {TargetCarrier : Type*}
variable [Fintype TargetCarrier] [DecidableEq TargetCarrier]

def transportDistinction
    (relabel : Carrier ≃ TargetCarrier)
    (distinction : PrimitiveDistinction Carrier) :
    PrimitiveDistinction TargetCarrier where
  first := relabel distinction.first
  second := relabel distinction.second
  separated := by
    intro equal
    apply distinction.separated
    exact relabel.injective equal

def transportFamily
    (relabel : Carrier ≃ TargetCarrier)
    (family : DisjointDistinctionFamily Index Carrier) :
    DisjointDistinctionFamily Index TargetCarrier where
  distinction := fun index =>
    transportDistinction relabel (family.distinction index)
  supportsDisjoint := by
    intro first second different
    rcases family.supportsDisjoint different with
      ⟨firstFirst, firstSecond, secondFirst, secondSecond⟩
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro equal
      exact firstFirst (relabel.injective equal)
    · intro equal
      exact firstSecond (relabel.injective equal)
    · intro equal
      exact secondFirst (relabel.injective equal)
    · intro equal
      exact secondSecond (relabel.injective equal)

/-! Conjugation carries an ambient permutation to the relabeled carrier. -/
def transportPermutation
    (relabel : Carrier ≃ TargetCarrier)
    (permutation : Equiv.Perm Carrier) : Equiv.Perm TargetCarrier :=
  relabel.symm.trans (permutation.trans relabel)

@[simp] theorem transportPermutation_apply
    (relabel : Carrier ≃ TargetCarrier)
    (permutation : Equiv.Perm Carrier)
    (point : TargetCarrier) :
    transportPermutation relabel permutation point =
      relabel (permutation (relabel.symm point)) := by
  rfl

theorem transport_pairSwap
    (relabel : Carrier ≃ TargetCarrier)
    (distinction : PrimitiveDistinction Carrier) :
    transportPermutation relabel (pairSwapEquiv distinction) =
      pairSwapEquiv (transportDistinction relabel distinction) := by
  ext point
  by_cases pointFirst : point = relabel distinction.first
  · subst point
    rw [transportPermutation_apply]
    simp only [pairSwapEquiv, Equiv.symm_apply_apply]
    change relabel (distinction.pairSwap distinction.first) =
      (transportDistinction relabel distinction).pairSwap
        (relabel distinction.first)
    rw [distinction.pairSwap_first]
    simpa [transportDistinction] using
      ((transportDistinction relabel distinction).pairSwap_first).symm
  · by_cases pointSecond : point = relabel distinction.second
    · subst point
      rw [transportPermutation_apply]
      simp only [pairSwapEquiv, Equiv.symm_apply_apply]
      change relabel (distinction.pairSwap distinction.second) =
        (transportDistinction relabel distinction).pairSwap
          (relabel distinction.second)
      rw [distinction.pairSwap_second]
      simpa [transportDistinction] using
        ((transportDistinction relabel distinction).pairSwap_second).symm
    · have preimageFirst : relabel.symm point ≠ distinction.first := by
        intro equal
        apply pointFirst
        calc
          point = relabel (relabel.symm point) :=
            (relabel.apply_symm_apply point).symm
          _ = relabel distinction.first := congrArg relabel equal
      have preimageSecond : relabel.symm point ≠ distinction.second := by
        intro equal
        apply pointSecond
        calc
          point = relabel (relabel.symm point) :=
            (relabel.apply_symm_apply point).symm
          _ = relabel distinction.second := congrArg relabel equal
      rw [transportPermutation_apply]
      simp only [pairSwapEquiv]
      change relabel (distinction.pairSwap (relabel.symm point)) =
        (transportDistinction relabel distinction).pairSwap point
      rw [distinction.pairSwap_outside _ preimageFirst preimageSecond]
      simpa using
        ((transportDistinction relabel distinction).pairSwap_outside
          point pointFirst pointSecond).symm

theorem transport_nativeReversalClosure
    (relabel : Carrier ≃ TargetCarrier)
    (family : DisjointDistinctionFamily Index Carrier)
    (seed : Finset Index) :
    (transportFamily relabel family).nativeReversalClosure seed =
      family.nativeReversalClosure seed := by
  rw [DisjointDistinctionFamily.nativeReversalClosure_eq_seed,
    DisjointDistinctionFamily.nativeReversalClosure_eq_seed]

theorem transport_nativeReversalFinitaryClosure_rank
    (relabel : Carrier ≃ TargetCarrier)
    (family : DisjointDistinctionFamily Index Carrier)
    (seed : Finset Index) :
    ((transportFamily relabel family).nativeReversalFinitaryClosure).rank seed =
      (family.nativeReversalFinitaryClosure).rank seed := by
  rw [DisjointDistinctionFamily.nativeReversalFinitaryClosure_rank_eq_card,
    DisjointDistinctionFamily.nativeReversalFinitaryClosure_rank_eq_card]

end NativeCarrierTransport

end PrimitiveDistinction

end OCKIndividuationMSpaceComposition
