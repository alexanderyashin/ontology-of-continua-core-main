import OCKIndividuationMSpaceComposition.SymmetryNativeIntrinsicDimensionBridge
import Mathlib.Combinatorics.Matroid.Constructions

namespace OCKIndividuationMSpaceComposition

universe uIndex uCarrier

namespace PrimitiveDistinction

/-!
# Reduction of the native finite model to a standard free matroid

The native disjoint-reversal construction is generated by actual carrier
permutations.  Its nontrivial closure theorem says that the subgroup-generated
index closure of every finite seed is exactly that seed.  This file consumes
that theorem to give an explicit prior-art reduction to Mathlib's `freeOn`
matroid on the finite index ground set.

The reduction has three separately visible preservation clauses:

* the finite native closure, after coercion to a set, agrees with matroid
  closure;
* finite native independence agrees with matroid independence;
* every finite seed is a matroid basis of itself.

The target is therefore a *free finite matroid presentation* of this selected
native family.  This is not a theorem that arbitrary OC closure is a matroid:
the existing finite fan countermodel has extensivity, monotonicity and
idempotence but fails exchange.  Nor does this file identify the free target
with a global OC dimension; the native/action and intrinsic rank boundaries
remain the explicit premises of their respective modules.
-/

namespace NativeFreeMatroidReduction

open DisjointDistinctionFamily
open IntrinsicFinitaryRank
open IntrinsicDimensionInterface

variable {Index : Type uIndex} {Carrier : Type uCarrier}
variable [Fintype Index] [DecidableEq Index]
variable [Fintype Carrier] [DecidableEq Carrier]

/-! ## The explicit target map -/

/-- The standard prior-art target for a native disjoint family.

The family parameter records the source of the reduction.  Its independence
from the target value is intentional and is justified by the native closure
normal-form theorem proved from subgroup generation below. -/
noncomputable def freeMatroidPresentation
    (family : DisjointDistinctionFamily Index Carrier) : Matroid Index :=
  Matroid.freeOn (Set.univ : Set Index)

@[simp] theorem freeMatroidPresentation_ground
    (family : DisjointDistinctionFamily Index Carrier) :
    (freeMatroidPresentation family).E = (Set.univ : Set Index) := by
  rfl

/-! ## Closure and independence preservation -/

/-- The subgroup-generated native closure agrees with standard matroid closure
after the finite-set coercion. -/
theorem nativeClosure_coe_eq_freeMatroid_closure
    (family : DisjointDistinctionFamily Index Carrier)
    (seed : Finset Index) :
    (↑(family.nativeReversalClosure seed) : Set Index) =
      (freeMatroidPresentation family).closure (↑seed : Set Index) := by
  rw [family.nativeReversalClosure_eq_seed,
    freeMatroidPresentation, Matroid.freeOn_closure_eq]
  simp

/-- Native finite independence is exactly independence in the free matroid
target.  The left side is obtained from the actual native closure result; it
is not stipulated by the target definition. -/
theorem nativeIndependent_iff_freeMatroid_indep
    (family : DisjointDistinctionFamily Index Carrier)
    (seed : Finset Index) :
    (family.nativeReversalFinitaryClosure).Independent seed ↔
      (freeMatroidPresentation family).Indep (↑seed : Set Index) := by
  constructor
  · intro _
    exact Matroid.freeOn_indep (Set.subset_univ _)
  · intro _
    exact family.nativeReversalFinitaryClosure_independent seed

/-! ## Basis preservation and the finite cardinality readback -/

/-- A finite native seed is a basis of its coerced set in the target free
matroid.  This is the standard `freeOn` basis theorem, with the finite native
seed supplied as the observed set. -/
theorem nativeSeed_is_freeMatroid_basis
    (family : DisjointDistinctionFamily Index Carrier)
    (seed : Finset Index) :
    (freeMatroidPresentation family).IsBasis
      (↑seed : Set Index) (↑seed : Set Index) := by
  rw [freeMatroidPresentation, Matroid.freeOn_isBasis_iff]
  exact ⟨rfl, Set.subset_univ _⟩

/-! A compact preservation package for consumers of the reduction. -/
theorem native_freeMatroid_structure_preserved
    (family : DisjointDistinctionFamily Index Carrier)
    (seed : Finset Index) :
    ((↑(family.nativeReversalClosure seed) : Set Index) =
        (freeMatroidPresentation family).closure (↑seed : Set Index)) ∧
      ((family.nativeReversalFinitaryClosure).Independent seed ↔
        (freeMatroidPresentation family).Indep (↑seed : Set Index)) ∧
      (freeMatroidPresentation family).IsBasis
        (↑seed : Set Index) (↑seed : Set Index) := by
  exact ⟨nativeClosure_coe_eq_freeMatroid_closure family seed,
    nativeIndependent_iff_freeMatroid_indep family seed,
    nativeSeed_is_freeMatroid_basis family seed⟩

/-! ## Exact reduction boundary -/

/-- The ordinary closure laws in the existing fan countermodel do not satisfy
the exchange condition required by the matroid prior-art class.  Thus the
native reduction above is conditional on its actual exchange-producing
composition; it is not a generic OC-to-matroid theorem. -/
theorem ordinary_closure_not_matroid_reducible_by_laws_alone :
    IntrinsicDimensionBoundary.ClosureExtensive
          IntrinsicDimensionBoundary.fanClosure ∧
      IntrinsicDimensionBoundary.ClosureMonotone
          IntrinsicDimensionBoundary.fanClosure ∧
      IntrinsicDimensionBoundary.ClosureIdempotent
          IntrinsicDimensionBoundary.fanClosure ∧
      ¬ IntrinsicDimensionBoundary.ClosureExchange
          IntrinsicDimensionBoundary.fanClosure := by
  exact ⟨IntrinsicDimensionBoundary.fanClosure_extensive,
    IntrinsicDimensionBoundary.fanClosure_monotone,
    IntrinsicDimensionBoundary.fanClosure_idempotent,
    IntrinsicDimensionBoundary.fanClosure_fails_exchange⟩

end NativeFreeMatroidReduction

end PrimitiveDistinction

end OCKIndividuationMSpaceComposition
