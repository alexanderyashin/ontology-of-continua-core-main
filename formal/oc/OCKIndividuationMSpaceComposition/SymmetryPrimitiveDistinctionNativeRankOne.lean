import OCKIndividuationMSpaceComposition.SymmetryNativeIntrinsicDimensionBridge
import OCKIndividuationMSpaceComposition.SymmetryPrimitiveDistinctionC2Boundary

namespace OCKIndividuationMSpaceComposition

universe uCarrier

namespace PrimitiveDistinction

/-!
# One native direction generated by one primitive distinction

The finite native-rank construction is now specialized to the axis that a
primitive distinction itself generates.  The index type is `Fin 1`; its only
family member is the endpoint exchange on that derived axis.  The closure is
still the subgroup closure of an actual ambient permutation, so the rank-one
statement is a realization theorem rather than a definition of dimension.

This closes the exact local bridge

`unequal pair -> derived free C₂ axis -> one independent native direction`.

It does not claim that a lone pair fixes the rank of an arbitrary ambient
carrier: the global coverage and complement-extension boundaries remain
separate theorems.
-/

noncomputable instance generatedAxisDecidableEq
    {Carrier : Type uCarrier}
    (distinction : PrimitiveDistinction Carrier) : DecidableEq distinction.Axis :=
  Classical.decEq _

/-! ## The one-member family on the generated axis -/

noncomputable def generatedAxisSingletonFamily
    {Carrier : Type uCarrier}
    (distinction : PrimitiveDistinction Carrier) :
    DisjointDistinctionFamily (Fin 1) distinction.Axis := by
  classical
  let axisPair : PrimitiveDistinction distinction.Axis :=
    { first := distinction.axisFirst
      second := distinction.axisSecond
      separated := distinction.axisFirst_ne_axisSecond }
  exact
    { distinction := fun _ => axisPair
      supportsDisjoint := by
        intro first second different
        exact (different (Subsingleton.elim _ _)).elim }

theorem generatedAxisSingletonFamily_rank_empty
    {Carrier : Type uCarrier}
    (distinction : PrimitiveDistinction Carrier) :
    (distinction.generatedAxisSingletonFamily.nativeReversalFinitaryClosure).rank ∅ =
      0 := by
  rw [DisjointDistinctionFamily.nativeReversalFinitaryClosure_rank_eq_card]
  simp

theorem generatedAxisSingletonFamily_rank_singleton
    {Carrier : Type uCarrier}
    (distinction : PrimitiveDistinction Carrier) :
    (distinction.generatedAxisSingletonFamily.nativeReversalFinitaryClosure).rank
        ({0} : Finset (Fin 1)) = 1 := by
  rw [DisjointDistinctionFamily.nativeReversalFinitaryClosure_rank_eq_card]
  decide

theorem generatedAxisSingletonFamily_rank_birth
    {Carrier : Type uCarrier}
    (distinction : PrimitiveDistinction Carrier) :
    (distinction.generatedAxisSingletonFamily.nativeReversalFinitaryClosure).rank
        ({0} : Finset (Fin 1)) =
      (distinction.generatedAxisSingletonFamily.nativeReversalFinitaryClosure).rank ∅ + 1 := by
  rw [distinction.generatedAxisSingletonFamily_rank_singleton,
    distinction.generatedAxisSingletonFamily_rank_empty]

theorem generatedAxisSingletonFamily_action_log_rank
    {Carrier : Type uCarrier}
    (distinction : PrimitiveDistinction Carrier) :
    DisjointDistinctionFamily.symmetryAlgebraLogRank
        distinction.generatedAxisSingletonFamily = 1 := by
  rw [DisjointDistinctionFamily.symmetryAlgebraLogRank_eq_card]
  decide

/-! ## Orientation does not alter the one-direction count -/

theorem generatedAxisSingletonFamily_native_rank_is_polarity_free
    {Carrier : Type uCarrier}
    (distinction : PrimitiveDistinction Carrier) :
    (distinction.generatedAxisSingletonFamily.nativeReversalFinitaryClosure).rank
        ({0} : Finset (Fin 1)) =
      DisjointDistinctionFamily.symmetryAlgebraLogRank
        distinction.generatedAxisSingletonFamily := by
  rw [distinction.generatedAxisSingletonFamily_rank_singleton,
    distinction.generatedAxisSingletonFamily_action_log_rank]

end PrimitiveDistinction

end OCKIndividuationMSpaceComposition
