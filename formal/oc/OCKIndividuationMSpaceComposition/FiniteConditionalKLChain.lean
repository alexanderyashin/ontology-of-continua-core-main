import OCKIndividuationMSpaceComposition.FinitePMFKLReduction

namespace OCKIndividuationMSpaceComposition

/-!
## A finite conditional information chain rule

This is the exact discrete process law needed between product-channel KL and
adaptive occurrence streams.  The first coordinate selects a registered
state; the second coordinate is drawn from the state-conditioned channel.
-/

variable {State Observation : Type*}
  [Fintype State] [Fintype Observation]

/-- Finite relative entropy in natural-log units for strictly positive mass
functions.  Normalization is supplied as a theorem contract where required. -/
noncomputable def finiteRelativeEntropy
    (first second : State → ℝ) : ℝ :=
  ∑ state, first state * Real.log (first state / second state)

/-- Relative entropy of the joint law generated by a state mass and a
state-conditioned observation channel. -/
noncomputable def finiteJointRelativeEntropy
    (firstState secondState : State → ℝ)
    (firstChannel secondChannel : State → Observation → ℝ) : ℝ :=
  ∑ state, ∑ observation,
    firstState state * firstChannel state observation *
      Real.log
        ((firstState state * firstChannel state observation) /
          (secondState state * secondChannel state observation))

/-- Expected conditional divergence, weighted by the first state law. -/
noncomputable def finiteExpectedConditionalRelativeEntropy
    (firstState : State → ℝ)
    (firstChannel secondChannel : State → Observation → ℝ) : ℝ :=
  ∑ state, firstState state *
    ∑ observation, firstChannel state observation *
      Real.log (firstChannel state observation /
        secondChannel state observation)

/-- Pointwise factorization of a positive joint likelihood ratio. -/
theorem positive_joint_likelihood_ratio_factorization
    (firstState secondState : State → ℝ)
    (firstChannel secondChannel : State → Observation → ℝ)
    (state : State) (observation : Observation)
    (secondStatePositive : 0 < secondState state)
    (secondChannelPositive : 0 < secondChannel state observation) :
    (firstState state * firstChannel state observation) /
        (secondState state * secondChannel state observation) =
      (firstState state / secondState state) *
        (firstChannel state observation /
          secondChannel state observation) := by
  field_simp [secondStatePositive.ne', secondChannelPositive.ne']

/-- Exact finite conditional KL chain rule.

The joint information separating two sequential channels is the information
in the state marginal plus the first-law expectation of the information in
the conditional observation channel.  Strict positivity makes the logarithm
factorization total; normalization makes the inputs probability channels. -/
theorem finiteConditionalRelativeEntropy_chain_rule
    (firstState secondState : State → ℝ)
    (firstChannel secondChannel : State → Observation → ℝ)
    (firstStatePositive : ∀ state, 0 < firstState state)
    (secondStatePositive : ∀ state, 0 < secondState state)
    (firstChannelPositive : ∀ state observation,
      0 < firstChannel state observation)
    (secondChannelPositive : ∀ state observation,
      0 < secondChannel state observation)
    (firstChannelNormalized : ∀ state,
      ∑ observation, firstChannel state observation = 1)
    (_secondChannelNormalized : ∀ state,
      ∑ observation, secondChannel state observation = 1) :
    finiteJointRelativeEntropy firstState secondState
        firstChannel secondChannel =
      finiteRelativeEntropy firstState secondState +
        finiteExpectedConditionalRelativeEntropy firstState
          firstChannel secondChannel := by
  rw [finiteJointRelativeEntropy, finiteRelativeEntropy,
    finiteExpectedConditionalRelativeEntropy]
  calc
    (∑ state, ∑ observation,
        firstState state * firstChannel state observation *
          Real.log
            ((firstState state * firstChannel state observation) /
              (secondState state * secondChannel state observation))) =
      ∑ state, ∑ observation,
        firstState state * firstChannel state observation *
          (Real.log (firstState state / secondState state) +
            Real.log (firstChannel state observation /
              secondChannel state observation)) := by
        apply Finset.sum_congr rfl
        intro state _
        apply Finset.sum_congr rfl
        intro observation _
        rw [positive_joint_likelihood_ratio_factorization
          firstState secondState firstChannel secondChannel state observation
          (secondStatePositive state) (secondChannelPositive state observation)]
        rw [Real.log_mul
          (ne_of_gt (div_pos (firstStatePositive state)
            (secondStatePositive state)))
          (ne_of_gt (div_pos (firstChannelPositive state observation)
            (secondChannelPositive state observation)))]
    _ = (∑ state, firstState state *
          Real.log (firstState state / secondState state)) +
        ∑ state, firstState state *
          ∑ observation, firstChannel state observation *
            Real.log (firstChannel state observation /
              secondChannel state observation) := by
        rw [← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl
        intro state _
        calc
          (∑ observation,
              firstState state * firstChannel state observation *
                (Real.log (firstState state / secondState state) +
                  Real.log (firstChannel state observation /
                    secondChannel state observation))) =
            firstState state *
                Real.log (firstState state / secondState state) *
                  (∑ observation, firstChannel state observation) +
              firstState state *
                (∑ observation, firstChannel state observation *
                  Real.log (firstChannel state observation /
                    secondChannel state observation)) := by
              simp_rw [mul_add]
              rw [Finset.sum_add_distrib]
              congr 1
              · rw [Finset.mul_sum]
                apply Finset.sum_congr rfl
                intro observation _
                ring
              · rw [Finset.mul_sum]
                apply Finset.sum_congr rfl
                intro observation _
                ring
          _ = firstState state *
                Real.log (firstState state / secondState state) +
              firstState state *
                ∑ observation, firstChannel state observation *
                  Real.log (firstChannel state observation /
                    secondChannel state observation) := by
              rw [firstChannelNormalized state]
              ring

/-- A strictly positive finite mass function carries no relative information
against itself. -/
theorem finiteRelativeEntropy_self
    (mass : State → ℝ) (massPositive : ∀ state, 0 < mass state) :
    finiteRelativeEntropy mass mass = 0 := by
  rw [finiteRelativeEntropy]
  apply Finset.sum_eq_zero
  intro state _
  rw [div_self (massPositive state).ne', Real.log_one, mul_zero]

/-- An unchanged strictly positive conditional channel contributes exactly
zero expected conditional information, regardless of the state weights. -/
theorem finiteExpectedConditionalRelativeEntropy_self
    (stateMass : State → ℝ) (channel : State → Observation → ℝ)
    (channelPositive : ∀ state observation, 0 < channel state observation) :
    finiteExpectedConditionalRelativeEntropy stateMass channel channel = 0 := by
  rw [finiteExpectedConditionalRelativeEntropy]
  apply Finset.sum_eq_zero
  intro state _
  have innerZero :
      (∑ observation, channel state observation *
        Real.log (channel state observation / channel state observation)) = 0 := by
    apply Finset.sum_eq_zero
    intro observation _
    rw [div_self (channelPositive state observation).ne', Real.log_one,
      mul_zero]
  rw [innerZero, mul_zero]

/-- No-go for decorative context: if the conditional channel is identical in
the competing models, adding that channel contributes no discrimination and
the joint divergence remains exactly the state-marginal divergence. -/
theorem unchanged_conditional_channel_adds_no_information
    (firstState secondState : State → ℝ)
    (channel : State → Observation → ℝ)
    (firstStatePositive : ∀ state, 0 < firstState state)
    (secondStatePositive : ∀ state, 0 < secondState state)
    (channelPositive : ∀ state observation, 0 < channel state observation)
    (channelNormalized : ∀ state, ∑ observation, channel state observation = 1) :
    finiteJointRelativeEntropy firstState secondState channel channel =
      finiteRelativeEntropy firstState secondState := by
  rw [finiteConditionalRelativeEntropy_chain_rule firstState secondState
    channel channel firstStatePositive secondStatePositive channelPositive
    channelPositive channelNormalized channelNormalized]
  rw [finiteExpectedConditionalRelativeEntropy_self firstState channel
    channelPositive, add_zero]

/-! A three-stage process is a conditional chain applied twice. -/

variable {NextObservation : Type*} [Fintype NextObservation]

/-- Joint state-observation mass used as the history state of the next step. -/
noncomputable def finitePairMass
    (stateMass : State → ℝ) (channel : State → Observation → ℝ) :
    State × Observation → ℝ :=
  fun history => stateMass history.1 * channel history.1 history.2

/-- Finite sums over a pair turn the pair-mass relative entropy into the
two-stage joint relative entropy. -/
theorem finiteRelativeEntropy_pairMass_eq_joint
    (firstState secondState : State → ℝ)
    (firstChannel secondChannel : State → Observation → ℝ) :
    finiteRelativeEntropy
        (finitePairMass firstState firstChannel)
        (finitePairMass secondState secondChannel) =
      finiteJointRelativeEntropy firstState secondState
        firstChannel secondChannel := by
  rw [finiteRelativeEntropy, finiteJointRelativeEntropy]
  rw [Fintype.sum_prod_type]
  rfl

/-- Exact three-stage chain rule.  The third channel may depend on the entire
registered two-stage history, so this includes finite adaptive policies. -/
theorem finiteThreeStageRelativeEntropy_chain_rule
    (firstState secondState : State → ℝ)
    (firstChannel secondChannel : State → Observation → ℝ)
    (firstNext secondNext : State × Observation → NextObservation → ℝ)
    (firstStatePositive : ∀ state, 0 < firstState state)
    (secondStatePositive : ∀ state, 0 < secondState state)
    (firstChannelPositive : ∀ state observation,
      0 < firstChannel state observation)
    (secondChannelPositive : ∀ state observation,
      0 < secondChannel state observation)
    (firstChannelNormalized : ∀ state,
      ∑ observation, firstChannel state observation = 1)
    (secondChannelNormalized : ∀ state,
      ∑ observation, secondChannel state observation = 1)
    (firstNextPositive : ∀ history next, 0 < firstNext history next)
    (secondNextPositive : ∀ history next, 0 < secondNext history next)
    (firstNextNormalized : ∀ history,
      ∑ next, firstNext history next = 1)
    (secondNextNormalized : ∀ history,
      ∑ next, secondNext history next = 1) :
    finiteJointRelativeEntropy
        (finitePairMass firstState firstChannel)
        (finitePairMass secondState secondChannel)
        firstNext secondNext =
      finiteRelativeEntropy firstState secondState +
        finiteExpectedConditionalRelativeEntropy firstState
          firstChannel secondChannel +
        finiteExpectedConditionalRelativeEntropy
          (finitePairMass firstState firstChannel) firstNext secondNext := by
  have firstPairPositive : ∀ history,
      0 < finitePairMass firstState firstChannel history := by
    intro history
    exact mul_pos (firstStatePositive history.1)
      (firstChannelPositive history.1 history.2)
  have secondPairPositive : ∀ history,
      0 < finitePairMass secondState secondChannel history := by
    intro history
    exact mul_pos (secondStatePositive history.1)
      (secondChannelPositive history.1 history.2)
  rw [finiteConditionalRelativeEntropy_chain_rule
    (finitePairMass firstState firstChannel)
    (finitePairMass secondState secondChannel) firstNext secondNext
    firstPairPositive secondPairPositive firstNextPositive secondNextPositive
    firstNextNormalized secondNextNormalized]
  rw [finiteRelativeEntropy_pairMass_eq_joint]
  rw [finiteConditionalRelativeEntropy_chain_rule firstState secondState
    firstChannel secondChannel firstStatePositive secondStatePositive
    firstChannelPositive secondChannelPositive firstChannelNormalized
    secondChannelNormalized]

end OCKIndividuationMSpaceComposition
