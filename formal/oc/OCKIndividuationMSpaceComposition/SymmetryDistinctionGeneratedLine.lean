import OCKIndividuationMSpaceComposition.SymmetryDistinctionAffineDimension

namespace OCKIndividuationMSpaceComposition

universe uScalar uCarrier

namespace PrimitiveDistinction

/-!
# The generated affine line without a preferred coordinate

The preceding affine layer proves that a distinction selects a nonzero vector
and hence a one-dimensional direction submodule.  Here the actual affine line
is defined coordinate-free as the translate of that direction through the
first endpoint.  Scalar coordinates are then proved to exist uniquely; they
are not built into the definition of the line.

Exchanging endpoint labels changes the coordinate by `t ↦ 1 - t` but leaves
the underlying affine line unchanged.  This isolates the exact origin of one
degree of freedom: the distinction supplies one generator, while the supplied
field/module structure supplies linear combination and affine translation.
-/

section GeneratedAffineLine

variable {K : Type uScalar} {V : Type uCarrier}
  [Field K] [AddCommGroup V] [Module K V]

/-- The coordinate-free affine line generated by the distinction: the
translate through the first endpoint of the span of its displacement. -/
def generatedAffineLine (distinction : PrimitiveDistinction V) : Set V :=
  {point | point - distinction.first ∈
    directionSubmodule (K := K) distinction}

/-- A point belongs to the generated line exactly when it has a unique scalar
coordinate in the affine parameterization. -/
theorem mem_generatedAffineLine_iff_existsUnique_parameter
    (distinction : PrimitiveDistinction V) (point : V) :
    point ∈ generatedAffineLine (K := K) distinction ↔
      ∃! parameter : K,
        point = distinction.affineAxisPoint parameter := by
  constructor
  · intro membership
    rcases (Submodule.mem_span_singleton.mp membership) with
      ⟨parameter, parameterWitness⟩
    refine ⟨parameter, ?_, ?_⟩
    · calc
        point = distinction.first + (point - distinction.first) := by abel
        _ = distinction.first + parameter • distinction.displacement := by
          rw [parameterWitness]
        _ = distinction.affineAxisPoint parameter := by
          rfl
    · intro otherParameter otherWitness
      apply distinction.affineAxisPoint_injective
      exact otherWitness.symm.trans (by
        calc
          point = distinction.affineAxisPoint parameter := by
            calc
              point = distinction.first + (point - distinction.first) := by abel
              _ = distinction.first + parameter • distinction.displacement := by
                rw [parameterWitness]
              _ = distinction.affineAxisPoint parameter := by rfl)
  · rintro ⟨parameter, pointEquals, _⟩
    rw [pointEquals]
    change distinction.affineAxisPoint parameter - distinction.first ∈
      directionSubmodule (K := K) distinction
    rw [affineAxisPoint, add_sub_cancel_left]
    exact (directionSubmodule (K := K) distinction).smul_mem parameter
      (Submodule.mem_span_singleton_self distinction.displacement)

/-- Both primitive endpoints lie on the same generated affine line. -/
theorem first_mem_generatedAffineLine
    (distinction : PrimitiveDistinction V) :
    distinction.first ∈ generatedAffineLine (K := K) distinction := by
  rw [mem_generatedAffineLine_iff_existsUnique_parameter]
  refine ⟨0, distinction.affineAxisPoint_zero.symm, ?_⟩
  intro parameter equality
  apply distinction.affineAxisPoint_injective
  simpa using equality.symm

theorem second_mem_generatedAffineLine
    (distinction : PrimitiveDistinction V) :
    distinction.second ∈ generatedAffineLine (K := K) distinction := by
  rw [mem_generatedAffineLine_iff_existsUnique_parameter]
  refine ⟨1, distinction.affineAxisPoint_one.symm, ?_⟩
  intro parameter equality
  apply distinction.affineAxisPoint_injective
  simpa using equality.symm

/-- Reversing endpoint labels changes coordinates but not the generated
unoriented affine line. -/
theorem reverseLabels_generatedAffineLine
    (distinction : PrimitiveDistinction V) :
    generatedAffineLine (K := K) distinction.reverseLabels =
      generatedAffineLine (K := K) distinction := by
  ext point
  constructor
  · intro membership
    rcases (distinction.reverseLabels.mem_generatedAffineLine_iff_existsUnique_parameter
      point).mp membership with ⟨parameter, pointEquals, _⟩
    apply (distinction.mem_generatedAffineLine_iff_existsUnique_parameter point).mpr
    refine ⟨1 - parameter, ?_, ?_⟩
    · simpa [reverseLabels_affineAxisPoint] using pointEquals
    · intro otherParameter otherEquals
      apply distinction.affineAxisPoint_injective
      exact otherEquals.symm.trans (by
        simpa [reverseLabels_affineAxisPoint] using pointEquals)
  · intro membership
    rcases (distinction.mem_generatedAffineLine_iff_existsUnique_parameter
      point).mp membership with ⟨parameter, pointEquals, _⟩
    apply (distinction.reverseLabels.mem_generatedAffineLine_iff_existsUnique_parameter
      point).mpr
    refine ⟨1 - parameter, ?_, ?_⟩
    · calc
        point = distinction.affineAxisPoint parameter := pointEquals
        _ = distinction.reverseLabels.affineAxisPoint (1 - parameter) := by
          rw [reverseLabels_affineAxisPoint]
          simp
    · intro otherParameter otherEquals
      apply distinction.reverseLabels.affineAxisPoint_injective
      calc
        distinction.reverseLabels.affineAxisPoint otherParameter = point :=
          otherEquals.symm
        _ = distinction.affineAxisPoint parameter := pointEquals
        _ = distinction.reverseLabels.affineAxisPoint (1 - parameter) := by
          rw [reverseLabels_affineAxisPoint]
          simp

/-- The generated line has a scalar coordinate system, but the coordinate is
orientation-dependent.  This equivalence is a theorem from unique existence,
not the definition of the line. -/
noncomputable def affineParameterEquiv
    (distinction : PrimitiveDistinction V) :
    K ≃ {point // point ∈ generatedAffineLine (K := K) distinction} :=
  Equiv.ofBijective
    (fun parameter =>
      ⟨distinction.affineAxisPoint parameter,
        (distinction.mem_generatedAffineLine_iff_existsUnique_parameter
          (distinction.affineAxisPoint parameter)).mpr
          ⟨parameter, rfl, fun other equality =>
            distinction.affineAxisPoint_injective equality.symm⟩⟩)
    ⟨fun _ _ equality =>
        distinction.affineAxisPoint_injective (congrArg Subtype.val equality),
      fun point => by
        rcases (distinction.mem_generatedAffineLine_iff_existsUnique_parameter
          point.1).mp point.2 with ⟨parameter, pointEquals, _⟩
        exact ⟨parameter, Subtype.ext pointEquals.symm⟩⟩

end GeneratedAffineLine

end PrimitiveDistinction

end OCKIndividuationMSpaceComposition
