import OCKIndividuationMSpaceComposition.ConstitutiveBridge
import OCMaturityCompletionCycle.JointCharacterization

namespace OCKIndividuationMSpaceComposition

open OCMaturityCompletionCycle

universe
  uMechanism uIntervention uOutcome uProvenance uTime
  uOccurrence uExperiment uExperimentOutcome

/-!
# Constraint-generated object occurrences

The negative admissibility theorem is retained: an extensional predicate on
joint configurations does not determine a parent.  This module studies the
strictly richer intensional case.  A dependency is admitted only with a typed
intervention whose removal response differs from the actual response.

The generated carrier is the least non-port dependency closure of one
provenance root.  Object qualification adds grounded provenance, internal
integration, persistence at two distinct times, and a separately supplied
scale-robustness test.  No `ParentState` is an input to the construction.
-/

/-- An intensional constraint model with explicit removal interventions. -/
structure ActiveConstraintModel
    (Mechanism : Type uMechanism)
    (Intervention : Type uIntervention)
    (Outcome : Type uOutcome) where
  response : Mechanism → Intervention → Outcome
  responseWithout : Mechanism → Mechanism → Intervention → Outcome
  /-- Dependencies declared as ports remain outside this object boundary. -/
  port : Mechanism → Prop

/-- A support is essential only when disabling it changes a typed response. -/
structure DifferenceWitness
    {Mechanism : Type uMechanism}
    {Intervention : Type uIntervention}
    {Outcome : Type uOutcome}
    (model : ActiveConstraintModel Mechanism Intervention Outcome)
    (target support : Mechanism) where
  intervention : Intervention
  changes :
    model.response target intervention ≠
      model.responseWithout target support intervention

def EssentialDependency
    {Mechanism : Type uMechanism}
    {Intervention : Type uIntervention}
    {Outcome : Type uOutcome}
    (model : ActiveConstraintModel Mechanism Intervention Outcome)
    (target support : Mechanism) : Prop :=
  Nonempty (DifferenceWitness model target support)

/--
The symmetric causal neighborhood used for carrier generation.  A neighboring
mechanism is internal exactly when it is not an admitted boundary port.
-/
def InternalDependency
    {Mechanism : Type uMechanism}
    {Intervention : Type uIntervention}
    {Outcome : Type uOutcome}
    (model : ActiveConstraintModel Mechanism Intervention Outcome) :
    Mechanism → Mechanism → Prop :=
  fun current next =>
    ¬ model.port next ∧
      (EssentialDependency model current next ∨
        EssentialDependency model next current)

/-- The least causal carrier generated by one actual provenance root. -/
inductive GeneratedKernel
    {Mechanism : Type uMechanism}
    {Intervention : Type uIntervention}
    {Outcome : Type uOutcome}
    (model : ActiveConstraintModel Mechanism Intervention Outcome)
    (root : Mechanism) : Mechanism → Prop
  | ofRoot : GeneratedKernel model root root
  | ofInternalDependency {current next} :
      GeneratedKernel model root current →
      InternalDependency model current next →
      GeneratedKernel model root next

def DependencyClosed
    {Mechanism : Type uMechanism}
    {Intervention : Type uIntervention}
    {Outcome : Type uOutcome}
    (model : ActiveConstraintModel Mechanism Intervention Outcome)
    (carrier : Mechanism → Prop) : Prop :=
  ∀ ⦃current next⦄,
    carrier current → InternalDependency model current next → carrier next

theorem generatedKernel_contains_root
    {Mechanism : Type uMechanism}
    {Intervention : Type uIntervention}
    {Outcome : Type uOutcome}
    (model : ActiveConstraintModel Mechanism Intervention Outcome)
    (root : Mechanism) :
    GeneratedKernel model root root :=
  .ofRoot

theorem generatedKernel_is_dependencyClosed
    {Mechanism : Type uMechanism}
    {Intervention : Type uIntervention}
    {Outcome : Type uOutcome}
    (model : ActiveConstraintModel Mechanism Intervention Outcome)
    (root : Mechanism) :
    DependencyClosed model (GeneratedKernel model root) := by
  intro current next currentMember dependency
  exact .ofInternalDependency currentMember dependency

/-- Universal property: generated kernels contain no arbitrary additions. -/
theorem generatedKernel_is_least_closed
    {Mechanism : Type uMechanism}
    {Intervention : Type uIntervention}
    {Outcome : Type uOutcome}
    {model : ActiveConstraintModel Mechanism Intervention Outcome}
    {root : Mechanism}
    {carrier : Mechanism → Prop}
    (containsRoot : carrier root)
    (closed : DependencyClosed model carrier) :
    ∀ ⦃mechanism⦄,
      GeneratedKernel model root mechanism → carrier mechanism := by
  intro mechanism generated
  induction generated with
  | ofRoot => exact containsRoot
  | ofInternalDependency previous dependency inductionHypothesis =>
      exact closed inductionHypothesis dependency

/-- Adding evidenced dependencies can only enlarge the generated kernel. -/
theorem generatedKernel_mono
    {Mechanism : Type uMechanism}
    {Intervention₁ : Type uIntervention}
    {Outcome₁ : Type uOutcome}
    {Intervention₂ : Type*}
    {Outcome₂ : Type*}
    {first : ActiveConstraintModel Mechanism Intervention₁ Outcome₁}
    {second : ActiveConstraintModel Mechanism Intervention₂ Outcome₂}
    (refines : RelationRefines
      (InternalDependency first) (InternalDependency second))
    (root : Mechanism) :
    ∀ ⦃mechanism⦄,
      GeneratedKernel first root mechanism →
        GeneratedKernel second root mechanism := by
  intro mechanism generated
  induction generated with
  | ofRoot => exact .ofRoot
  | ofInternalDependency previous dependency inductionHypothesis =>
      exact .ofInternalDependency inductionHypothesis (refines dependency)

/-- A port can influence the kernel but is not silently absorbed into it. -/
theorem port_is_not_an_internal_dependency_target
    {Mechanism : Type uMechanism}
    {Intervention : Type uIntervention}
    {Outcome : Type uOutcome}
    {model : ActiveConstraintModel Mechanism Intervention Outcome}
    {current boundary : Mechanism}
    (isPort : model.port boundary) :
    ¬ InternalDependency model current boundary := by
  intro internal
  exact internal.1 isPort

/-- No admitted boundary port is silently absorbed by kernel generation. -/
theorem generatedKernel_contains_no_ports
    {Mechanism : Type uMechanism}
    {Intervention : Type uIntervention}
    {Outcome : Type uOutcome}
    {model : ActiveConstraintModel Mechanism Intervention Outcome}
    {root mechanism : Mechanism}
    (rootNotPort : ¬ model.port root)
    (generated : GeneratedKernel model root mechanism) :
    ¬ model.port mechanism := by
  cases generated with
  | ofRoot => exact rootNotPort
  | ofInternalDependency _ dependency => exact dependency.1

/-- An explicit causal edge crossing from the generated carrier to a port. -/
def BoundaryPort
    {Mechanism : Type uMechanism}
    {Intervention : Type uIntervention}
    {Outcome : Type uOutcome}
    (model : ActiveConstraintModel Mechanism Intervention Outcome)
    (root boundary : Mechanism) : Prop :=
  model.port boundary ∧
    ∃ inside,
      GeneratedKernel model root inside ∧
        (EssentialDependency model inside boundary ∨
          EssentialDependency model boundary inside)

/--
Qualification is deliberately stronger than closure.  Each field blocks a
known countermodel: ports/common causes, arbitrary grouping, duplicate-token
labels, transient coupling, and knife-edge scale choices respectively.
-/
structure KernelQualification
    {Mechanism : Type uMechanism}
    {Intervention : Type uIntervention}
    {Outcome : Type uOutcome}
    (model : ActiveConstraintModel Mechanism Intervention Outcome)
    (Provenance : Type uProvenance)
    (Time : Type uTime)
    (formedBy : Mechanism → Provenance → Prop)
    (continuesAt : Mechanism → Time → Prop)
    (robustAtScale : (Mechanism → Prop) → Prop)
    (root : Mechanism)
    (provenance : Provenance) : Prop where
  root_not_port : ¬ model.port root
  provenance_grounded : formedBy root provenance
  internally_integrated :
    ∃ first second,
      GeneratedKernel model root first ∧
      GeneratedKernel model root second ∧
      first ≠ second ∧
      InternalDependency model first second
  persists_at_distinct_times :
    ∃ start finish,
      start ≠ finish ∧ continuesAt root start ∧ continuesAt root finish
  scale_robust : robustAtScale (GeneratedKernel model root)

/-- A proof-carrying object occurrence derived from a root and its kernel. -/
structure DerivedObjectOccurrence
    {Mechanism : Type uMechanism}
    {Intervention : Type uIntervention}
    {Outcome : Type uOutcome}
    (model : ActiveConstraintModel Mechanism Intervention Outcome)
    (Provenance : Type uProvenance)
    (Time : Type uTime)
    (formedBy : Mechanism → Provenance → Prop)
    (continuesAt : Mechanism → Time → Prop)
    (robustAtScale : (Mechanism → Prop) → Prop) where
  root : Mechanism
  provenance : Provenance
  qualification : KernelQualification model Provenance Time
    formedBy continuesAt robustAtScale root provenance

def derivedObjectOccurrence_of_qualification
    {Mechanism : Type uMechanism}
    {Intervention : Type uIntervention}
    {Outcome : Type uOutcome}
    {model : ActiveConstraintModel Mechanism Intervention Outcome}
    {Provenance : Type uProvenance}
    {Time : Type uTime}
    {formedBy : Mechanism → Provenance → Prop}
    {continuesAt : Mechanism → Time → Prop}
    {robustAtScale : (Mechanism → Prop) → Prop}
    {root : Mechanism}
    {provenance : Provenance}
    (qualification : KernelQualification model Provenance Time
      formedBy continuesAt robustAtScale root provenance) :
    DerivedObjectOccurrence model Provenance Time
      formedBy continuesAt robustAtScale :=
  ⟨root, provenance, qualification⟩

theorem distinct_provenance_gives_distinct_occurrences
    {Mechanism : Type uMechanism}
    {Intervention : Type uIntervention}
    {Outcome : Type uOutcome}
    {model : ActiveConstraintModel Mechanism Intervention Outcome}
    {Provenance : Type uProvenance}
    {Time : Type uTime}
    {formedBy : Mechanism → Provenance → Prop}
    {continuesAt : Mechanism → Time → Prop}
    {robustAtScale : (Mechanism → Prop) → Prop}
    {root : Mechanism}
    {firstProvenance secondProvenance : Provenance}
    (different : firstProvenance ≠ secondProvenance)
    (first : KernelQualification model Provenance Time
      formedBy continuesAt robustAtScale root firstProvenance)
    (second : KernelQualification model Provenance Time
      formedBy continuesAt robustAtScale root secondProvenance) :
    derivedObjectOccurrence_of_qualification first ≠
      derivedObjectOccurrence_of_qualification second := by
  intro equalOccurrences
  apply different
  exact congrArg DerivedObjectOccurrence.provenance equalOccurrences

/-!
## Finite causal witness

This fixture is intentionally small.  It proves that the qualification is
inhabited without supplying a parent object: two mechanisms are joined by
typed removal effects, while an environmental mechanism remains an explicit
port outside the generated kernel.
-/

inductive ToyMechanism
  | left
  | right
  | environment
  deriving DecidableEq

def toyConstraintModel : ActiveConstraintModel ToyMechanism Unit Bool where
  response := fun _ _ => true
  responseWithout := fun target support _ =>
    match target, support with
    | .left, .right => false
    | .right, .left => false
    | _, _ => true
  port := fun mechanism => mechanism = .environment

def toyLeftDependsOnRight :
    DifferenceWitness toyConstraintModel .left .right where
  intervention := ()
  changes := by simp [toyConstraintModel]

def toyRightDependsOnLeft :
    DifferenceWitness toyConstraintModel .right .left where
  intervention := ()
  changes := by simp [toyConstraintModel]

theorem toy_internal_left_right :
    InternalDependency toyConstraintModel .left .right := by
  refine ⟨?_, Or.inl ⟨toyLeftDependsOnRight⟩⟩
  simp [toyConstraintModel]

theorem toy_right_is_in_generated_kernel :
    GeneratedKernel toyConstraintModel .left .right :=
  .ofInternalDependency .ofRoot toy_internal_left_right

def toyFormedBy (mechanism : ToyMechanism) (_ : Unit) : Prop :=
  mechanism = .left

def toyContinuesAt (mechanism : ToyMechanism) (_ : Bool) : Prop :=
  mechanism = .left

def toyRobustAtScale (carrier : ToyMechanism → Prop) : Prop :=
  carrier .left ∧ carrier .right ∧ ¬ carrier .environment

def toyKernelQualification :
    KernelQualification toyConstraintModel Unit Bool
      toyFormedBy toyContinuesAt toyRobustAtScale .left () where
  root_not_port := by simp [toyConstraintModel]
  provenance_grounded := rfl
  internally_integrated := by
    exact ⟨.left, .right, .ofRoot, toy_right_is_in_generated_kernel,
      by decide, toy_internal_left_right⟩
  persists_at_distinct_times := by
    exact ⟨false, true, by decide, rfl, rfl⟩
  scale_robust := by
    refine ⟨.ofRoot, toy_right_is_in_generated_kernel, ?_⟩
    intro environmentMember
    exact (generatedKernel_contains_no_ports
      (model := toyConstraintModel)
      (root := ToyMechanism.left)
      (mechanism := ToyMechanism.environment)
      (by simp [toyConstraintModel]) environmentMember)
      (by simp [toyConstraintModel])

def toyDerivedObjectOccurrence :
    DerivedObjectOccurrence toyConstraintModel Unit Bool
      toyFormedBy toyContinuesAt toyRobustAtScale :=
  derivedObjectOccurrence_of_qualification toyKernelQualification

/-!
## Constraint interval for identity

Positive evidence generates the least identity relation.  The complete typed
experiment family generates the greatest relation not ruled out by a
distinguishing result.  Their interval gives an exact three-way adjudication:
inconsistent, underdetermined, or uniquely constrained.
-/

abbrev ForcedIdentity
    {Occurrence : Type uOccurrence}
    (evidence : BinaryRelation Occurrence) : BinaryRelation Occurrence :=
  EquivalenceGenerated evidence

abbrev AllowedIdentity
    {Occurrence : Type uOccurrence}
    {Experiment : Type uExperiment}
    {ExperimentOutcome : Type uExperimentOutcome}
    (law : Occurrence → Experiment → ExperimentOutcome) :
    BinaryRelation Occurrence :=
  AllExperimentBehavior law

/-- Equivalence evidence is already a fixed point of equivalence closure. -/
theorem forcedIdentity_eq_of_equivalence
    {Occurrence : Type uOccurrence}
    {evidence : BinaryRelation Occurrence}
    (reflexive : Reflexive evidence)
    (symmetric : Symmetric evidence)
    (transitive : Transitive evidence) :
    ForcedIdentity evidence = evidence := by
  funext left right
  apply propext
  constructor
  · intro generated
    exact EquivalenceGenerated.minimal
      (by intro source target edge; exact edge)
      reflexive symmetric transitive generated
  · intro edge
    exact .ofEvidence edge

structure AdmissibleIdentityRelation
    {Occurrence : Type uOccurrence}
    {Experiment : Type uExperiment}
    {ExperimentOutcome : Type uExperimentOutcome}
    (evidence : BinaryRelation Occurrence)
    (law : Occurrence → Experiment → ExperimentOutcome)
    (relation : BinaryRelation Occurrence) : Prop where
  containsEvidence : RelationRefines evidence relation
  reflexive : Reflexive relation
  symmetric : Symmetric relation
  transitive : Transitive relation
  experimentSound : RelationRefines relation (AllowedIdentity law)

theorem admissibleIdentityRelation_implies_evidenceSound
    {Occurrence : Type uOccurrence}
    {Experiment : Type uExperiment}
    {ExperimentOutcome : Type uExperimentOutcome}
    {evidence : BinaryRelation Occurrence}
    {law : Occurrence → Experiment → ExperimentOutcome}
    {relation : BinaryRelation Occurrence}
    (candidate : AdmissibleIdentityRelation evidence law relation) :
    RelationRefines evidence (AllowedIdentity law) := by
  intro left right edge
  exact candidate.experimentSound (candidate.containsEvidence edge)

theorem inconsistent_identity_bounds_have_no_candidate
    {Occurrence : Type uOccurrence}
    {Experiment : Type uExperiment}
    {ExperimentOutcome : Type uExperimentOutcome}
    {evidence : BinaryRelation Occurrence}
    {law : Occurrence → Experiment → ExperimentOutcome}
    (inconsistent : ¬ RelationRefines evidence (AllowedIdentity law)) :
    ¬ ∃ relation, AdmissibleIdentityRelation evidence law relation := by
  rintro ⟨relation, candidate⟩
  exact inconsistent
    (admissibleIdentityRelation_implies_evidenceSound candidate)

def forcedIdentityCandidate
    {Occurrence : Type uOccurrence}
    {Experiment : Type uExperiment}
    {ExperimentOutcome : Type uExperimentOutcome}
    (evidence : BinaryRelation Occurrence)
    (law : Occurrence → Experiment → ExperimentOutcome)
    (safe : RelationRefines (ForcedIdentity evidence) (AllowedIdentity law)) :
    AdmissibleIdentityRelation evidence law (ForcedIdentity evidence) where
  containsEvidence := by
    intro left right edge
    exact .ofEvidence edge
  reflexive := EquivalenceGenerated.isReflexive
  symmetric := EquivalenceGenerated.isSymmetric
  transitive := EquivalenceGenerated.isTransitive
  experimentSound := safe

def allowedIdentityCandidate
    {Occurrence : Type uOccurrence}
    {Experiment : Type uExperiment}
    {ExperimentOutcome : Type uExperimentOutcome}
    (evidence : BinaryRelation Occurrence)
    (law : Occurrence → Experiment → ExperimentOutcome)
    (safe : RelationRefines (ForcedIdentity evidence) (AllowedIdentity law)) :
    AdmissibleIdentityRelation evidence law (AllowedIdentity law) where
  containsEvidence := by
    intro left right edge
    exact safe (.ofEvidence edge)
  reflexive := by
    intro occurrence
    exact (allExperimentBehavior_equivalence law).refl occurrence
  symmetric := by
    intro left right related
    exact (allExperimentBehavior_equivalence law).symm related
  transitive := by
    intro first second third firstSecond secondThird
    exact (allExperimentBehavior_equivalence law).trans
      firstSecond secondThird
  experimentSound := by
    intro left right related
    exact related

theorem strict_identity_bounds_are_underdetermined
    {Occurrence : Type uOccurrence}
    {Experiment : Type uExperiment}
    {ExperimentOutcome : Type uExperimentOutcome}
    (evidence : BinaryRelation Occurrence)
    (law : Occurrence → Experiment → ExperimentOutcome)
    (safe : RelationRefines (ForcedIdentity evidence) (AllowedIdentity law))
    (strict : ForcedIdentity evidence ≠ AllowedIdentity law) :
    ∃ first second : BinaryRelation Occurrence,
      first ≠ second ∧
      AdmissibleIdentityRelation evidence law first ∧
      AdmissibleIdentityRelation evidence law second := by
  exact ⟨ForcedIdentity evidence, AllowedIdentity law, strict,
    forcedIdentityCandidate evidence law safe,
    allowedIdentityCandidate evidence law safe⟩

/-- When both constraint bounds meet, every admissible identity is forced. -/
theorem converged_identity_bounds_force_unique_relation
    {Occurrence : Type uOccurrence}
    {Experiment : Type uExperiment}
    {ExperimentOutcome : Type uExperimentOutcome}
    {evidence : BinaryRelation Occurrence}
    {law : Occurrence → Experiment → ExperimentOutcome}
    (convergence : ForcedIdentity evidence = AllowedIdentity law)
    {relation : BinaryRelation Occurrence}
    (candidate : AdmissibleIdentityRelation evidence law relation) :
    relation = ForcedIdentity evidence := by
  funext left right
  apply propext
  constructor
  · intro related
    have allowed := candidate.experimentSound related
    rw [← convergence] at allowed
    exact allowed
  · intro forced
    exact EquivalenceGenerated.minimal
      candidate.containsEvidence candidate.reflexive candidate.symmetric
        candidate.transitive forced

def forcedIdentitySetoid
    {Occurrence : Type uOccurrence}
    (evidence : BinaryRelation Occurrence) : Setoid Occurrence where
  r := ForcedIdentity evidence
  iseqv := ⟨
    by
      intro occurrence
      exact EquivalenceGenerated.isReflexive occurrence,
    by
      intro left right related
      exact EquivalenceGenerated.isSymmetric related,
    by
      intro first second third firstSecond secondThird
      exact EquivalenceGenerated.isTransitive firstSecond secondThird⟩

abbrev OperationalToken
    {Occurrence : Type uOccurrence}
    (evidence : BinaryRelation Occurrence) :=
  Quotient (forcedIdentitySetoid evidence)

def operationalTokenOf
    {Occurrence : Type uOccurrence}
    (evidence : BinaryRelation Occurrence)
    (occurrence : Occurrence) : OperationalToken evidence :=
  Quotient.mk _ occurrence

structure NontrivialForcedClass
    {Occurrence : Type uOccurrence}
    (evidence : BinaryRelation Occurrence)
    (seed : Occurrence) : Prop where
  has_distinct_internal_occurrence :
    ∃ other, other ≠ seed ∧ ForcedIdentity evidence seed other
  has_external_occurrence :
    ∃ outside, ¬ ForcedIdentity evidence seed outside

/-- A token is operationally derived when the two constraint bounds coincide. -/
structure UniquelyConstrainedOperationalIndividual
    {Occurrence : Type uOccurrence}
    {Experiment : Type uExperiment}
    {ExperimentOutcome : Type uExperimentOutcome}
    (evidence : BinaryRelation Occurrence)
    (law : Occurrence → Experiment → ExperimentOutcome) where
  seed : Occurrence
  convergence : ForcedIdentity evidence = AllowedIdentity law
  nontrivial : NontrivialForcedClass evidence seed

def UniquelyConstrainedOperationalIndividual.token
    {Occurrence : Type uOccurrence}
    {Experiment : Type uExperiment}
    {ExperimentOutcome : Type uExperimentOutcome}
    {evidence : BinaryRelation Occurrence}
    {law : Occurrence → Experiment → ExperimentOutcome}
    (individual : UniquelyConstrainedOperationalIndividual evidence law) :
    OperationalToken evidence :=
  operationalTokenOf evidence individual.seed

theorem converged_bounds_construct_operational_individual
    {Occurrence : Type uOccurrence}
    {Experiment : Type uExperiment}
    {ExperimentOutcome : Type uExperimentOutcome}
    (evidence : BinaryRelation Occurrence)
    (law : Occurrence → Experiment → ExperimentOutcome)
    (seed : Occurrence)
    (convergence : ForcedIdentity evidence = AllowedIdentity law)
    (nontrivial : NontrivialForcedClass evidence seed) :
    Nonempty (UniquelyConstrainedOperationalIndividual evidence law) := by
  exact ⟨⟨seed, convergence, nontrivial⟩⟩

/-!
## Finite identity witness and causal-identity bridge

The first Boolean coordinate is the complete experiment result and therefore
the object class; the second coordinate distinguishes two internal occurrences.
The third and final construction proves exact correspondence between this
class and the two-mechanism causal kernel above.
-/

abbrev ToyOccurrence := Bool × Bool

def toyIdentityEvidence : BinaryRelation ToyOccurrence :=
  fun left right => left.1 = right.1

def toyIdentityLaw : ToyOccurrence → Unit → Bool :=
  fun occurrence _ => occurrence.1

theorem toy_forced_identity_eq_evidence :
    ForcedIdentity toyIdentityEvidence = toyIdentityEvidence := by
  apply forcedIdentity_eq_of_equivalence
  · intro occurrence
    rfl
  · intro left right related
    exact related.symm
  · intro first second third firstSecond secondThird
    exact firstSecond.trans secondThird

theorem toy_allowed_identity_eq_evidence :
    AllowedIdentity toyIdentityLaw = toyIdentityEvidence := by
  funext left right
  apply propext
  constructor
  · intro related
    exact related ()
  · intro related _
    exact related

theorem toy_identity_bounds_converge :
    ForcedIdentity toyIdentityEvidence = AllowedIdentity toyIdentityLaw := by
  exact toy_forced_identity_eq_evidence.trans
    toy_allowed_identity_eq_evidence.symm

def toyIdentitySeed : ToyOccurrence := (false, false)

theorem toy_identity_class_is_nontrivial :
    NontrivialForcedClass toyIdentityEvidence toyIdentitySeed := by
  constructor
  · refine ⟨(false, true), by decide, ?_⟩
    rw [toy_forced_identity_eq_evidence]
    rfl
  · refine ⟨(true, false), ?_⟩
    rw [toy_forced_identity_eq_evidence]
    simp [toyIdentityEvidence, toyIdentitySeed]

def toyOperationalIndividual :
    UniquelyConstrainedOperationalIndividual
      toyIdentityEvidence toyIdentityLaw where
  seed := toyIdentitySeed
  convergence := toy_identity_bounds_converge
  nontrivial := toy_identity_class_is_nontrivial

/--
A positive object witness requires the operational identity class to realize
exactly the independently generated causal carrier, not merely to coexist with
it in the same record.
-/
structure ConstraintGeneratedObject
    {Mechanism : Type uMechanism}
    {Intervention : Type uIntervention}
    {Outcome : Type uOutcome}
    (model : ActiveConstraintModel Mechanism Intervention Outcome)
    (Provenance : Type uProvenance)
    (Time : Type uTime)
    (formedBy : Mechanism → Provenance → Prop)
    (continuesAt : Mechanism → Time → Prop)
    (robustAtScale : (Mechanism → Prop) → Prop)
    {Occurrence : Type uOccurrence}
    {Experiment : Type uExperiment}
    {ExperimentOutcome : Type uExperimentOutcome}
    (evidence : BinaryRelation Occurrence)
    (law : Occurrence → Experiment → ExperimentOutcome) where
  occurrence : DerivedObjectOccurrence model Provenance Time
    formedBy continuesAt robustAtScale
  individual : UniquelyConstrainedOperationalIndividual evidence law
  represents : Occurrence → Mechanism
  seed_represents_root : represents individual.seed = occurrence.root
  class_exactly_realizes_kernel : ∀ mechanism,
    GeneratedKernel model occurrence.root mechanism ↔
      ∃ internalOccurrence,
        ForcedIdentity evidence individual.seed internalOccurrence ∧
          represents internalOccurrence = mechanism

def toyRepresents : ToyOccurrence → ToyMechanism
  | (false, false) => .left
  | (false, true) => .right
  | (true, _) => .environment

def toyConstraintGeneratedObject :
    ConstraintGeneratedObject toyConstraintModel Unit Bool
      toyFormedBy toyContinuesAt toyRobustAtScale
      toyIdentityEvidence toyIdentityLaw where
  occurrence := toyDerivedObjectOccurrence
  individual := toyOperationalIndividual
  represents := toyRepresents
  seed_represents_root := rfl
  class_exactly_realizes_kernel := by
    intro mechanism
    cases mechanism with
    | left =>
        constructor
        · intro _
          refine ⟨(false, false), ?_, rfl⟩
          rw [toy_forced_identity_eq_evidence]
          rfl
        · intro _
          exact .ofRoot
    | right =>
        constructor
        · intro _
          refine ⟨(false, true), ?_, rfl⟩
          rw [toy_forced_identity_eq_evidence]
          rfl
        · intro _
          exact toy_right_is_in_generated_kernel
    | environment =>
        constructor
        · intro generated
          exact False.elim ((generatedKernel_contains_no_ports
            (model := toyConstraintModel)
            (root := ToyMechanism.left)
            (mechanism := ToyMechanism.environment)
            (by simp [toyConstraintModel]) generated)
            (by simp [toyConstraintModel]))
        · rintro ⟨internalOccurrence, sameClass, represented⟩
          rw [toy_forced_identity_eq_evidence] at sameClass
          change false = internalOccurrence.1 at sameClass
          rcases internalOccurrence with ⟨first, second⟩
          cases first <;> cases second <;>
            simp [toyRepresents] at sameClass represented

end OCKIndividuationMSpaceComposition
