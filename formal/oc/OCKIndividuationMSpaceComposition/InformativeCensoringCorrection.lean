import OCKIndividuationMSpaceComposition.CensoringVisibilityAndEffectiveSample
import OCKIndividuationMSpaceComposition.PopulationObservationBounds

namespace OCKIndividuationMSpaceComposition

universe uContext

/-!
# Conditional and informative censoring correction

The observable atom under censoring is a product `latentMass * visibility`.
Without a registered visibility contract this product has a rescaling symmetry,
so the latent mass is not identifiable.  With a positive conditional visibility
the symmetry is broken and inverse-visibility correction is exact.  With a
misspecified visibility, the module derives the exact bias and a robust radius
that can be composed with the existing `2 * epsilon` discrimination boundary.
-/

/-- Generic observed mass when visibility may be context- or model-dependent. -/
def informativelyCensoredMass (latentMass visibility : ℚ) : ℚ :=
  latentMass * visibility

/-- Inverse-visibility correction using a declared visibility value. -/
def inverseVisibilityCorrectedMass
    (observedMass assumedVisibility : ℚ) : ℚ :=
  observedMass / assumedVisibility

/-- Exact recovery when the declared positive visibility is the true one. -/
theorem inverseVisibilityCorrection_exact
    (latentMass visibility : ℚ) (visibilityPositive : 0 < visibility) :
    inverseVisibilityCorrectedMass
        (informativelyCensoredMass latentMass visibility) visibility =
      latentMass := by
  unfold inverseVisibilityCorrectedMass informativelyCensoredMass
  exact mul_div_cancel_right₀ latentMass visibilityPositive.ne'

/--
Gauge-like rescaling invariance: the same observed mass is generated by a
continuum of latent-mass/visibility pairs unless the scale is fixed by data or
a domain contract.
-/
theorem informative_censoring_rescaling_invariance
    (latentMass visibility scale : ℚ) (scaleNonzero : scale ≠ 0) :
    informativelyCensoredMass (latentMass * scale) (visibility / scale) =
      informativelyCensoredMass latentMass visibility := by
  unfold informativelyCensoredMass
  field_simp

/-- Concrete in-range alias: distinct latent masses produce the same observation. -/
theorem informative_censoring_latent_mass_not_identified_from_product :
    informativelyCensoredMass (1 / 2) (1 / 2) =
        informativelyCensoredMass (1 / 4) 1 ∧
      (1 / 2 : ℚ) ≠ 1 / 4 := by
  norm_num [informativelyCensoredMass]

/-- Exact signed correction error under a misspecified visibility. -/
theorem inverseVisibilityCorrection_error_exact
    (observedMass latentMass trueVisibility assumedVisibility : ℚ)
    (assumedNonzero : assumedVisibility ≠ 0) :
    inverseVisibilityCorrectedMass observedMass assumedVisibility - latentMass =
      ((observedMass - latentMass * trueVisibility) +
        latentMass * (trueVisibility - assumedVisibility)) /
          assumedVisibility := by
  unfold inverseVisibilityCorrectedMass
  field_simp
  ring

/-- Exact systematic bias when the observed product itself has no sampling error. -/
theorem inverseVisibilityCorrection_systematic_bias_exact
    (latentMass trueVisibility assumedVisibility : ℚ)
    (assumedPositive : 0 < assumedVisibility) :
    |inverseVisibilityCorrectedMass
          (informativelyCensoredMass latentMass trueVisibility)
          assumedVisibility - latentMass| =
      |latentMass| * |trueVisibility - assumedVisibility| /
        assumedVisibility := by
  rw [inverseVisibilityCorrection_error_exact
    (informativelyCensoredMass latentMass trueVisibility)
    latentMass trueVisibility assumedVisibility assumedPositive.ne']
  simp only [informativelyCensoredMass, sub_self, zero_add, abs_div, abs_mul]
  rw [abs_of_pos assumedPositive]

/--
Robust correction radius.  Observation error `epsilon` and visibility-model
error `visibilityError` add in the numerator and are amplified by the inverse
registered visibility floor.
-/
theorem inverseVisibilityCorrection_error_bound
    (observedMass latentMass trueVisibility assumedVisibility
      epsilon visibilityError visibilityFloor : ℚ)
    (latentNonnegative : 0 ≤ latentMass)
    (latentAtMostOne : latentMass ≤ 1)
    (epsilonNonnegative : 0 ≤ epsilon)
    (visibilityErrorNonnegative : 0 ≤ visibilityError)
    (visibilityFloorPositive : 0 < visibilityFloor)
    (assumedAtLeastFloor : visibilityFloor ≤ assumedVisibility)
    (observationError :
      |observedMass - latentMass * trueVisibility| ≤ epsilon)
    (misspecification :
      |trueVisibility - assumedVisibility| ≤ visibilityError) :
    |inverseVisibilityCorrectedMass observedMass assumedVisibility - latentMass| ≤
      (epsilon + visibilityError) / visibilityFloor := by
  have assumedPositive : 0 < assumedVisibility :=
    visibilityFloorPositive.trans_le assumedAtLeastFloor
  rw [inverseVisibilityCorrection_error_exact observedMass latentMass
    trueVisibility assumedVisibility assumedPositive.ne', abs_div,
    abs_of_pos assumedPositive]
  have systematicBound :
      |latentMass * (trueVisibility - assumedVisibility)| ≤ visibilityError := by
    rw [abs_mul, abs_of_nonneg latentNonnegative]
    calc
      latentMass * |trueVisibility - assumedVisibility| ≤
          1 * |trueVisibility - assumedVisibility| :=
        mul_le_mul_of_nonneg_right latentAtMostOne (abs_nonneg _)
      _ ≤ 1 * visibilityError :=
        mul_le_mul_of_nonneg_left misspecification (by norm_num)
      _ = visibilityError := by ring
  have numeratorBound :
      |(observedMass - latentMass * trueVisibility) +
        latentMass * (trueVisibility - assumedVisibility)| ≤
          epsilon + visibilityError := by
    exact (abs_add_le _ _).trans (add_le_add observationError systematicBound)
  have combinedNonnegative : 0 ≤ epsilon + visibilityError :=
    add_nonneg epsilonNonnegative visibilityErrorNonnegative
  calc
    |(observedMass - latentMass * trueVisibility) +
          latentMass * (trueVisibility - assumedVisibility)| /
        assumedVisibility ≤
      (epsilon + visibilityError) / assumedVisibility :=
        div_le_div_of_nonneg_right numeratorBound (le_of_lt assumedPositive)
    _ ≤ (epsilon + visibilityError) / visibilityFloor :=
      div_le_div_of_nonneg_left combinedNonnegative visibilityFloorPositive
        assumedAtLeastFloor

/-! ## Conditional correction by registered context -/

/-- Positive context-indexed visibility contract. -/
structure ConditionalVisibilityContract (Context : Type uContext) where
  visibility : Context → ℚ
  positive : ∀ context, 0 < visibility context

/-- Observed mass under conditional independent censoring within a context. -/
def conditionalCensoredMass
    {Context : Type uContext}
    (contract : ConditionalVisibilityContract Context)
    (latentMass : Context → ℚ) (context : Context) : ℚ :=
  informativelyCensoredMass (latentMass context) (contract.visibility context)

/-- Conditional correction recovers the complete latent signature pointwise. -/
theorem conditionalVisibilityCorrection_recovers_signature
    {Context : Type uContext}
    (contract : ConditionalVisibilityContract Context)
    (latentMass : Context → ℚ) :
    (fun context => inverseVisibilityCorrectedMass
      (conditionalCensoredMass contract latentMass context)
      (contract.visibility context)) = latentMass := by
  funext context
  exact inverseVisibilityCorrection_exact
    (latentMass context) (contract.visibility context) (contract.positive context)

/-- Exact conditional correction preserves every registered separation witness. -/
theorem conditionalVisibilityCorrection_preserves_model_separation
    {Model : Type*} {Context : Type uContext}
    (contract : ConditionalVisibilityContract Context)
    (latentPredict : Model → Context → ℚ)
    (left right : Model) (epsilon : ℚ)
    (separated : ModelsSeparatedBeyondError latentPredict left right epsilon) :
    ModelsSeparatedBeyondError
      (fun model context => inverseVisibilityCorrectedMass
        (conditionalCensoredMass contract (latentPredict model) context)
        (contract.visibility context))
      left right epsilon := by
  obtain ⟨context, gap⟩ := separated
  refine ⟨context, ?_⟩
  simpa [conditionalCensoredMass,
    inverseVisibilityCorrection_exact _ _ (contract.positive context)] using gap

/-! ## Separation feasibility and concentration-derived radius -/

/-- Total latent-scale radius after observed-mass and visibility errors. -/
noncomputable def censoringAdjustedRadius
    (observationError visibilityError visibilityFloor : ℝ) : ℝ :=
  (observationError + visibilityError) / visibilityFloor

/-- Algebraic separation criterion on the observed scale. -/
theorem censoringAdjusted_separation_iff
    (observationError visibilityError visibilityFloor latentGap : ℝ)
    (visibilityFloorPositive : 0 < visibilityFloor) :
    2 * censoringAdjustedRadius observationError visibilityError visibilityFloor <
        latentGap ↔
      2 * (observationError + visibilityError) < latentGap * visibilityFloor := by
  unfold censoringAdjustedRadius
  rw [show 2 * ((observationError + visibilityError) / visibilityFloor) =
      (2 * (observationError + visibilityError)) / visibilityFloor by ring,
    div_lt_iff₀ visibilityFloorPositive]

/--
Irreducible model-error floor: if visibility misspecification already consumes
the latent separation margin, no nonnegative sampling error can restore robust
pairwise discrimination.
-/
theorem visibility_misspecification_can_make_separation_impossible
    (observationError visibilityError visibilityFloor latentGap : ℝ)
    (observationErrorNonnegative : 0 ≤ observationError)
    (visibilityFloorPositive : 0 < visibilityFloor)
    (floorConsumesMargin : latentGap * visibilityFloor ≤ 2 * visibilityError) :
    ¬ 2 * censoringAdjustedRadius
        observationError visibilityError visibilityFloor < latentGap := by
  rw [censoringAdjusted_separation_iff _ _ _ _ visibilityFloorPositive]
  linarith

/--
End-to-end prospective certificate: a Hoeffding/union log budget supplies the
observed-mass concentration event, while the declared visibility uncertainty
and floor convert it to the latent-scale radius used for model separation.
-/
theorem censoringAdjusted_concentration_and_separation_certificate
    (sampleSize hypothesisCount : ℕ)
    (observationError targetError visibilityError visibilityFloor latentGap : ℝ)
    (observationErrorPositive : 0 < observationError)
    (targetErrorPositive : 0 < targetError)
    (hypothesisCountPositive : 0 < hypothesisCount)
    (visibilityFloorPositive : 0 < visibilityFloor)
    (logBudget :
      Real.log (2 * (hypothesisCount : ℝ) / targetError) ≤
        2 * (sampleSize : ℝ) * observationError ^ 2)
    (separationBudget :
      2 * (observationError + visibilityError) <
        latentGap * visibilityFloor) :
    UniformConcentrationCertificate
        sampleSize hypothesisCount observationError targetError ∧
      2 * censoringAdjustedRadius
          observationError visibilityError visibilityFloor < latentGap := by
  constructor
  · exact uniformConcentrationCertificate_of_log_budget
      sampleSize hypothesisCount observationError targetError
      observationErrorPositive targetErrorPositive hypothesisCountPositive logBudget
  · exact (censoringAdjusted_separation_iff observationError visibilityError
      visibilityFloor latentGap visibilityFloorPositive).2 separationBudget

end OCKIndividuationMSpaceComposition
