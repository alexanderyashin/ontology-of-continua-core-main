import OCKIndividuationMSpaceComposition.SymmetryNativeIntrinsicDimensionBridge
import Mathlib.Tactic

namespace OCKIndividuationMSpaceComposition

universe uIndex uCarrier

namespace PrimitiveDistinction

/-!
# Exact rank-birth equivalence in the native disjoint-reversal model

The native closure is generated by actual carrier permutations, and its
exchange-bearing finite rank was proved independently in the preceding
modules.  This file closes the strongest local form of the OC emergence law:
for a finite pairwise-disjoint family, a primitive reversal is outside the
subgroup closure exactly when adjoining its index raises rank by one.  If it is
already generated, adjoining it leaves rank unchanged.

The equivalence is therefore not obtained by defining rank to count fresh
indices; it is a consequence of the subgroup-generated closure normal form and
the exchange rank-growth theorem.
-/

namespace DisjointDistinctionFamily

variable {Index : Type uIndex} {Carrier : Type uCarrier}
variable [Fintype Index] [DecidableEq Index]
variable [Fintype Carrier] [DecidableEq Carrier]

theorem nativeReversalGenerated_iff_mem
    (family : DisjointDistinctionFamily Index Carrier)
    (seed : Finset Index) (index : Index) :
    family.reversalGenerated seed index ↔ index ∈ seed := by
  constructor
  · intro generated
    have inClosure : index ∈ family.nativeReversalClosure seed := by
      exact (mem_nativeReversalClosure family).2 generated
    rw [family.nativeReversalClosure_eq_seed seed] at inClosure
    exact inClosure
  · intro member
    exact family.reversalGenerated_of_mem member

/-! In the native model, non-generation is exactly non-membership in the
finite seed. -/
theorem nativeReversalNotGenerated_iff_not_mem
    (family : DisjointDistinctionFamily Index Carrier)
    (seed : Finset Index) (index : Index) :
    ¬ family.reversalGenerated seed index ↔ index ∉ seed := by
  exact not_congr (nativeReversalGenerated_iff_mem family seed index)

/-! A generated reversal is redundant: adjoining its index does not change the
native exchange rank. -/
theorem nativeReversal_rank_insert_eq_iff_generated
    (family : DisjointDistinctionFamily Index Carrier)
    (seed : Finset Index) (index : Index) :
    (family.nativeReversalFinitaryClosure).rank (insert index seed) =
        (family.nativeReversalFinitaryClosure).rank seed ↔
      family.reversalGenerated seed index := by
  constructor
  · intro rankEqual
    by_contra notGenerated
    have indexNotMember : index ∉ seed :=
      (nativeReversalNotGenerated_iff_not_mem family seed index).mp
        notGenerated
    have rankGrowth :=
      family.nativeReversalFinitaryClosure_rank_insert_eq_add_one_of_not_mem
        seed index indexNotMember
    omega
  · intro generated
    have indexMember : index ∈ seed :=
      (nativeReversalGenerated_iff_mem family seed index).mp generated
    rw [Finset.insert_eq_of_mem indexMember]

/-! Exact native dimension-birth law: a reversal lies outside the current
subgroup closure iff adding its distinction raises rank by exactly one. -/
theorem nativeReversal_rank_birth_iff_not_generated
    (family : DisjointDistinctionFamily Index Carrier)
    (seed : Finset Index) (index : Index) :
    ¬ family.reversalGenerated seed index ↔
      (family.nativeReversalFinitaryClosure).rank (insert index seed) =
        (family.nativeReversalFinitaryClosure).rank seed + 1 := by
  constructor
  · intro notGenerated
    have indexNotMember : index ∉ seed :=
      (nativeReversalNotGenerated_iff_not_mem family seed index).mp
        notGenerated
    exact family.nativeReversalFinitaryClosure_rank_insert_eq_add_one_of_not_mem
      seed index indexNotMember
  · intro rankGrowth generated
    have rankEqual :=
      (nativeReversal_rank_insert_eq_iff_generated family seed index).mpr generated
    omega

/-! The same result stated with the actual subgroup closure rather than its
finite normal form. -/
theorem nativeReversal_rank_birth_iff_not_in_subgroup
    (family : DisjointDistinctionFamily Index Carrier)
    (seed : Finset Index) (index : Index) :
    (pairSwapEquiv (family.distinction index) : Equiv.Perm Carrier) ∉
        family.reversalSubgroup seed ↔
      (family.nativeReversalFinitaryClosure).rank (insert index seed) =
        (family.nativeReversalFinitaryClosure).rank seed + 1 := by
  exact nativeReversal_rank_birth_iff_not_generated family seed index

end DisjointDistinctionFamily

end PrimitiveDistinction

end OCKIndividuationMSpaceComposition
