import OCKIndividuationMSpaceComposition.SymmetryFiniteDistinctionCube
import OCKIndividuationMSpaceComposition.SymmetryBooleanCompositionRank
import Mathlib.Algebra.Ring.BooleanRing
import Mathlib.Data.Fintype.Card
import Mathlib.Data.Fintype.Pi

namespace OCKIndividuationMSpaceComposition

namespace FiniteCubeRankRealization

/-!
# Boolean closure rank of the finite cube's coordinate masks

This file connects the finite Cartesian realization to the existing bounded
Boolean-composition closure/rank interface. The tokens are masks, viewed as
`Multiplicative (Index → Bool)`: multiplication is pointwise Boolean XOR and
the identity is the all-false mask. A singleton-support coordinate mask is
then independent from the remaining coordinate masks, by evaluation at its
coordinate and induction over subgroup closure.

The conclusion is intentionally local. It says that the supplied product
realization has full coordinate-family rank. Product structure, coordinate
independence and the local two-point axes are premises of this realization;
they are not derived here and they do not define an intrinsic OC dimension.
No vector space, matroid, `finrank` or generic joint-generation claim is used.
-/

universe uIndex uCarrier

/-- A Boolean mask used as a multiplicative reversible token. -/
abbrev BooleanMask (Index : Type uIndex) := Multiplicative (Index → Bool)

open BooleanCompositionRank

/-! `BooleanRing Bool` supplies addition as `Bool.xor`; the type tag turns that
additive commutative group into the multiplicative mask group. -/
instance booleanCompositionMask (Index : Type uIndex) :
    BooleanComposition (BooleanMask Index) where
  self_cancel token := by
    ext index
    change (Multiplicative.toAdd token index) +
      (Multiplicative.toAdd token index) = 0
    exact BooleanRing.add_self _

noncomputable instance booleanMaskFintype (Index : Type uIndex) [Fintype Index] :
    Fintype (BooleanMask Index) :=
  by
    classical
    exact Fintype.ofEquiv (Index → Bool) Multiplicative.ofAdd

variable {Index : Type uIndex} [Fintype Index]

/-- The singleton-support mask for one coordinate. -/
noncomputable def coordinateMask (index : Index) : BooleanMask Index := by
  classical
  exact Multiplicative.ofAdd
    (fun current => if current = index then true else false)

/-- The full finite family of singleton-support coordinate masks. -/
noncomputable def fullCoordinateFamily : Finset (BooleanMask Index) :=
  Finset.univ.image coordinateMask

/-- Distinct coordinates yield distinct singleton-support masks. -/
theorem coordinateMask_injective :
    Function.Injective (coordinateMask (Index := Index)) := by
  classical
  intro first second equal
  have atFirst := congrArg (fun mask : BooleanMask Index => mask first) equal
  by_contra unequal
  have impossible : (true : Bool) = false := by
    change (if first = first then true else false) =
      (if first = second then true else false) at atFirst
    simpa [unequal] using atFirst
  cases impossible

/-- Evaluation at one coordinate is a homomorphism of mask groups. -/
noncomputable def maskEvaluation (index : Index) :
    BooleanMask Index →* Multiplicative Bool where
  toFun := fun mask => mask index
  map_one' := by rfl
  map_mul' := by
    intro first second
    rfl

/-- Any subgroup generated by masks evaluating to the identity continues to
evaluate to the identity. This is the required subgroup-closure induction. -/
theorem maskEvaluation_eq_one_of_mem_closure
    (index : Index) (seed : Set (BooleanMask Index))
    (seed_eq_one : ∀ token ∈ seed, maskEvaluation index token = 1)
    {token : BooleanMask Index}
    (generated : token ∈ Subgroup.closure seed) :
    maskEvaluation index token = 1 := by
  induction generated using Subgroup.closure_induction with
  | mem current currentMember =>
      exact seed_eq_one current currentMember
  | one =>
      exact (maskEvaluation index).map_one
  | mul first second _ _ firstValue secondValue =>
      rw [(maskEvaluation index).map_mul, firstValue, secondValue, mul_one]
  | inv current _ currentValue =>
      rw [(maskEvaluation index).map_inv, currentValue]
      exact inv_one

/-! The coordinate family is independent for the already-proved Boolean
subgroup closure. The only nontrivial input is endpoint-free evaluation: every
other singleton mask evaluates to the identity at the selected coordinate. -/
theorem fullCoordinateFamily_independent :
    booleanGeneratedClosure.Independent (fullCoordinateFamily (Index := Index)) := by
  classical
  intro token tokenMember
  rcases Finset.mem_image.mp tokenMember with ⟨index, _, rfl⟩
  intro generated
  change coordinateMask index ∈
    BooleanCompositionRank.generatedClose
      ((fullCoordinateFamily (Index := Index)).erase (coordinateMask index)) at generated
  rw [BooleanCompositionRank.mem_generatedClose] at generated
  have seed_eq_one :
      ∀ current ∈
          (↑((fullCoordinateFamily (Index := Index)).erase
            (coordinateMask index)) : Set (BooleanMask Index)),
        maskEvaluation index current = 1 := by
    intro current currentMember
    have currentMember' :
        current ∈ (fullCoordinateFamily (Index := Index)).erase
          (coordinateMask index) := currentMember
    rcases Finset.mem_erase.mp currentMember' with
      ⟨currentNe, currentInFamily⟩
    rcases Finset.mem_image.mp currentInFamily with
      ⟨other, _, rfl⟩
    have otherNe : other ≠ index := by
      intro equality
      apply currentNe
      subst other
      rfl
    change (if index = other then true else false) = false
    simp [Ne.symm otherNe]
  have generated_eq_one := maskEvaluation_eq_one_of_mem_closure
    index
    (↑((fullCoordinateFamily (Index := Index)).erase
      (coordinateMask index)) : Set (BooleanMask Index))
    seed_eq_one generated
  have impossible : (true : Bool) = false := by
    have generated_eq_one' := congrArg
      (fun value : Multiplicative Bool => Multiplicative.toAdd value)
      generated_eq_one
    change (if index = index then true else false) = false at generated_eq_one'
    simpa using generated_eq_one'
  cases impossible

/-- The full singleton-support family has one member per finite coordinate. -/
theorem fullCoordinateFamily_card :
    (fullCoordinateFamily (Index := Index)).card = Fintype.card Index := by
  classical
  rw [fullCoordinateFamily]
  simpa using
    (Finset.card_image_of_injective
      (s := (Finset.univ : Finset Index))
      (f := coordinateMask (Index := Index)) coordinateMask_injective)

/-- Any independent finite seed reaches exactly its own cardinality under the
finite-family rank definition. -/
theorem rank_eq_card_of_independent
    (seed : Finset (BooleanMask Index))
    (independent : booleanGeneratedClosure.Independent seed) :
    booleanGeneratedClosure.rank seed = seed.card := by
  classical
  apply Nat.le_antisymm
  · unfold IntrinsicFinitaryRank.FinitaryDistinctionClosure.rank
    apply Finset.sup_le
    intro family familyMember
    exact Finset.card_le_card
      (Finset.mem_powerset.mp (Finset.mem_filter.mp familyMember).1)
  · exact booleanGeneratedClosure.independent_card_le_rank
      (subset_refl _) independent

/-- The supplied Cartesian cube has full Boolean closure rank, one per
coordinate. This is a realization theorem, not an intrinsic OC-dimension
theorem. -/
theorem booleanGeneratedClosure_fullCoordinateFamily_rank :
    booleanGeneratedClosure.rank (fullCoordinateFamily (Index := Index)) =
      Fintype.card Index := by
  rw [rank_eq_card_of_independent _ fullCoordinateFamily_independent]
  exact fullCoordinateFamily_card

/-- Faithfulness of the coordinate-flip action is retained when masks are
viewed as multiplicative Boolean tokens. -/
theorem maskAction_faithful
    {Carrier : Index → Type uCarrier}
    (axis : PrimitiveDistinctionFamily Index Carrier) :
    Function.Injective
      (fun token : BooleanMask Index =>
        maskAction axis (Multiplicative.toAdd token)) := by
  intro first second equal
  exact Multiplicative.toAdd.injective (maskAction_injective axis equal)

end FiniteCubeRankRealization

end OCKIndividuationMSpaceComposition
