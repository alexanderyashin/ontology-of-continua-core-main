import Mathlib.Data.Set.Basic
import Mathlib.Data.Set.Insert

namespace OCKIndividuationMSpaceComposition

universe u

/-!
# A proved two-point symmetry core

This file makes one precise, deliberately bounded answer to the distinction /
axis intuition.  A fixed-point-free involution is the smallest carrier on
which a distinction is non-trivial.  Its generated axis is the orbit of a
point under the two-element action: it has exactly two distinct endpoints,
the involution exchanges them, and every axis is a canonical equivalence
class.  The results below do **not** assert that every OC carrier already
has such an involution; that is a separate modelling obligation.

The construction is useful as a symmetry kernel for later OC work because it
separates four statements which were previously easy to conflate:

* a distinction is a fixed-point-free action, not an arbitrary inequality;
* an axis is an orbit, not an untyped name for an object;
* an invariant is a predicate constant on an orbit;
* an allowed transformation must commute with the action to preserve axes.

All claims in this module are constructive and introduce no unproved
declaration.  The accompanying audit module prints every theorem declaration.
-/

/-! ## The primitive action and its distinction -/

/-- A two-sided symmetry action with no fixed point. -/
structure FixedPointFreeInvolution (Carrier : Type u) where
  action : Carrier ≃ Carrier
  involutive : ∀ x : Carrier, action (action x) = x
  fixedPointFree : ∀ x : Carrier, action x ≠ x

/-- The primitive distinction generated by an involution at a point. -/
def distinction {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier) : Prop :=
  x ≠ symmetry.action x

/-- Every point of a fixed-point-free involution is distinguished. -/
theorem distinction_holds {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier) :
    distinction symmetry x := by
  change x ≠ symmetry.action x
  exact Ne.symm (symmetry.fixedPointFree x)

/-! ## The generated axis and its exact normal form -/

/-- The axis/orbit generated by `x`; no larger set is smuggled in. -/
def axis {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier) : Set Carrier :=
  {y | y = x ∨ y = symmetry.action x}

@[simp] theorem mem_axis_iff {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x y : Carrier) :
    y ∈ axis symmetry x ↔ y = x ∨ y = symmetry.action x :=
  Iff.rfl

theorem axis_mem_left {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier) :
    x ∈ axis symmetry x :=
  Or.inl rfl

theorem axis_mem_right {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier) :
    symmetry.action x ∈ axis symmetry x :=
  Or.inr rfl

/-- The axis has the exact two-point set normal form. -/
theorem axis_eq_pair {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier) :
    axis symmetry x = ({x, symmetry.action x} : Set Carrier) := by
  ext y
  simp [axis]

/-- The two endpoints of an axis are distinct. -/
theorem axis_endpoints_distinct {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier) :
    x ≠ symmetry.action x := by
  change x ≠ symmetry.action x
  exact Ne.symm (symmetry.fixedPointFree x)

/-- Applying the action does not change the generated axis. -/
theorem axis_invariant {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier) :
    axis symmetry (symmetry.action x) = axis symmetry x := by
  ext y
  simp [axis, symmetry.involutive x, or_comm]

/-! ## The orbit equivalence relation and quotient -/

/-- Two points are in the same generated axis exactly when one is the other
or the image of the other under the involution. -/
def sameAxis {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x y : Carrier) : Prop :=
  y = x ∨ y = symmetry.action x

@[simp] theorem sameAxis_iff_mem_axis {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x y : Carrier) :
    sameAxis symmetry x y ↔ y ∈ axis symmetry x :=
  Iff.rfl

theorem sameAxis_refl {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier) :
    sameAxis symmetry x x :=
  Or.inl rfl

theorem sameAxis_symm {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) {x y : Carrier}
    (same : sameAxis symmetry x y) :
    sameAxis symmetry y x := by
  rcases same with same | same
  · exact Or.inl same.symm
  · exact Or.inr (by
      calc
        x = symmetry.action (symmetry.action x) :=
          (symmetry.involutive x).symm
        _ = symmetry.action y := (congrArg symmetry.action same).symm)

theorem sameAxis_trans {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) {x y z : Carrier}
    (xy : sameAxis symmetry x y) (yz : sameAxis symmetry y z) :
    sameAxis symmetry x z := by
  rcases xy with rfl | xy
  · exact yz
  · subst y
    rcases yz with yz | yz
    · exact Or.inr yz
    · exact Or.inl (by
        calc
          z = symmetry.action (symmetry.action x) := yz
          _ = x := symmetry.involutive x)

/-- The involution-generated axes form a genuine equivalence partition. -/
def axisSetoid {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) : Setoid Carrier where
  r := sameAxis symmetry
  iseqv := by
    constructor
    · exact sameAxis_refl symmetry
    · exact sameAxis_symm symmetry
    · exact sameAxis_trans symmetry

/-- The space of axes (one point per two-point orbit). -/
def AxisQuotient {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) : Type u :=
  Quotient (axisSetoid symmetry)

/-- The canonical projection from a carrier point to its axis class. -/
def axisClass {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier) :
    AxisQuotient symmetry :=
  Quotient.mk (axisSetoid symmetry) x

theorem axisClass_eq_iff_sameAxis {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x y : Carrier) :
    axisClass symmetry x = axisClass symmetry y ↔
      sameAxis symmetry x y := by
  constructor
  · intro equality
    exact Quotient.exact (s := axisSetoid symmetry) equality
  · intro same
    exact Quotient.sound (s := axisSetoid symmetry) same

theorem action_preserves_axis_class {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier) :
    axisClass symmetry (symmetry.action x) = axisClass symmetry x :=
  Quotient.sound (s := axisSetoid symmetry)
    (Or.inr (symmetry.involutive x).symm)

/-- Axis equality is exactly the orbit relation, with no hidden third case. -/
theorem axis_eq_iff_sameAxis {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x y : Carrier) :
    axis symmetry x = axis symmetry y ↔ sameAxis symmetry x y := by
  constructor
  · intro equality
    have member : y ∈ axis symmetry x := by
      rw [equality]
      exact axis_mem_left symmetry y
    change y = x ∨ y = symmetry.action x
    exact member
  · intro same
    rcases same with same | same
    · subst y
      rfl
    · subst y
      exact (axis_invariant symmetry x).symm

/-- If two axes share one member, they are the same axis. -/
theorem axis_overlap_implies_equal {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x y : Carrier)
    (overlap : ∃ z, z ∈ axis symmetry x ∧ z ∈ axis symmetry y) :
    axis symmetry x = axis symmetry y := by
  obtain ⟨z, xz, yz⟩ := overlap
  change sameAxis symmetry x z at xz
  change sameAxis symmetry y z at yz
  apply (axis_eq_iff_sameAxis symmetry x y).2
  exact sameAxis_trans symmetry xz (sameAxis_symm symmetry yz)

/-! ## Balanced endpoints and the action as the axis' internal symmetry -/

/-- The action maps either endpoint of an axis to an endpoint of the same axis. -/
theorem axis_action_mem {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier)
    {y : Carrier} (membership : y ∈ axis symmetry x) :
    symmetry.action y ∈ axis symmetry x := by
  change y = x ∨ y = symmetry.action x at membership
  change symmetry.action y = x ∨ symmetry.action y = symmetry.action x
  rcases membership with rfl | rfl
  · exact Or.inr rfl
  · exact Or.inl (symmetry.involutive x)

/-- A subset is closed under the primitive symmetry action. -/
def AxisClosed {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (subset : Set Carrier) : Prop :=
  ∀ ⦃y⦄, y ∈ subset → symmetry.action y ∈ subset

theorem axis_closed {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier) :
    AxisClosed symmetry (axis symmetry x) := by
  intro y membership
  exact axis_action_mem symmetry x membership

/-- The generated axis is the smallest action-closed subset containing its
seed.  This is the precise minimality statement available from the
fixed-point-free involution alone. -/
theorem axis_is_smallest_closed {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier)
    (subset : Set Carrier) (contains : x ∈ subset)
    (closed : AxisClosed symmetry subset) :
    axis symmetry x ⊆ subset := by
  intro y membership
  change y = x ∨ y = symmetry.action x at membership
  rcases membership with rfl | rfl
  · exact contains
  · exact closed contains

/-- The action restricts to an involutive equivalence of every axis. -/
def axisSwap {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier) :
    axis symmetry x ≃ axis symmetry x where
  toFun := fun y => ⟨symmetry.action y.1, axis_action_mem symmetry x y.2⟩
  invFun := fun y => ⟨symmetry.action y.1, axis_action_mem symmetry x y.2⟩
  left_inv := by
    intro y
    apply Subtype.ext
    exact symmetry.involutive y.1
  right_inv := by
    intro y
    apply Subtype.ext
    exact symmetry.involutive y.1

theorem axisSwap_involutive {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier) :
    ∀ y : axis symmetry x, axisSwap symmetry x (axisSwap symmetry x y) = y := by
  intro y
  apply Subtype.ext
  exact symmetry.involutive y.1

theorem axisSwap_fixedPointFree {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier) :
    ∀ y : axis symmetry x, axisSwap symmetry x y ≠ y := by
  intro y equality
  have valueEquality : symmetry.action y.1 = y.1 :=
    congrArg Subtype.val equality
  exact symmetry.fixedPointFree y.1 valueEquality

theorem axisSwap_exchanges_endpoints_left {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier) :
    axisSwap symmetry x ⟨x, axis_mem_left symmetry x⟩ =
      ⟨symmetry.action x, axis_mem_right symmetry x⟩ := by
  apply Subtype.ext
  rfl

theorem axisSwap_exchanges_endpoints_right {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier) :
    axisSwap symmetry x ⟨symmetry.action x, axis_mem_right symmetry x⟩ =
      ⟨x, axis_mem_left symmetry x⟩ := by
  apply Subtype.ext
  exact symmetry.involutive x

/-- A non-trivial distinction supplies a genuinely two-sided axis. -/
theorem distinction_axis_nontrivial {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier)
    (distinguished : distinction symmetry x) :
    ∃ left right, left ∈ axis symmetry x ∧ right ∈ axis symmetry x ∧ left ≠ right :=
  ⟨x, symmetry.action x, axis_mem_left symmetry x, axis_mem_right symmetry x,
    distinguished⟩

/-- The generated axis is balanced by its canonical fixed-point-free swap. -/
theorem distinction_axis_balanced {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (x : Carrier)
    (distinguished : distinction symmetry x) :
    ∃ swap : axis symmetry x ≃ axis symmetry x,
      (∀ y, swap (swap y) = y) ∧ (∀ y, swap y ≠ y) :=
  ⟨axisSwap symmetry x, axisSwap_involutive symmetry x,
    axisSwap_fixedPointFree symmetry x⟩

/-! ## Invariants and allowed transformations -/

/-- A predicate is an axis invariant when the action cannot change it. -/
def AxisInvariant {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (predicate : Carrier → Prop) : Prop :=
  ∀ x, predicate (symmetry.action x) ↔ predicate x

theorem axisInvariant_constant_on_axis {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (predicate : Carrier → Prop)
    (invariant : AxisInvariant symmetry predicate) {x y : Carrier}
    (same : sameAxis symmetry x y) :
    predicate y ↔ predicate x := by
  rcases same with rfl | same
  · exact Iff.rfl
  · subst y
    exact invariant x

/-- A commuting map sends every endpoint to the corresponding transformed
endpoint; this is the exact preservation condition for generated axes. -/
def CommutesWithInvolution {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (map : Carrier → Carrier) : Prop :=
  ∀ x, map (symmetry.action x) = symmetry.action (map x)

theorem commuting_map_preserves_axis {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (map : Carrier → Carrier)
    (commutes : CommutesWithInvolution symmetry map) {x y : Carrier}
    (membership : y ∈ axis symmetry x) :
    map y ∈ axis symmetry (map x) := by
  change y = x ∨ y = symmetry.action x at membership
  change map y = map x ∨ map y = symmetry.action (map x)
  rcases membership with rfl | rfl
  · exact Or.inl rfl
  · exact Or.inr (commutes x)

theorem commuting_equiv_maps_axis_exactly {Carrier : Type u}
    (symmetry : FixedPointFreeInvolution Carrier) (map : Carrier ≃ Carrier)
    (commutes : CommutesWithInvolution symmetry map) (x : Carrier) :
    map '' axis symmetry x = axis symmetry (map x) := by
  ext z
  constructor
  · rintro ⟨y, membership, rfl⟩
    exact commuting_map_preserves_axis symmetry map commutes membership
  · intro membership
    change z = map x ∨ z = symmetry.action (map x) at membership
    rcases membership with membership | membership
    · exact ⟨x, axis_mem_left symmetry x, membership.symm⟩
    · exact ⟨symmetry.action x, axis_mem_right symmetry x,
        (commutes x).trans membership.symm⟩

end OCKIndividuationMSpaceComposition
