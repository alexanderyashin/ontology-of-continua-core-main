import OCKIndividuationMSpaceComposition.SymmetryDistinctionDimensionBoundary
import Mathlib.LinearAlgebra.FiniteDimensional.Basic
import Mathlib.Algebra.Field.ZMod

namespace OCKIndividuationMSpaceComposition

universe uScalar uCarrier

namespace PrimitiveDistinction

/-!
# The exact affine premise which turns a distinction into one direction

A bare primitive distinction produces a two-point `C₂` axis, but the preceding
boundary theorem proves that this axis has no strict intermediate point.  This
file adds one mathematically explicit premise: the carrier is already a vector
space over a field.  The distinction then determines a nonzero displacement,
and the span of that displacement has finrank exactly one.

This is a genuine derivation of a one-dimensional *linear direction*; it is
not a definition of the primitive axis as a line.  The original generated axis
still contains only its two endpoints.  Affine interpolation becomes available
through scalar parameters, and an interior parameter exists exactly when the
scalar field supplies an element different from `0` and `1`.  Thus dimension,
interpolation, order, density and continuum are kept as distinct layers.
-/

section AffineRealization

variable {K : Type uScalar} {V : Type uCarrier}
  [Field K] [AddCommGroup V] [Module K V]

/-- The oriented displacement selected by the displayed endpoint labels. -/
def displacement (distinction : PrimitiveDistinction V) : V :=
  distinction.second - distinction.first

/-- A genuine distinction has a nonzero displacement in every linear
realization. -/
theorem displacement_ne_zero (distinction : PrimitiveDistinction V) :
    distinction.displacement ≠ 0 := by
  exact sub_ne_zero.mpr (Ne.symm distinction.separated)

/-- The linear direction generated by the distinction. -/
def directionSubmodule (distinction : PrimitiveDistinction V) : Submodule K V :=
  K ∙ distinction.displacement

/-- Once an affine/linear realization is supplied, a primitive distinction
generates exactly one linear dimension. -/
theorem directionSubmodule_finrank (distinction : PrimitiveDistinction V) :
    Module.finrank K (directionSubmodule (K := K) distinction) = 1 := by
  exact finrank_span_singleton distinction.displacement_ne_zero

/-- Reversing endpoint labels negates the oriented displacement. -/
@[simp] theorem reverseLabels_displacement
    (distinction : PrimitiveDistinction V) :
    distinction.reverseLabels.displacement = -distinction.displacement := by
  simp [displacement, reverseLabels, sub_eq_add_neg]

/-- The label-independent direction submodule survives reversal. -/
theorem reverseLabels_directionSubmodule
    (distinction : PrimitiveDistinction V) :
    directionSubmodule (K := K) distinction.reverseLabels =
      directionSubmodule (K := K) distinction := by
  rw [directionSubmodule, directionSubmodule, reverseLabels_displacement]
  apply Submodule.span_singleton_eq_span_singleton.mpr
  exact ⟨(-1 : Kˣ), by simp⟩

/-- Algebraic affine parameterization of the line through the distinguished
endpoints.  No topology, order or continuity is claimed. -/
def affineAxisPoint (distinction : PrimitiveDistinction V) (t : K) : V :=
  distinction.first + t • distinction.displacement

@[simp] theorem affineAxisPoint_zero (distinction : PrimitiveDistinction V) :
    distinction.affineAxisPoint (0 : K) = distinction.first := by
  simp [affineAxisPoint]

@[simp] theorem affineAxisPoint_one (distinction : PrimitiveDistinction V) :
    distinction.affineAxisPoint (1 : K) = distinction.second := by
  simp [affineAxisPoint, displacement]

/-- A nonzero displacement makes the scalar parameterization injective. -/
theorem affineAxisPoint_injective (distinction : PrimitiveDistinction V) :
    Function.Injective (affineAxisPoint (K := K) distinction) := by
  intro firstScalar secondScalar equality
  have scaledEquality :
      firstScalar • distinction.displacement =
        secondScalar • distinction.displacement := by
    exact add_left_cancel equality
  have zeroProduct :
      (firstScalar - secondScalar) • distinction.displacement = 0 := by
    rw [sub_smul, scaledEquality, sub_self]
  have scalarDifferenceZero : firstScalar - secondScalar = 0 :=
    (smul_eq_zero.mp zeroProduct).resolve_right distinction.displacement_ne_zero
  exact sub_eq_zero.mp scalarDifferenceZero

/-- Every scalar other than the endpoint parameters supplies an ambient point
outside the original generated two-point axis. -/
theorem affineAxisPoint_outside (distinction : PrimitiveDistinction V)
    {t : K} (notZero : t ≠ 0) (notOne : t ≠ 1) :
    distinction.affineAxisPoint t ≠ distinction.first ∧
      distinction.affineAxisPoint t ≠ distinction.second := by
  constructor
  · intro equalsFirst
    apply notZero
    apply affineAxisPoint_injective (K := K) distinction
    simpa using equalsFirst
  · intro equalsSecond
    apply notOne
    apply affineAxisPoint_injective (K := K) distinction
    simpa using equalsSecond

/-- Affine interpolation has a strict third sample exactly when the scalar
field has a parameter other than the two endpoint parameters.  One-dimensional
finrank alone therefore does not imply density or continuum. -/
theorem affineAxis_has_strict_third_sample_iff
    (distinction : PrimitiveDistinction V) :
    (∃ t : K,
        distinction.affineAxisPoint t ≠ distinction.first ∧
          distinction.affineAxisPoint t ≠ distinction.second) ↔
      ∃ t : K, t ≠ 0 ∧ t ≠ 1 := by
  constructor
  · rintro ⟨t, notFirst, notSecond⟩
    refine ⟨t, ?_, ?_⟩
    · intro equalsZero
      subst t
      exact notFirst (distinction.affineAxisPoint_zero)
    · intro equalsOne
      subst t
      exact notSecond (distinction.affineAxisPoint_one)
  · rintro ⟨t, notZero, notOne⟩
    exact ⟨t, distinction.affineAxisPoint_outside notZero notOne⟩

/-- Reversing endpoint labels reverses the affine parameter while leaving the
underlying point unchanged. -/
theorem reverseLabels_affineAxisPoint
    (distinction : PrimitiveDistinction V) (t : K) :
    distinction.reverseLabels.affineAxisPoint t =
      distinction.affineAxisPoint (1 - t) := by
  simp [affineAxisPoint, displacement, reverseLabels, sub_smul]
  module

end AffineRealization

/-! ## A finite-field countermodel to interpolation from finrank alone -/

/-- Over the two-element field the generated direction still has finrank one,
but the affine parameter line contains no strict third sample. -/
theorem zmodTwo_no_strict_third_affine_sample
    (distinction : PrimitiveDistinction (ZMod 2)) :
    ¬ ∃ t : ZMod 2,
        affineAxisPoint distinction t ≠ distinction.first ∧
          affineAxisPoint distinction t ≠ distinction.second := by
  rw [affineAxis_has_strict_third_sample_iff]
  push_neg
  intro t
  fin_cases t <;> simp

end PrimitiveDistinction

end OCKIndividuationMSpaceComposition
