import OCKIndividuationMSpaceComposition.SymmetryIntrinsicComponentRank
import Mathlib.Data.Finset.Lattice.Fold
import Mathlib.Tactic

namespace OCKIndividuationMSpaceComposition

namespace IntrinsicFinitaryRank

/-!
# Intrinsic finite-family rank after composition has been fixed

This module does not choose OC's scientific composition law.  Instead it
isolates the exact finite theorem that becomes available once such a law has
been grounded and its induced closure has been proved to satisfy exchange.

No vector, coordinate, basis, module, affine space, matroid or `finrank` is
part of the definitions.  Rank is the maximum cardinality of a
closure-independent subfamily of the observed finite distinction family.

The main theorem proves the requested one-way emergence law:

`newDistinction ∉ closure existing` implies
`rank (insert newDistinction existing) = rank existing + 1`.

The theorem is conditional because the current OC core still has to supply
and scientifically justify the actual composition of distinction witnesses.
Here `finite-family` means that observed families are represented by `Finset`;
no algebraic finitarity or directed-union theorem is claimed.  Exchange is a
visible structural premise, not a property already derived from OC.  The
idempotence field belongs to the full closure interface, although the local
rank-growth proof below needs only extensivity, monotonicity and exchange.
-/

universe uToken

/-- A finite-family closure interface isolated from any preselected
representation.  `exchange` is visible as a separate scientific obligation. -/
structure FinitaryDistinctionClosure (Token : Type uToken) [DecidableEq Token] where
  close : Finset Token → Finset Token
  extensive : ∀ seed, seed ⊆ close seed
  monotone : ∀ ⦃first second⦄, first ⊆ second → close first ⊆ close second
  idempotent : ∀ seed, close (close seed) = close seed
  exchange : ∀ seed first second,
    first ∈ close (insert second seed) →
    first ∉ close seed →
    second ∈ close (insert first seed)

variable {Token : Type uToken} [DecidableEq Token]

/-- No member of an independent family is generated by all the others. -/
def FinitaryDistinctionClosure.Independent
    (closure : FinitaryDistinctionClosure Token) (family : Finset Token) : Prop :=
  ∀ token ∈ family, token ∉ closure.close (family.erase token)

/-- Rank relative to a supplied closure and an observed finite seed: the
largest closure-independent subfamily cardinality.  This is not yet a rank of
the whole OC system. -/
noncomputable def FinitaryDistinctionClosure.rank
    (closure : FinitaryDistinctionClosure Token) (seed : Finset Token) : Nat := by
  classical
  exact (seed.powerset.filter closure.Independent).sup Finset.card

theorem FinitaryDistinctionClosure.empty_independent
    (closure : FinitaryDistinctionClosure Token) :
    closure.Independent ∅ := by
  simp [Independent]

/-- Closure-independence is hereditary; this uses monotonicity rather than
assuming a separate hereditary axiom. -/
theorem FinitaryDistinctionClosure.Independent.mono
    {closure : FinitaryDistinctionClosure Token}
    {larger smaller : Finset Token}
    (independent : closure.Independent larger)
    (subset : smaller ⊆ larger) :
    closure.Independent smaller := by
  intro token tokenMember generated
  have inLarger : token ∈ larger := subset tokenMember
  exact independent token inLarger
    (closure.monotone (Finset.erase_subset_erase token subset) generated)

theorem FinitaryDistinctionClosure.independent_card_le_rank
    (closure : FinitaryDistinctionClosure Token)
    {family seed : Finset Token}
    (subset : family ⊆ seed)
    (independent : closure.Independent family) :
    family.card ≤ closure.rank seed := by
  classical
  unfold rank
  apply Finset.le_sup
  simp [subset, independent]

/-- Adding an element outside closure preserves independence.  The nontrivial
old-member case is exactly where exchange is used. -/
theorem FinitaryDistinctionClosure.Independent.insert_of_not_generated
    {closure : FinitaryDistinctionClosure Token}
    {family : Finset Token} {token : Token}
    (independent : closure.Independent family)
    (notGenerated : token ∉ closure.close family) :
    closure.Independent (insert token family) := by
  have tokenNotMember : token ∉ family := by
    intro tokenMember
    exact notGenerated (closure.extensive family tokenMember)
  intro current currentMember
  rcases Finset.mem_insert.mp currentMember with currentEq | currentInFamily
  · subst current
    simpa [tokenNotMember] using notGenerated
  · have currentNeToken : current ≠ token := by
      intro currentEq
      subst current
      exact tokenNotMember currentInFamily
    have currentNotGenerated :
        current ∉ closure.close (family.erase current) :=
      independent current currentInFamily
    intro currentGenerated
    have currentGenerated' :
        current ∈ closure.close (insert token (family.erase current)) := by
      rw [Finset.erase_insert_of_ne currentNeToken.symm] at currentGenerated
      exact currentGenerated
    have tokenGenerated := closure.exchange
      (family.erase current) current token
      currentGenerated' currentNotGenerated
    apply notGenerated
    simpa [Finset.insert_erase currentInFamily] using tokenGenerated

/-- Every finite family has an independent subfamily attaining the defined
rank.  This is a finite maximum theorem, not a choice of coordinates. -/
theorem FinitaryDistinctionClosure.exists_independent_rank_witness
    (closure : FinitaryDistinctionClosure Token) (seed : Finset Token) :
    ∃ family ⊆ seed,
      closure.Independent family ∧ family.card = closure.rank seed := by
  classical
  let candidates := seed.powerset.filter closure.Independent
  have candidatesNonempty : candidates.Nonempty := by
    refine ⟨∅, ?_⟩
    simp [candidates, closure.empty_independent]
  rcases Finset.exists_mem_eq_sup candidates candidatesNonempty Finset.card with
    ⟨family, familyMember, rankEq⟩
  have familyFacts := Finset.mem_filter.mp familyMember
  exact ⟨family, Finset.mem_powerset.mp familyFacts.1, familyFacts.2,
    rankEq.symm⟩

/-- A subset of `insert token seed` has cardinality at most one more than the
rank of `seed`.  This upper bound uses only heredity. -/
theorem FinitaryDistinctionClosure.independent_insert_card_le
    (closure : FinitaryDistinctionClosure Token)
    {family seed : Finset Token} {token : Token}
    (subset : family ⊆ insert token seed)
    (independent : closure.Independent family) :
    family.card ≤ closure.rank seed + 1 := by
  have erasedSubset : family.erase token ⊆ seed :=
    Finset.subset_insert_iff.mp subset
  have erasedIndependent : closure.Independent (family.erase token) :=
    independent.mono (Finset.erase_subset token family)
  have erasedCardBound :=
    closure.independent_card_le_rank erasedSubset erasedIndependent
  by_cases tokenMember : token ∈ family
  · rw [← Finset.card_erase_add_one tokenMember]
    exact Nat.add_le_add_right erasedCardBound 1
  · simpa [Finset.erase_eq_of_notMem tokenMember] using
      Nat.le_succ_of_le erasedCardBound

/-- Main intrinsic emergence theorem.  Once an OC-grounded finite composition
closure satisfies exchange, every genuinely new distinction increases the
intrinsic rank by exactly one. -/
theorem FinitaryDistinctionClosure.rank_insert_eq_add_one_of_not_generated
    (closure : FinitaryDistinctionClosure Token)
    (seed : Finset Token) (token : Token)
    (notGenerated : token ∉ closure.close seed) :
    closure.rank (insert token seed) = closure.rank seed + 1 := by
  classical
  rcases closure.exists_independent_rank_witness seed with
    ⟨basis, basisSubset, basisIndependent, basisCard⟩
  have tokenNotGeneratedByBasis : token ∉ closure.close basis := by
    intro generated
    exact notGenerated (closure.monotone basisSubset generated)
  have extendedIndependent : closure.Independent (insert token basis) :=
    basisIndependent.insert_of_not_generated tokenNotGeneratedByBasis
  have tokenNotBasis : token ∉ basis := by
    intro tokenMember
    exact tokenNotGeneratedByBasis (closure.extensive basis tokenMember)
  have lower : closure.rank seed + 1 ≤ closure.rank (insert token seed) := by
    rw [← basisCard, ← Finset.card_insert_of_notMem tokenNotBasis]
    exact closure.independent_card_le_rank
      (Finset.insert_subset_insert token basisSubset) extendedIndependent
  have upper : closure.rank (insert token seed) ≤ closure.rank seed + 1 := by
    unfold rank
    apply Finset.sup_le
    intro family familyMember
    have familyFacts := Finset.mem_filter.mp familyMember
    exact closure.independent_insert_card_le
      (Finset.mem_powerset.mp familyFacts.1) familyFacts.2
  exact Nat.le_antisymm upper lower

/-! ## Invariance under admissible relabeling

An arbitrary bijection is not automatically an admissible OC transformation.
The following interface makes the exact additional obligation visible: the
bijection must preserve generatedness for every finite family.  Only under
that obligation does rank descend to the invariant layer.
-/

/-- A relabeling that preserves and reflects the supplied closure.  This is an
admissibility witness, not a definition of which transformations OC admits. -/
structure FinitaryDistinctionClosure.Relabeling
    (closure : FinitaryDistinctionClosure Token) where
  relabel : Token ≃ Token
  preserves_generatedness : ∀ seed token,
    relabel token ∈ closure.close (seed.image relabel) ↔
      token ∈ closure.close seed

/-- A closure-preserving relabeling carries independent families to
independent families. -/
theorem FinitaryDistinctionClosure.Relabeling.independent_image
    {closure : FinitaryDistinctionClosure Token}
    (relabeling : closure.Relabeling)
    {family : Finset Token}
    (independent : closure.Independent family) :
    closure.Independent (family.image relabeling.relabel) := by
  intro mappedToken mappedMember mappedGenerated
  rcases Finset.mem_image.mp mappedMember with
    ⟨token, tokenMember, rfl⟩
  have eraseImage :
      (family.image relabeling.relabel).erase (relabeling.relabel token) =
        (family.erase token).image relabeling.relabel := by
    ext candidate
    constructor
    · intro candidateMember
      rcases Finset.mem_erase.mp candidateMember with
        ⟨candidateNe, candidateImageMember⟩
      rcases Finset.mem_image.mp candidateImageMember with
        ⟨original, originalMember, originalMaps⟩
      apply Finset.mem_image.mpr
      refine ⟨original, Finset.mem_erase.mpr ⟨?_, originalMember⟩,
        originalMaps⟩
      intro originalEq
      subst original
      exact candidateNe originalMaps.symm
    · intro candidateMember
      rcases Finset.mem_image.mp candidateMember with
        ⟨original, originalMember, originalMaps⟩
      rcases Finset.mem_erase.mp originalMember with
        ⟨originalNe, originalInFamily⟩
      apply Finset.mem_erase.mpr
      refine ⟨?_, Finset.mem_image.mpr
        ⟨original, originalInFamily, originalMaps⟩⟩
      intro candidateEq
      apply originalNe
      exact relabeling.relabel.injective
        (originalMaps.trans candidateEq)
  rw [eraseImage] at mappedGenerated
  exact independent token tokenMember
    ((relabeling.preserves_generatedness (family.erase token) token).mp
      mappedGenerated)

/-- Reversing an admissible relabeling remains admissible. -/
def FinitaryDistinctionClosure.Relabeling.symm
    {closure : FinitaryDistinctionClosure Token}
    (relabeling : closure.Relabeling) : closure.Relabeling where
  relabel := relabeling.relabel.symm
  preserves_generatedness := by
    intro seed token
    have transported := relabeling.preserves_generatedness
      (seed.image relabeling.relabel.symm) (relabeling.relabel.symm token)
    simpa [Finset.image_image] using transported.symm

/-- Mapping a finite seed through a closure-preserving relabeling cannot lower
its relative closure-rank. -/
theorem FinitaryDistinctionClosure.Relabeling.rank_le_rank_image
    {closure : FinitaryDistinctionClosure Token}
    (relabeling : closure.Relabeling)
    (seed : Finset Token) :
    closure.rank seed ≤ closure.rank (seed.image relabeling.relabel) := by
  classical
  rcases closure.exists_independent_rank_witness seed with
    ⟨basis, basisSubset, basisIndependent, basisCard⟩
  have mappedIndependent :
      closure.Independent (basis.image relabeling.relabel) :=
    relabeling.independent_image basisIndependent
  have mappedSubset :
      basis.image relabeling.relabel ⊆ seed.image relabeling.relabel :=
    Finset.image_subset_image basisSubset
  have mappedBound := closure.independent_card_le_rank
    mappedSubset mappedIndependent
  rw [Finset.card_image_of_injective basis relabeling.relabel.injective,
    basisCard]
    at mappedBound
  exact mappedBound

/-- Relative closure-rank is invariant under every admissible relabeling.
Consequently pole names, orientation names and coordinate names cannot alter
dimension once their transformations are proved to preserve closure. -/
theorem FinitaryDistinctionClosure.Relabeling.rank_image_eq
    {closure : FinitaryDistinctionClosure Token}
    (relabeling : closure.Relabeling)
    (seed : Finset Token) :
    closure.rank (seed.image relabeling.relabel) = closure.rank seed := by
  apply Nat.le_antisymm
  · have reverseBound := relabeling.symm.rank_le_rank_image
      (seed.image relabeling.relabel)
    change closure.rank (seed.image relabeling.relabel) ≤
      closure.rank
        ((seed.image relabeling.relabel).image relabeling.relabel.symm)
      at reverseBound
    have roundtrip :
        (seed.image relabeling.relabel).image relabeling.relabel.symm =
          seed := by
      ext token
      simp
    rw [roundtrip] at reverseBound
    exact reverseBound
  · exact relabeling.rank_le_rank_image seed

/-! ## The triangle closure realizes the theorem without vectors -/

open IntrinsicComponentRank in
def triangleFinitaryClosure :
    FinitaryDistinctionClosure TriangleToken where
  close := triangleClosure
  extensive := triangleClosure_extensive
  monotone := triangleClosure_monotone
  idempotent := triangleClosure_idempotent
  exchange := triangleClosure_exchange

open IntrinsicComponentRank in
theorem triangle_rank_insert_grows :
    triangleFinitaryClosure.rank (insert 1 {0}) =
      triangleFinitaryClosure.rank {0} + 1 := by
  exact triangleFinitaryClosure.rank_insert_eq_add_one_of_not_generated
    {0} 1 (by decide)

end IntrinsicFinitaryRank

end OCKIndividuationMSpaceComposition
